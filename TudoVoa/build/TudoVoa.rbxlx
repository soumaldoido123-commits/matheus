      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="10">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
--[[
	TUDO VOA! — Ilhas do Caos
	Script principal do servidor: inicia os sistemas, gera o mundo e coloca os jogadores.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

Players.CharacterAutoLoads = false
Players.RespawnTime = 3

workspace.Gravity = 196.2
workspace.StreamingEnabled = false
workspace.FallenPartsDestroyHeight = Config.World.KillY - 200
workspace:SetAttribute("TV_WorldReady", false)
workspace:SetAttribute("TV_Progress", 0)
workspace:SetAttribute("TV_LoadText", "Iniciando...")

-- 1) remotes primeiro (todo o resto usa)
Remotes.init()

-- 2) sistemas base (cada um carregado/iniciado de forma protegida: um erro nao derruba o jogo todo)
local function load(name: string): any
	local ok, mod = xpcall(function()
		return require(script:WaitForChild(name, 20))
	end, debug.traceback)
	if not ok then
		warn("[Servidor] falha ao carregar '" .. name .. "':\n" .. tostring(mod))
		return nil
	end
	return mod
end

local function start(name: string, mod: any)
	if mod and type(mod.init) == "function" then
		local ok, err = xpcall(mod.init, debug.traceback)
		if not ok then
			warn("[Servidor] falha ao iniciar '" .. name .. "':\n" .. tostring(err))
		end
	end
end

local Data = load("Data")
local Physics = load("Physics")
local Ragdoll = load("Ragdoll")
local Scoring = load("Scoring")
local Board = load("Board")
local Blasts = load("Blasts")
local Pickups = load("Pickups")
local ToyPassive = load("ToyPassive")
local ToySpawner = load("ToySpawner")
local Grab = load("Grab")
local AbilityService = load("AbilityService")
local Shop = load("Shop")
local Zones = load("Zones")
local Quests = load("Quests")
local Atmosphere = load("Atmosphere")

start("Atmosphere", Atmosphere)
start("Data", Data)
start("Physics", Physics)
start("Ragdoll", Ragdoll)
start("Scoring", Scoring)
start("Board", Board)
start("Blasts", Blasts)
start("Pickups", Pickups)
start("ToyPassive", ToyPassive)
start("ToySpawner", ToySpawner)
start("Grab", Grab)
start("AbilityService", AbilityService)
start("Shop", Shop)
start("Zones", Zones)
start("Quests", Quests)

-- 3) jogadores: espera o mundo + dados e so entao cria o personagem
local function spawnPlayer(player: Player)
	local t0 = os.clock()
	while not workspace:GetAttribute("TV_WorldReady") and player.Parent do
		task.wait(0.25)
	end
	while Data and not Data.isLoaded(player) and os.clock() - t0 < 30 and player.Parent do
		task.wait(0.2)
	end
	if player.Parent then
		Physics.loadCharacter(player)
	end
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(spawnPlayer, player)
end)
for _, p in Players:GetPlayers() do
	task.spawn(spawnPlayer, p)
end

-- 4) mundo (demora alguns segundos)
task.spawn(function()
	local ok, err = xpcall(function()
		local Scenery = require(script:WaitForChild("World"):WaitForChild("Scenery"))
		Scenery.build()
		ToySpawner.fillAll()

		-- atividades e eventos (modulos opcionais: se um falhar, o resto do jogo segue)
		local Activities = script:FindFirstChild("Activities")
		if Activities then
			for _, mod in Activities:GetChildren() do
				if mod:IsA("ModuleScript") then
					local okMod, res = pcall(require, mod)
					if okMod and type(res) == "table" and res.init then
						local okInit, e = pcall(res.init)
						if not okInit then
							warn("[Atividade] falhou ao iniciar", mod.Name, e)
						end
					elseif not okMod then
						warn("[Atividade] falhou ao carregar", mod.Name, res)
					end
				end
			end
		end
	end, debug.traceback)
	if not ok then
		warn("[TudoVoa] erro ao gerar o mundo:\n" .. tostring(err))
		workspace:SetAttribute("TV_LoadText", "Erro ao gerar o mundo (veja o Output)")
	end
	workspace:SetAttribute("TV_WorldReady", true)
	Remotes.get("WorldReady"):FireAllClients()
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">AbilityService</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Abilities (servidor): valida e executa as habilidades.
	Cliente pede (UseAbility), servidor confere nivel, recarga, alcance e aplica o efeito.
	  pull    puxa um objeto mirado ate voce
	  dash    impulso (o cliente aplica a velocidade; servidor so controla a recarga e o visual)
	  stasis  congela/descongela um objeto no ar (vira plataforma)
	  shock   onda de choque em volta
	  bubble  bolha anti-gravidade no ponto mirado
	  hook    gancho: te puxa ate o ponto mirado
	  shield  escudo: ninguem agarra nem empurra
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local AbilityDefs = require(Shared:WaitForChild("AbilityDefs"))
local Util = require(Shared:WaitForChild("Util"))

local Data = require(script.Parent:WaitForChild("Data"))
local Grab = require(script.Parent:WaitForChild("Grab"))
local Physics = require(script.Parent:WaitForChild("Physics"))
local Blasts = require(script.Parent:WaitForChild("Blasts"))
local Quests = require(script.Parent:WaitForChild("Quests"))

local Abilities = {}

local cooldowns = {} -- [player] = { [id] = os.clock() ate quando }
local frozen = {} -- [player] = { root, ... }
local hooks = {} -- [player] = { align, att, anchor, expire, point }

local MAX_FROZEN = 5
local FREEZE_TIME = 32

local function cooldownFor(player: Player, def): number
	local scale = 1 - 0.06 * Data.getUpgrade(player, "Cooldown")
	return def.cooldown * math.max(0.4, scale)
end

local function isObject(root: any): boolean
	return typeof(root) == "Instance"
		and root:IsA("BasePart")
		and root:IsDescendantOf(workspace)
		and CollectionService:HasTag(root, Config.Tags.Grabbable)
end

local function flatDistance(a: Vector3, b: Vector3): number
	return (a - b).Magnitude
end

-- Estase -----------------------------------------------------------------------------------------------

local function unfreeze(root: BasePart)
	if not root.Parent then
		return
	end
	root:SetAttribute("Frozen", nil)
	root.Anchored = false
	root.AssemblyLinearVelocity = Vector3.zero
	local model = root:FindFirstAncestorOfClass("Model")
	local hl = (model or root):FindFirstChild("TV_FrozenHL")
	if hl then
		hl:Destroy()
	end
	Util.setAll(model and model.PrimaryPart == root and model or root, "Anchored", false)
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
end

local function freeze(player: Player, root: BasePart)
	local list = frozen[player]
	if not list then
		list = {}
		frozen[player] = list
	end
	while #list >= MAX_FROZEN do
		local old = table.remove(list, 1)
		if old and old.Parent then
			unfreeze(old)
		end
	end
	local model = root:FindFirstAncestorOfClass("Model")
	if not (model and model.PrimaryPart == root) then
		model = nil
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	Util.setAll(model or root, "Anchored", true)
	root:SetAttribute("Frozen", os.clock())
	local hl = Instance.new("Highlight")
	hl.Name = "TV_FrozenHL"
	hl.FillColor = Color3.fromRGB(120, 220, 255)
	hl.FillTransparency = 0.72
	hl.OutlineColor = Color3.fromRGB(230, 250, 255)
	hl.OutlineTransparency = 0.1
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Adornee = model or root
	hl.Parent = model or root
	table.insert(list, root)
	Remotes.get("Fx"):FireAllClients("freeze", root.Position, 1, nil)

	task.delay(FREEZE_TIME, function()
		if root.Parent and root:GetAttribute("Frozen") then
			unfreeze(root)
			local i = table.find(list, root)
			if i then
				table.remove(list, i)
			end
		end
	end)
end

local function doStasis(player: Player, hrp: BasePart, target: any)
	-- descongelar?
	if isObject(target) and target:GetAttribute("Frozen") then
		if flatDistance(target.Position, hrp.Position) > 150 then
			return false
		end
		unfreeze(target)
		local list = frozen[player]
		if list then
			local i = table.find(list, target)
			if i then
				table.remove(list, i)
			end
		end
		Remotes.get("Fx"):FireAllClients("unfreeze", target.Position, 1, nil)
		return true
	end
	-- congelar o que esta segurando
	local held = Grab.holdsOf(player)
	local hold
	for _, h in held do
		if h.kind == "object" and (target == nil or h.key == target) then
			hold = h
			break
		end
	end
	local root
	if hold then
		root = hold.key
		Grab.forceRelease(root, "freeze")
	elseif isObject(target) and not target:GetAttribute("HeldBy") and not target.Anchored then
		root = target
		if flatDistance(root.Position, hrp.Position) > 130 then
			return false
		end
	end
	if not root or not root.Parent then
		return false
	end
	freeze(player, root)
	return true
end

-- Gancho ---------------------------------------------------------------------------------------------------

local function stopHook(player: Player)
	local h = hooks[player]
	if not h then
		return
	end
	hooks[player] = nil
	for _, o in { h.align, h.att, h.anchor } do
		if o and o.Parent then
			o:Destroy()
		end
	end
	player:SetAttribute("HookPoint", nil)
end

local function doHook(player: Player, hrp: BasePart, point: any)
	if typeof(point) ~= "Vector3" then
		return false
	end
	local def = AbilityDefs.ById.hook
	local off = point - hrp.Position
	if off.Magnitude > def.range + 15 or off.Magnitude < 8 then
		return false
	end
	-- o ponto tem que estar "perto" de uma superficie de verdade (nao no ar)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local hit = workspace:Raycast(hrp.Position, off.Unit * (off.Magnitude + 6), params)
	if not hit or (hit.Position - point).Magnitude > 9 then
		return false
	end
	stopHook(player)

	local mass = Physics.characterMass(player.Character)
	local anchor = Instance.new("Part")
	anchor.Name = "TV_HookAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = hit.Position
	anchor.Parent = workspace

	local att = Instance.new("Attachment")
	att.Name = "TV_HookAtt"
	att.Parent = hrp

	local align = Instance.new("AlignPosition")
	align.Name = "TV_HookAlign"
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = att
	align.Position = hit.Position + hit.Normal * 3.5
	align.MaxVelocity = 115
	align.Responsiveness = 11
	align.MaxForce = mass * 9000
	align.RigidityEnabled = false
	align.ApplyAtCenterOfMass = true
	align.Parent = hrp

	hooks[player] = { align = align, att = att, anchor = anchor, expire = os.clock() + 2.6, point = hit.Position }
	player:SetAttribute("HookPoint", hit.Position)
	Remotes.get("AbilityFx"):FireAllClients("hook", player.UserId, hit.Position, nil)
	return true
end

-- Pull ---------------------------------------------------------------------------------------------------------

local function doPull(player: Player, hrp: BasePart, target: any)
	if not isObject(target) or target.Anchored or target:GetAttribute("HeldBy") then
		return false
	end
	local def = AbilityDefs.ById.pull
	local off = (hrp.Position + Vector3.new(0, 3, 0)) - target.Position
	if off.Magnitude > def.range + 20 then
		return false
	end
	local mass = target.AssemblyMass
	if mass > Grab.maxMass(player) then
		return false
	end
	Physics.setOwner(target, nil)
	local speed = math.clamp(off.Magnitude * 1.7, 45, 140)
	target.AssemblyLinearVelocity = off.Unit * speed
	target.AssemblyAngularVelocity = Util.randomUnit() * 4
	Remotes.get("AbilityFx"):FireAllClients("pull", player.UserId, target.Position, nil)
	return true
end

-- Registro ------------------------------------------------------------------------------------------------------

local function handleUse(player: Player, id: any, arg: any)
	if type(id) ~= "string" then
		return
	end
	local def = AbilityDefs.ById[id]
	if not def or not Data.isLoaded(player) then
		return
	end
	local d = Data.get(player)
	if d.Level < def.level then
		Remotes.get("Notify"):FireClient(player, def.name .. " libera no nível " .. def.level, "bad")
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return
	end
	local cds = cooldowns[player]
	if not cds then
		cds = {}
		cooldowns[player] = cds
	end
	local now = os.clock()
	if cds[id] and now < cds[id] - 0.15 then
		return
	end

	local ok = false
	if id == "pull" then
		ok = doPull(player, hrp, arg)
	elseif id == "dash" then
		ok = true
		Remotes.get("AbilityFx"):FireAllClients("dash", player.UserId, hrp.Position, nil)
	elseif id == "stasis" then
		ok = doStasis(player, hrp, arg)
	elseif id == "shock" then
		ok = true
		Blasts.shock(player, hrp.Position, def.radius, 125)
	elseif id == "bubble" then
		if typeof(arg) == "Vector3" and (arg - hrp.Position).Magnitude <= def.range + 20 then
			Blasts.bubble(arg + Vector3.new(0, def.radius * 0.35, 0), def.radius, def.duration, player)
			ok = true
		end
	elseif id == "hook" then
		ok = doHook(player, hrp, arg)
	elseif id == "shield" then
		player:SetAttribute("ShieldUntil", workspace:GetServerTimeNow() + def.duration)
		Remotes.get("AbilityFx"):FireAllClients("shield", player.UserId, hrp.Position, def.duration)
		ok = true
	end

	if ok then
		Quests.report(player, "ability", 1)
		cds[id] = now + cooldownFor(player, def)
	else
		Remotes.get("AbilityFx"):FireClient(player, "fail", player.UserId, hrp.Position, id)
	end
end

function Abilities.init()
	Remotes.get("UseAbility").OnServerEvent:Connect(function(player, id, arg)
		local ok, err = pcall(handleUse, player, id, arg)
		if not ok then
			warn("[Abilities] erro:", err)
		end
	end)

	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for player, h in hooks do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp or now >= h.expire or (hrp.Position - h.point).Magnitude < 9 then
				stopHook(player)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		stopHook(player)
		cooldowns[player] = nil
		local list = frozen[player]
		if list then
			for _, r in list do
				if r.Parent then
					unfreeze(r)
				end
			end
		end
		frozen[player] = nil
	end)
end

return Abilities
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Activities</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Arena</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Arena: "Arena do Caos" na ilha flutuante sobre a praca.
	Plataforma suspensa: quem cai perde a rodada. Robos rolantes vem em ondas e tentam te empurrar
	para fora — agarre-os e arremesse-os para o vazio! Tambem serve para duelos entre jogadores.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Server = script.Parent.Parent
local Build = require(Server:WaitForChild("World"):WaitForChild("Build"))
local WorldGen = require(Server:WaitForChild("World"):WaitForChild("WorldGen"))
local Hub = require(Server:WaitForChild("World"):WaitForChild("Hub"))
local Data = require(Server:WaitForChild("Data"))
local Quests = require(Server:WaitForChild("Quests"))
local Physics = require(Server:WaitForChild("Physics"))
local Ragdoll = require(Server:WaitForChild("Ragdoll"))

local Arena = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local PLATFORM_R = 56
local PLATFORM_LIFT = 46 -- altura da plataforma acima da grama da ilha
local MAX_WAVE = 8

local center: Vector3 -- centro da plataforma (topo)
local floorTop: number
local folder: Folder
local botFolder: Folder
local scoreLabels = {}

local state = "idle"
local wave = 0
local bots = {} -- { part, kind, born, lastBump }
local inArena = {} -- [player] = true
local emptySince = nil
local countdownEnd = 0
local idleUntil = 0
local presenceTicks = 0
local lastBumpAt = {} -- [player] = t
local lastText = ""

-- Robos -----------------------------------------------------------------------------------------------------------------------------

local KINDS = {
	basic = { size = 4.2, density = 1.2, color = rgb(90, 190, 255), accel = 46, maxSpeed = 24, bump = 60, name = "Robô" },
	jumper = { size = 3.6, density = 1.0, color = rgb(255, 180, 60), accel = 40, maxSpeed = 22, bump = 55, hop = true, name = "Saltador" },
	tank = { size = 7, density = 2.6, color = rgb(255, 90, 100), accel = 34, maxSpeed = 18, bump = 90, name = "Tanque" },
	boss = { size = 12, density = 2.6, color = rgb(190, 90, 255), accel = 30, maxSpeed = 15, bump = 120, name = "Chefe Robô", boss = true },
}

local function spawnBot(kind: string, pos: Vector3)
	local def = KINDS[kind]
	local m = Instance.new("Model")
	m.Name = "ArenaBot_" .. kind
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.one * def.size
	body.Color = def.color
	body.Material = M.Metal
	body.Position = pos
	body.CustomPhysicalProperties = PhysicalProperties.new(def.density, 0.25, 0.35, 1, 1)
	body.Parent = m
	m.PrimaryPart = body

	local function deco(offset: CFrame, size: Vector3, color: Color3, material: any, shape: any?): Part
		local p = Instance.new("Part")
		p.Shape = shape or Enum.PartType.Block
		p.Size = size
		p.CFrame = body.CFrame * offset
		p.Color = color
		p.Material = material
		p.CanCollide = false
		p.Massless = true
		p.CanTouch = false
		p.Parent = m
		local w = Instance.new("WeldConstraint")
		w.Part0 = body
		w.Part1 = p
		w.Parent = p
		return p
	end
	local s = def.size
	-- olhos (para -Z)
	for _, sx in { -0.24, 0.24 } do
		deco(CFrame.new(sx * s, 0.18 * s, -0.42 * s), Vector3.one * s * 0.3, rgb(255, 255, 255), M.SmoothPlastic, Enum.PartType.Ball)
		deco(CFrame.new(sx * s, 0.18 * s, -0.53 * s), Vector3.one * s * 0.14, rgb(20, 20, 30), M.SmoothPlastic, Enum.PartType.Ball)
	end
	deco(CFrame.new(0, 0.62 * s, 0), Vector3.new(0.07 * s, 0.35 * s, 0.07 * s), rgb(200, 200, 210), M.Metal)
	local bulb = deco(CFrame.new(0, 0.85 * s, 0), Vector3.one * s * 0.16, def.boss and rgb(255, 80, 200) or rgb(255, 90, 90), M.Neon, Enum.PartType.Ball)
	if def.boss then
		local l = Instance.new("PointLight")
		l.Color = rgb(255, 80, 200)
		l.Range = 30
		l.Brightness = 2
		l.Parent = bulb
	end
	-- listra
	local band = deco(CFrame.new(0, 0, 0), Vector3.new(0.3 * s, s * 1.02, s * 1.02), rgb(30, 34, 60), M.Metal, Enum.PartType.Cylinder)
	band.Color = rgb(30, 34, 60)

	m.Parent = botFolder
	CollectionService:AddTag(body, Config.Tags.Grabbable)
	body:SetAttribute("Behavior", "none")
	body:SetAttribute("Bot", true)
	body:SetAttribute("BotKind", kind)
	pcall(function()
		body:SetNetworkOwner(nil)
	end)
	table.insert(bots, { part = body, model = m, kind = kind, born = os.clock(), lastHop = 0, def = def })
	return body
end

local function removeBot(rec)
	local i = table.find(bots, rec)
	if i then
		table.remove(bots, i)
	end
	if rec.model and rec.model.Parent then
		rec.model:Destroy()
	end
end

local function clearBots()
	for i = #bots, 1, -1 do
		removeBot(bots[i])
	end
end

-- Presenca na plataforma -------------------------------------------------------------------------------------------------------------------

local function onPlatform(pos: Vector3): boolean
	local flat = Vector3.new(pos.X - center.X, 0, pos.Z - center.Z).Magnitude
	return flat < PLATFORM_R + 2 and pos.Y > floorTop - 4 and pos.Y < floorTop + 60
end

local function nearestPlayerTo(pos: Vector3)
	local best, bestD, bestChar = nil, 1e9, nil
	for player in inArena do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local d = (hrp.Position - pos).Magnitude
			if d < bestD then
				best, bestD, bestChar = hrp, d, char
			end
		end
	end
	return best, bestD, bestChar
end

local function broadcast()
	local payload = { state = state, wave = wave, maxWave = MAX_WAVE, bots = #bots, countdown = math.max(0, math.ceil(countdownEnd - os.clock())) }
	for player in inArena do
		Remotes.get("ArenaState"):FireClient(player, payload)
	end
	local text
	if state == "idle" then
		text = "ARENA DO CAOS\nSuba na plataforma para começar!"
	elseif state == "countdown" then
		text = string.format("PREPARAR!\n%d", payload.countdown)
	else
		text = string.format("ONDA %d/%d\nRobôs: %d", wave, MAX_WAVE, #bots)
	end
	if text ~= lastText then
		lastText = text
		for _, l in scoreLabels do
			l.Text = text
		end
	end
end

local function creditFor(inst: Instance, model: Model?): Player?
	local id = inst:GetAttribute("LastThrower") or (model and model:GetAttribute("LastHitBy"))
	local t = inst:GetAttribute("LastThrowT") or (model and model:GetAttribute("LastHitTime"))
	if id and t and os.clock() - t < 14 then
		return Players:GetPlayerByUserId(id)
	end
	return nil
end

local function giveWaveReward(w: number, final: boolean)
	for player in inArena do
		if Data.isLoaded(player) then
			local coins = 25 + w * 18 + (final and 300 or 0)
			Data.addCoins(player, coins, final and "Arena vencida" or ("Onda " .. w))
			Data.addXP(player, coins)
			if final then
				Data.addStat(player, "Wins", 1)
			end
		end
	end
end

local function startWave(w: number)
	wave = w
	state = "wave"
	local plan = {}
	local nBasic = 2 + w
	for _ = 1, nBasic do
		table.insert(plan, "basic")
	end
	if w >= 2 then
		for _ = 1, math.floor(w / 2) + 1 do
			table.insert(plan, "jumper")
		end
	end
	if w >= 4 then
		for _ = 1, math.floor((w - 2) / 2) do
			table.insert(plan, "tank")
		end
	end
	if w == 5 or w == MAX_WAVE then
		table.insert(plan, "boss")
	end
	local rng = Random.new()
	for _, kind in plan do
		if #bots >= 26 then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(30, PLATFORM_R - 6)
		spawnBot(kind, center + Vector3.new(math.cos(a) * r, 14 + rng:NextNumber(0, 8), math.sin(a) * r))
	end
	for player in inArena do
		Remotes.get("Announce"):FireClient(player, w == MAX_WAVE and "ONDA FINAL!" or ("ONDA " .. w), #plan .. " robôs a caminho", 2.2, w == MAX_WAVE and P.Pink or P.Accent2)
	end
	Remotes.get("Fx"):FireAllClients("shock", center + Vector3.new(0, 4, 0), 1.5, nil)
end

-- Laco principal (0.15 s): robos ---------------------------------------------------------------------------------------------------------------

local function botStep()
	local now = os.clock()
	for i = #bots, 1, -1 do
		local rec = bots[i]
		local p = rec.part
		if not p.Parent then
			table.remove(bots, i)
		elseif p.Position.Y < floorTop - 14 or now - rec.born > 240 then
			-- caiu do palco: quem arremessou por ultimo ganha creditos
			local killer = p.Position.Y < floorTop - 14 and creditFor(p, rec.model) or nil
			if killer and Data.isLoaded(killer) then
				local coins = (rec.kind == "boss" and 200) or (rec.kind == "tank" and 30) or 12
				Data.addCoins(killer, coins, "derrubou " .. rec.def.name)
				Data.addXP(killer, coins)
				Quests.report(killer, "bot", 1)
				Remotes.get("ScorePopup"):FireClient(killer, p.Position + Vector3.new(0, 10, 0), "+" .. coins .. " 🪙", P.Green)
			end
			removeBot(rec)
		elseif not p:GetAttribute("HeldBy") and not CollectionService:HasTag(p, Config.Tags.Airborne) then
			local hrp, dist = nearestPlayerTo(p.Position)
			if hrp then
				local dir = Vector3.new(hrp.Position.X - p.Position.X, 0, hrp.Position.Z - p.Position.Z)
				if dir.Magnitude > 0.1 then
					dir = dir.Unit
					local v = p.AssemblyLinearVelocity
					local flatSpeed = Vector3.new(v.X, 0, v.Z).Magnitude
					if flatSpeed < rec.def.maxSpeed then
						p:ApplyImpulse(dir * p.AssemblyMass * rec.def.accel * 0.15)
					end
					if rec.def.hop and now - rec.lastHop > 1.8 and dist < 40 then
						rec.lastHop = now
						p:ApplyImpulse(Vector3.new(dir.X * 14, 62, dir.Z * 14) * p.AssemblyMass)
					end
				end
				-- empurrao
				if dist < p.Size.X / 2 + 3.6 then
					local char = hrp.Parent
					local player = Players:GetPlayerFromCharacter(char)
					if player and not Physics.isProtected(player) then
						local last = lastBumpAt[player]
						if not last or now - last > 2.2 then
							lastBumpAt[player] = now
							local away = Util.safeUnit(Vector3.new(hrp.Position.X - p.Position.X, 0, hrp.Position.Z - p.Position.Z), Vector3.zAxis)
							Ragdoll.knock(char, 1.4)
							Physics.launch(char, away * rec.def.bump + Vector3.new(0, 26, 0))
							Remotes.get("Struck"):FireClient(player, 0.5, away)
							Remotes.get("Fx"):FireAllClients("impact", hrp.Position, 0.7, { mat = "Metal", color = rec.def.color })
						end
					end
				end
			end
		end
	end
end

-- Laco lento (0.5 s): jogadores, ondas ---------------------------------------------------------------------------------------------------------

local function playerStep()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local pos = hrp.Position
			if onPlatform(pos) then
				if not inArena[player] then
					inArena[player] = true
					player:SetAttribute("InArena", true)
					Remotes.get("Notify"):FireClient(player, "⚔️ Você entrou na Arena do Caos!", "info")
				end
			elseif inArena[player] then
				-- saiu da plataforma: caiu (abaixo) ou pulou fora
				inArena[player] = nil
				player:SetAttribute("InArena", nil)
				if pos.Y < floorTop - 6 then
					Remotes.get("Notify"):FireClient(player, "💥 Você caiu da arena!", "bad")
					local killer = creditFor(hrp, char)
					if killer and killer ~= player and Data.isLoaded(killer) then
						Data.addCoins(killer, 30, "derrubou " .. player.DisplayName)
						Data.addXP(killer, 25)
					end
				end
			end
		elseif inArena[player] then
			inArena[player] = nil
			player:SetAttribute("InArena", nil)
		end
	end

	local count = 0
	for _ in inArena do
		count += 1
	end

	if state == "idle" then
		if count > 0 and now > idleUntil then
			presenceTicks += 1
			if presenceTicks >= 3 then
				state = "countdown"
				countdownEnd = now + 5
			end
		else
			presenceTicks = 0
		end
	elseif state == "countdown" then
		if count == 0 then
			state = "idle"
		elseif now >= countdownEnd then
			startWave(1)
		end
	elseif state == "wave" then
		if count == 0 then
			emptySince = emptySince or now
			if now - emptySince > 12 then
				clearBots()
				state = "idle"
				wave = 0
				emptySince = nil
				idleUntil = now + 4
			end
		else
			emptySince = nil
			if #bots == 0 then
				local final = wave >= MAX_WAVE
				giveWaveReward(wave, final)
				if final then
					for player in inArena do
						Remotes.get("Announce"):FireClient(player, "ARENA CONQUISTADA!", "Você derrotou todas as ondas", 4, P.Accent)
					end
					Remotes.get("Fx"):FireAllClients("confetti", center + Vector3.new(0, 6, 0), 1.8, nil)
					state = "idle"
					wave = 0
					idleUntil = now + 20
				else
					state = "countdown"
					countdownEnd = now + 4
					-- proxima onda depois da contagem
					task.delay(4, function()
						if state == "countdown" and wave < MAX_WAVE then
							startWave(wave + 1)
						end
					end)
				end
			end
		end
	end
	broadcast()
end

-- Construcao ---------------------------------------------------------------------------------------------------------------------------------

local function buildPlatform()
	local isl = WorldGen.getIsland("Arena")
	local top = WorldGen.islandTop(isl)
	floorTop = top + PLATFORM_LIFT + 2
	center = Vector3.new(isl.pos.X, floorTop, isl.pos.Z)
	local c = CFrame.new(center.X, floorTop - 2, center.Z)

	local m = Build.model(folder, "ArenaPlatform")
	-- coluna central e pedestal
	Build.cyl(m, CFrame.new(center.X, top + PLATFORM_LIFT / 2 - 2, center.Z), PLATFORM_LIFT + 4, 22, rgb(90, 84, 130), M.Marble)
	Build.cyl(m, CFrame.new(center.X, top + 2, center.Z), 4, 34, rgb(110, 100, 160), M.Marble)
	-- piso
	Build.cyl(m, c, 4, PLATFORM_R * 2, rgb(40, 36, 78), M.Marble, { name = "ArenaFloor" })
	Build.cyl(m, c * CFrame.new(0, 2.05, 0), 0.3, PLATFORM_R * 2 - 3, rgb(60, 54, 110), M.SmoothPlastic, { collide = false })
	Build.cyl(m, c * CFrame.new(0, 2.15, 0), 0.2, PLATFORM_R * 2 + 0.5, P.Pink, M.Neon, { collide = false, shadow = false })
	Build.cyl(m, c * CFrame.new(0, 2.25, 0), 0.3, PLATFORM_R * 2 - 8, rgb(40, 36, 78), M.Marble, { collide = false })
	for i = 1, 4 do
		Build.cyl(m, c * CFrame.new(0, 2.4, 0), 0.1, PLATFORM_R * 2 - i * 16, i % 2 == 0 and P.Accent2 or P.Purple, M.Neon, { collide = false, shadow = false, transparency = 0.5 })
	end
	-- pilares de luz ao redor
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local px, pz = center.X + math.cos(a) * (PLATFORM_R + 1), center.Z + math.sin(a) * (PLATFORM_R + 1)
		Build.cyl(m, CFrame.new(px, floorTop + 6, pz), 12, 2.2, rgb(70, 66, 120), M.Metal)
		local orb = Build.ball(m, CFrame.new(px, floorTop + 13.5, pz), 3.4, Color3.fromHSV(i / 8, 0.6, 1), M.Neon, { collide = false })
		Build.light(orb, Color3.fromHSV(i / 8, 0.6, 1), 2, 40, false)
		Build.pulse(orb, 0.8, 3, 2 + i * 0.2)
	end
	-- placar sobre a coluna
	local pole = Build.cyl(m, CFrame.new(center.X, floorTop + 20, center.Z), 40, 4, rgb(80, 74, 130), M.Metal, { collide = false })
	local screen = Build.block(m, CFrame.new(center.X, floorTop + 44, center.Z), Vector3.new(30, 12, 1), rgb(20, 22, 50), M.SmoothPlastic, { collide = false })
	local screen2 = Build.block(m, CFrame.new(center.X, floorTop + 44, center.Z), Vector3.new(1, 12, 30), rgb(20, 22, 50), M.SmoothPlastic, { collide = false })
	table.insert(scoreLabels, Build.label(screen, "ARENA DO CAOS", { color = P.Accent, face = Enum.NormalId.Front, ppu = 30 }))
	table.insert(scoreLabels, Build.label(screen, "ARENA DO CAOS", { color = P.Accent, face = Enum.NormalId.Back, ppu = 30, name = "Label2" }))
	table.insert(scoreLabels, Build.label(screen2, "ARENA DO CAOS", { color = P.Accent, face = Enum.NormalId.Right, ppu = 30, name = "Label3" }))
	table.insert(scoreLabels, Build.label(screen2, "ARENA DO CAOS", { color = P.Accent, face = Enum.NormalId.Left, ppu = 30, name = "Label4" }))

	-- jump pads na base para subir na plataforma
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		local px, pz = center.X + math.cos(a) * 26, center.Z + math.sin(a) * 26
		local dir = Vector3.new(-math.cos(a) * 0.35, 1, -math.sin(a) * 0.35)
		Hub.jumpPad(m, Vector3.new(px, top + 1.6, pz), 190, Color3.fromHSV(i / 4, 0.7, 1), dir)
	end
	Build.billboard(pole, "⚔️ ARENA DO CAOS", { size = UDim2.fromOffset(340, 60), color = P.Accent, offset = Vector3.new(0, 26, 0), maxDistance = 400 })
end

local function decorateIsland()
	local isl = WorldGen.getIsland("Arena")
	local top = WorldGen.islandTop(isl)
	local rng = Random.new(Config.World.Seed + 44)
	-- arvores e bancos ao redor (torcida)
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2
		local r = 84 + rng:NextNumber(-4, 4)
		Build.tree(folder, Vector3.new(isl.pos.X + math.cos(a) * r, top - 0.4, isl.pos.Z + math.sin(a) * r), (i % 2 == 0) and "round" or "oak", rng:NextNumber(0.9, 1.4), rng)
	end
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + 0.2
		local cf = CFrame.new(isl.pos.X + math.cos(a) * 70, top + 1, isl.pos.Z + math.sin(a) * 70) * CFrame.Angles(0, -a + math.pi / 2, 0)
		Build.block(folder, cf * CFrame.new(0, 0.9, 0), Vector3.new(8, 0.7, 2.4), rgb(190, 130, 80), M.Wood)
		Build.block(folder, cf * CFrame.new(0, 2.3, -1), Vector3.new(8, 2.2, 0.5), rgb(190, 130, 80), M.Wood)
	end
end

function Arena.init()
	folder = Build.folder("Arena")
	botFolder = Build.folder("ArenaBots")
	buildPlatform()
	decorateIsland()

	local acc, acc2 = 0, 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		acc2 += dt
		if acc >= 0.15 then
			acc = 0
			if #bots > 0 then
				local ok, err = pcall(botStep)
				if not ok then
					warn("[Arena] erro nos robos:", err)
				end
			end
		end
		if acc2 >= 0.5 then
			acc2 = 0
			local ok, err = pcall(playerStep)
			if not ok then
				warn("[Arena] erro:", err)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		inArena[p] = nil
		lastBumpAt[p] = nil
	end)
end

return Arena
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Boss</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Boss: o GOLEM SUCATA, chefao co-op da Ilha do Golem.
	- Modelo articulado animado pelo servidor (20 Hz): andar, respirar, pisao, arremesso de pedras
	- Voce causa dano arremessando objetos NO NUCLEO brilhante do peito (massa x velocidade)
	- Pisao: aviso vermelho no chao; PULE para escapar da onda de choque
	- Pedras que ele joga viram municao para voces devolverem
	- Fases (75/50/25%): ele cambaleia (dano dobrado) e depois fica mais rapido
	- Recompensa proporcional ao dano de cada jogador
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Server = script.Parent.Parent
local Build = require(Server:WaitForChild("World"):WaitForChild("Build"))
local WorldGen = require(Server:WaitForChild("World"):WaitForChild("WorldGen"))
local Interactive = require(Server:WaitForChild("World"):WaitForChild("Interactive"))
local Data = require(Server:WaitForChild("Data"))
local Quests = require(Server:WaitForChild("Quests"))
local Physics = require(Server:WaitForChild("Physics"))
local Ragdoll = require(Server:WaitForChild("Ragdoll"))
local Blasts = require(Server:WaitForChild("Blasts"))
local Pickups = require(Server:WaitForChild("Pickups"))
local ToySpawner = require(Server:WaitForChild("ToySpawner"))

local Boss = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local FIRST_SPAWN = 150 -- segundos depois do servidor abrir
local COOLDOWN = 420
local MAX_ACTIVE = 600

local folder: Folder
local island
local groundY: number
local rockFolder: Folder

local golem = nil -- estado do chefao ativo
local nextSpawnAt = os.clock() + FIRST_SPAWN

-- Rig ------------------------------------------------------------------------------------------------------------------------------------------------------

local function newPart(model: Model, name: string, size: Vector3, color: Color3, material: any, shape: any?, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.Shape = shape or Enum.PartType.Block
	p.Anchored = true
	p.CanCollide = collide ~= false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- Cria o golem e devolve { model, parts = { {part, offset, group} }, core, head }
local function buildGolem(rootCF: CFrame)
	local model = Instance.new("Model")
	model.Name = "GolemSucata"
	local stone = rgb(120, 112, 138)
	local dark = rgb(78, 72, 96)
	local metal = rgb(150, 160, 180)
	local parts = {}
	local function add(name: string, offset: Vector3, size: Vector3, color: Color3, material: any, group: string, shape: any?, collide: boolean?)
		local p = newPart(model, name, size, color, material, shape, collide)
		table.insert(parts, { part = p, offset = offset, group = group })
		return p
	end

	-- pernas e pes (grupo legL/legR gira no quadril)
	for _, s in { -1, 1 } do
		local g = s < 0 and "legL" or "legR"
		add("Foot" .. g, Vector3.new(s * 7.5, 2, -1), Vector3.new(11, 4, 15), dark, M.Slate, g)
		add("Leg" .. g, Vector3.new(s * 7.5, 14, 0), Vector3.new(8.4, 20, 8.4), stone, M.Slate, g)
		add("Knee" .. g, Vector3.new(s * 7.5, 15, -4.6), Vector3.new(5, 5, 2), metal, M.Metal, g, nil, false)
	end
	add("Hips", Vector3.new(0, 27, 0), Vector3.new(21, 6, 13), dark, M.Slate, "body")
	add("Torso", Vector3.new(0, 43, 0), Vector3.new(26, 28, 15), stone, M.Slate, "body")
	add("Belly", Vector3.new(0, 34, -7.8), Vector3.new(18, 8, 1.6), metal, M.DiamondPlate, "body", nil, false)
	local core = add("Core", Vector3.new(0, 45, -8.4), Vector3.one * 9.5, rgb(255, 120, 60), M.Neon, "body", Enum.PartType.Ball, false)
	core.CanTouch = true
	-- placas de sucata nas costas
	add("Scrap1", Vector3.new(-6, 48, 8.8), Vector3.new(10, 14, 2.4), metal, M.CorrodedMetal, "body", nil, false)
	add("Scrap2", Vector3.new(7, 44, 9), Vector3.new(9, 16, 2.4), rgb(180, 120, 80), M.CorrodedMetal, "body", nil, false)
	-- cabeca
	local head = add("Head", Vector3.new(0, 62, -1), Vector3.new(13, 11, 12), stone, M.Slate, "head")
	add("EyeL", Vector3.new(-3, 63, -7.2), Vector3.new(3.6, 2, 0.8), rgb(255, 90, 60), M.Neon, "head", nil, false)
	add("EyeR", Vector3.new(3, 63, -7.2), Vector3.new(3.6, 2, 0.8), rgb(255, 90, 60), M.Neon, "head", nil, false)
	add("Jaw", Vector3.new(0, 57.6, -5), Vector3.new(9, 2.4, 3), dark, M.Slate, "head", nil, false)
	for i, x in { -3.6, 0, 3.6 } do
		add("Crystal" .. i, Vector3.new(x, 69 + (i == 2 and 2 or 0), -1), Vector3.new(2.2, 6 + (i == 2 and 3 or 0), 2.2), rgb(120, 240, 255), M.Neon, "head", nil, false)
	end
	-- bracos (giram no ombro)
	for _, s in { -1, 1 } do
		local g = s < 0 and "armL" or "armR"
		add("Shoulder" .. g, Vector3.new(s * 16.5, 53, 0), Vector3.one * 11.5, metal, M.Metal, g, Enum.PartType.Ball)
		add("ArmUp" .. g, Vector3.new(s * 18.5, 43, 0), Vector3.new(7, 18, 7), stone, M.Slate, g)
		add("ArmLow" .. g, Vector3.new(s * 18.5, 27, -2), Vector3.new(8.4, 16, 8.4), dark, M.Slate, g)
		add("Fist" .. g, Vector3.new(s * 18.5, 16, -2), Vector3.one * 12.5, stone, M.Slate, g, Enum.PartType.Ball)
	end

	model.PrimaryPart = parts[1].part
	model.Parent = folder
	return {
		model = model,
		parts = parts,
		core = core,
		head = head,
		rootCF = rootCF,
	}
end

local SHOULDER = { armL = Vector3.new(-16.5, 53, 0), armR = Vector3.new(16.5, 53, 0) }
local HIP = { legL = Vector3.new(-7.5, 28, 0), legR = Vector3.new(7.5, 28, 0) }

-- Aplica a pose. pose = { rootCF, armL, armR, legL, legR, headPitch }
local function applyPose(g, pose)
	local root = pose.rootCF
	for _, rec in g.parts do
		local cf = CFrame.new(rec.offset)
		local group = rec.group
		if group == "armL" or group == "armR" then
			local pivot = SHOULDER[group]
			cf = CFrame.new(pivot) * CFrame.Angles(pose[group], 0, (group == "armL" and -1 or 1) * (pose.armSpread or 0)) * CFrame.new(rec.offset - pivot)
		elseif group == "legL" or group == "legR" then
			local pivot = HIP[group]
			cf = CFrame.new(pivot) * CFrame.Angles(pose[group], 0, 0) * CFrame.new(rec.offset - pivot)
		elseif group == "head" then
			local pivot = Vector3.new(0, 56, 0)
			cf = CFrame.new(pivot) * CFrame.Angles(pose.headPitch or 0, pose.headYaw or 0, 0) * CFrame.new(rec.offset - pivot)
		end
		rec.part.CFrame = root * cf
	end
end

-- Estado/IA -----------------------------------------------------------------------------------------------------------------------------------------------------------------

local function playersNearby(radius: number)
	local out = {}
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local flat = Vector3.new(hrp.Position.X - island.pos.X, 0, hrp.Position.Z - island.pos.Z).Magnitude
			if flat < radius and math.abs(hrp.Position.Y - groundY) < 60 then
				table.insert(out, { player = p, hrp = hrp, char = char })
			end
		end
	end
	return out
end

local function broadcastState(final: string?)
	if not golem then
		return
	end
	Remotes.get("BossState"):FireAllClients({
		active = final == nil,
		name = "Golem Sucata",
		hp = math.max(0, golem.hp),
		maxHp = golem.maxHp,
		phase = golem.phase,
		pos = golem.rootCF.Position,
		result = final,
	})
end

local function spawnRock(pos: Vector3, vel: Vector3?, thrown: boolean)
	local size = math.random(38, 52) / 10
	local rock = Instance.new("Part")
	rock.Name = "GolemRock"
	rock.Shape = Enum.PartType.Ball
	rock.Size = Vector3.one * size
	rock.Color = rgb(128, 120, 146)
	rock.Material = M.Slate
	rock.CustomPhysicalProperties = PhysicalProperties.new(1.6, 0.6, 0.15, 1, 1)
	rock.Position = pos
	rock.Parent = rockFolder
	CollectionService:AddTag(rock, Config.Tags.Grabbable)
	rock:SetAttribute("Behavior", "heavy")
	pcall(function()
		rock:SetNetworkOwner(nil)
	end)
	if vel then
		rock.AssemblyLinearVelocity = vel
	end
	if thrown then
		local done = false
		rock.Touched:Connect(function(other)
			if done or not rock.Parent or other:IsDescendantOf(golem and golem.model or folder) then
				return
			end
			if os.clock() - (rock:GetAttribute("BornT") or 0) < 0.25 then
				return
			end
			done = true
			local char, player = Physics.characterOf(other)
			if char and player and not Physics.isProtected(player) then
				local dir = Util.safeUnit(rock.AssemblyLinearVelocity, Vector3.zAxis)
				Ragdoll.knock(char, 2.4)
				Physics.launch(char, dir * 70 + Vector3.new(0, 34, 0))
				Remotes.get("Struck"):FireClient(player, 0.8, dir)
			end
			Blasts.push(rock.Position, 14, 60, { fx = "explosion", noCharacters = true })
		end)
	end
	rock:SetAttribute("BornT", os.clock())
	task.delay(45, function()
		if rock.Parent and not rock:GetAttribute("HeldBy") then
			rock:Destroy()
		end
	end)
	return rock
end

local function damage(amount: number, player: Player?)
	if not golem or golem.dead then
		return
	end
	if golem.phaseStagger then
		amount *= 2
	end
	golem.hp -= amount
	if player then
		golem.damageBy[player.UserId] = (golem.damageBy[player.UserId] or 0) + amount
		Quests.report(player, "boss", amount)
	end
	-- fases
	local frac = golem.hp / golem.maxHp
	local nextPhase = (frac < 0.25 and 4) or (frac < 0.5 and 3) or (frac < 0.75 and 2) or 1
	if nextPhase > golem.phase then
		golem.phase = nextPhase
		golem.staggerUntil = os.clock() + 5.5
		golem.phaseStagger = true
		golem.action = { kind = "stagger", t0 = os.clock() }
		Remotes.get("Announce"):FireAllClients("O GOLEM CAMBALEIA!", "Dano dobrado por alguns segundos!", 2.5, P.Accent)
		Remotes.get("Fx"):FireAllClients("shock", golem.rootCF.Position + Vector3.new(0, 30, 0), 2, nil)
		for i = 1, 3 do
			local a = math.random() * math.pi * 2
			spawnRock(golem.rootCF.Position + Vector3.new(math.cos(a) * 30, 50, math.sin(a) * 30), nil, false)
		end
		Pickups.burst(golem.rootCF.Position + Vector3.new(0, 30, -12), 80 * nextPhase, 12)
	end
	-- brilho no nucleo
	golem.core.Color = rgb(255, 255, 200)
	task.delay(0.12, function()
		if golem and golem.core.Parent then
			golem.core.Color = rgb(255, 120, 60)
		end
	end)
	if golem.hp <= 0 then
		golem.dead = true
	end
end

local function onCoreTouched(other: BasePart)
	if not golem or golem.dead then
		return
	end
	local thrower = other:GetAttribute("Thrower")
	if not thrower then
		return
	end
	local speed = other.AssemblyLinearVelocity.Magnitude
	if speed < 34 then
		return
	end
	local last = golem.hitLog[other]
	if last and os.clock() - last < 0.7 then
		return
	end
	golem.hitLog[other] = os.clock()
	local player = Players:GetPlayerByUserId(thrower)
	local mass = other.AssemblyMass
	local dmg = math.clamp(mass * speed / 45, 3, 300)
	damage(dmg, player)
	Remotes.get("Fx"):FireAllClients("impact", golem.core.Position, 1, { mat = "Metal", color = rgb(255, 200, 120) })
	if player then
		Remotes.get("ScorePopup"):FireClient(player, golem.core.Position + Vector3.new(0, 8, -6), string.format("-%d", math.floor(dmg)), golem.phaseStagger and P.Pink or P.Accent)
	end
end

-- Ataques -----------------------------------------------------------------------------------------------------------------------------------------------------------------------

local function telegraphStomp(pos: Vector3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = M.Neon
	ring.Color = P.Red
	ring.Transparency = 0.5
	ring.Size = Vector3.new(0.4, 4, 4)
	ring.CFrame = CFrame.new(pos.X, groundY + 0.5, pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Parent = folder
	TweenService:Create(ring, TweenInfo.new(1.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.4, 128, 128), Transparency = 0.8 }):Play()
	task.delay(1.5, function()
		ring:Destroy()
	end)
end

local function stompImpact(pos: Vector3)
	local radius = 64
	Remotes.get("Fx"):FireAllClients("explosion", Vector3.new(pos.X, groundY + 2, pos.Z), 1.5, nil)
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 and not Physics.isProtected(p) then
			local off = Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z)
			local flatD = off.Magnitude
			local height = hrp.Position.Y - groundY
			if flatD < radius and height < 7.5 then
				local dir = Util.safeUnit(off, Vector3.zAxis)
				local fall = 1 - flatD / radius
				Ragdoll.knock(char, 2.6)
				Physics.launch(char, dir * (60 + 70 * fall) + Vector3.new(0, 55 + 30 * fall, 0))
				Remotes.get("Struck"):FireClient(p, 0.6 + fall * 0.4, dir)
			end
		end
	end
	Blasts.push(Vector3.new(pos.X, groundY + 2, pos.Z), radius, 80, { fx = false, noCharacters = true })
end

local function pickTarget(list)
	if #list == 0 then
		return nil
	end
	return list[math.random(1, #list)]
end

local function startAction(g, kind: string)
	g.action = { kind = kind, t0 = os.clock() }
end

-- Laco de animacao/IA ----------------------------------------------------------------------------------------------------------------------------------------------------------

local function stepGolem(dt: number)
	local g = golem
	local now = os.clock()
	local center = Vector3.new(island.pos.X, groundY, island.pos.Z)
	local near = playersNearby(150)

	-- termina cambaleio
	if g.phaseStagger and now > g.staggerUntil then
		g.phaseStagger = false
		g.action = nil
		g.attackDelay = 1.5
	end

	-- alvo mais proximo
	local target, targetD = nil, 1e9
	for _, n in near do
		local d = (Vector3.new(n.hrp.Position.X, 0, n.hrp.Position.Z) - Vector3.new(g.rootCF.Position.X, 0, g.rootCF.Position.Z)).Magnitude
		if d < targetD then
			target, targetD = n, d
		end
	end

	local pos = g.rootCF.Position
	local yaw = g.yaw
	local walking = false

	local action = g.action
	local speedMul = 1 + (g.phase - 1) * 0.25

	if not action and target then
		-- gira e anda em direcao ao alvo
		local dir = Vector3.new(target.hrp.Position.X - pos.X, 0, target.hrp.Position.Z - pos.Z)
		local wanted = math.atan2(-dir.X, -dir.Z)
		local diff = (wanted - yaw + math.pi) % (math.pi * 2) - math.pi
		yaw += math.clamp(diff, -1.4 * dt, 1.4 * dt)
		if targetD > 34 and dir.Magnitude > 1 then
			local step = dir.Unit * 8.5 * speedMul * dt
			local newPos = pos + step
			if Vector3.new(newPos.X - center.X, 0, newPos.Z - center.Z).Magnitude < island.radius - 28 then
				pos = newPos
			end
			walking = true
		end
		-- escolhe o ataque
		g.attackDelay -= dt
		if g.attackDelay <= 0 then
			g.attackDelay = math.max(2.2, 4.2 - g.phase * 0.5)
			if targetD < 55 and math.random() < 0.7 then
				startAction(g, "stomp")
			else
				startAction(g, "throw")
				g.action.target = pickTarget(near)
			end
		end
	end

	local t = now - g.t0
	local pose = { armL = 0, armR = 0, legL = 0, legR = 0, headPitch = 0, headYaw = 0, armSpread = 0 }
	local lift = 0
	local sink = 0

	if walking then
		local w = t * 4.2 * speedMul
		pose.legL = math.sin(w) * 0.55
		pose.legR = -math.sin(w) * 0.55
		pose.armL = -math.sin(w) * 0.35
		pose.armR = math.sin(w) * 0.35
		lift = math.abs(math.sin(w)) * 1.4
		-- passos fazem o chao tremer
		local stepPhase = math.floor(w / math.pi)
		if stepPhase ~= g.lastStep then
			g.lastStep = stepPhase
			Remotes.get("Fx"):FireAllClients("thud", pos, 0.35, nil)
		end
	else
		pose.armL = math.sin(t * 1.4) * 0.06
		pose.armR = -math.sin(t * 1.4) * 0.06
		lift = math.sin(t * 1.4) * 0.35
	end

	if action then
		local a = now - action.t0
		if action.kind == "stomp" then
			-- 0-0.9 sobe os bracos, 0.9-1.7 pula, 1.7 pisa
			if a < 0.9 then
				pose.armL = -2.5 * (a / 0.9)
				pose.armR = -2.5 * (a / 0.9)
				pose.armSpread = 0.4
				if not action.telegraphed then
					action.telegraphed = true
					telegraphStomp(pos)
					Remotes.get("Fx"):FireAllClients("fuse", pos, 1, nil)
				end
			elseif a < 1.7 then
				local ph = (a - 0.9) / 0.8
				pose.armL = -2.5 + 3.3 * ph
				pose.armR = -2.5 + 3.3 * ph
				lift = 22 * math.sin(math.pi * ph)
				pose.legL = -0.4
				pose.legR = -0.4
			else
				if not action.impact then
					action.impact = true
					stompImpact(pos)
				end
				pose.armL = 0.8
				pose.armR = 0.8
				sink = 3
				if a > 2.4 then
					g.action = nil
				end
			end
		elseif action.kind == "throw" then
			-- braco direito para tras (0-0.7), solta a pedra (0.7), segue (ate 1.3)
			if a < 0.7 then
				pose.armR = -2.9 * (a / 0.7)
				pose.armL = 0.5
				pose.legL = 0.15
			else
				local ph = math.min(1, (a - 0.7) / 0.35)
				pose.armR = -2.9 + 4.4 * ph
				if not action.released then
					action.released = true
					local tgt = action.target
					local hand = pos + (CFrame.Angles(0, yaw, 0) * Vector3.new(18.5, 48, -6))
					local from = hand
					local goal = tgt and tgt.hrp and (tgt.hrp.Position + tgt.hrp.AssemblyLinearVelocity * 0.6) or (pos + Vector3.new(0, 0, -60))
					local v = Interactive.ballistic(from, goal, 38) or (Util.safeUnit(goal - from, Vector3.zAxis) * 120)
					spawnRock(from, v, true)
					Remotes.get("Fx"):FireAllClients("thud", from, 0.5, nil)
				end
				if a > 1.6 then
					g.action = nil
				end
			end
		elseif action.kind == "stagger" then
			sink = 12
			pose.armL = 0.9 + math.sin(now * 9) * 0.1
			pose.armR = 0.9 + math.sin(now * 9 + 1) * 0.1
			pose.headPitch = 0.55
			pose.legL = -0.6
			pose.legR = -0.6
		end
	end

	g.yaw = yaw
	g.rootCF = CFrame.new(pos.X, groundY + lift - sink, pos.Z) * CFrame.Angles(0, yaw, 0)
	pose.rootCF = g.rootCF
	applyPose(g, pose)
end

-- Ciclo de vida -------------------------------------------------------------------------------------------------------------------------------------------------------------------

local function finish(result: string)
	local g = golem
	if not g then
		return
	end
	golem = nil
	if result == "defeated" then
		local total = 0
		for _, v in g.damageBy do
			total += v
		end
		Remotes.get("Announce"):FireAllClients("GOLEM DERROTADO!", "Recompensas para todos que ajudaram", 4, P.Accent)
		Remotes.get("Fx"):FireAllClients("explosion", g.rootCF.Position + Vector3.new(0, 30, 0), 2.2, nil)
		Remotes.get("Fx"):FireAllClients("confetti", g.rootCF.Position + Vector3.new(0, 40, 0), 2, nil)
		for userId, dmg in g.damageBy do
			local p = Players:GetPlayerByUserId(userId)
			if p and Data.isLoaded(p) then
				local share = dmg / math.max(total, 1)
				local coins = math.floor(200 + 1100 * share)
				Data.addCoins(p, coins, "Golem derrotado")
				Data.addXP(p, math.floor(coins * 1.2))
				Data.addStat(p, "BossDamage", math.floor(dmg))
			end
		end
		Pickups.burst(g.rootCF.Position + Vector3.new(0, 40, -10), 500, 36)
		for i = 1, 3 do
			local a = i / 3 * math.pi * 2
			ToySpawner.spawnAt("cristal", g.rootCF.Position + Vector3.new(math.cos(a) * 24, 30, math.sin(a) * 24))
		end
		-- desmonta o golem com efeito
		for _, rec in g.parts do
			local p = rec.part
			p.Anchored = false
			p.CanCollide = true
			p.AssemblyLinearVelocity = Vector3.new(math.random(-40, 40), math.random(30, 80), math.random(-40, 40))
			task.delay(6, function()
				if p.Parent then
					p:Destroy()
				end
			end)
		end
		task.delay(6.5, function()
			if g.model.Parent then
				g.model:Destroy()
			end
		end)
	else
		Remotes.get("Announce"):FireAllClients("O Golem foi embora...", "Ninguém o derrotou a tempo", 3, P.Muted)
		g.model:Destroy()
	end
	Remotes.get("BossState"):FireAllClients({
		active = false,
		name = "Golem Sucata",
		hp = 0,
		maxHp = g.maxHp,
		phase = g.phase,
		result = result,
	})
	nextSpawnAt = os.clock() + COOLDOWN
	for _, r in rockFolder:GetChildren() do
		r:Destroy()
	end
end

local function summon()
	local center = Vector3.new(island.pos.X, groundY, island.pos.Z)
	local count = math.clamp(#Players:GetPlayers(), 1, 8)
	local maxHp = 3200 + 1300 * count
	local g = buildGolem(CFrame.new(center + Vector3.new(0, 0, -30)))
	g.hp = maxHp
	g.maxHp = maxHp
	g.phase = 1
	g.dead = false
	g.damageBy = {}
	g.hitLog = {}
	g.t0 = os.clock()
	g.born = os.clock()
	g.yaw = 0
	g.attackDelay = 3
	g.lastStep = 0
	g.action = nil
	g.staggerUntil = 0
	g.phaseStagger = false
	g.core.Touched:Connect(onCoreTouched)
	Build.billboard(g.head, "🗿 GOLEM SUCATA", { size = UDim2.fromOffset(300, 50), color = P.Accent, offset = Vector3.new(0, 14, 0), maxDistance = 500 })
	golem = g
	Remotes.get("Announce"):FireAllClients("O GOLEM SUCATA DESPERTOU!", "Ilha do Golem — use o tubo de vento laranja e arremesse no núcleo brilhante!", 5, rgb(255, 140, 80))
	Remotes.get("Fx"):FireAllClients("explosion", g.rootCF.Position + Vector3.new(0, 20, 0), 1.6, nil)
	broadcastState()
end

local function step(dt: number)
	local now = os.clock()
	if not golem then
		if now >= nextSpawnAt then
			summon()
		end
		return
	end
	if golem.dead then
		finish("defeated")
		return
	end
	if now - golem.born > MAX_ACTIVE then
		finish("timeout")
		return
	end
	local ok, err = pcall(stepGolem, dt)
	if not ok then
		warn("[Boss] erro:", err)
		finish("timeout")
	end
end

function Boss.summon()
	if not golem then
		summon()
	end
end

function Boss.init()
	island = WorldGen.getIsland("Boss")
	groundY = WorldGen.islandTop(island)
	folder = Build.folder("Boss")
	rockFolder = Build.folder("BossRocks")

	-- pedras iniciais espalhadas na ilha (municao)
	local rng = Random.new(Config.World.Seed + 66)
	local function scatterRocks()
		for i = 1, 8 do
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(30, island.radius - 26)
			spawnRock(Vector3.new(island.pos.X + math.cos(a) * r, groundY + 4, island.pos.Z + math.sin(a) * r), nil, false)
		end
	end
	scatterRocks()

	local acc, accBroadcast, accRocks = 0, 0, 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		accBroadcast += dt
		accRocks += dt
		if acc >= 0.05 then
			local d = acc
			acc = 0
			step(d)
		end
		if golem and accBroadcast >= 0.5 then
			accBroadcast = 0
			broadcastState()
		end
		-- reabastece municao em volta da ilha durante a luta
		if golem and accRocks >= 6 then
			accRocks = 0
			if #rockFolder:GetChildren() < 12 then
				local a = rng:NextNumber(0, math.pi * 2)
				local r = rng:NextNumber(30, island.radius - 26)
				spawnRock(Vector3.new(island.pos.X + math.cos(a) * r, groundY + 30, island.pos.Z + math.sin(a) * r), nil, false)
			end
		end
	end)
end

return Boss
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Bowling</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Bowling: "Boliche Gigante" — pista com 10 pinos fisicos. Derrube todos com qualquer objeto.
	Depois do primeiro impacto, espera os pinos assentarem, paga por pino e arruma tudo de novo.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Server = script.Parent.Parent
local Build = require(Server:WaitForChild("World"):WaitForChild("Build"))
local Data = require(Server:WaitForChild("Data"))
local Quests = require(Server:WaitForChild("Quests"))
local Pickups = require(Server:WaitForChild("Pickups"))

local Bowling = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local pinFolder
local pins = {} -- { part, home }
local origin -- CFrame do inicio da pista (x cresce para os pinos)
local roundThrower, roundStart, resetting = nil, nil, false
local rec_time = nil

local PIN_SIZE = Vector3.new(5, 2.4, 2.4) -- cilindro com eixo em X; deitado em CFrame para ficar de pe

local function makePin(home: Vector3): Part
	local p = Instance.new("Part")
	p.Name = "Pin"
	p.Shape = Enum.PartType.Cylinder
	p.Size = PIN_SIZE
	p.CFrame = CFrame.new(home) * CFrame.Angles(0, 0, math.pi / 2)
	p.Color = rgb(250, 250, 250)
	p.Material = M.SmoothPlastic
	p.CustomPhysicalProperties = PhysicalProperties.new(0.9, 0.5, 0.25, 1, 1)
	p.Anchored = false
	p.Parent = pinFolder
	-- faixa vermelha
	local band = Instance.new("Part")
	band.Shape = Enum.PartType.Cylinder
	band.Size = Vector3.new(0.7, 2.5, 2.5)
	band.CFrame = p.CFrame * CFrame.new(1.2, 0, 0)
	band.Color = rgb(230, 50, 60)
	band.Material = M.SmoothPlastic
	band.CanCollide = false
	band.Massless = true
	band.CanTouch = false
	band.Parent = pinFolder
	local w = Instance.new("WeldConstraint")
	w.Part0 = p
	w.Part1 = band
	w.Parent = band
	band.Parent = p
	pcall(function()
		p:SetNetworkOwner(nil)
	end)
	p.Touched:Connect(function(other)
		local thrower = other:GetAttribute("Thrower")
		if thrower and not roundThrower and not resetting then
			roundThrower = thrower
			roundStart = os.clock()
		end
	end)
	return p
end

local function rackPins()
	for _, rec in pins do
		if rec.part and rec.part.Parent then
			rec.part:Destroy()
		end
	end
	table.clear(pins)
	local idx = 0
	for row = 0, 3 do
		for k = 0, row do
			idx += 1
			local local_ = Vector3.new(row * 3.4, PIN_SIZE.Y / 2 + 0.4, (k - row / 2) * 3.4)
			local home = (origin * CFrame.new(local_)).Position
			table.insert(pins, { part = makePin(home), home = home })
		end
	end
end

local function knockedCount(): number
	local n = 0
	for _, rec in pins do
		local p = rec.part
		if not p.Parent then
			n += 1
		else
			-- de pe = eixo X do cilindro apontando para cima
			local up = math.abs(p.CFrame.RightVector.Y)
			if up < 0.72 or (p.Position - rec.home).Magnitude > 3.5 then
				n += 1
			end
		end
	end
	return n
end

local function settle()
	local player = roundThrower and Players:GetPlayerByUserId(roundThrower)
	local knocked = knockedCount()
	local center = (origin * CFrame.new(5, 4, 0)).Position
	if player and Data.isLoaded(player) and knocked > 0 then
		local coins = knocked * 10 + (knocked == #pins and 120 or 0)
		Data.addCoins(player, coins)
		Data.addXP(player, coins)
		local label = knocked == #pins and "STRIKE!" or string.format("%d pinos", knocked)
		Remotes.get("ScorePopup"):FireClient(player, center + Vector3.new(0, 6, 0), string.format("%s +%d", label, coins), knocked == #pins and P.Accent or P.Green)
		if knocked == #pins then
			Quests.report(player, "strike", 1)
			Remotes.get("Announce"):FireClient(player, "STRIKE!", "Derrubou todos os pinos", 2, P.Accent)
			Remotes.get("Fx"):FireAllClients("confetti", center, 1.3, nil)
		end
	end
	roundThrower, roundStart = nil, nil
	resetting = true
	task.wait(2.5)
	rackPins()
	resetting = false
end

function Bowling.init()
	local folder = Build.folder("Bowling")
	pinFolder = Build.folder("BowlingPins")

	-- pista a leste da praca, ao longo de +X
	local sx, sz = 112, 70
	local samples = {}
	for i = 0, 6 do
		table.insert(samples, Build.y(sx + i * 16, sz))
		table.insert(samples, Build.y(sx + i * 16, sz + 10))
		table.insert(samples, Build.y(sx + i * 16, sz - 10))
	end
	local top, low = -1e9, 1e9
	for _, y in samples do
		top = math.max(top, y)
		low = math.min(low, y)
	end
	local floorY = top + 0.8
	local len = 118
	local center = Vector3.new(sx + len / 2, floorY, sz)
	origin = CFrame.new(sx + len - 24, floorY, sz)

	-- plataforma + pista
	local depth = floorY - low + 6
	Build.block(folder, CFrame.new(center.X, floorY - depth / 2, center.Z), Vector3.new(len + 8, depth, 26), rgb(120, 110, 130), M.Concrete)
	Build.block(folder, CFrame.new(center.X, floorY + 0.1, center.Z), Vector3.new(len, 0.4, 14), rgb(214, 160, 100), M.WoodPlanks)
	for _, sgn in { -1, 1 } do
		Build.block(folder, CFrame.new(center.X, floorY + 0.25, center.Z + sgn * 7.6), Vector3.new(len, 0.5, 1.6), rgb(50, 54, 100), M.SmoothPlastic)
		Build.block(folder, CFrame.new(center.X, floorY + 0.5, center.Z + sgn * 8.6), Vector3.new(len, 0.6, 0.3), P.Pink, M.Neon, { collide = false, shadow = false })
	end
	-- setas na pista
	for i = 1, 6 do
		local wedge = Build.wedge(folder, CFrame.new(sx + 28 + i * 4, floorY + 0.35, sz + (i - 3.5) * 1.1) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(0.4, 0.2, 1.6), rgb(90, 50, 30), M.SmoothPlastic, { collide = false })
		_ = wedge
	end
	-- paredao dos pinos
	local wall = Build.block(folder, CFrame.new(sx + len + 1, floorY + 8, sz), Vector3.new(2, 16, 26), rgb(44, 40, 100), M.SmoothPlastic)
	Build.label(wall, "🎳 BOLICHE GIGANTE", { color = P.Accent, face = Enum.NormalId.Left })
	Build.block(folder, CFrame.new(sx + len - 4, floorY + 16.4, sz), Vector3.new(0.4, 0.6, 26), P.Pink, M.Neon, { collide = false })
	local sign = Build.block(folder, CFrame.new(sx - 4, floorY + 6, sz - 12), Vector3.new(0.6, 6, 14), rgb(36, 34, 90), M.SmoothPlastic)
	Build.label(sign, "Jogue qualquer objeto\nnos pinos. Strike = +120!", { color = P.White, face = Enum.NormalId.Right, ppu = 32 })
	-- linha de arremesso
	Build.block(folder, CFrame.new(sx + 6, floorY + 0.4, sz), Vector3.new(1, 0.2, 14), P.Accent, M.Neon, { collide = false })

	rackPins()

	task.spawn(function()
		while true do
			task.wait(0.5)
			if roundThrower and not resetting and roundStart and os.clock() - roundStart > 6 then
				settle()
			elseif not roundThrower and not resetting then
				-- arruma sozinho se alguem bagunçou os pinos
				local disturbed = 0
				for _, rec in pins do
					if not rec.part.Parent or (rec.part.Position - rec.home).Magnitude > 3.5 then
						disturbed += 1
					end
				end
				if disturbed > 0 then
					rec_time = rec_time or os.clock()
					if os.clock() - rec_time > 20 then
						rec_time = nil
						rackPins()
					end
				else
					rec_time = nil
				end
			end
		end
	end)
	_ = Pickups
end

return Bowling
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Events: eventos do mundo que acontecem de tempos em tempos.
	  ☄️ Chuva de Meteoros    🌙 Gravidade Lunar    🪙 Chuva de Moedas
	  🌋 Erupção do Vulcão    ✨ Hora do Ouro (moedas em dobro)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Server = script.Parent.Parent
local Data = require(Server:WaitForChild("Data"))
local Blasts = require(Server:WaitForChild("Blasts"))
local Pickups = require(Server:WaitForChild("Pickups"))
local Zones = require(Server:WaitForChild("Zones"))
local Interactive = require(Server:WaitForChild("World"):WaitForChild("Interactive"))
local Volcano = require(Server:WaitForChild("World"):WaitForChild("Volcano"))
local Build = require(Server:WaitForChild("World"):WaitForChild("Build"))

local Events = {}

local P = Config.Palette
local M = Enum.Material
local GRAVITY_DEFAULT = 196.2

local active = nil -- { id, name, icon, endsAt }
local rng = Random.new()

local function livePlayers()
	local out = {}
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 and hrp.Position.Y < Config.World.SkyY - 40 then
			table.insert(out, { player = p, hrp = hrp })
		end
	end
	return out
end

local function broadcast(on: boolean, ev, endsAt: number?)
	Remotes.get("EventState"):FireAllClients({
		active = on,
		id = ev.id,
		name = ev.name,
		icon = ev.icon,
		desc = ev.desc,
		endsAt = endsAt,
	})
end

-- Meteoros ------------------------------------------------------------------------------------------------------------------------------------------

local function meteor(target: Vector3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = M.Neon
	ring.Color = P.Red
	ring.Transparency = 0.4
	ring.Size = Vector3.new(0.4, 22, 22)
	ring.CFrame = CFrame.new(target + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Parent = workspace
	task.delay(1.8, function()
		ring:Destroy()
	end)

	local fall = 1.7
	local from = target + Vector3.new(rng:NextNumber(-70, 70), 280, rng:NextNumber(-70, 70))
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * 8
	ball.Material = M.Neon
	ball.Color = Color3.fromRGB(255, 130, 50)
	ball.CanCollide = false
	ball.CanQuery = false
	ball.Position = from
	ball.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0, 1, 1)
	ball.Parent = workspace
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 60)
	light.Range = 60
	light.Brightness = 4
	light.Parent = ball
	local att = Instance.new("Attachment")
	att.Parent = ball
	local trail = Instance.new("ParticleEmitter")
	trail.Texture = "rbxasset://textures/particles/fire_main.dds"
	trail.Rate = 90
	trail.Lifetime = NumberRange.new(0.6, 1.2)
	trail.Speed = NumberRange.new(0, 4)
	trail.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 0) })
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 70, 20))
	trail.Parent = att

	-- velocidade para chegar no alvo em "fall" segundos sob a gravidade atual
	local g = workspace.Gravity
	local off = target - from
	local vel = Vector3.new(off.X / fall, off.Y / fall + 0.5 * g * fall, off.Z / fall)
	ball.AssemblyLinearVelocity = vel
	pcall(function()
		ball:SetNetworkOwner(nil)
	end)
	ball.CanCollide = true
	local hit = false
	ball.Touched:Connect(function(other)
		if hit or other:IsDescendantOf(ball) then
			return
		end
		hit = true
		local pos = ball.Position
		ball:Destroy()
		Blasts.explode(pos, 24, 95, nil)
		Pickups.burst(pos + Vector3.new(0, 3, 0), 60, 6)
	end)
	task.delay(6, function()
		if ball.Parent then
			ball:Destroy()
		end
	end)
end

local function runMeteors(ev, endsAt)
	while os.clock() < endsAt do
		local list = livePlayers()
		if #list > 0 then
			local pick = list[rng:NextInteger(1, #list)]
			local base = pick.hrp.Position
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(4, 45)
			local x, z = base.X + math.cos(a) * r, base.Z + math.sin(a) * r
			-- longe da zona segura
			if Vector3.new(x, 0, z).Magnitude < Zones.SafeRadius + 10 and base.Y < Config.World.SkyY - 60 then
				local push = Vector3.new(x, 0, z)
				push = push.Magnitude > 1 and push.Unit or Vector3.xAxis
				x, z = push.X * (Zones.SafeRadius + 14), push.Z * (Zones.SafeRadius + 14)
			end
			local y = Build.y(x, z)
			meteor(Vector3.new(x, y, z))
		end
		task.wait(rng:NextNumber(1.1, 2.0))
	end
end

-- Erupcao ---------------------------------------------------------------------------------------------------------------------------------------------

local function runEruption(ev, endsAt)
	local crater = Volcano.craterPos
	if not crater then
		return
	end
	local n = 0
	while os.clock() < endsAt and n < 14 do
		n += 1
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(70, 330)
		local tx = crater.X + math.cos(a) * r
		local tz = crater.Z + math.sin(a) * r
		local ty = Build.y(tx, tz)
		local from = crater + Vector3.new(0, 16, 0)
		local vel = Interactive.ballistic(from, Vector3.new(tx, ty, tz), 62)
		if vel then
			local fb = Instance.new("Part")
			fb.Shape = Enum.PartType.Ball
			fb.Size = Vector3.one * 9
			fb.Material = M.Neon
			fb.Color = Color3.fromRGB(255, 110, 30)
			fb.Position = from
			fb.Parent = workspace
			local l = Instance.new("PointLight")
			l.Color = Color3.fromRGB(255, 120, 40)
			l.Range = 70
			l.Brightness = 4
			l.Parent = fb
			local att = Instance.new("Attachment")
			att.Parent = fb
			local pe = Instance.new("ParticleEmitter")
			pe.Texture = "rbxasset://textures/particles/fire_main.dds"
			pe.Rate = 80
			pe.Lifetime = NumberRange.new(0.6, 1.2)
			pe.Speed = NumberRange.new(0, 4)
			pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 9), NumberSequenceKeypoint.new(1, 0) })
			pe.LightEmission = 1
			pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 110), Color3.fromRGB(255, 60, 20))
			pe.Parent = att
			fb.AssemblyLinearVelocity = vel
			pcall(function()
				fb:SetNetworkOwner(nil)
			end)
			Remotes.get("Fx"):FireAllClients("explosion", from, 1.4, nil)
			local hit = false
			task.delay(0.5, function()
				fb.Touched:Connect(function(other)
					if hit or other:IsDescendantOf(fb) then
						return
					end
					hit = true
					local pos = fb.Position
					fb:Destroy()
					Blasts.explode(pos, 28, 105, nil)
					Pickups.burst(pos + Vector3.new(0, 3, 0), 90, 8)
				end)
			end)
			task.delay(12, function()
				if fb.Parent then
					fb:Destroy()
				end
			end)
		end
		task.wait(rng:NextNumber(1.6, 2.6))
	end
end

-- Chuva de moedas ------------------------------------------------------------------------------------------------------------------------------------------

local function runCoinRain(ev, endsAt)
	while os.clock() < endsAt do
		for _, e in livePlayers() do
			local base = e.hrp.Position
			for _ = 1, 2 do
				local x = base.X + rng:NextNumber(-45, 45)
				local z = base.Z + rng:NextNumber(-45, 45)
				Pickups.burst(Vector3.new(x, base.Y + 70, z), 8, 1)
			end
		end
		task.wait(0.6)
	end
end

-- Gravidade lunar --------------------------------------------------------------------------------------------------------------------------------------------

local function runLowGravity(ev, endsAt)
	workspace.Gravity = 62
	while os.clock() < endsAt do
		task.wait(0.5)
	end
	workspace.Gravity = GRAVITY_DEFAULT
end

local function runGoldHour(ev, endsAt)
	Data.multiplier = 2
	while os.clock() < endsAt do
		task.wait(0.5)
	end
	Data.multiplier = 1
end

local LIST = {
	{ id = "meteors", name = "Chuva de Meteoros", icon = "☄️", duration = 48, weight = 3, run = runMeteors, desc = "Fique de olho no chão: círculos vermelhos mostram onde eles caem!" },
	{ id = "lowgrav", name = "Gravidade Lunar", icon = "🌙", duration = 65, weight = 3, run = runLowGravity, desc = "Tudo flutua! Seus arremessos vão MUITO mais longe." },
	{ id = "coinrain", name = "Chuva de Moedas", icon = "🪙", duration = 38, weight = 3, run = runCoinRain, desc = "Moedas caem do céu. Corra e pegue!" },
	{ id = "eruption", name = "Erupção do Vulcão", icon = "🌋", duration = 40, weight = 2, run = runEruption, desc = "Bolas de fogo do Vulcão Furioso! Elas dão moedas ao explodir." },
	{ id = "goldhour", name = "Hora do Ouro", icon = "✨", duration = 80, weight = 2, run = runGoldHour, desc = "Todas as moedas valem o DOBRO!" },
}

local function pickEvent()
	local total = 0
	for _, e in LIST do
		total += e.weight
	end
	local r = rng:NextNumber(0, total)
	for _, e in LIST do
		r -= e.weight
		if r <= 0 then
			return e
		end
	end
	return LIST[1]
end

function Events.trigger(id: string?)
	if active then
		return
	end
	local ev = nil
	if id then
		for _, e in LIST do
			if e.id == id then
				ev = e
			end
		end
	end
	ev = ev or pickEvent()
	local endsAt = os.clock() + ev.duration
	local serverEnd = workspace:GetServerTimeNow() + ev.duration
	active = { id = ev.id, name = ev.name, icon = ev.icon, endsAt = endsAt }
	broadcast(true, ev, serverEnd)
	for _, p in Players:GetPlayers() do
		Remotes.get("Announce"):FireClient(p, ev.icon .. " " .. string.upper(ev.name), ev.desc, 4, P.Accent2)
	end
	task.spawn(function()
		local ok, err = pcall(ev.run, ev, endsAt)
		if not ok then
			warn("[Eventos] erro em", ev.id, err)
		end
		workspace.Gravity = GRAVITY_DEFAULT
		Data.multiplier = 1
		active = nil
		broadcast(false, ev, nil)
	end)
end

function Events.init()
	task.spawn(function()
		task.wait(110)
		while true do
			if #Players:GetPlayers() > 0 and not active then
				Events.trigger()
			end
			task.wait(rng:NextNumber(230, 340))
		end
	end)
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Extras</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Extras: acoes do cliente que precisam de validacao no servidor (Remotes.ActivityAction).
	  boomerang/catch  pegar o bumerangue de volta rende moedas
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Server = script.Parent.Parent
local Data = require(Server:WaitForChild("Data"))
local Quests = require(Server:WaitForChild("Quests"))

local Extras = {}

local handlers = {}

function handlers.boomerang(player, action, part)
	if action ~= "catch" or typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return
	end
	if part:GetAttribute("Behavior") ~= "boomerang" or part:GetAttribute("Thrower") ~= player.UserId then
		return
	end
	if part:GetAttribute("Caught") then
		return
	end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or (hrp.Position - part.Position).Magnitude > 18 then
		return
	end
	part:SetAttribute("Caught", true)
	task.delay(20, function()
		if part.Parent then
			part:SetAttribute("Caught", nil)
		end
	end)
	if Data.isLoaded(player) then
		Quests.report(player, "boomerang", 1)
		Data.addCoins(player, 15, "pegou o bumerangue")
		Data.addXP(player, 10)
		Remotes.get("ScorePopup"):FireClient(player, part.Position + Vector3.new(0, 3, 0), "PEGOU! +15", Config.Palette.Accent)
		Remotes.get("Fx"):FireAllClients("sparkle", part.Position, 1, nil)
	end
end

local lastEmote = {}
local EMOTES = { wave = true, cheer = true, dance = true }

function handlers.emote(player, action)
	if type(action) ~= "string" or not EMOTES[action] then
		return
	end
	local now = os.clock()
	if lastEmote[player] and now - lastEmote[player] < 0.8 then
		return
	end
	lastEmote[player] = now
	local char = player.Character
	if char then
		char:SetAttribute("Emote", action)
		char:SetAttribute("EmoteT", workspace:GetServerTimeNow())
	end
end

function Extras.init()
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		lastEmote[p] = nil
	end)
	Remotes.get("ActivityAction").OnServerEvent:Connect(function(player, activity, action, arg)
		if type(activity) ~= "string" or type(action) ~= "string" then
			return
		end
		local h = handlers[activity]
		if h then
			local ok, err = pcall(h, player, action, arg)
			if not ok then
				warn("[Extras] erro:", err)
			end
		end
	end)
end

return Extras
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Hoops</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Hoops: "Cestas" — aros de basquete em varias alturas/distancias perto da praca.
	Faca o objeto arremessado passar por dentro do aro (de cima para baixo).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Server = script.Parent.Parent
local Build = require(Server:WaitForChild("World"):WaitForChild("Build"))
local Data = require(Server:WaitForChild("Data"))
local Quests = require(Server:WaitForChild("Quests"))

local Hoops = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local scored = {}

local function makeHoop(folder: Folder, x: number, z: number, height: number, points: number, color: Color3)
	local gy = Build.y(x, z)
	local m = Build.model(folder, "Hoop")
	Build.foundation(m, CFrame.new(x, gy, z), Vector3.new(6, 1, 6))
	Build.cyl(m, CFrame.new(x, gy + height / 2, z), height, 1.2, rgb(70, 74, 110), M.Metal)
	-- tabela virada para o leste (+X): jogadores arremessam do leste para o oeste
	local boardCF = CFrame.new(x - 0.8, gy + height + 4, z)
	local board = Build.block(m, boardCF, Vector3.new(0.6, 8, 12), rgb(245, 245, 250), M.SmoothPlastic)
	Build.block(m, boardCF * CFrame.new(0.32, -1, 0), Vector3.new(0.2, 3.4, 5.4), color, M.SmoothPlastic, { collide = false })
	-- aro: anel de bolinhas de neon (horizontal)
	local ringCenter = Vector3.new(x + 5.4, gy + height + 1.6, z)
	Build.block(m, CFrame.new(x + 2.4, gy + height + 1.6, z), Vector3.new(5.4, 0.5, 0.6), P.Red, M.Metal, { collide = false })
	local n = 14
	for i = 1, n do
		local a = i / n * math.pi * 2
		Build.ball(m, CFrame.new(ringCenter + Vector3.new(math.cos(a) * 4.4, 0, math.sin(a) * 4.4)), 1.1, color, M.Neon, { shadow = false })
	end
	-- rede (cones de cilindros translucidos)
	for i = 0, 3 do
		local d = 8.4 - i * 1.6
		local net = Build.cyl(m, CFrame.new(ringCenter - Vector3.new(0, 1 + i * 1.3, 0)), 1.2, d, Color3.new(1, 1, 1), M.Fabric, { collide = false, transparency = 0.5, shadow = false })
		net.CanQuery = false
	end
	-- sensor dentro do aro
	local sensor = Build.cyl(m, CFrame.new(ringCenter - Vector3.new(0, 0.6, 0)), 1.2, 7, P.Accent, M.Neon, { collide = false, transparency = 1, shadow = false })
	sensor.CanQuery = false
	sensor.CanTouch = true
	Build.billboard(board, string.format("🏀 %d pts", points), { color = P.Accent, offset = Vector3.new(0, 7, 0) })

	sensor.Touched:Connect(function(other)
		local thrower = other:GetAttribute("Thrower")
		if not thrower then
			return
		end
		local vel = other.AssemblyLinearVelocity
		if vel.Y > -4 then
			return -- precisa estar descendo
		end
		if scored[other] and os.clock() - scored[other] < 4 then
			return
		end
		local flat = Vector3.new(other.Position.X - ringCenter.X, 0, other.Position.Z - ringCenter.Z).Magnitude
		if flat > 4.8 then
			return
		end
		scored[other] = os.clock()
		local player = Players:GetPlayerByUserId(thrower)
		if not player or not Data.isLoaded(player) then
			return
		end
		local coins = points
		Quests.report(player, "hoop", 1)
		Data.addCoins(player, coins)
		Data.addXP(player, points * 2)
		Remotes.get("ScorePopup"):FireClient(player, ringCenter + Vector3.new(0, 4, 0), string.format("CESTA! +%d", coins), P.Accent)
		Remotes.get("Fx"):FireAllClients("confetti", ringCenter + Vector3.new(0, 3, 0), 0.7, nil)
		Remotes.get("Fx"):FireAllClients("bounce", ringCenter, 0.8, nil)
	end)
	return m
end

function Hoops.init()
	local folder = Build.folder("Hoops")
	local baseX, baseZ = -95, -85
	makeHoop(folder, baseX, baseZ, 14, 20, P.Green)
	makeHoop(folder, baseX - 12, baseZ - 34, 24, 45, P.Blue)
	makeHoop(folder, baseX - 22, baseZ - 74, 36, 90, P.Pink)
	makeHoop(folder, baseX - 8, baseZ + 38, 10, 12, P.Accent)
	local sy = Build.y(baseX + 40, baseZ)
	local board = Build.block(folder, CFrame.new(baseX + 40, sy + 6, baseZ), Vector3.new(0.6, 8, 20), rgb(36, 34, 90), M.SmoothPlastic)
	Build.label(board, "🏀 CESTAS\nQuanto mais alto, mais moedas!", { color = P.White, face = Enum.NormalId.Left, ppu = 28 })
	Build.foundation(folder, CFrame.new(baseX + 40, sy, baseZ), Vector3.new(2, 1, 2))
end

return Hoops
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Plots</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Plots: "Vila dos Jogadores" — casinhas que cada jogador pode reivindicar.
	Dentro de um lote ninguem consegue agarrar ninguem (zona segura). O dono pode pintar a casa.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Server = script.Parent.Parent
local Build = require(Server:WaitForChild("World"):WaitForChild("Build"))
local Zones = require(Server:WaitForChild("Zones"))

local Plots = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local PALETTE = {
	rgb(255, 214, 200), rgb(200, 232, 255), rgb(214, 255, 210), rgb(255, 240, 180),
	rgb(236, 210, 255), rgb(255, 196, 226), rgb(200, 255, 244), rgb(255, 224, 170),
}
local ROOFS = { rgb(220, 80, 90), rgb(70, 110, 200), rgb(90, 160, 90), rgb(230, 150, 50), rgb(140, 90, 200), rgb(220, 90, 160), rgb(60, 170, 170), rgb(200, 110, 60) }

local plots = {}

local function refresh(plot)
	local owner = plot.owner
	if owner then
		plot.pp.ActionText = "Visitar (dono: pintar)"
		plot.pp.ObjectText = "Casa de " .. owner.DisplayName
		plot.sign.Text = "🏠 " .. owner.DisplayName
	else
		plot.pp.ActionText = "Reivindicar casa"
		plot.pp.ObjectText = "Lote livre"
		plot.sign.Text = "LOTE LIVRE\n[E] reivindicar"
	end
end

local function release(player: Player)
	for _, plot in plots do
		if plot.owner == player then
			plot.owner = nil
			plot.colorIndex = plot.baseIndex
			plot.body.Color = PALETTE[plot.colorIndex]
			refresh(plot)
		end
	end
end

local function ownedBy(player: Player)
	for _, plot in plots do
		if plot.owner == player then
			return plot
		end
	end
	return nil
end

local function makePlot(folder: Folder, center: Vector3, faceTo: Vector3, index: number)
	local samples = {}
	for dx = -18, 18, 9 do
		for dz = -18, 18, 9 do
			table.insert(samples, Build.y(center.X + dx, center.Z + dz))
		end
	end
	local top, low = -1e9, 1e9
	for _, y in samples do
		top = math.max(top, y)
		low = math.min(low, y)
	end
	local floorY = top + 0.6
	local pos = Vector3.new(center.X, floorY, center.Z)
	-- o "fundo" (-Z) do lote aponta para longe do centro da vila; a frente (+Z, com portao/correio) olha para ele
	local cf = CFrame.lookAt(pos, Vector3.new(2 * pos.X - faceTo.X, floorY, 2 * pos.Z - faceTo.Z))
	local m = Build.model(folder, "Plot" .. index)

	-- gramado
	local depth = floorY - low + 6
	Build.block(m, cf * CFrame.new(0, -depth / 2, 0), Vector3.new(42, depth, 42), rgb(120, 96, 80), M.Ground)
	Build.block(m, cf * CFrame.new(0, 0.1, 0), Vector3.new(42, 0.4, 42), rgb(104, 212, 72), M.Grass)
	-- calçada
	Build.block(m, cf * CFrame.new(0, 0.35, 12), Vector3.new(6, 0.3, 24), rgb(200, 196, 210), M.Cobblestone, { collide = false })

	-- casa (fundos do lote)
	local house = Build.house(m, cf * CFrame.new(0, 0, -8), Vector3.new(18, 11, 14), PALETTE[index], ROOFS[index], "House")
	local body = house.PrimaryPart

	-- cerca em volta (com portao aberto na frente)
	local function fence(from: Vector3, to: Vector3)
		local mid = (from + to) / 2
		local len = (to - from).Magnitude
		local look = CFrame.lookAt(cf * mid, cf * to)
		Build.block(m, look * CFrame.new(0, 1.6, 0), Vector3.new(0.5, 0.5, len), rgb(240, 236, 226), M.Wood, { collide = false })
		Build.block(m, look * CFrame.new(0, 0.7, 0), Vector3.new(0.5, 0.5, len), rgb(240, 236, 226), M.Wood, { collide = false })
	end
	fence(Vector3.new(-20, 0, -20), Vector3.new(20, 0, -20))
	fence(Vector3.new(-20, 0, -20), Vector3.new(-20, 0, 20))
	fence(Vector3.new(20, 0, -20), Vector3.new(20, 0, 20))
	fence(Vector3.new(-20, 0, 20), Vector3.new(-6, 0, 20))
	fence(Vector3.new(6, 0, 20), Vector3.new(20, 0, 20))
	for _, c in { Vector3.new(-20, 0, -20), Vector3.new(20, 0, -20), Vector3.new(-20, 0, 20), Vector3.new(20, 0, 20), Vector3.new(-6, 0, 20), Vector3.new(6, 0, 20) } do
		Build.block(m, cf * CFrame.new(c.X, 1.2, c.Z), Vector3.new(0.9, 2.6, 0.9), rgb(210, 200, 190), M.Wood)
	end

	-- caixa de correio com placa
	local post = Build.block(m, cf * CFrame.new(9, 1.4, 17), Vector3.new(0.6, 2.8, 0.6), rgb(120, 84, 52), M.Wood)
	local board = Build.block(m, cf * CFrame.new(9, 4.2, 17), Vector3.new(7, 2.6, 0.4), rgb(40, 34, 90), M.SmoothPlastic)
	local label = Build.label(board, "", { color = P.White, face = Enum.NormalId.Front, ppu = 40 })
	local pp = Build.prompt(post, "Reivindicar casa", "Lote livre", "plot")
	pp.MaxActivationDistance = 12

	local plot = { owner = nil, body = body, sign = label, pp = pp, colorIndex = index, baseIndex = index, center = pos }
	table.insert(plots, plot)
	refresh(plot)
	table.insert(Zones.SafeExtra, { center = pos + Vector3.new(0, 6, 0), radius = 32 })

	pp.Triggered:Connect(function(player)
		if not plot.owner then
			if ownedBy(player) then
				Remotes.get("Notify"):FireClient(player, "Você já tem uma casa!", "bad")
				return
			end
			plot.owner = player
			refresh(plot)
			Remotes.get("Announce"):FireClient(player, "CASA SUA!", "Ninguém consegue agarrar você aqui dentro", 2.5, P.Green)
			Remotes.get("Fx"):FireAllClients("confetti", pos + Vector3.new(0, 8, 0), 0.8, nil)
		elseif plot.owner == player then
			plot.colorIndex = plot.colorIndex % #PALETTE + 1
			plot.body.Color = PALETTE[plot.colorIndex]
			Remotes.get("Fx"):FireAllClients("spawn", pos + Vector3.new(0, 6, -8), 1, nil)
		else
			Remotes.get("Notify"):FireClient(player, "Casa de " .. plot.owner.DisplayName, "info")
		end
	end)
end

function Plots.init()
	local folder = Build.folder("Plots")
	-- vila a sudeste da praca, em arco, todas viradas para o centro da vila
	local villageCenter = Config.World.Village
	local n = 8
	for i = 1, n do
		local a = (i - 0.5) / n * math.pi * 1.5 + math.pi * 0.85
		local pos = villageCenter + Vector3.new(math.cos(a) * 78, 0, math.sin(a) * 78)
		makePlot(folder, pos, villageCenter, i)
	end
	-- praca da vila
	local y = Build.y(villageCenter.X, villageCenter.Z)
	Build.cyl(folder, CFrame.new(villageCenter.X, y + 0.2, villageCenter.Z), 1, 34, rgb(226, 218, 240), M.Marble)
	Build.lamp(folder, Vector3.new(villageCenter.X, y + 0.7, villageCenter.Z), 14, rgb(255, 226, 150))
	local sign = Build.block(folder, CFrame.new(villageCenter.X, y + 8, villageCenter.Z + 12), Vector3.new(16, 4, 0.5), rgb(40, 34, 90), M.SmoothPlastic)
	Build.label(sign, "🏘️ VILA DOS JOGADORES", { color = P.Accent, face = Enum.NormalId.Front })
	Build.foundation(folder, CFrame.new(villageCenter.X, y, villageCenter.Z + 12), Vector3.new(2, 1, 2))

	Players.PlayerRemoving:Connect(release)
end

return Plots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Targets</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Targets: "Tiro ao Alvo" — alvos parados e moveis num campo perto da praca.
	Acerte com qualquer objeto arremessado: mais longe e mais no centro = mais pontos.
]]

local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Server = script.Parent.Parent
local Build = require(Server:WaitForChild("World"):WaitForChild("Build"))
local Data = require(Server:WaitForChild("Data"))
local Quests = require(Server:WaitForChild("Quests"))

local Targets = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local RINGS = {
	{ d = 12, color = rgb(250, 250, 250), value = 10 },
	{ d = 9.4, color = rgb(230, 50, 60), value = 20 },
	{ d = 6.6, color = rgb(250, 250, 250), value = 30 },
	{ d = 4.2, color = rgb(230, 50, 60), value = 40 },
	{ d = 1.8, color = rgb(255, 210, 60), value = 60 },
}

local hitCooldown = {}

local function award(player: Player, value: number, dist: number, pos: Vector3, label: string)
	if not Data.isLoaded(player) then
		return
	end
	local mult = 1 + math.min(dist, 260) / 90
	local points = math.floor(value * mult)
	local coins = math.max(2, math.floor(points * 0.45))
	Data.addCoins(player, coins)
	Data.addXP(player, math.floor(points * 0.6))
	Data.addStat(player, "TotalHits", 1)
	Quests.report(player, "target", 1)
	Remotes.get("ScorePopup"):FireClient(player, pos + Vector3.new(0, 3, 0), string.format("%s +%d", label, coins), value >= 60 and P.Accent or P.Green)
end

-- Cria um alvo. cf: posicao/orientacao (eixo do disco = lookVector do cf), moving: { axis, dist, time }
local function makeTarget(folder: Folder, center: Vector3, moving)
	local m = Build.model(folder, "Target")
	local faceCF = CFrame.new(center) * CFrame.Angles(0, 0, -math.pi / 2) -- eixo do cilindro = +X (voltado para a praca)
	local anchored = moving == nil
	local opts = function(extra)
		extra = extra or {}
		extra.anchored = anchored
		return extra
	end

	-- poste
	local groundY = Build.y(center.X, center.Z)
	local h = center.Y - groundY
	local pole = Build.cyl(m, CFrame.new(center.X - 0.5, groundY + h / 2, center.Z), h, 1.2, rgb(130, 96, 66), M.Wood, opts())
	local discParts = {}
	for i, r in RINGS do
		local p = Build.cyl(m, faceCF * CFrame.new(0, i * 0.12, 0), 0.3, r.d, r.color, i == #RINGS and M.Neon or M.SmoothPlastic, opts({ collide = false }))
		p.CanTouch = true
		p:SetAttribute("Ring", r.value)
		table.insert(discParts, p)
		if not anchored then
			local w = Instance.new("WeldConstraint")
			w.Part0 = pole
			w.Part1 = p
			w.Parent = p
		end
	end
	if not anchored then
		pole.Anchored = true
		-- cada peca do modelo precisa estar soldada ao "carrier"
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and d ~= pole and not d:FindFirstChildOfClass("WeldConstraint") then
				local w = Instance.new("WeldConstraint")
				w.Part0 = pole
				w.Part1 = d
				w.Parent = d
			end
		end
	end
	m.PrimaryPart = pole

	-- placa com a distancia
	local sign = Build.block(m, CFrame.new(center.X - 0.6, groundY + 2.2, center.Z), Vector3.new(0.4, 2.2, 5), rgb(40, 40, 90), M.SmoothPlastic, opts({ collide = false }))
	local dist = (Vector3.new(center.X, 0, center.Z) - Vector3.new(-75, 0, center.Z)).Magnitude
	Build.label(sign, string.format("%dm", math.floor(dist)), { color = P.White, face = Enum.NormalId.Right, ppu = 30 })

	local function onTouch(other: BasePart)
		local thrower = other:GetAttribute("Thrower")
		if not thrower or not other.Parent then
			return
		end
		local now = os.clock()
		if hitCooldown[other] and now - hitCooldown[other] < 1 then
			return
		end
		if other.AssemblyLinearVelocity.Magnitude < 28 then
			return
		end
		local player = Players:GetPlayerByUserId(thrower)
		if not player then
			return
		end
		hitCooldown[other] = now
		-- anel atingido: distancia do impacto ao centro no plano do alvo
		local rel = faceCF:PointToObjectSpace(other.Position)
		local rr = math.sqrt(rel.X * rel.X + rel.Z * rel.Z)
		local value = 5
		local label = "ACERTOU"
		for i = #RINGS, 1, -1 do
			if rr <= RINGS[i].d / 2 + 0.6 then
				value = RINGS[i].value
				label = (i == #RINGS) and "NA MOSCA!" or "ACERTOU"
				break
			end
		end
		local throwerPos = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local dist2 = throwerPos and (throwerPos.Position - center).Magnitude or 60
		award(player, value, dist2, center, label)
		Remotes.get("Fx"):FireAllClients(value >= 60 and "confetti" or "sparkle", center, 0.6, nil)
	end
	for _, p in discParts do
		p.Touched:Connect(onTouch)
	end

	if moving then
		local from = center
		local to = center + moving.axis * moving.dist
		local yOff = 0
		local tinfo = TweenInfo.new(moving.time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		-- move o carrier (o resto vai junto, soldado)
		TweenService:Create(pole, tinfo, { CFrame = pole.CFrame + (to - from) + Vector3.new(0, yOff, 0) }):Play()
	end
	return m
end

function Targets.init()
	local folder = Build.folder("Targets")
	-- campo a oeste da praca; alvos voltados para +X (para quem arremessa da linha de partida)
	local baseX = -75
	local lane = { z = 58 }
	local specs = {
		{ dx = -40, dz = -18, h = 8 },
		{ dx = -55, dz = 12, h = 10 },
		{ dx = -75, dz = -8, h = 14 },
		{ dx = -95, dz = 20, h = 12 },
		{ dx = -115, dz = -24, h = 16 },
		{ dx = -140, dz = 4, h = 18 },
		{ dx = -170, dz = -14, h = 22 },
		{ dx = -200, dz = 18, h = 26 },
	}
	for i, s in specs do
		local x, z = baseX + s.dx, lane.z + s.dz
		local y = Build.y(x, z) + s.h
		local moving = nil
		if i % 3 == 0 then
			moving = { axis = Vector3.new(0, 0, 1), dist = 22, time = 2.4 + i * 0.25 }
		end
		makeTarget(folder, Vector3.new(x, y, z), moving)
	end

	-- linha de partida
	local sy = Build.y(baseX + 6, lane.z)
	local line = Build.block(folder, CFrame.new(baseX + 6, sy + 0.2, lane.z), Vector3.new(2, 0.4, 70), P.Accent, M.Neon, { collide = false })
	local board = Build.block(folder, CFrame.new(baseX - 6, sy + 6, lane.z + 42), Vector3.new(0.6, 7, 16), rgb(36, 34, 90), M.SmoothPlastic)
	Build.label(board, "🎯 TIRO AO ALVO\nArremesse nos alvos!", { color = P.White, face = Enum.NormalId.Right, ppu = 30 })
	Build.foundation(folder, CFrame.new(baseX - 6, sy, lane.z + 42), Vector3.new(2, 1, 2))
	_ = line
	_ = CollectionService
end

return Targets
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Atmosphere</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Atmosphere: iluminacao, ceu, efeitos de pos-processamento e ciclo de dia/noite.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Atmosphere = {}

Atmosphere.DayLength = 960 -- segundos para um dia completo

local function clearOld()
	for _, c in Lighting:GetChildren() do
		if c:IsA("Sky") or c:IsA("Atmosphere") or c:IsA("BloomEffect") or c:IsA("ColorCorrectionEffect") or c:IsA("SunRaysEffect") or c:IsA("DepthOfFieldEffect") or c:IsA("Clouds") then
			c:Destroy()
		end
	end
end

function Atmosphere.init()
	clearOld()

	Lighting.Brightness = 3
	Lighting.ExposureCompensation = 0.1
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.18
	Lighting.GeographicLatitude = 22
	Lighting.Ambient = Color3.fromRGB(70, 74, 110)
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 130, 170)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 236, 205)
	Lighting.ClockTime = 15.3
	pcall(function()
		Lighting.FogEnd = 100000
	end)

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 14
	sky.StarCount = 4500
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	local atm = Instance.new("Atmosphere")
	atm.Density = 0.32
	atm.Offset = 0.22
	atm.Color = Color3.fromRGB(196, 214, 255)
	atm.Decay = Color3.fromRGB(255, 190, 170)
	atm.Glare = 0.35
	atm.Haze = 1.1
	atm.Parent = Lighting

	local clouds = Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = Color3.fromRGB(255, 255, 255)
	clouds.Parent = workspace.Terrain

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.55
	bloom.Size = 26
	bloom.Threshold = 1.0
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Brightness = 0.0
	cc.Contrast = 0.1
	cc.Saturation = 0.22
	cc.TintColor = Color3.fromRGB(255, 248, 240)
	cc.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.1
	rays.Spread = 0.6
	rays.Parent = Lighting

	local dof = Instance.new("DepthOfFieldEffect")
	dof.FarIntensity = 0.12
	dof.FocusDistance = 120
	dof.InFocusRadius = 70
	dof.NearIntensity = 0
	dof.Parent = Lighting

	pcall(function()
		SoundService.AmbientReverb = Enum.ReverbType.Forest
	end)

	-- ciclo dia/noite
	local speed = 24 / Atmosphere.DayLength
	RunService.Heartbeat:Connect(function(dt)
		Lighting.ClockTime = (Lighting.ClockTime + dt * speed) % 24
	end)
end

return Atmosphere
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Blasts</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Blasts: explosoes, ondas de choque e bolhas de gravidade zero.
]]

local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Physics = require(script.Parent:WaitForChild("Physics"))
local Ragdoll = require(script.Parent:WaitForChild("Ragdoll"))
local Scoring = require(script.Parent:WaitForChild("Scoring"))

local Blasts = {}

local GRAVITY = 196.2

local function overlapParams(): OverlapParams
	local p = OverlapParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	local pickups = workspace:FindFirstChild("TV_Pickups")
	if pickups then
		table.insert(ignore, pickups)
	end
	p.FilterDescendantsInstances = ignore
	return p
end

-- Empurra tudo em volta de um ponto.
-- power: velocidade final (studs/s) no centro; falloff linear ate o raio.
-- opts: { credit = Player?, knock = seg?, skip = Model?, fx = "explosion"|"shock"|false, lift = number?, noCharacters = bool? }
function Blasts.push(position: Vector3, radius: number, power: number, opts: { [string]: any }?)
	opts = opts or {}
	local credit: Player? = opts.credit
	local lift = opts.lift or 0.55
	if opts.fx ~= false then
		Remotes.get("Fx"):FireAllClients(opts.fx or "explosion", position, radius / 26, nil)
	end

	local parts = workspace:GetPartBoundsInRadius(position, radius, overlapParams())
	local seen = {}
	for _, part in parts do
		if part.Anchored then
			continue
		end
		local model, player = Physics.characterOf(part)
		if model and opts.noCharacters then
			continue
		end
		if model then
			if seen[model] or model == opts.skip then
				continue
			end
			seen[model] = true
			local root = Physics.rootOfCharacter(model)
			if not root then
				continue
			end
			if player and Physics.isProtected(player) then
				continue
			end
			local off = root.Position - position
			local dist = off.Magnitude
			local fall = Util.saturate(1 - dist / radius)
			local dir = Util.safeUnit(off + Vector3.new(0, radius * lift, 0), Vector3.yAxis)
			Ragdoll.knock(model, opts.knock or (1.6 + 2.2 * fall))
			Physics.launch(model, dir * (power * (0.35 + 0.65 * fall)))
			if player then
				Remotes.get("Struck"):FireClient(player, fall, dir)
			end
			if credit then
				Scoring.hit(credit, model, player, power)
			end
		else
			local root = part.AssemblyRootPart or part
			if seen[root] then
				continue
			end
			seen[root] = true
			if root:GetAttribute("HeldBy") or root.Anchored then
				continue
			end
			local mass = root.AssemblyMass
			local off = root.Position - position
			local dist = off.Magnitude
			local fall = Util.saturate(1 - dist / radius)
			local dir = Util.safeUnit(off + Vector3.new(0, radius * lift, 0), Vector3.yAxis)
			Physics.impulse(root, dir * (mass * power * (0.3 + 0.7 * fall)))
			root.AssemblyAngularVelocity = Util.randomUnit() * 8 * fall
		end
	end
end

-- Explosao "de verdade": empurra + quebra brinquedos explosivos proximos em cadeia
function Blasts.explode(position: Vector3, radius: number, power: number, credit: Player?)
	Blasts.push(position, radius, power, { credit = credit, fx = "explosion" })
end

-- Onda de choque de habilidade (sem "boom" grande, mais anel de energia)
function Blasts.shock(player: Player, position: Vector3, radius: number, power: number)
	local model = player.Character
	Blasts.push(position, radius, power, { credit = player, skip = model, fx = "shock", knock = 2.2 })
end

-- Bolha anti-gravidade ------------------------------------------------------------------------------

local bubbles = {} -- lista de { part, center, radius, expire, forces = { [part] = VectorForce } }

function Blasts.bubble(position: Vector3, radius: number, duration: number, owner: Player?)
	local shell = Instance.new("Part")
	shell.Name = "TV_Bubble"
	shell.Shape = Enum.PartType.Ball
	shell.Size = Vector3.one * radius * 2
	shell.Anchored = true
	shell.CanCollide = false
	shell.CanTouch = false
	shell.CanQuery = false
	shell.CastShadow = false
	shell.Material = Enum.Material.ForceField
	shell.Color = Color3.fromRGB(160, 120, 255)
	shell.Transparency = 0.35
	shell.CFrame = CFrame.new(position)
	shell.Parent = workspace
	shell:SetAttribute("Owner", owner and owner.UserId or 0)
	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(170, 130, 255)
	pl.Range = radius * 1.4
	pl.Brightness = 1.2
	pl.Shadows = false
	pl.Parent = shell

	shell.Size = Vector3.one * 2
	Util.tween(shell, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = Vector3.one * radius * 2 })
	Remotes.get("Fx"):FireAllClients("bubble", position, radius / 26, nil)

	table.insert(bubbles, {
		part = shell,
		center = position,
		radius = radius,
		expire = os.clock() + duration,
		forces = {},
	})
end

local function clearForce(rec, part)
	local f = rec.forces[part]
	if f then
		if f.force.Parent then
			f.force:Destroy()
		end
		if f.att.Parent then
			f.att:Destroy()
		end
		rec.forces[part] = nil
	end
end

local function bubbleStep()
	local now = os.clock()
	local i = 1
	while i <= #bubbles do
		local rec = bubbles[i]
		if now >= rec.expire or not rec.part.Parent then
			for part in rec.forces do
				clearForce(rec, part)
			end
			if rec.part.Parent then
				rec.part.Anchored = true
				Util.tween(rec.part, 0.4, { Size = Vector3.one * 1, Transparency = 1 })
				Debris:AddItem(rec.part, 0.5)
			end
			table.remove(bubbles, i)
		else
			local inside = {}
			for _, part in workspace:GetPartBoundsInRadius(rec.center, rec.radius, overlapParams()) do
				if not part.Anchored and part.AssemblyRootPart == part and part.Name ~= "TV_Bubble" then
					inside[part] = true
					if not rec.forces[part] then
						local att = Instance.new("Attachment")
						att.Name = "TV_BubbleAtt"
						att.Parent = part
						local vf = Instance.new("VectorForce")
						vf.Name = "TV_BubbleForce"
						vf.Attachment0 = att
						vf.RelativeTo = Enum.ActuatorRelativeTo.World
						vf.ApplyAtCenterOfMass = true
						vf.Force = Vector3.new(0, part.AssemblyMass * GRAVITY * 0.94, 0)
						vf.Parent = part
						rec.forces[part] = { force = vf, att = att }
					else
						rec.forces[part].force.Force = Vector3.new(0, part.AssemblyMass * GRAVITY * 0.94, 0)
					end
					-- personagens dentro da bolha: o cliente reduz a gravidade
					local model, player = Physics.characterOf(part)
					if model and player then
						player:SetAttribute("LowGravUntil", workspace:GetServerTimeNow() + 0.6)
					end
				end
			end
			for part in rec.forces do
				if not inside[part] then
					clearForce(rec, part)
				end
			end
			i += 1
		end
	end
end

function Blasts.init()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.2 then
			acc = 0
			bubbleStep()
		end
	end)
end

return Blasts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Board</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Board: placar de recordes de arremesso (maior distancia).
	Usa OrderedDataStore quando disponivel; sempre mantem uma copia em memoria do servidor.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Board = {}

Board.Changed = Util.Signal.new()

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.Progression.BoardStoreName)
	end)
	if ok then
		store = result
	end
end

local local_best = {} -- [userId] = { name, value } (so desta sessao do servidor)
local global_cache = {} -- ultima leitura global
local last_fetch = 0

function Board.submit(player: Player, distance: number)
	local value = math.floor(distance)
	local rec = local_best[player.UserId]
	if rec and rec.value >= value then
		return
	end
	local_best[player.UserId] = { name = player.DisplayName, userId = player.UserId, value = value }
	Board.Changed:Fire()
	if store then
		task.spawn(function()
			pcall(function()
				store:UpdateAsync("U_" .. player.UserId, function(old)
					if old and old >= value then
						return old
					end
					return value
				end)
			end)
		end)
	end
end

local function fetchGlobal()
	if not store or os.clock() - last_fetch < 30 then
		return
	end
	last_fetch = os.clock()
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 10)
	end)
	if not ok or not pages then
		return
	end
	local ok2, top = pcall(function()
		return pages:GetCurrentPage()
	end)
	if not ok2 then
		return
	end
	local list = {}
	for _, entry in top do
		local userId = tonumber(string.match(entry.key, "U_(%d+)"))
		local name = "Jogador"
		if userId then
			local okName, n = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			if okName then
				name = n
			end
		end
		table.insert(list, { name = name, userId = userId, value = entry.value })
	end
	global_cache = list
end

-- Lista combinada (global + sessao), top 10
function Board.top(): { { name: string, value: number } }
	task.spawn(fetchGlobal)
	local merged = {}
	local seen = {}
	for _, r in global_cache do
		seen[r.userId or r.name] = r
	end
	for _, r in local_best do
		local key = r.userId or r.name
		local cur = seen[key]
		if not cur or cur.value < r.value then
			seen[key] = r
		end
	end
	for _, r in seen do
		table.insert(merged, r)
	end
	table.sort(merged, function(a, b)
		return a.value > b.value
	end)
	local out = {}
	for i = 1, math.min(10, #merged) do
		out[i] = { name = merged[i].name, value = merged[i].value }
	end
	return out
end

function Board.init()
	Remotes.get("GetBoard").OnServerInvoke = function()
		return Board.top()
	end
end

return Board
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Data: dados do jogador (moedas, XP, nivel, upgrades, brinquedos comprados, cosmeticos).
	- Salva em DataStore (com pcall: no Studio sem "Enable Studio Access to API Services"
	  o jogo funciona normalmente, so nao salva).
	- Replica para o cliente via Remotes.DataSync / DataChanged.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Toys = require(Shared:WaitForChild("Toys"))

local Data = {}

Data.Loaded = Util.Signal.new() -- (player)
Data.LevelUp = Util.Signal.new() -- (player, novoNivel)
Data.Changed = Util.Signal.new() -- (player, chave, valor)
Data.multiplier = 1 -- multiplicador global de moedas (evento "Hora do Ouro")

local DEFAULT = {
	Version = 1,
	Coins = Config.Economy.StartCoins,
	XP = 0,
	Level = 1,
	SkillPoints = 0,
	BestThrow = 0,
	TotalThrows = 0,
	TotalHits = 0,
	BossDamage = 0,
	PlayTime = 0,
	Upgrades = {},
	Toys = {}, -- id -> true (comprados)
	OwnedTethers = { Roxo = true, Ciano = true, Rosa = true },
	OwnedTrails = { Nenhum = true },
	Tether = "Roxo",
	Trail = "Nenhum",
	Settings = { Peaceful = false, Music = true, Sfx = true, Shake = true, Tutorial = false },
	LastSlot = 0,
	Wins = 0,
	Quests = { slots = {}, completed = 0 },
}

local profiles = {} -- [player] = { data, loaded, dirty, lastSave }
local store = nil
local canPersist = false

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Progression.StoreName)
	end)
	if ok then
		store = result
		canPersist = true
	end
end

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in t do
		out[k] = deepCopy(v)
	end
	return out
end

local function reconcile(target, template)
	for k, v in template do
		if target[k] == nil then
			target[k] = deepCopy(v)
		elseif type(v) == "table" and type(target[k]) == "table" then
			reconcile(target[k], v)
		end
	end
end

function Data.xpForLevel(level: number): number
	return math.floor(Config.Progression.XPBase * (level ^ Config.Progression.XPExponent))
end

local PUBLIC_KEYS = {
	"Coins", "XP", "Level", "SkillPoints", "BestThrow", "TotalThrows", "TotalHits", "BossDamage",
	"Upgrades", "Toys", "OwnedTethers", "OwnedTrails", "Tether", "Trail", "Settings", "Wins", "Quests",
}

function Data.snapshot(player: Player)
	local prof = profiles[player]
	if not prof then
		return nil
	end
	local snap = {}
	for _, k in PUBLIC_KEYS do
		snap[k] = deepCopy(prof.data[k])
	end
	snap.XPNeeded = Data.xpForLevel(prof.data.Level)
	return snap
end

function Data.get(player: Player)
	local prof = profiles[player]
	return prof and prof.data or nil
end

function Data.isLoaded(player: Player): boolean
	local prof = profiles[player]
	return prof ~= nil and prof.loaded
end

local function updateLeaderstats(player: Player)
	local prof = profiles[player]
	if not prof then
		return
	end
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		return
	end
	local lvl = ls:FindFirstChild("Nível")
	if lvl then
		lvl.Value = prof.data.Level
	end
	local coins = ls:FindFirstChild("Moedas")
	if coins then
		coins.Value = math.floor(prof.data.Coins)
	end
	local best = ls:FindFirstChild("Recorde")
	if best then
		best.Value = math.floor(prof.data.BestThrow)
	end
end

local function push(player: Player, key: string)
	local prof = profiles[player]
	if not prof then
		return
	end
	prof.dirty = true
	local value = deepCopy(prof.data[key])
	Remotes.get("DataChanged"):FireClient(player, key, value)
	if key == "XP" or key == "Level" then
		Remotes.get("DataChanged"):FireClient(player, "XPNeeded", Data.xpForLevel(prof.data.Level))
	end
	if key == "Settings" then
		player:SetAttribute("Peaceful", prof.data.Settings.Peaceful == true)
	elseif key == "Tether" then
		player:SetAttribute("TetherColor", prof.data.Tether)
	elseif key == "Trail" then
		player:SetAttribute("TetherTrail", prof.data.Trail)
	elseif key == "Level" then
		player:SetAttribute("Level", prof.data.Level)
	end
	updateLeaderstats(player)
	Data.Changed:Fire(player, key, value)
end

Data.push = push

function Data.set(player: Player, key: string, value: any)
	local prof = profiles[player]
	if not prof then
		return
	end
	prof.data[key] = value
	push(player, key)
end

function Data.addCoins(player: Player, amount: number, reason: string?): number
	local prof = profiles[player]
	if not prof or amount == 0 then
		return 0
	end
	amount = math.floor(amount)
	if amount > 0 and Data.multiplier ~= 1 then
		amount = math.floor(amount * Data.multiplier)
	end
	prof.data.Coins = math.max(0, prof.data.Coins + amount)
	push(player, "Coins")
	if amount > 0 then
		Remotes.get("Notify"):FireClient(player, "+" .. Util.formatNumber(amount) .. " 🪙" .. (reason and (" · " .. reason) or ""), "coin")
	end
	return amount
end

function Data.spendCoins(player: Player, amount: number): boolean
	local prof = profiles[player]
	if not prof or prof.data.Coins < amount then
		return false
	end
	prof.data.Coins -= amount
	push(player, "Coins")
	return true
end

function Data.addXP(player: Player, amount: number)
	local prof = profiles[player]
	if not prof or amount <= 0 then
		return
	end
	local d = prof.data
	if d.Level >= Config.Progression.MaxLevel then
		return
	end
	d.XP += math.floor(amount)
	local leveled = false
	while d.XP >= Data.xpForLevel(d.Level) and d.Level < Config.Progression.MaxLevel do
		d.XP -= Data.xpForLevel(d.Level)
		d.Level += 1
		d.SkillPoints += Config.Progression.SkillPointEvery
		leveled = true
		Data.LevelUp:Fire(player, d.Level)
	end
	push(player, "XP")
	if leveled then
		push(player, "Level")
		push(player, "SkillPoints")
		Remotes.get("Announce"):FireClient(
			player,
			"NÍVEL " .. d.Level .. "!",
			"+1 ponto de habilidade  ·  novas coisas foram liberadas",
			3.5,
			Config.Palette.Accent
		)
	end
end

function Data.addStat(player: Player, key: string, amount: number)
	local prof = profiles[player]
	if not prof then
		return
	end
	prof.data[key] = (prof.data[key] or 0) + amount
	push(player, key)
end

function Data.getUpgrade(player: Player, id: string): number
	local prof = profiles[player]
	if not prof then
		return 0
	end
	return prof.data.Upgrades[id] or 0
end

function Data.upgradeCost(player: Player, id: string): number
	local cur = Data.getUpgrade(player, id)
	if id == "DoubleTether" then
		return 5
	end
	return 1 + cur // 3
end

function Data.buyUpgrade(player: Player, id: string): (boolean, string)
	local prof = profiles[player]
	local def = Config.Upgrades[id]
	if not prof or not def then
		return false, "Upgrade inválido"
	end
	local cur = prof.data.Upgrades[id] or 0
	if cur >= def.max then
		return false, "Já está no máximo"
	end
	local cost = Data.upgradeCost(player, id)
	if prof.data.SkillPoints < cost then
		return false, "Faltam pontos de habilidade (" .. cost .. ")"
	end
	prof.data.SkillPoints -= cost
	prof.data.Upgrades[id] = cur + 1
	push(player, "SkillPoints")
	push(player, "Upgrades")
	return true, def.name .. " nível " .. (cur + 1)
end

function Data.ownsToy(player: Player, id: string): boolean
	local prof = profiles[player]
	local toy = Toys.ById[id]
	if not prof or not toy then
		return false
	end
	if toy.price == 0 then
		return true
	end
	return prof.data.Toys[id] == true
end

function Data.getSetting(player: Player, key: string): any
	local prof = profiles[player]
	if not prof then
		return nil
	end
	return prof.data.Settings[key]
end

function Data.setSetting(player: Player, key: string, value: any)
	local prof = profiles[player]
	if not prof then
		return
	end
	if prof.data.Settings[key] == nil then
		return
	end
	if typeof(value) ~= typeof(prof.data.Settings[key]) then
		return
	end
	prof.data.Settings[key] = value
	push(player, "Settings")
end

-- Persistencia ----------------------------------------------------------------

local function load(player: Player)
	local key = "P_" .. player.UserId
	local data = nil
	if canPersist then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key)
			end)
			if ok then
				data = result
				break
			end
			if RunService:IsStudio() then
				-- Studio sem "Enable Studio Access to API Services": nao adianta tentar de novo
				canPersist = false
				warn("[Data] DataStore indisponivel no Studio; jogando sem salvar. (" .. tostring(result) .. ")")
				break
			end
			task.wait(attempt)
		end
	end
	if type(data) ~= "table" then
		data = deepCopy(DEFAULT)
	else
		reconcile(data, DEFAULT)
	end
	return data
end

local function save(player: Player, force: boolean?)
	local prof = profiles[player]
	if not prof or not prof.loaded or not canPersist then
		return
	end
	if not prof.dirty and not force then
		return
	end
	prof.dirty = false
	local key = "P_" .. player.UserId
	local snapshot = deepCopy(prof.data)
	for attempt = 1, 3 do
		local ok = pcall(function()
			store:SetAsync(key, snapshot)
		end)
		if ok then
			return
		end
		task.wait(attempt * 1.5)
	end
	prof.dirty = true
end

Data.save = save

local function onPlayerAdded(player: Player)
	local prof = { data = nil, loaded = false, dirty = false, joined = os.clock() }
	profiles[player] = prof

	-- leaderstats (aparece na lista de jogadores)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in { "Nível", "Moedas", "Recorde" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Value = 0
		v.Parent = ls
	end
	ls.Parent = player

	local data = load(player)
	if not player.Parent then
		profiles[player] = nil
		return
	end
	prof.data = data
	prof.loaded = true

	player:SetAttribute("Peaceful", data.Settings.Peaceful == true)
	player:SetAttribute("TetherColor", data.Tether)
	player:SetAttribute("TetherTrail", data.Trail)
	player:SetAttribute("Level", data.Level)
	updateLeaderstats(player)
	Data.Loaded:Fire(player)
end

local function onPlayerRemoving(player: Player)
	local prof = profiles[player]
	if prof and prof.loaded then
		prof.data.PlayTime += os.clock() - prof.joined
		save(player, true)
	end
	profiles[player] = nil
end

function Data.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end

	-- o cliente pede o snapshot quando estiver pronto
	Remotes.get("ClientReady").OnServerEvent:Connect(function(player)
		task.spawn(function()
			local t0 = os.clock()
			while not Data.isLoaded(player) and os.clock() - t0 < 30 do
				task.wait(0.1)
			end
			local snap = Data.snapshot(player)
			if snap then
				Remotes.get("DataSync"):FireClient(player, snap)
			end
		end)
	end)

	Remotes.get("SetSetting").OnServerEvent:Connect(function(player, key, value)
		if type(key) ~= "string" then
			return
		end
		Data.setSetting(player, key, value)
	end)

	Remotes.get("BuyUpgrade").OnServerEvent:Connect(function(player, id)
		if type(id) ~= "string" then
			return
		end
		local ok, msg = Data.buyUpgrade(player, id)
		Remotes.get("Notify"):FireClient(player, msg, ok and "good" or "bad")
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(Config.Progression.SaveInterval)
			for player in profiles do
				task.spawn(save, player)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Grab</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Grab: o servidor do "cabo de energia".
	O CLIENTE faz o movimento (constraints locais) porque ele vira dono da fisica do objeto.
	O SERVIDOR: valida quem pode agarrar o que, entrega o dono da fisica, cuida de
	escapar (espernear), coleira de distancia, arremesso (limites anti-trapaca),
	rastreio de distancia/recorde e impactos.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Data = require(script.Parent:WaitForChild("Data"))
local Physics = require(script.Parent:WaitForChild("Physics"))
local Ragdoll = require(script.Parent:WaitForChild("Ragdoll"))
local Scoring = require(script.Parent:WaitForChild("Scoring"))
local Impact = require(script.Parent:WaitForChild("Impact"))

local Grab = {}

local holds = {} -- [player] = { hold, ... }
local byKey = {} -- [BasePart] = hold
local tracking = {} -- arremessos em andamento
local struggles = {} -- [vitima] = { value, last, hold }
local releasedAt = {} -- [model] = os.clock()

-- Limites (dependem dos upgrades) ---------------------------------------------------------

function Grab.range(player: Player): number
	return Config.Grab.BaseRange + Config.Grab.RangePerLevel * Data.getUpgrade(player, "Range")
end

function Grab.holdMax(player: Player): number
	return Config.Grab.HoldMaxBase + Config.Grab.HoldMaxPerLevel * Data.getUpgrade(player, "Range")
end

function Grab.maxMass(player: Player): number
	return Config.Grab.MaxMassBase + Config.Grab.MaxMassPerLevel * Data.getUpgrade(player, "Strength")
end

function Grab.maxHolds(player: Player): number
	return 1 + Data.getUpgrade(player, "DoubleTether")
end

-- Velocidade de arremesso (mesma formula do cliente)
function Grab.throwSpeed(player: Player, mass: number, charge: number): number
	local T = Config.Throw
	local factor = math.clamp((T.RefMass / math.max(mass, 0.5)) ^ T.MassExponent, 0.2, 1.6)
	local power = 1 + T.PowerPerLevel * Data.getUpgrade(player, "Power")
	local speed = Util.lerp(T.MinSpeed, T.MaxSpeed, charge ^ 0.85) * factor * power
	return math.min(speed, T.MaxSpeedHard)
end

function Grab.holdsOf(player: Player): { any }
	return holds[player] or {}
end

function Grab.holdOfKey(key: Instance): any
	return byKey[key]
end

function Grab.isHeld(inst: Instance): boolean
	return inst:GetAttribute("HeldBy") ~= nil
end

-- Classificacao ------------------------------------------------------------------------------

-- retorna kind ("object" | "character"), model, targetPlayer, root
local function classify(player: Player, part: any)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then
		return nil
	end
	local model, targetPlayer = Physics.characterOf(part)
	if model then
		if model == player.Character then
			return nil
		end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then
			return nil
		end
		if not targetPlayer and not CollectionService:HasTag(model, Config.Tags.Grabbable) then
			return nil
		end
		return "character", model, targetPlayer, Physics.holdPartOfCharacter(model)
	end
	local root = part.AssemblyRootPart or part
	if root.Anchored then
		return nil
	end
	if not CollectionService:HasTag(root, Config.Tags.Grabbable) then
		return nil
	end
	return "object", root:FindFirstAncestorOfClass("Model"), nil, root
end

local function holdsFolder(character: Model): Folder
	local f = character:FindFirstChild("TV_Holds")
	if not f then
		f = Instance.new("Folder")
		f.Name = "TV_Holds"
		f.Parent = character
	end
	return f
end

-- Termina um hold. reason: "client" | "throw" | "escaped" | "leash" | "gone" | "died" | "force"
local function endHold(hold, reason: string)
	if hold.ended then
		return
	end
	hold.ended = true
	local player = hold.player

	local list = holds[player]
	if list then
		local idx = table.find(list, hold)
		if idx then
			table.remove(list, idx)
		end
		if #list == 0 then
			holds[player] = nil
		end
	end
	byKey[hold.key] = nil
	if hold.ov and hold.ov.Parent then
		hold.ov:Destroy()
	end

	local target = hold.model or hold.key
	if hold.key.Parent then
		hold.key:SetAttribute("HeldBy", nil)
	end
	if hold.kind == "character" and hold.model then
		hold.model:SetAttribute("HeldBy", nil)
		releasedAt[hold.model] = os.clock()
		if hold.targetPlayer then
			struggles[hold.targetPlayer] = nil
			Remotes.get("HoldedBy"):FireClient(hold.targetPlayer, nil, 0)
		end
		Ragdoll.setHeld(hold.model, false, reason == "throw" and 1.2 or nil)
	end

	local immediate = reason ~= "throw" and reason ~= "client"
	task.delay(Config.Grab.ReleaseGrace, function()
		if target.Parent then
			Physics.setGroup(target, hold.kind == "character" and Config.Groups.Players or Config.Groups.Default)
		end
	end)
	local function giveBack()
		if not target.Parent then
			return
		end
		if hold.kind == "character" then
			Physics.setOwnerAuto(target)
		elseif not hold.key:GetAttribute("HeldBy") and not CollectionService:HasTag(hold.key, Config.Tags.Airborne) then
			Physics.setOwner(target, nil)
		end
	end
	if immediate then
		giveBack()
	else
		task.delay(Config.Grab.OwnerLinger, giveBack)
	end

	if reason ~= "client" and reason ~= "throw" and player.Parent then
		Remotes.get("ForceRelease"):FireClient(player, hold.key, reason)
	end
end

function Grab.releaseAll(player: Player, reason: string?)
	local list = holds[player]
	if not list then
		return
	end
	for i = #list, 1, -1 do
		endHold(list[i], reason or "force")
	end
end

function Grab.forceRelease(key: Instance, reason: string?)
	local hold = byKey[key]
	if hold then
		endHold(hold, reason or "force")
	end
end

-- Agarrar --------------------------------------------------------------------------------------

local function handleGrab(player: Player, part: any)
	if not Data.isLoaded(player) then
		return false, "Carregando seus dados..."
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return false, "Você está fora de combate"
	end
	local list = holds[player]
	if list and #list >= Grab.maxHolds(player) then
		return false, "Mãos ocupadas"
	end
	local kind, model, targetPlayer, root = classify(player, part)
	if not kind then
		return false, "Não dá para agarrar isso"
	end

	local reach = Grab.range(player) + 14 + root.Size.Magnitude * 0.5
	if (root.Position - hrp.Position).Magnitude > reach then
		return false, "Longe demais"
	end
	if root:GetAttribute("HeldBy") or (model and kind == "character" and model:GetAttribute("HeldBy")) then
		return false, "Alguém já está segurando"
	end

	local mass
	if kind == "character" then
		if player:GetAttribute("Peaceful") == true then
			return false, "Modo Pacífico ligado: você não pode agarrar pessoas"
		end
		if player:GetAttribute("SafeZone") == true then
			return false, "Zona segura: sem agarrar pessoas"
		end
		if targetPlayer and Physics.isProtected(targetPlayer) then
			return false, "Esse jogador está protegido"
		end
		local last = releasedAt[model]
		if last and os.clock() - last < Config.Grab.CharacterGrabCooldown then
			return false, "Calma!"
		end
		mass = Physics.characterMass(model)
		if mass > Grab.maxMass(player) then
			return false, "Pesado demais!"
		end
	else
		mass = root.AssemblyMass
		if mass > Grab.maxMass(player) then
			return false, "Pesado demais! Suba o upgrade de Força"
		end
	end

	-- objeto: so o modelo do brinquedo (quando a raiz e o PrimaryPart) muda de grupo/dono
	local target = model or root
	if kind == "object" and not (model and model.PrimaryPart == root) then
		model = nil
		target = root
	end

	local hold = {
		player = player,
		key = root,
		kind = kind,
		model = model,
		targetPlayer = targetPlayer,
		mass = mass,
		since = os.clock(),
	}

	-- reserva o alvo ja (evita dois jogadores agarrarem ao mesmo tempo durante a pausa abaixo)
	root:SetAttribute("HeldBy", player.UserId)
	if kind == "character" then
		model:SetAttribute("HeldBy", player.UserId)
		-- primeiro vira ragdoll (as partes viram montagens separadas), so depois entrega a fisica
		Ragdoll.enable(model, { duration = 1, held = true })
		task.wait(0.06)
		if not model.Parent or not root.Parent or (player.Character ~= char) then
			root:SetAttribute("HeldBy", nil)
			model:SetAttribute("HeldBy", nil)
			Ragdoll.setHeld(model, false)
			return false, "O alvo sumiu"
		end
	end
	Physics.setOwner(target, player, kind == "character")
	Physics.setGroup(target, Config.Groups.Held)

	local ov = Instance.new("ObjectValue")
	ov.Name = "Hold"
	ov.Value = root
	ov:SetAttribute("Kind", kind)
	ov.Parent = holdsFolder(char)
	hold.ov = ov

	if not holds[player] then
		holds[player] = {}
	end
	table.insert(holds[player], hold)
	byKey[root] = hold

	if kind == "character" then
		if targetPlayer then
			struggles[targetPlayer] = { value = 0, last = 0, hold = hold }
			Remotes.get("HoldedBy"):FireClient(targetPlayer, player.DisplayName, 0)
		end
		model:SetAttribute("LastHitBy", player.UserId)
		model:SetAttribute("LastHitTime", os.clock())
	end

	return true, { kind = kind, key = root, model = model, mass = mass }
end

-- Arremesso --------------------------------------------------------------------------------------

local function finalize(rec, index: number?)
	if rec.finalized then
		return
	end
	rec.finalized = true
	if index then
		table.remove(tracking, index)
	else
		local i = table.find(tracking, rec)
		if i then
			table.remove(tracking, i)
		end
	end
	Impact.finish(rec)

	local key = rec.key
	local alive = key.Parent ~= nil
	if alive then
		CollectionService:RemoveTag(key, Config.Tags.Airborne)
		key:SetAttribute("Thrower", nil)
		key:SetAttribute("ThrowClock", nil)
		local target = rec.model or key
		if rec.kind == "character" then
			Physics.setOwnerAuto(target)
		elseif not key:GetAttribute("HeldBy") then
			Physics.setOwner(target, nil)
		end
	end

	local thrower = rec.thrower
	if thrower and thrower.Parent then
		local pos = alive and key.Position or rec.lastPos
		if pos and pos.Y > Config.World.KillY then
			local distance = Util.flat(pos - rec.origin).Magnitude
			if distance >= Config.Throw.DistanceMin then
				local bonus = 1
				local label = nil
				if rec.kind == "character" then
					bonus = 1.5
					label = "Pessoa voadora!"
				elseif rec.behavior == "crystal" then
					bonus = 2
					label = "Cristal!"
				end
				Scoring.throwLanded(thrower, distance, bonus, pos, label)
			end
		end
	end
end

local function doThrow(player: Player, key: any, dir: any, charge: any)
	if typeof(key) ~= "Instance" or typeof(dir) ~= "Vector3" or type(charge) ~= "number" then
		return
	end
	local hold = byKey[key]
	if not hold or hold.player ~= player then
		return
	end
	if dir.Magnitude < 0.5 or dir.Magnitude ~= dir.Magnitude then
		return
	end
	charge = math.clamp(charge, Config.Throw.MinCharge, 1)
	local expected = Grab.throwSpeed(player, hold.mass, charge)

	local kind = hold.kind
	local model = hold.model
	local parts
	if kind == "character" then
		parts = {}
		for _, n in { "HumanoidRootPart", "UpperTorso", "Torso", "Head" } do
			local p = model:FindFirstChild(n)
			if p then
				table.insert(parts, p)
			end
		end
	else
		parts = { key }
	end

	local rec = {
		key = key,
		parts = parts,
		model = model,
		thrower = player,
		kind = kind,
		mass = hold.mass,
		behavior = (kind == "object") and (key:GetAttribute("Behavior") or "none") or "person",
		t0 = os.clock(),
		origin = key.Position,
		lastPos = key.Position,
		rest = 0,
		maxSpeed = expected * 1.35 + 30,
	}

	endHold(hold, "throw")

	key:SetAttribute("Thrower", player.UserId)
	key:SetAttribute("ThrowClock", workspace:GetServerTimeNow())
	key:SetAttribute("LastThrower", player.UserId)
	key:SetAttribute("LastThrowT", os.clock())
	if player.Character then
		player.Character:SetAttribute("ThrowT", workspace:GetServerTimeNow())
	end
	if kind == "object" then
		CollectionService:AddTag(key, Config.Tags.Airborne)
	end
	table.insert(tracking, rec)
	Impact.begin(rec)
end

-- Laços periódicos -----------------------------------------------------------------------------

local function trackingStep(dt: number)
	local now = os.clock()
	for i = #tracking, 1, -1 do
		local rec = tracking[i]
		local key = rec.key
		if not key.Parent then
			finalize(rec, i)
		else
			rec.lastPos = key.Position
			local v = key.AssemblyLinearVelocity
			local speed = v.Magnitude
			local age = now - rec.t0
			if age < 1.5 and speed > rec.maxSpeed then
				key.AssemblyLinearVelocity = v.Unit * rec.maxSpeed
			end
			if age > 0.6 and speed < Config.Throw.LandSpeed then
				rec.rest += dt
			else
				rec.rest = 0
			end
			if rec.rest >= Config.Throw.LandTime or age > Config.Throw.TrackTimeout or key.Position.Y < Config.World.KillY then
				finalize(rec, i)
			end
		end
	end
end

local function escape(hold)
	local victim = hold.targetPlayer
	local model = hold.model
	local holder = hold.player
	endHold(hold, "escaped")
	if victim then
		victim:SetAttribute("ImmuneUntil", workspace:GetServerTimeNow() + 2.5)
		Remotes.get("Notify"):FireClient(victim, "Você escapou! 🕊️", "good")
	end
	if model then
		local root = Physics.rootOfCharacter(model)
		local hrp = holder.Character and holder.Character:FindFirstChild("HumanoidRootPart")
		if root and hrp then
			local away = Util.safeUnit(Util.flat(root.Position - hrp.Position), Vector3.zAxis)
			Physics.launch(model, away * 55 + Vector3.new(0, 40, 0))
		end
	end
	Remotes.get("Notify"):FireClient(holder, "Ele escapou!", "bad")
end

local function leashStep(dt: number)
	-- coleira de distancia
	for player, list in holds do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		for i = #list, 1, -1 do
			local hold = list[i]
			if not hold.ended then
				local key = hold.key
				local bad = false
				if not hrp or not hum or hum.Health <= 0 then
					bad = true
				elseif not key.Parent or not key:IsDescendantOf(workspace) then
					bad = true
				elseif (key.Position - hrp.Position).Magnitude > Grab.holdMax(player) + Config.Grab.ServerLeash then
					bad = true
				elseif hold.kind == "character" then
					local th = hold.model and hold.model:FindFirstChildOfClass("Humanoid")
					if not th or th.Health <= 0 then
						bad = true
					end
				end
				if bad then
					endHold(hold, "leash")
				end
			end
		end
	end
	-- espernear: decaimento e progresso
	for victim, st in struggles do
		local needed = math.max(6, Config.Ragdoll.StruggleNeeded - Config.Ragdoll.StrugglePerLevel * Data.getUpgrade(victim, "Escape"))
		st.value = math.max(0, st.value - (Config.Ragdoll.StruggleDecay / needed) * dt)
		if victim.Parent and st.hold and not st.hold.ended then
			Remotes.get("HoldedBy"):FireClient(victim, st.hold.player.DisplayName, st.value)
		end
	end
end

local function onPlayerGone(player: Player)
	Grab.releaseAll(player, "gone")
	-- se era vitima
	local st = struggles[player]
	if st and st.hold then
		endHold(st.hold, "gone")
	end
	struggles[player] = nil
	for key, hold in byKey do
		if hold.targetPlayer == player then
			endHold(hold, "gone")
		end
	end
end

function Grab.init()
	Remotes.get("Grab").OnServerInvoke = function(player, part, _aim)
		local ok, a, b = pcall(handleGrab, player, part)
		if not ok then
			warn("[Grab] erro:", a)
			return false, "Erro interno"
		end
		return a, b
	end

	Remotes.get("Release").OnServerEvent:Connect(function(player, key)
		if typeof(key) ~= "Instance" then
			return
		end
		local hold = byKey[key]
		if hold and hold.player == player then
			endHold(hold, "client")
		end
	end)

	Remotes.get("Throw").OnServerEvent:Connect(function(player, key, dir, charge)
		local ok, err = pcall(doThrow, player, key, dir, charge)
		if not ok then
			warn("[Grab] erro no arremesso:", err)
		end
	end)

	Remotes.get("Struggle").OnServerEvent:Connect(function(player)
		local st = struggles[player]
		if not st or not st.hold or st.hold.ended then
			return
		end
		local now = os.clock()
		if now - st.last < 0.06 then
			return
		end
		st.last = now
		local needed = math.max(6, Config.Ragdoll.StruggleNeeded - Config.Ragdoll.StrugglePerLevel * Data.getUpgrade(player, "Escape"))
		st.value += 1 / needed
		if st.value >= Config.Ragdoll.StruggleMax then
			escape(st.hold)
		end
	end)

	local acc = 0
	local accTrack = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		accTrack += dt
		if accTrack >= 0.1 then
			trackingStep(accTrack)
			accTrack = 0
		end
		if acc >= 0.25 then
			leashStep(acc)
			acc = 0
		end
	end)

	Players.PlayerRemoving:Connect(onPlayerGone)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterRemoving:Connect(function()
			Grab.releaseAll(player, "died")
			local st = struggles[player]
			if st and st.hold then
				endHold(st.hold, "died")
			end
		end)
	end)
	for _, p in Players:GetPlayers() do
		p.CharacterRemoving:Connect(function()
			Grab.releaseAll(p, "died")
		end)
	end
end

return Grab
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Impact</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Impact: o que acontece quando um objeto/pessoa arremessado bate em alguma coisa.
	Cada arremesso tem um "registro" (rec) criado pelo modulo Grab:
	  rec = { key, parts, model, thrower, kind, mass, behavior, t0, conns, ... }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Physics = require(script.Parent:WaitForChild("Physics"))
local Ragdoll = require(script.Parent:WaitForChild("Ragdoll"))
local Scoring = require(script.Parent:WaitForChild("Scoring"))
local Blasts = require(script.Parent:WaitForChild("Blasts"))
local Pickups = require(script.Parent:WaitForChild("Pickups"))

local Impact = {}

local function destroyToy(rec)
	rec.done = true
	if rec.model and rec.model.Parent then
		rec.model:Destroy()
	end
end

local Behaviors = {}

function Behaviors.splat(rec, other, speed, pos)
	if speed > 70 and rec.kind == "object" then
		Remotes.get("Fx"):FireAllClients("splat", pos, math.min(speed / 140, 1), { color = rec.key.Color })
		destroyToy(rec)
	end
end

function Behaviors.explosive(rec, other, speed, pos)
	if rec.kind ~= "object" or rec.fuse then
		return
	end
	if speed > 110 then
		rec.fuse = true
		Blasts.explode(pos, 30, 160, rec.thrower)
		destroyToy(rec)
		return
	end
	if speed > 35 then
		rec.fuse = true
		local spark = rec.key:FindFirstChild("Spark", true)
		if spark then
			spark.Enabled = true
		end
		Remotes.get("Fx"):FireAllClients("fuse", pos, 1, nil)
		task.delay(2.0, function()
			if rec.model and rec.model.Parent then
				Blasts.explode(rec.key.Position, 30, 160, rec.thrower)
				destroyToy(rec)
			end
		end)
	end
end

function Behaviors.rocket(rec, other, speed, pos)
	if rec.kind == "object" and speed > 30 and not rec.done then
		Blasts.explode(pos, 26, 145, rec.thrower)
		destroyToy(rec)
	end
end

function Behaviors.sticky(rec, other, speed, pos)
	if rec.kind ~= "object" or rec.stuck or speed < 28 then
		return
	end
	rec.stuck = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = rec.key
	w.Part1 = other
	w.Parent = rec.key
	rec.key.AssemblyLinearVelocity = Vector3.zero
	Remotes.get("Fx"):FireAllClients("splat", pos, 0.5, { color = rec.key.Color })
	task.delay(10, function()
		if w.Parent then
			w:Destroy()
		end
	end)
end

function Behaviors.pinata(rec, other, speed, pos)
	if rec.kind ~= "object" or speed < 26 then
		return
	end
	rec.pinHits = (rec.pinHits or 0) + 1
	local value = 10 + math.floor(speed / 10)
	if rec.pinHits >= 8 then
		Pickups.burst(pos + Vector3.new(0, 2, 0), value * 8, 26)
		Remotes.get("Fx"):FireAllClients("confetti", pos, 1.6, nil)
		destroyToy(rec)
	else
		Pickups.burst(pos + Vector3.new(0, 2, 0), value, 3)
		Remotes.get("Fx"):FireAllClients("confetti", pos, 0.6, nil)
	end
end

function Behaviors.gravity(rec, other, speed, pos)
	if rec.kind ~= "object" or rec.popped or speed < 26 then
		return
	end
	rec.popped = true
	Blasts.bubble(pos + Vector3.new(0, 6, 0), 24, 8.5, rec.thrower)
	destroyToy(rec)
end

function Behaviors.crystal(rec, other, speed, pos)
	if speed > 50 then
		Remotes.get("Fx"):FireAllClients("sparkle", pos, 1, nil)
	end
end

function Behaviors.squeak(rec, other, speed, pos)
	if speed > 24 then
		Remotes.get("Fx"):FireAllClients("squeak", pos, math.min(speed / 100, 1), nil)
	end
end

function Behaviors.bouncy(rec, other, speed, pos)
	if speed > 30 then
		Remotes.get("Fx"):FireAllClients("bounce", pos, math.min(speed / 120, 1), nil)
	end
end

function Behaviors.heavy(rec, other, speed, pos)
	if speed > 65 then
		Remotes.get("Fx"):FireAllClients("thud", pos, math.min(speed / 150, 1), nil)
	end
end

local function onTouch(rec, mine: BasePart, other: BasePart)
	if rec.done or not other.Parent then
		return
	end
	local now = os.clock()
	if now - rec.t0 < 0.08 then
		return
	end
	if rec.model and other:IsDescendantOf(rec.model) then
		return
	end
	if now - rec.lastTouch < 0.08 then
		return
	end
	if other.CollisionGroup == Config.Groups.Held then
		return
	end
	if other:IsDescendantOf(workspace:FindFirstChild("TV_Pickups") or workspace) and other.Name == "Coin" then
		return
	end

	local otherModel, otherPlayer = Physics.characterOf(other)
	-- nao se acerta logo apos arremessar
	if otherModel and rec.thrower and otherPlayer == rec.thrower and now - rec.t0 < 1.4 then
		return
	end

	local otherVel = other.AssemblyLinearVelocity
	local speed = (rec.key.AssemblyLinearVelocity - otherVel).Magnitude
	if speed < 16 then
		return
	end
	rec.lastTouch = now
	local pos = mine.Position

	if speed > 24 and now - rec.lastFx > 0.15 then
		rec.lastFx = now
		Remotes.get("Fx"):FireAllClients("impact", pos, math.min(speed / 150, 1), { mat = other.Material.Name, color = other.Color })
	end

	-- pessoas atingidas
	if otherModel and otherModel ~= rec.model then
		local momentum = rec.mass * speed
		if momentum >= 150 or speed >= 85 then
			if not (otherPlayer and Physics.isProtected(otherPlayer)) then
				local dir = Util.safeUnit(rec.key.AssemblyLinearVelocity, Vector3.yAxis)
				Ragdoll.knock(otherModel, math.clamp(momentum / 180, 1.4, 5))
				Physics.launch(otherModel, dir * math.min(speed * 0.6, 150) + Vector3.new(0, 26, 0))
				if otherPlayer then
					Remotes.get("Struck"):FireClient(otherPlayer, math.min(momentum / 500, 1), dir)
					Remotes.get("Fx"):FireAllClients("oof", pos, 1, nil)
				end
				Scoring.hit(rec.thrower, otherModel, otherPlayer, momentum)
			end
		end
	end

	local fn = Behaviors[rec.behavior]
	if fn then
		fn(rec, other, speed, pos, otherModel)
	end
end

function Impact.begin(rec)
	rec.conns = {}
	rec.lastTouch = 0
	rec.lastFx = 0
	for _, part in rec.parts do
		table.insert(
			rec.conns,
			part.Touched:Connect(function(other)
				onTouch(rec, part, other)
			end)
		)
	end
end

function Impact.finish(rec)
	rec.done = true
	if rec.conns then
		for _, c in rec.conns do
			c:Disconnect()
		end
		rec.conns = nil
	end
end

return Impact
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Physics</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Physics: utilidades de fisica no servidor.
	- Grupos de colisao (objetos segurados nao colidem com jogadores)
	- Dono da fisica (network ownership) de objetos e personagens
	- Lancar alvos (objetos ou personagens)
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Physics = {}

local GROUP_PLAYERS = Config.Groups.Players
local GROUP_HELD = Config.Groups.Held

local function registerGroup(name)
	local ok = pcall(function()
		PhysicsService:RegisterCollisionGroup(name)
	end)
	return ok
end

function Physics.setGroup(inst: Instance, group: string)
	if inst:IsA("BasePart") then
		inst.CollisionGroup = group
	end
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

-- Modelo do personagem de um jogador (ou NPC) a partir de qualquer parte dele
function Physics.characterOf(part: Instance): (Model?, Player?)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			return model, Players:GetPlayerFromCharacter(model)
		end
		local parent = model.Parent
		model = parent and parent:FindFirstAncestorOfClass("Model") or nil
	end
	return nil, nil
end

function Physics.rootOfCharacter(model: Model): BasePart?
	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

-- parte "principal" para segurar: torso (mais estavel) ou HRP
function Physics.holdPartOfCharacter(model: Model): BasePart?
	return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or Physics.rootOfCharacter(model)
end

function Physics.characterMass(model: Model): number
	local total = 0
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			total += d:GetMass()
		end
	end
	return total
end

-- Dono da fisica para todas as partes soltas de um modelo/parte.
-- player = nil devolve para o servidor.
function Physics.setOwner(target: Instance, player: Player?, deep: boolean?)
	local function apply(p: BasePart)
		if p.Anchored then
			return
		end
		pcall(function()
			p:SetNetworkOwner(player)
		end)
	end
	if target:IsA("BasePart") then
		if deep or target.AssemblyRootPart == target then
			apply(target)
		end
	end
	for _, d in target:GetDescendants() do
		if d:IsA("BasePart") and (deep or d.AssemblyRootPart == d) then
			apply(d)
		end
	end
end

function Physics.setOwnerAuto(target: Instance)
	local function apply(p: BasePart)
		if p.Anchored then
			return
		end
		pcall(function()
			p:SetNetworkOwnershipAuto()
		end)
	end
	if target:IsA("BasePart") then
		apply(target)
	end
	for _, d in target:GetDescendants() do
		if d:IsA("BasePart") then
			apply(d)
		end
	end
end

-- Lanca um alvo: parte solta, modelo ou personagem. Personagens de jogadores recebem
-- a velocidade no proprio cliente (ele e o dono da fisica).
function Physics.launch(target: Instance, velocity: Vector3, angular: Vector3?)
	local model, player = nil, nil
	if target:IsA("Model") then
		model = target
	else
		model, player = Physics.characterOf(target)
	end
	if model and model:FindFirstChildOfClass("Humanoid") then
		player = Players:GetPlayerFromCharacter(model)
		if player then
			Remotes.get("Launch"):FireClient(player, velocity)
		end
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.AssemblyLinearVelocity = velocity
				if angular then
					d.AssemblyAngularVelocity = angular
				end
			end
		end
		return
	end
	local function apply(p: BasePart)
		if p.Anchored then
			return
		end
		p.AssemblyLinearVelocity = velocity
		if angular then
			p.AssemblyAngularVelocity = angular
		end
	end
	if target:IsA("BasePart") then
		apply(target.AssemblyRootPart or target)
	else
		for _, d in target:GetDescendants() do
			if d:IsA("BasePart") and d.AssemblyRootPart == d then
				apply(d)
			end
		end
	end
end

-- Impulso (massa * velocidade) num objeto solto: garante que o servidor e o dono.
function Physics.impulse(root: BasePart, impulse: Vector3)
	if root.Anchored then
		return
	end
	if root:GetAttribute("HeldBy") then
		return
	end
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	root:ApplyImpulse(impulse)
end

function Physics.isProtected(player: Player?): boolean
	if not player then
		return false
	end
	if player:GetAttribute("Peaceful") == true then
		return true
	end
	if player:GetAttribute("SafeZone") == true then
		return true
	end
	local shield = player:GetAttribute("ShieldUntil")
	if type(shield) == "number" and shield > workspace:GetServerTimeNow() then
		return true
	end
	local immune = player:GetAttribute("ImmuneUntil")
	if type(immune) == "number" and immune > workspace:GetServerTimeNow() then
		return true
	end
	return false
end

local function hookCharacter(player: Player, character: Model)
	Physics.setGroup(character, GROUP_PLAYERS)
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") and d.CollisionGroup == Config.Groups.Default then
			d.CollisionGroup = GROUP_PLAYERS
		end
	end)
end

-- Cria o personagem (LoadCharacter esta obsoleto; usa a versao nova quando existe)
function Physics.loadCharacter(player: Player)
	local ok = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		pcall(function()
			player:LoadCharacter()
		end)
	end
end

function Physics.init()
	registerGroup(GROUP_PLAYERS)
	registerGroup(GROUP_HELD)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(GROUP_HELD, GROUP_PLAYERS, false)
	end)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(char)
			hookCharacter(player, char)
		end)
		if player.Character then
			hookCharacter(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
end

-- Marca (ou remove) etiqueta de "agarravel" numa parte raiz
function Physics.markGrabbable(root: BasePart, on: boolean)
	if on then
		CollectionService:AddTag(root, Config.Tags.Grabbable)
	else
		CollectionService:RemoveTag(root, Config.Tags.Grabbable)
	end
end

return Physics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Pickups</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Pickups: moedas no mundo. Podem ser jogadas (piñata, alvos) ou fixas (respawn).
	Coletadas por proximidade (um laco a 10 Hz, sem Touched).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Data = require(script.Parent:WaitForChild("Data"))
local Quests = require(script.Parent:WaitForChild("Quests"))

local Pickups = {}

local folder
local coins = {} -- lista de { part, value, born, static, home, respawn }

local GOLD = Color3.fromRGB(255, 205, 50)
local COLLECT_RADIUS = 5.5
local MAGNET_RADIUS = 16

local function makeCoin(position: Vector3, value: number)
	local p = Instance.new("Part")
	p.Name = "Coin"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(0.35, 2.2, 2.2)
	p.Color = GOLD
	p.Material = Enum.Material.Neon
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Anchored = true
	p.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	p.Massless = true
	p:SetAttribute("Value", value)
	CollectionService:AddTag(p, Config.Tags.Spin)
	CollectionService:AddTag(p, Config.Tags.Bob)
	local pl = Instance.new("PointLight")
	pl.Color = GOLD
	pl.Range = 8
	pl.Brightness = 0.8
	pl.Shadows = false
	pl.Parent = p
	p.Parent = folder
	return p
end

-- Moedas que "explodem" para os lados e caem (efeito de recompensa)
function Pickups.burst(position: Vector3, totalValue: number, count: number)
	count = math.clamp(count, 1, 40)
	local each = math.max(1, math.floor(totalValue / count))
	for i = 1, count do
		local p = makeCoin(position, each)
		local angle = (i / count) * math.pi * 2 + math.random() * 0.6
		local speed = 14 + math.random() * 16
		local vel = Vector3.new(math.cos(angle) * speed, 30 + math.random() * 24, math.sin(angle) * speed)
		-- movimento balistico simples no proprio servidor (moeda e leve e curta)
		local rec = { part = p, value = each, born = os.clock(), static = false, vel = vel, pos = position }
		table.insert(coins, rec)
	end
end

-- Moeda fixa no mapa, reaparece depois de coletada
function Pickups.placeStatic(position: Vector3, value: number, respawn: number?)
	local p = makeCoin(position, value)
	p:SetAttribute("Home", position)
	table.insert(coins, {
		part = p,
		value = value,
		born = os.clock(),
		static = true,
		home = position,
		respawn = respawn or 60,
		vel = nil,
	})
end

local function collect(rec, player: Player)
	Data.addCoins(player, rec.value)
	Data.addXP(player, math.max(1, math.floor(rec.value / 3)))
	Quests.report(player, "coin", rec.value)
	Remotes.get("Fx"):FireClient(player, "coin", rec.part.Position, 1, nil)
	if rec.static then
		rec.part.Parent = nil
		rec.hiddenUntil = os.clock() + rec.respawn
	else
		rec.dead = true
		rec.part:Destroy()
	end
end

local GRAV = Vector3.new(0, -196.2 * 0.45, 0) -- moedas caem "leves"

local function step(dt: number)
	local now = os.clock()
	local players = {}
	for _, pl in Players:GetPlayers() do
		local char = pl.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			table.insert(players, { player = pl, pos = hrp.Position })
		end
	end

	local i = 1
	while i <= #coins do
		local rec = coins[i]
		if rec.dead then
			table.remove(coins, i)
		else
			if rec.static and rec.hiddenUntil then
				if now >= rec.hiddenUntil then
					rec.hiddenUntil = nil
					rec.part.Parent = folder
				end
			else
				local part = rec.part
				if not part.Parent then
					table.remove(coins, i)
					continue
				end
				-- voo balistico
				if rec.vel then
					rec.vel += GRAV * dt
					rec.pos += rec.vel * dt
					part.CFrame = CFrame.new(rec.pos) * CFrame.Angles(0, 0, math.pi / 2)
					if rec.vel.Y < 0 then
						local hit = workspace:Raycast(rec.pos + Vector3.new(0, 2, 0), Vector3.new(0, -4, 0))
						if hit then
							rec.pos = hit.Position + Vector3.new(0, 1.4, 0)
							part.CFrame = CFrame.new(rec.pos) * CFrame.Angles(0, 0, math.pi / 2)
							rec.vel = nil
							rec.settled = now
						end
					end
				end
				-- coleta / imã
				local age = now - rec.born
				for _, pp in players do
					local d = (pp.pos - part.Position).Magnitude
					if d < COLLECT_RADIUS and age > 0.5 then
						collect(rec, pp.player)
						break
					elseif d < MAGNET_RADIUS and age > 1.0 and not rec.vel then
						local dir = (pp.pos - part.Position)
						local move = dir.Unit * math.min(dir.Magnitude, 46 * dt)
						part.CFrame = part.CFrame + move
						if rec.pos then
							rec.pos += move
						end
					end
				end
				-- some sozinha depois de um tempo (nao as fixas)
				if not rec.static and age > 60 then
					rec.dead = true
					part:Destroy()
				end
			end
			i += 1
		end
	end
end

function Pickups.init()
	folder = workspace:FindFirstChild("TV_Pickups")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "TV_Pickups"
		folder.Parent = workspace
	end
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.06 then
			step(acc)
			acc = 0
		end
	end)
end

return Pickups
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Quests (servidor): mantem 3 missoes ativas por jogador, conta progresso e paga recompensas.
	Outros modulos chamam Quests.report(jogador, tipo, quantidade).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local QuestDefs = require(Shared:WaitForChild("QuestDefs"))

local Data = require(script.Parent:WaitForChild("Data"))

local Quests = {}

local rng = Random.new()

local function pickNew(data, level: number)
	local slots = data.Quests.slots
	local taken = {}
	for _, s in slots do
		taken[s.id] = true
	end
	local pool = {}
	for _, q in QuestDefs.List do
		if not taken[q.id] and (q.minLevel or 1) <= level then
			table.insert(pool, q)
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[rng:NextInteger(1, #pool)]
end

local function ensure(player: Player)
	local d = Data.get(player)
	if not d then
		return
	end
	if type(d.Quests) ~= "table" then
		d.Quests = { slots = {}, completed = 0 }
	end
	d.Quests.slots = d.Quests.slots or {}
	d.Quests.completed = d.Quests.completed or 0
	-- remove missoes que nao existem mais
	for i = #d.Quests.slots, 1, -1 do
		if not QuestDefs.ById[d.Quests.slots[i].id] then
			table.remove(d.Quests.slots, i)
		end
	end
	while #d.Quests.slots < QuestDefs.SlotCount do
		local q = pickNew(d, d.Level)
		if not q then
			break
		end
		table.insert(d.Quests.slots, { id = q.id, progress = 0 })
	end
	Data.push(player, "Quests")
end

function Quests.report(player: Player, kind: string, amount: number?)
	local d = Data.get(player)
	if not d or type(d.Quests) ~= "table" then
		return
	end
	amount = amount or 1
	local changed = false
	for i = #d.Quests.slots, 1, -1 do
		local s = d.Quests.slots[i]
		local def = QuestDefs.ById[s.id]
		if def and def.kind == kind then
			s.progress = math.min(def.goal, s.progress + amount)
			changed = true
			if s.progress >= def.goal then
				-- concluida!
				d.Quests.completed += 1
				table.remove(d.Quests.slots, i)
				Data.addCoins(player, def.coins, "missão")
				Data.addXP(player, def.xp)
				Remotes.get("Announce"):FireClient(player, "MISSÃO CUMPRIDA!", def.icon .. " " .. def.text, 3, Config.Palette.Green)
				local nq = pickNew(d, d.Level)
				if nq then
					table.insert(d.Quests.slots, { id = nq.id, progress = 0 })
				end
			end
		end
	end
	if changed then
		Data.push(player, "Quests")
	end
end

function Quests.init()
	Data.Loaded:Connect(function(player)
		ensure(player)
	end)
	for _, p in Players:GetPlayers() do
		if Data.isLoaded(p) then
			ensure(p)
		end
	end
	-- missoes de nivel mais alto passam a entrar ao subir de nivel (nas vagas livres)
	Data.LevelUp:Connect(function(player)
		ensure(player)
	end)
end

return Quests
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Ragdoll</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Ragdoll: transforma personagens (R6/R15, jogadores ou NPCs) em bonecos de trapo.
	- Constroi BallSocketConstraints no lugar dos Motor6D (o servidor faz a parte fisica).
	- Avisa o cliente dono do personagem para entrar em estado Physics.
	- Recupera sozinho: depois de parado (e nao segurado) ou quando o tempo maximo acaba.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Physics = require(script.Parent:WaitForChild("Physics"))

local Ragdoll = {}

local states = {} -- [character] = estado

-- limites por junta (graus). Padrao generoso: o objetivo e ficar engracado, nao realista.
local JOINT_LIMITS = {
	Neck = { upper = 50, twist = 40 },
	Waist = { upper = 25, twist = 20 },
	RightShoulder = { upper = 110, twist = 70 },
	LeftShoulder = { upper = 110, twist = 70 },
	["Right Shoulder"] = { upper = 110, twist = 70 },
	["Left Shoulder"] = { upper = 110, twist = 70 },
	RightElbow = { upper = 75, twist = 5 },
	LeftElbow = { upper = 75, twist = 5 },
	RightWrist = { upper = 40, twist = 20 },
	LeftWrist = { upper = 40, twist = 20 },
	RightHip = { upper = 80, twist = 20 },
	LeftHip = { upper = 80, twist = 20 },
	["Right Hip"] = { upper = 80, twist = 20 },
	["Left Hip"] = { upper = 80, twist = 20 },
	RightKnee = { upper = 70, twist = 5 },
	LeftKnee = { upper = 70, twist = 5 },
	RightAnkle = { upper = 30, twist = 10 },
	LeftAnkle = { upper = 30, twist = 10 },
}
local DEFAULT_LIMIT = { upper = 60, twist = 30 }

function Ragdoll.isRagdolled(character: Model): boolean
	return states[character] ~= nil
end

function Ragdoll.isHeld(character: Model): boolean
	local st = states[character]
	return st ~= nil and st.held == true
end

local function tellOwner(character: Model, on: boolean, duration: number?)
	local player = Players:GetPlayerFromCharacter(character)
	if player then
		Remotes.get("RagdollState"):FireClient(player, on, duration or 0)
	end
end

local function build(character: Model, st)
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") and d.Name ~= "RootJoint" and d.Part0 and d.Part1 then
			local limit = JOINT_LIMITS[d.Name] or DEFAULT_LIMIT
			local a0 = Instance.new("Attachment")
			a0.Name = "TV_RagA0"
			a0.CFrame = d.C0
			a0.Parent = d.Part0
			local a1 = Instance.new("Attachment")
			a1.Name = "TV_RagA1"
			a1.CFrame = d.C1
			a1.Parent = d.Part1

			local ball = Instance.new("BallSocketConstraint")
			ball.Name = "TV_RagBall"
			ball.Attachment0 = a0
			ball.Attachment1 = a1
			ball.LimitsEnabled = true
			ball.UpperAngle = limit.upper
			ball.TwistLimitsEnabled = true
			ball.TwistLowerAngle = -limit.twist
			ball.TwistUpperAngle = limit.twist
			ball.Restitution = 0
			ball.Parent = d.Part0

			-- evita membros brigando com o tronco
			local nc = Instance.new("NoCollisionConstraint")
			nc.Name = "TV_RagNC"
			nc.Part0 = d.Part0
			nc.Part1 = d.Part1
			nc.Parent = d.Part0

			d.Enabled = false
			table.insert(st.motors, d)
			table.insert(st.objects, a0)
			table.insert(st.objects, a1)
			table.insert(st.objects, ball)
			table.insert(st.objects, nc)
		end
	end
end

local function restore(character: Model, st)
	for _, obj in st.objects do
		if obj.Parent then
			obj:Destroy()
		end
	end
	for _, m in st.motors do
		if m.Parent then
			m.Enabled = true
		end
	end
end

-- Liga o ragdoll. opts: { duration = s, held = bool }
function Ragdoll.enable(character: Model, opts: { duration: number?, held: boolean? }?)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	opts = opts or {}
	local duration = opts.duration or Config.Ragdoll.MinDuration
	local st = states[character]
	local now = os.clock()
	if st then
		st.minEnd = math.max(st.minEnd, now + duration)
		if opts.held then
			st.held = true
		end
		return true
	end

	st = {
		motors = {},
		objects = {},
		start = now,
		minEnd = now + duration,
		held = opts.held == true,
		rest = 0,
		prevAutoRotate = humanoid.AutoRotate,
	}
	states[character] = st
	character:SetAttribute("Ragdolled", true)
	build(character, st)

	humanoid.AutoRotate = false
	humanoid.PlatformStand = true
	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	end)
	tellOwner(character, true, duration)

	humanoid.Died:Once(function()
		if states[character] then
			-- morreu ragdollado: deixa os membros soltos e limpa o estado
			states[character] = nil
			character:SetAttribute("Ragdolled", nil)
		end
	end)
	return true
end

function Ragdoll.disable(character: Model)
	local st = states[character]
	if not st then
		return
	end
	states[character] = nil
	character:SetAttribute("Ragdolled", nil)

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = Physics.rootOfCharacter(character)
	if humanoid and humanoid.Health > 0 and root then
		-- levanta na vertical, olhando na direcao atual
		local look = Util.flat(root.CFrame.LookVector)
		if look.Magnitude < 0.05 then
			look = Util.flat(root.CFrame.UpVector)
		end
		look = Util.safeUnit(look, Vector3.zAxis)
		local pos = root.Position + Vector3.new(0, 3, 0)
		for _, d in character:GetDescendants() do
			if d:IsA("BasePart") then
				d.AssemblyLinearVelocity = Vector3.zero
				d.AssemblyAngularVelocity = Vector3.zero
			end
		end
		restore(character, st)
		character:PivotTo(CFrame.lookAt(pos, pos + look))
		humanoid.PlatformStand = false
		humanoid.AutoRotate = st.prevAutoRotate ~= false
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	else
		restore(character, st)
	end
	tellOwner(character, false, 0)
end

-- Derruba por um tempo (nao segurado)
function Ragdoll.knock(character: Model, duration: number?)
	return Ragdoll.enable(character, { duration = duration or Config.Ragdoll.MinDuration })
end

function Ragdoll.setHeld(character: Model, held: boolean, extraTime: number?)
	local st = states[character]
	if not st then
		return
	end
	st.held = held
	if not held then
		st.minEnd = math.max(st.minEnd, os.clock() + (extraTime or Config.Ragdoll.MinDuration))
		st.rest = 0
	end
end

local function step(dt: number)
	local now = os.clock()
	for character, st in states do
		if not character.Parent then
			states[character] = nil
		elseif not st.held then
			local root = Physics.rootOfCharacter(character)
			local speed = 0
			if root then
				speed = root.AssemblyLinearVelocity.Magnitude
			end
			if speed < Config.Ragdoll.RestSpeed then
				st.rest += dt
			else
				st.rest = 0
			end
			local resting = st.rest > 0.8
			local age = now - st.start
			if now >= st.minEnd and (resting or age >= Config.Ragdoll.MaxDuration) then
				Ragdoll.disable(character)
			end
		end
	end
end

function Ragdoll.init()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.2 then
			step(acc)
			acc = 0
		end
	end)

	-- o proprio jogador pode pedir para levantar (espaco) depois de um tempo
	Remotes.get("RequestGetUp").OnServerEvent:Connect(function(player)
		local character = player.Character
		local st = character and states[character]
		if not st or st.held then
			return
		end
		if os.clock() - st.start >= Config.Ragdoll.GetUpAfter then
			Ragdoll.disable(character)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local c = player.Character
		if c then
			states[c] = nil
		end
	end)
end

return Ragdoll
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Scoring</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Scoring: recompensas por arremessos longos, acertos em jogadores e combos.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Data = require(script.Parent:WaitForChild("Data"))
local Board = require(script.Parent:WaitForChild("Board"))
local Quests = require(script.Parent:WaitForChild("Quests"))

local Scoring = {}

local combos = {} -- [player] = { count, last }
local hitCooldowns = {} -- [attacker] = { [victimKey] = t }

local function combo(player: Player): number
	local now = os.clock()
	local c = combos[player]
	if c and now - c.last <= Config.Economy.ComboWindow then
		c.count = math.min(Config.Economy.ComboMax, c.count + 1)
		c.last = now
	else
		c = { count = 1, last = now }
		combos[player] = c
	end
	return c.count
end

function Scoring.comboOf(player: Player): number
	local c = combos[player]
	if c and os.clock() - c.last <= Config.Economy.ComboWindow then
		return c.count
	end
	return 0
end

-- Arremesso terminou (objeto parou). bonus: multiplicador (cristal, pessoa...)
function Scoring.throwLanded(player: Player, distance: number, bonus: number?, position: Vector3?, label: string?)
	if not Data.isLoaded(player) then
		return
	end
	local d = Data.get(player)
	local count = combo(player)
	local mult = (1 + 0.15 * (count - 1)) * (bonus or 1)
	local coins = math.floor((distance ^ Config.Economy.DistanceCoinExponent) * Config.Economy.DistanceCoinFactor * mult)
	local xp = math.floor(distance * 0.28 * mult) + 4
	local record = distance > (d.BestThrow or 0)
	Data.addStat(player, "TotalThrows", 1)
	Quests.report(player, "throw", 1)
	if distance >= 150 then
		Quests.report(player, "far", 1)
	end
	if distance >= 300 then
		Quests.report(player, "far300", 1)
	end
	if record then
		Data.set(player, "BestThrow", math.floor(distance))
		Board.submit(player, distance)
		Remotes.get("Announce"):FireClient(
			player,
			"NOVO RECORDE!",
			string.format("%d studs", math.floor(distance)),
			2.6,
			Config.Palette.Pink
		)
	else
		Board.submit(player, distance)
	end
	if coins > 0 then
		Data.addCoins(player, coins)
	end
	Data.addXP(player, xp)
	Remotes.get("ThrowResult"):FireClient(player, math.floor(distance), coins, xp, record, count, label)
	if position then
		Remotes.get("ScorePopup"):FireClient(
			player,
			position + Vector3.new(0, 4, 0),
			string.format("%d studs%s", math.floor(distance), count > 1 and (" ×" .. count) or ""),
			Config.Palette.Accent
		)
	end
end

-- Acertou um jogador/NPC. Retorna true se pontuou (respeita o cooldown por vitima).
function Scoring.hit(attacker: Player?, victimModel: Model, victimPlayer: Player?, magnitude: number?): boolean
	if not attacker or attacker == victimPlayer then
		return false
	end
	-- marca quem acertou por ultimo (usado por "cair do mundo" e arenas)
	victimModel:SetAttribute("LastHitBy", attacker.UserId)
	victimModel:SetAttribute("LastHitTime", os.clock())

	local now = os.clock()
	local cds = hitCooldowns[attacker]
	if not cds then
		cds = {}
		hitCooldowns[attacker] = cds
	end
	local key = victimPlayer and victimPlayer.UserId or victimModel
	local last = cds[key]
	if last and now - last < Config.Economy.HitCooldownPerVictim then
		return false
	end
	cds[key] = now

	if Data.isLoaded(attacker) then
		local count = combo(attacker)
		local coins = math.floor(Config.Economy.HitCoins * (1 + 0.15 * (count - 1)))
		Data.addStat(attacker, "TotalHits", 1)
		Quests.report(attacker, "hit", 1)
		Data.addCoins(attacker, coins)
		Data.addXP(attacker, 8)
		local root = victimModel:FindFirstChild("HumanoidRootPart")
		if root then
			Remotes.get("ScorePopup"):FireClient(attacker, root.Position + Vector3.new(0, 4, 0), "ACERTOU! +" .. coins, Config.Palette.Green)
		end
	end
	return true
end

function Scoring.init()
	game:GetService("Players").PlayerRemoving:Connect(function(p)
		combos[p] = nil
		hitCooldowns[p] = nil
	end)
end

return Scoring
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Shop: compra de brinquedos, cores de cabo e rastros. Tudo com moedas + nivel minimo.
	Chamado pelo cliente via RemoteFunction "Shop": (acao, id) -> ok, mensagem
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Toys = require(Shared:WaitForChild("Toys"))

local Data = require(script.Parent:WaitForChild("Data"))

local Shop = {}

local function findById(list, id)
	for _, item in list do
		if item.id == id then
			return item
		end
	end
	return nil
end

local actions = {}

function actions.buyToy(player, id)
	local toy = Toys.ById[id]
	if not toy then
		return false, "Brinquedo inexistente"
	end
	local d = Data.get(player)
	if toy.price == 0 or d.Toys[id] then
		return false, "Você já tem esse"
	end
	if d.Level < toy.level then
		return false, "Precisa do nível " .. toy.level
	end
	if not Data.spendCoins(player, toy.price) then
		return false, "Moedas insuficientes"
	end
	d.Toys[id] = true
	Data.push(player, "Toys")
	return true, toy.name .. " desbloqueado!"
end

function actions.buyTether(player, id)
	local item = findById(Config.TetherColors, id)
	if not item then
		return false, "Cor inexistente"
	end
	local d = Data.get(player)
	if d.OwnedTethers[id] then
		return false, "Você já tem essa cor"
	end
	if d.Level < item.level then
		return false, "Precisa do nível " .. item.level
	end
	if not Data.spendCoins(player, item.price) then
		return false, "Moedas insuficientes"
	end
	d.OwnedTethers[id] = true
	Data.push(player, "OwnedTethers")
	Data.set(player, "Tether", id)
	return true, item.name .. " equipado!"
end

function actions.equipTether(player, id)
	local d = Data.get(player)
	if not findById(Config.TetherColors, id) or not d.OwnedTethers[id] then
		return false, "Você não tem essa cor"
	end
	Data.set(player, "Tether", id)
	return true, "Cabo trocado"
end

function actions.buyTrail(player, id)
	local item = findById(Config.Trails, id)
	if not item then
		return false, "Rastro inexistente"
	end
	local d = Data.get(player)
	if d.OwnedTrails[id] then
		return false, "Você já tem esse rastro"
	end
	if d.Level < item.level then
		return false, "Precisa do nível " .. item.level
	end
	if not Data.spendCoins(player, item.price) then
		return false, "Moedas insuficientes"
	end
	d.OwnedTrails[id] = true
	Data.push(player, "OwnedTrails")
	Data.set(player, "Trail", id)
	return true, item.name .. " equipado!"
end

function actions.equipTrail(player, id)
	local d = Data.get(player)
	if not findById(Config.Trails, id) or not d.OwnedTrails[id] then
		return false, "Você não tem esse rastro"
	end
	Data.set(player, "Trail", id)
	return true, "Rastro trocado"
end

function Shop.init()
	Remotes.get("Shop").OnServerInvoke = function(player, action, id)
		if type(action) ~= "string" or type(id) ~= "string" then
			return false, "Pedido inválido"
		end
		if not Data.isLoaded(player) then
			return false, "Carregando..."
		end
		local fn = actions[action]
		if not fn then
			return false, "Ação inválida"
		end
		local ok, a, b = pcall(fn, player, id)
		if not ok then
			warn("[Shop] erro:", a)
			return false, "Erro"
		end
		return a, b
	end
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ToyFactory</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	ToyFactory: constroi os modelos dos brinquedos a partir do catalogo (shared/Toys).
	Cada brinquedo e um Model com uma parte "Body" (raiz da montagem, PrimaryPart).
	As demais partes sao decoracao soldada (sem colisao e sem massa, exceto brinquedos pesados).

	Convencao de frente: para brinquedos que voam "para frente" (aviao, peixe, bumerangue)
	a frente e -Z (LookVector). Foguete e dinamite tem eixo X: atributo AlignYaw = 90.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Toys = require(Shared:WaitForChild("Toys"))

local ToyFactory = {}

local GRAVITY = 196.2

local function v3(x, y, z)
	return Vector3.new(x, y, z)
end

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function newPart(name: string, size: Vector3, color: Color3, material: any, shape: any?)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.Shape = shape or Enum.PartType.Block
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = false
	return p
end

-- Decoracao soldada ao corpo. keepMass = conta na massa/colisao (brinquedos pesados).
local function decor(model: Model, body: BasePart, offset: CFrame, p: BasePart, keepMass: boolean?)
	p.CFrame = body.CFrame * offset
	if keepMass then
		p.CanCollide = true
		p.Massless = false
		p.CustomPhysicalProperties = body.CustomPhysicalProperties
	else
		p.CanCollide = false
		p.Massless = true
	end
	p.CanTouch = false
	p.Anchored = false
	p.Parent = model
	local w = Instance.new("WeldConstraint")
	w.Part0 = body
	w.Part1 = p
	w.Parent = p
	return p
end

local function ball(model, body, offset, diameter, color, material, keepMass)
	local p = newPart("Deco", v3(diameter, diameter, diameter), color, material or Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	return decor(model, body, offset, p, keepMass)
end

local function block(model, body, offset, size, color, material, keepMass)
	local p = newPart("Deco", size, color, material or Enum.Material.SmoothPlastic)
	return decor(model, body, offset, p, keepMass)
end

local function cyl(model, body, offset, size, color, material, keepMass)
	local p = newPart("Deco", size, color, material or Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	return decor(model, body, offset, p, keepMass)
end

local function light(parent: Instance, color: Color3, brightness: number, range: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

-- Construtores especificos ----------------------------------------------------------------

local Builders = {}

function Builders.duck(model, body, toy)
	body.Shape = Enum.PartType.Ball
	body.Size = v3(3.2, 3.2, 3.2)
	ball(model, body, CFrame.new(0, 2.0, -0.9), 2.1, toy.color)
	block(model, body, CFrame.new(0, 1.85, -2.05), v3(1.1, 0.4, 1.0), rgb(255, 130, 30))
	ball(model, body, CFrame.new(-0.55, 2.5, -1.75), 0.38, rgb(20, 20, 20))
	ball(model, body, CFrame.new(0.55, 2.5, -1.75), 0.38, rgb(20, 20, 20))
	block(model, body, CFrame.new(0, 0.6, 1.65) * CFrame.Angles(math.rad(-30), 0, 0), v3(1.4, 0.5, 1.2), toy.color)
end

function Builders.balloon(model, body, toy)
	body.Shape = Enum.PartType.Ball
	body.Size = v3(5, 5, 5)
	body.Reflectance = 0.2
	ball(model, body, CFrame.new(0, -2.7, 0), 0.7, toy.color)
	block(model, body, CFrame.new(0, -5.1, 0), v3(0.12, 4.4, 0.12), rgb(240, 240, 240), Enum.Material.Fabric)
	local shine = ball(model, body, CFrame.new(-1.1, 1.3, -1.4), 0.9, rgb(255, 255, 255), Enum.Material.Neon)
	shine.Transparency = 0.6
end

function Builders.plane(model, body, toy)
	body.Size = v3(0.6, 0.6, 4.6)
	block(model, body, CFrame.new(0, 0, 0.4), v3(7, 0.12, 1.9), rgb(120, 190, 255))
	block(model, body, CFrame.new(0, 0.8, 2.0), v3(0.12, 1.3, 1.1), rgb(255, 90, 90))
	block(model, body, CFrame.new(0, 0.1, 2.1), v3(2.6, 0.1, 0.8), rgb(120, 190, 255))
	ball(model, body, CFrame.new(0, 0, -2.4), 0.75, rgb(255, 90, 90))
	body:SetAttribute("AlignMode", "look")
end

function Builders.fish(model, body, toy)
	body.Size = v3(1.6, 2.4, 5)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body
	block(model, body, CFrame.new(0, 0, 3.0), v3(0.25, 2.6, 1.6), rgb(255, 140, 60))
	block(model, body, CFrame.new(0, 1.6, 0.2), v3(0.2, 1.1, 1.8), rgb(255, 140, 60))
	ball(model, body, CFrame.new(-0.7, 0.45, -1.7), 0.5, rgb(255, 255, 255))
	ball(model, body, CFrame.new(0.7, 0.45, -1.7), 0.5, rgb(255, 255, 255))
	ball(model, body, CFrame.new(-0.85, 0.45, -1.85), 0.25, rgb(10, 10, 10))
	ball(model, body, CFrame.new(0.85, 0.45, -1.85), 0.25, rgb(10, 10, 10))
	body:SetAttribute("AlignMode", "look")
end

function Builders.pizza(model, body, toy)
	-- eixo X = para cima (PivotOffset). Coberturas na face +X.
	local spots = {
		v3(0.3, 0.0, 0.0), v3(0.3, 1.3, 0.6), v3(0.3, -1.2, 0.9), v3(0.3, 0.5, -1.4), v3(0.3, -0.9, -1.1), v3(0.3, 1.5, -0.9),
	}
	for _, s in spots do
		cyl(model, body, CFrame.new(s), v3(0.14, 0.95, 0.95), rgb(200, 50, 50))
	end
	cyl(model, body, CFrame.new(0.26, 0, 0), v3(0.1, 4.2, 4.2), rgb(255, 120, 60))
	body:SetAttribute("AlignMode", "flat")
end

function Builders.anvil(model, body, toy)
	body.Size = v3(1.6, 1.4, 3)
	block(model, body, CFrame.new(0, -1.1, 0), v3(3, 0.8, 4.6), toy.color, Enum.Material.Metal, true)
	block(model, body, CFrame.new(0, 1.2, 0), v3(2.6, 1.0, 5), rgb(75, 78, 92), Enum.Material.Metal, true)
	block(model, body, CFrame.new(0, 1.2, -3.0), v3(1.6, 0.9, 1.3), rgb(75, 78, 92), Enum.Material.Metal, true)
end

function Builders.sofa(model, body, toy)
	body.Size = v3(7, 1.4, 3)
	block(model, body, CFrame.new(0, 1.8, -1.1), v3(7, 2.2, 0.8), toy.color, Enum.Material.Fabric, true)
	block(model, body, CFrame.new(-3.05, 0.9, 0), v3(0.9, 2, 3), toy.color, Enum.Material.Fabric, true)
	block(model, body, CFrame.new(3.05, 0.9, 0), v3(0.9, 2, 3), toy.color, Enum.Material.Fabric, true)
	block(model, body, CFrame.new(-1.6, 1.0, 0.2), v3(3.0, 0.6, 2.5), rgb(190, 110, 230), Enum.Material.Fabric)
	block(model, body, CFrame.new(1.6, 1.0, 0.2), v3(3.0, 0.6, 2.5), rgb(190, 110, 230), Enum.Material.Fabric)
	for _, x in { -3.0, 3.0 } do
		for _, z in { -1.1, 1.1 } do
			block(model, body, CFrame.new(x, -1.0, z), v3(0.5, 0.7, 0.5), rgb(70, 45, 30), Enum.Material.WoodPlanks)
		end
	end
end

function Builders.rocket(model, body, toy)
	body.Size = v3(5.6, 2, 2)
	ball(model, body, CFrame.new(2.8, 0, 0), 2, rgb(235, 60, 60), Enum.Material.SmoothPlastic)
	for i = 0, 2 do
		local ang = i * (2 * math.pi / 3)
		block(model, body, CFrame.Angles(ang, 0, 0) * CFrame.new(-2.2, 1.45, 0), v3(1.3, 1.9, 0.18), rgb(235, 60, 60))
	end
	local window = ball(model, body, CFrame.new(0.9, 0.95, 0), 0.9, rgb(90, 225, 255), Enum.Material.Neon)
	window.Transparency = 0.15
	local att = Instance.new("Attachment")
	att.Name = "Exhaust"
	att.CFrame = CFrame.new(-3.0, 0, 0)
	att.Parent = body
	local flame = Instance.new("ParticleEmitter")
	flame.Name = "Flame"
	flame.Enabled = false
	flame.Rate = 90
	flame.Lifetime = NumberRange.new(0.25, 0.5)
	flame.Speed = NumberRange.new(10, 18)
	flame.EmissionDirection = Enum.NormalId.Left
	flame.SpreadAngle = Vector2.new(8, 8)
	flame.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0.1) })
	flame.Color = ColorSequence.new(rgb(255, 230, 120), rgb(255, 80, 20))
	flame.LightEmission = 1
	flame.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	flame.Parent = att
	body:SetAttribute("AlignYaw", 90)
	body:SetAttribute("AlignMode", "look")
end

function Builders.boomerang(model, body, toy)
	body.Size = v3(1.2, 0.4, 1.2)
	local phi = math.rad(40)
	for _, sgn in { -1, 1 } do
		local dir = v3(sgn * math.sin(phi), 0, math.cos(phi))
		local center = dir * 2.3
		local off = CFrame.lookAt(center, center + dir) * CFrame.Angles(0, math.pi / 2, 0)
		block(model, body, off, v3(4.8, 0.4, 1.1), toy.color, Enum.Material.WoodPlanks, true)
		local stripe = block(model, body, off * CFrame.new(0.4, 0.21, 0), v3(1.0, 0.05, 1.12), rgb(255, 255, 255))
		stripe.Material = Enum.Material.SmoothPlastic
	end
	body:SetAttribute("AlignMode", "flatY")
end

function Builders.dynamite(model, body, toy)
	body.Size = v3(4, 1.4, 1.4)
	cyl(model, body, CFrame.new(0, -1.25, 0.72), v3(4, 1.4, 1.4), toy.color)
	cyl(model, body, CFrame.new(0, -1.25, -0.72), v3(4, 1.4, 1.4), toy.color)
	cyl(model, body, CFrame.new(0, -0.5, 0), v3(1.0, 3.3, 3.3), rgb(30, 30, 30), Enum.Material.Fabric)
	cyl(model, body, CFrame.new(2.6, 0.3, 0) * CFrame.Angles(0, 0, math.rad(15)), v3(1.2, 0.2, 0.2), rgb(40, 40, 40))
	local att = Instance.new("Attachment")
	att.Name = "FuseTip"
	att.CFrame = CFrame.new(3.3, 0.6, 0)
	att.Parent = body
	local spark = Instance.new("ParticleEmitter")
	spark.Name = "Spark"
	spark.Enabled = false
	spark.Rate = 60
	spark.Lifetime = NumberRange.new(0.3, 0.6)
	spark.Speed = NumberRange.new(4, 10)
	spark.SpreadAngle = Vector2.new(90, 90)
	spark.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	spark.Color = ColorSequence.new(rgb(255, 240, 150), rgb(255, 120, 30))
	spark.LightEmission = 1
	spark.Parent = att
	body:SetAttribute("AlignYaw", 90)
	body:SetAttribute("AlignMode", "look")
end

function Builders.trampoline(model, body, toy)
	body.Size = v3(1.2, 9, 9)
	body.Color = rgb(35, 38, 50)
	local pad = cyl(model, body, CFrame.new(0.8, 0, 0), v3(0.35, 8.4, 8.4), toy.color)
	pad.Name = "Pad"
	pad.CanCollide = true
	pad.CanTouch = true
	pad.Material = Enum.Material.Fabric
	cyl(model, body, CFrame.new(0.5, 0, 0), v3(0.5, 9.3, 9.3), rgb(255, 120, 60))
	for _, s in { v3(-1.1, 3.6, 0), v3(-1.1, -3.6, 0), v3(-1.1, 0, 3.6), v3(-1.1, 0, -3.6) } do
		block(model, body, CFrame.new(s), v3(1.0, 0.6, 0.6), rgb(35, 38, 50))
	end
end

function Builders.pinata(model, body, toy)
	body.Size = v3(4, 3.4, 5)
	for i, x in { -1.4, 0, 1.4 } do
		local c = (i % 2 == 1) and rgb(255, 220, 60) or rgb(70, 220, 255)
		block(model, body, CFrame.new(x, 0, 0), v3(0.55, 3.5, 5.1), c, Enum.Material.Fabric)
	end
	block(model, body, CFrame.new(0, 1.6, -3.2), v3(2, 2.2, 2.4), toy.color, Enum.Material.Fabric)
	block(model, body, CFrame.new(-0.95, 3.1, -2.6), v3(0.6, 1.3, 0.6), toy.color, Enum.Material.Fabric)
	block(model, body, CFrame.new(0.95, 3.1, -2.6), v3(0.6, 1.3, 0.6), toy.color, Enum.Material.Fabric)
	ball(model, body, CFrame.new(-0.6, 2.2, -4.35), 0.5, rgb(15, 15, 15))
	ball(model, body, CFrame.new(0.6, 2.2, -4.35), 0.5, rgb(15, 15, 15))
	for _, x in { -1.3, 1.3 } do
		for _, z in { -1.7, 1.7 } do
			block(model, body, CFrame.new(x, -2.4, z), v3(0.8, 1.5, 0.8), toy.color, Enum.Material.Fabric)
		end
	end
end

function Builders.magnet(model, body, toy)
	body.Size = v3(5, 1.4, 1.8)
	for _, sgn in { -1, 1 } do
		block(model, body, CFrame.new(sgn * 1.8, -2.4, 0), v3(1.4, 3.4, 1.8), toy.color, Enum.Material.Metal, true)
		block(model, body, CFrame.new(sgn * 1.8, -4.6, 0), v3(1.4, 1.0, 1.8), rgb(215, 220, 230), Enum.Material.Metal, true)
	end
end

function Builders.piano(model, body, toy)
	body.Size = v3(6, 2.2, 7)
	block(model, body, CFrame.new(0, 1.25, -1), v3(6, 0.3, 4.6), rgb(20, 20, 26), nil, true)
	block(model, body, CFrame.new(0, 0.6, 4.1), v3(5.4, 0.25, 1.6), rgb(245, 245, 245), nil, true)
	block(model, body, CFrame.new(0, 0.78, 4.35), v3(5.4, 0.1, 0.8), rgb(20, 20, 20))
	block(model, body, CFrame.new(0, 1.9, 2.4) * CFrame.Angles(math.rad(-20), 0, 0), v3(3, 1.4, 0.15), rgb(30, 30, 38))
	for _, p in { v3(-2.6, -2.3, 3.0), v3(2.6, -2.3, 3.0), v3(0, -2.3, -3.0) } do
		block(model, body, CFrame.new(p), v3(0.6, 2.4, 0.6), rgb(30, 30, 38), nil, true)
	end
end

function Builders.crystal(model, body, toy)
	body.Size = v3(1.6, 4.4, 1.6)
	body.Transparency = 0.2
	local b = block(model, body, CFrame.new(1.0, -0.8, 0.3) * CFrame.Angles(math.rad(10), math.rad(20), math.rad(-28)), v3(1.1, 3.2, 1.1), toy.color, Enum.Material.Neon)
	b.Transparency = 0.25
	local c = block(model, body, CFrame.new(-0.9, -1.0, -0.2) * CFrame.Angles(math.rad(-12), math.rad(60), math.rad(24)), v3(0.9, 2.6, 0.9), toy.color, Enum.Material.Neon)
	c.Transparency = 0.25
	light(body, toy.color, 1.6, 14)
end

function Builders.orb(model, body, toy)
	local shell = ball(model, body, CFrame.new(), 4.2, toy.color, Enum.Material.Glass)
	shell.Transparency = 0.7
	light(body, toy.color, 2, 16)
end

function Builders.barrel(model, body, toy)
	for _, x in { -1.2, 1.2 } do
		cyl(model, body, CFrame.new(x, 0, 0), v3(0.4, 3.35, 3.35), rgb(60, 60, 70), Enum.Material.Metal)
	end
	cyl(model, body, CFrame.new(2.02, 0, 0), v3(0.06, 2.6, 2.6), rgb(150, 55, 40), Enum.Material.Metal)
end

function Builders.crate(model, body, toy)
	for _, y in { -1.35, 1.35 } do
		block(model, body, CFrame.new(0, y, 0), v3(3.1, 0.3, 3.1), rgb(120, 82, 48), Enum.Material.WoodPlanks)
	end
	for _, x in { -1.35, 1.35 } do
		for _, z in { -1.35, 1.35 } do
			block(model, body, CFrame.new(x, 0, z), v3(0.32, 3.1, 0.32), rgb(120, 82, 48), Enum.Material.WoodPlanks)
		end
	end
end

function Builders.ballbands(model, body, toy)
	local d = body.Size.X + 0.06
	for i = 0, 1 do
		local band = cyl(model, body, CFrame.Angles(0, i * math.pi / 2, 0), v3(0.35, d, d), rgb(255, 255, 255))
		band.Material = Enum.Material.SmoothPlastic
	end
end

function Builders.bowling(model, body, toy)
	ball(model, body, CFrame.new(-0.35, 1.3, 0.3), 0.5, rgb(10, 10, 10))
	ball(model, body, CFrame.new(0.35, 1.3, 0.3), 0.5, rgb(10, 10, 10))
	ball(model, body, CFrame.new(0, 1.2, -0.4), 0.5, rgb(10, 10, 10))
end

function Builders.feather(model, body, toy)
	block(model, body, CFrame.new(0, 0, 0), v3(0.12, 7.2, 0.28), rgb(230, 215, 190))
	for i = -3, 3 do
		if i ~= 0 then
			local side = (i % 2 == 0) and 1 or -1
			block(model, body, CFrame.new(side * 0.9, i * 0.85, 0) * CFrame.Angles(0, 0, side * math.rad(-30)), v3(1.8, 0.35, 0.12), toy.color, Enum.Material.Fabric)
		end
	end
end

-- Mapeia id do brinquedo -> construtor extra (quando nao usa toy.build)
local EXTRA = {
	caixa = Builders.crate,
	barril = Builders.barrel,
	bola = Builders.ballbands,
	melancia = Builders.ballbands,
	boliche = Builders.bowling,
	pena = Builders.feather,
	orbe = Builders.orb,
}

-- Constroi o modelo (nao coloca no mundo) ------------------------------------------------

function ToyFactory.build(toyId: string): Model?
	local toy = Toys.ById[toyId]
	if not toy then
		return nil
	end

	local model = Instance.new("Model")
	model.Name = "Toy_" .. toy.id

	local shape = Enum.PartType.Block
	if toy.shape == "Ball" then
		shape = Enum.PartType.Ball
	elseif toy.shape == "Cylinder" then
		shape = Enum.PartType.Cylinder
	end
	local material = Enum.Material[toy.material] or Enum.Material.SmoothPlastic
	local body = newPart("Body", toy.size, toy.color, material, shape)
	body.CustomPhysicalProperties = PhysicalProperties.new(
		toy.density,
		toy.friction,
		toy.elasticity,
		toy.friction < 0.1 and 100 or 1,
		toy.elasticity > 0.6 and 60 or 1
	)
	if toy.transparency then
		body.Transparency = toy.transparency
	end
	body.CanCollide = true
	body.Parent = model
	model.PrimaryPart = body

	if toy.shape == "Cylinder" then
		-- eixo do cilindro (X) fica na vertical quando o modelo e posicionado
		body.PivotOffset = CFrame.Angles(0, 0, -math.pi / 2)
	end

	local builder = toy.build and Builders[toy.build] or EXTRA[toy.id]
	if builder then
		builder(model, body, toy)
	end

	body:SetAttribute("ToyId", toy.id)
	body:SetAttribute("Behavior", toy.behavior)
	return model
end

-- Forcas continuas (flutuar / subir) dependem da massa real -> depois de estar no mundo
local function setupForces(model: Model, toy)
	local body = model.PrimaryPart
	if not body then
		return
	end
	local mass = body.AssemblyMass
	body:SetAttribute("Mass", mass)
	local k = nil
	if toy.behavior == "float" then
		k = 0.86
	elseif toy.behavior == "balloon" then
		k = 1.22
	elseif toy.behavior == "squeak" then
		k = 0 -- so boia na agua (flutuabilidade nativa do terreno); sem forca extra
	end
	if k and k > 0 then
		local att = Instance.new("Attachment")
		att.Name = "LiftAtt"
		att.Parent = body
		local vf = Instance.new("VectorForce")
		vf.Name = "Lift"
		vf.Attachment0 = att
		vf.RelativeTo = Enum.ActuatorRelativeTo.World
		vf.ApplyAtCenterOfMass = true
		vf.Force = v3(0, mass * GRAVITY * k, 0)
		vf.Parent = body
		if toy.behavior == "balloon" then
			-- balao tambem sofre arrasto do ar: sem isso acelera para sempre
			local lv = Instance.new("LinearVelocity")
			lv.Name = "AirCap"
			lv.Attachment0 = att
			lv.RelativeTo = Enum.ActuatorRelativeTo.World
			lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
			lv.VectorVelocity = v3(0, 0, 0)
			lv.MaxAxesForce = v3(mass * 6, 0, mass * 6)
			lv.Parent = body
			body:SetAttribute("Rises", true)
		end
	end
end

-- Cria e coloca no mundo -------------------------------------------------------------------

function ToyFactory.spawn(toyId: string, cf: CFrame, parent: Instance?, ownerUserId: number?): Model?
	local toy = Toys.ById[toyId]
	local model = ToyFactory.build(toyId)
	if not toy or not model then
		return nil
	end
	local body = model.PrimaryPart
	model:PivotTo(cf)
	model.Parent = parent or workspace
	setupForces(model, toy)
	CollectionService:AddTag(body, Config.Tags.Grabbable)
	CollectionService:AddTag(body, Config.Tags.Toy)
	if ownerUserId then
		body:SetAttribute("OwnerUserId", ownerUserId)
	end
	-- o servidor simula os brinquedos soltos (comportamentos consistentes para todos)
	pcall(function()
		body:SetNetworkOwner(nil)
	end)
	return model
end

function ToyFactory.getBody(inst: Instance): BasePart?
	if inst:IsA("Model") then
		return inst.PrimaryPart
	elseif inst:IsA("BasePart") then
		return inst
	end
	return nil
end

return ToyFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">ToyPassive</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	ToyPassive: comportamentos que funcionam o tempo todo (nao so quando arremessado):
	  trampoline  joga para cima quem/o que cair em cima
	  flop        o peixe pula sozinho no chao
	  magnet      o ima puxa objetos de metal por perto
]]

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Physics = require(script.Parent:WaitForChild("Physics"))

local ToyPassive = {}

local flops = {} -- [body] = proximo pulo
local magnets = {} -- [body] = true

local METAL_TOYS = { barril = true, bigorna = true, foguete = true, dinamite = false, ima = false }

local function attachTrampoline(model: Model)
	local body = model.PrimaryPart
	local pad = model:FindFirstChild("Pad")
	if not body or not pad then
		return
	end
	local last = {}
	pad.Touched:Connect(function(other)
		if not other.Parent then
			return
		end
		local normal = body.CFrame.RightVector -- eixo X do corpo = "para cima" do trampolim
		local rel = other.Position - pad.Position
		if rel:Dot(normal) < 0 then
			return
		end
		local now = os.clock()
		local charModel, player = Physics.characterOf(other)
		if charModel then
			if last[charModel] and now - last[charModel] < 0.45 then
				return
			end
			last[charModel] = now
			local root = Physics.rootOfCharacter(charModel)
			if not root then
				return
			end
			local v = root.AssemblyLinearVelocity
			local vy = 105 + math.max(0, -v.Y) * 0.5
			Physics.launch(charModel, Vector3.new(v.X * 0.5, vy, v.Z * 0.5))
			Remotes.get("Fx"):FireAllClients("bounce", pad.Position, 1, nil)
			if player then
				Remotes.get("Struck"):FireClient(player, 0.25, Vector3.yAxis)
			end
		else
			local root = other.AssemblyRootPart or other
			if root.Anchored or root:GetAttribute("HeldBy") or root == body or root:IsDescendantOf(model) then
				return
			end
			if last[root] and now - last[root] < 0.3 then
				return
			end
			last[root] = now
			local v = root.AssemblyLinearVelocity
			if v.Y < 25 then
				pcall(function()
					root:SetNetworkOwner(nil)
				end)
				root.AssemblyLinearVelocity = Vector3.new(v.X * 0.6, 88, v.Z * 0.6)
				Remotes.get("Fx"):FireAllClients("bounce", pad.Position, 0.7, nil)
			end
		end
	end)
end

function ToyPassive.attach(model: Model)
	local body = model.PrimaryPart
	if not body then
		return
	end
	local behavior = body:GetAttribute("Behavior")
	if behavior == "trampoline" then
		attachTrampoline(model)
	elseif behavior == "flop" then
		flops[body] = os.clock() + 2 + math.random() * 3
		body.Destroying:Once(function()
			flops[body] = nil
		end)
	elseif behavior == "magnet" then
		magnets[body] = true
		body.Destroying:Once(function()
			magnets[body] = nil
		end)
	end
end

local function step()
	local now = os.clock()
	for body, at in flops do
		if not body.Parent then
			flops[body] = nil
		elseif now >= at then
			flops[body] = now + 1.5 + math.random() * 3
			if not body:GetAttribute("HeldBy") and not CollectionService:HasTag(body, Config.Tags.Airborne) then
				-- so pula se estiver mais ou menos no chao (parado)
				if body.AssemblyLinearVelocity.Magnitude < 8 then
					local dir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
					dir = Util.safeUnit(dir, Vector3.xAxis)
					Physics.impulse(body, (dir * 22 + Vector3.new(0, 44, 0)) * body.AssemblyMass)
					body.AssemblyAngularVelocity = Util.randomUnit() * 6
				end
			end
		end
	end

	for body in magnets do
		if not body.Parent then
			magnets[body] = nil
		elseif not body:GetAttribute("HeldBy") and body.AssemblyLinearVelocity.Magnitude < 6 then
			local params = OverlapParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { body.Parent }
			for _, part in workspace:GetPartBoundsInRadius(body.Position, 34, params) do
				if not part.Anchored and part.Name == "Body" and part.AssemblyRootPart == part then
					local id = part:GetAttribute("ToyId")
					if id and METAL_TOYS[id] and not part:GetAttribute("HeldBy") then
						local off = body.Position - part.Position
						local d = off.Magnitude
						if d > 5 then
							local pull = Util.saturate(1 - d / 34)
							Physics.impulse(part, off.Unit * part.AssemblyMass * (18 + 40 * pull))
						end
					end
				end
			end
		end
	end
end

function ToyPassive.init()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.2 then
			acc = 0
			step()
		end
	end)
end

return ToyPassive
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">ToySpawner</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	ToySpawner: mantem brinquedos espalhados pelo mundo (com reaparecimento) e permite
	que jogadores invoquem os brinquedos que compraram.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Toys = require(Shared:WaitForChild("Toys"))
local Util = require(Shared:WaitForChild("Util"))

local Data = require(script.Parent:WaitForChild("Data"))
local ToyFactory = require(script.Parent:WaitForChild("ToyFactory"))
local ToyPassive = require(script.Parent:WaitForChild("ToyPassive"))

local ToySpawner = {}

local folder
local slots = {} -- { pos, biome, model, nextSpawn }
local playerToys = {} -- [player] = { model, ... }
local lastSpawn = {} -- [player] = t
local rng = Random.new(Config.World.Seed)

local function placeToy(toyId: string, position: Vector3, ownerUserId: number?): Model?
	local toy = Toys.ById[toyId]
	if not toy then
		return nil
	end
	local lift = math.max(toy.size.X, toy.size.Y, toy.size.Z) * 0.6 + 1
	local cf = CFrame.new(position + Vector3.new(0, lift, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local model = ToyFactory.spawn(toyId, cf, folder, ownerUserId)
	if model then
		ToyPassive.attach(model)
	end
	return model
end

function ToySpawner.addSlot(position: Vector3, biome: string)
	table.insert(slots, { pos = position, biome = biome, model = nil, nextSpawn = 0, idleSince = nil })
end

local function fillSlot(slot)
	local pool = Toys.worldPool(slot.biome)
	if #pool == 0 then
		return
	end
	local toy = Util.weightedPick(pool, function(t)
		return t.world[slot.biome] or 0
	end, rng)
	slot.model = placeToy(toy.id, slot.pos, nil)
	slot.idleSince = nil
end

local function busy(body: BasePart): boolean
	return body:GetAttribute("HeldBy") ~= nil or CollectionService:HasTag(body, Config.Tags.Airborne)
end

local function step()
	local now = os.clock()
	for _, slot in slots do
		local model = slot.model
		if not model or not model.Parent then
			slot.model = nil
			if slot.nextSpawn == 0 then
				slot.nextSpawn = now + 6
			elseif now >= slot.nextSpawn then
				slot.nextSpawn = 0
				fillSlot(slot)
			end
		else
			local body = model.PrimaryPart
			if not body then
				model:Destroy()
			elseif body.Position.Y < Config.World.KillY or body.Position.Y > Config.World.SkyY + 500 then
				model:Destroy()
			elseif body:GetAttribute("Rises") and body.Position.Y > Config.World.SkyY + 220 then
				model:Destroy()
			elseif not busy(body) then
				local far = (body.Position - slot.pos).Magnitude > 140
				if far then
					slot.idleSince = slot.idleSince or now
					if now - slot.idleSince > 50 then
						model:Destroy()
					end
				else
					slot.idleSince = nil
				end
			else
				slot.idleSince = nil
			end
		end
	end

	-- brinquedos de jogadores que sairam do mundo
	for player, list in playerToys do
		for i = #list, 1, -1 do
			local m = list[i]
			if not m.Parent then
				table.remove(list, i)
			elseif m.PrimaryPart and m.PrimaryPart.Position.Y < Config.World.KillY then
				m:Destroy()
				table.remove(list, i)
			end
		end
	end
end

-- Preenche todos os pontos de aparicao de uma vez (fim da geracao do mundo)
function ToySpawner.fillAll()
	local n = 0
	for _, slot in slots do
		if not slot.model then
			fillSlot(slot)
			n += 1
			if n % 20 == 0 then
				task.wait()
			end
		end
	end
end

function ToySpawner.spawnForPlayer(player: Player, toyId: string): (boolean, string)
	if not Data.isLoaded(player) then
		return false, "Carregando..."
	end
	if not Data.ownsToy(player, toyId) then
		return false, "Você ainda não tem esse brinquedo"
	end
	local toy = Toys.ById[toyId]
	if not toy then
		return false, "Brinquedo inválido"
	end
	if toy.level > Data.get(player).Level then
		return false, "Nível " .. toy.level .. " necessário"
	end
	local now = os.clock()
	if lastSpawn[player] and now - lastSpawn[player] < Config.Economy.SpawnToyCooldown then
		return false, "Calma!"
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false, "Sem personagem"
	end
	lastSpawn[player] = now

	local list = playerToys[player]
	if not list then
		list = {}
		playerToys[player] = list
	end
	while #list >= Config.Economy.MaxPlayerToys do
		local old = table.remove(list, 1)
		if old and old.Parent then
			old:Destroy()
		end
	end
	local pos = hrp.Position + hrp.CFrame.LookVector * 9 + Vector3.new(0, 3, 0)
	local model = placeToy(toyId, pos, player.UserId)
	if not model then
		return false, "Erro ao criar"
	end
	table.insert(list, model)
	Remotes.get("Fx"):FireAllClients("spawn", pos, 1, nil)
	return true, toy.name
end

function ToySpawner.despawnFor(player: Player)
	local list = playerToys[player]
	if list then
		for _, m in list do
			if m.Parent then
				m:Destroy()
			end
		end
	end
	playerToys[player] = nil
end

function ToySpawner.spawnAt(toyId: string, position: Vector3): Model?
	return placeToy(toyId, position, nil)
end

function ToySpawner.init()
	folder = workspace:FindFirstChild("TV_Toys")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "TV_Toys"
		folder.Parent = workspace
	end

	Remotes.get("SpawnToy").OnServerEvent:Connect(function(player, toyId)
		if type(toyId) ~= "string" then
			return
		end
		local ok, msg = ToySpawner.spawnForPlayer(player, toyId)
		if not ok then
			Remotes.get("Notify"):FireClient(player, msg, "bad")
		end
	end)
	Remotes.get("DespawnToys").OnServerEvent:Connect(function(player)
		ToySpawner.despawnFor(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		ToySpawner.despawnFor(player)
		lastSpawn[player] = nil
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 2 then
			acc = 0
			step()
		end
	end)
end

function ToySpawner.slotCount(): number
	return #slots
end

return ToySpawner
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Beach</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Beach: a Praia dos Ventos (sul). Deque, farol giratorio, cabanas, guarda-sois, palmeiras,
	navio pirata com bau e canhao, boias e balsa com cama elastica.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Build = require(script.Parent:WaitForChild("Build"))
local Nature = require(script.Parent:WaitForChild("Nature"))
local Hub = require(script.Parent:WaitForChild("Hub"))
local Interactive = require(script.Parent:WaitForChild("Interactive"))

local Beach = {}

local M = Enum.Material
local P = Config.Palette
local SEA = Config.World.SeaLevel
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function pier(folder: Folder, x: number, z0: number, z1: number)
	local m = Build.model(folder, "Pier")
	local y = SEA + 4.2
	local n = math.floor((z1 - z0) / 6)
	for i = 0, n do
		local z = z0 + i * 6
		Build.block(m, CFrame.new(x, y, z), Vector3.new(14, 0.8, 6.2), rgb(176, 128, 88), M.WoodPlanks)
		if i % 2 == 0 then
			for _, sx in { -6.4, 6.4 } do
				Build.cyl(m, CFrame.new(x + sx, y - 6, z), 14, 1.2, rgb(110, 76, 50), M.Wood)
			end
		end
	end
	for i = 0, n, 3 do
		for _, sx in { -7, 7 } do
			Build.lamp(m, Vector3.new(x + sx, y + 0.4, z0 + i * 6), 8, rgb(255, 220, 160))
		end
	end
	-- fim do deque: plataforma redonda com cadeira e boia
	local endZ = z0 + n * 6 + 8
	Build.cyl(m, CFrame.new(x, y, endZ), 0.8, 26, rgb(176, 128, 88), M.WoodPlanks)
	local sign = Build.block(m, CFrame.new(x, y + 9, endZ + 10), Vector3.new(14, 3.4, 0.5), rgb(30, 80, 130), M.SmoothPlastic)
	Build.label(sign, "⚓ DEQUE DOS VENTOS", { color = P.White })
	Beach.pierEnd = Vector3.new(x, y, endZ)
end

local function lighthouse(folder: Folder, x: number, z: number)
	local y = Build.y(x, z)
	local m = Build.model(folder, "Lighthouse")
	Build.foundation(m, CFrame.new(x, y, z), Vector3.new(20, 1, 20), rgb(200, 190, 180), M.Slate)
	local segs = 6
	for i = 0, segs - 1 do
		local d = 11 - i * 0.9
		local c = (i % 2 == 0) and rgb(240, 60, 70) or rgb(250, 250, 255)
		Build.cyl(m, CFrame.new(x, y + 1 + i * 6 + 3, z), 6, d, c, M.SmoothPlastic)
	end
	local topY = y + 1 + segs * 6
	Build.cyl(m, CFrame.new(x, topY + 0.6, z), 1.2, 12, rgb(50, 54, 90), M.Metal)
	local lamp = Build.cyl(m, CFrame.new(x, topY + 3.4, z), 4.4, 5.6, rgb(255, 240, 170), M.Neon, { collide = false, transparency = 0.15 })
	Build.light(lamp, rgb(255, 240, 170), 4, 90, false)
	Build.cyl(m, CFrame.new(x, topY + 6.6, z), 1.6, 8, rgb(240, 60, 70), M.SmoothPlastic)
	Build.ball(m, CFrame.new(x, topY + 8.4, z), 5, rgb(240, 60, 70), M.SmoothPlastic, { collide = false })
	-- feixe giratorio
	local sweep = Build.model(m, "Beam")
	local pivot = Build.block(sweep, CFrame.new(x, topY + 3.4, z), Vector3.one, P.Ink, M.SmoothPlastic, { collide = false, transparency = 1, query = false })
	sweep.PrimaryPart = pivot
	local beam = Build.block(sweep, CFrame.new(x, topY + 3.4, z + 34), Vector3.new(3, 3, 64), rgb(255, 245, 190), M.Neon, { collide = false, transparency = 0.7, shadow = false })
	beam.CanQuery = false
	local beam2 = Build.block(sweep, CFrame.new(x, topY + 3.4, z - 34), Vector3.new(3, 3, 64), rgb(255, 245, 190), M.Neon, { collide = false, transparency = 0.7, shadow = false })
	beam2.CanQuery = false
	Build.spin(sweep, "Y", 45)
	Nature.reserve(x, z, 16)
end

local function umbrella(folder: Folder, pos: Vector3, color: Color3, rng: Random)
	local m = Build.model(folder, "Umbrella")
	local cf = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6.28), math.rad(rng:NextNumber(-8, 8)))
	Build.cyl(m, cf * CFrame.new(0, 5, 0), 10, 0.5, rgb(240, 240, 245), M.Metal)
	local tiers = { { 13, 1 }, { 9.5, 1.3 }, { 5.5, 1.6 } }
	local y = 9.6
	for i, t in tiers do
		Build.cyl(m, cf * CFrame.new(0, y + i * 0.55, 0), t[2], t[1], (i % 2 == 0) and rgb(255, 255, 255) or color, M.Fabric, { collide = false })
	end
	Build.block(m, CFrame.new(pos + Vector3.new(4.4, 0.4, 2)), Vector3.new(4, 0.3, 7), color, M.Fabric, { collide = false })
	m.PrimaryPart = nil
end

local function hut(folder: Folder, x: number, z: number, color: Color3)
	local y = Build.y(x, z)
	local cf = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(0, y, 0))
	local m = Build.model(folder, "Hut")
	Build.foundation(m, cf, Vector3.new(14, 1, 12), rgb(200, 170, 130), M.Wood)
	local body = Build.block(m, cf * CFrame.new(0, 4.5, 0), Vector3.new(12, 8, 10), color, M.WoodPlanks)
	for _, sgn in { -1, 1 } do
		Build.block(m, cf * CFrame.new(sgn * 3.8, 10.4, 0) * CFrame.Angles(0, 0, -sgn * math.rad(34)), Vector3.new(8.4, 1, 12.4), rgb(216, 176, 90), M.Fabric)
	end
	Build.block(m, cf * CFrame.new(0, 3, 5.05), Vector3.new(3, 6, 0.3), rgb(100, 66, 44), M.Wood)
	local win = Build.block(m, cf * CFrame.new(4, 5, 5.05), Vector3.new(2.6, 2.6, 0.3), rgb(170, 226, 255), M.Glass)
	win.Transparency = 0.3
	m.PrimaryPart = body
	Nature.reserve(x, z, 10)
end

local function sandcastle(folder: Folder, x: number, z: number)
	local y = Build.y(x, z)
	local sand = rgb(238, 208, 140)
	local m = Build.model(folder, "Sandcastle")
	local cf = CFrame.new(x, y, z)
	Build.block(m, cf * CFrame.new(0, 2.5, 0), Vector3.new(16, 5, 16), sand, M.Sand)
	for _, sx in { -8, 8 } do
		for _, sz in { -8, 8 } do
			Build.cyl(m, cf * CFrame.new(sx, 5, sz), 10, 4.4, sand, M.Sand)
			Build.cyl(m, cf * CFrame.new(sx, 11, sz), 3, 5.4, rgb(255, 120, 150), M.SmoothPlastic, { collide = false })
		end
	end
	Build.cyl(m, cf * CFrame.new(0, 8, 0), 8, 6, sand, M.Sand)
	local flag = Build.block(m, cf * CFrame.new(1.5, 15, 0), Vector3.new(3, 2, 0.2), P.Red, M.Fabric, { collide = false })
	Build.sway(flag, 12, 1.5)
	Build.block(m, cf * CFrame.new(0, 13, 0), Vector3.new(0.3, 6, 0.3), rgb(230, 230, 240), M.Metal)
	Nature.reserve(x, z, 14)
end

local function ship(folder: Folder, x: number, z: number)
	local m = Build.model(folder, "PirateShip")
	local y = SEA + 3
	local cf = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(-25), math.rad(4))
	local wood = rgb(128, 84, 54)
	local dark = rgb(90, 58, 38)
	-- casco
	local hull = Build.block(m, cf * CFrame.new(0, 0, 0), Vector3.new(20, 9, 56), wood, M.WoodPlanks)
	Build.wedge(m, cf * CFrame.new(0, 0, -32) * CFrame.Angles(0, math.pi, 0), Vector3.new(20, 9, 8), wood, M.WoodPlanks)
	Build.wedge(m, cf * CFrame.new(0, 0, 31.5), Vector3.new(20, 9, 7), wood, M.WoodPlanks)
	Build.block(m, cf * CFrame.new(0, 5, 0), Vector3.new(20.8, 1.2, 56.8), dark, M.Wood, { collide = false })
	-- convés: piso
	Build.block(m, cf * CFrame.new(0, 4.6, 0), Vector3.new(18, 0.8, 54), rgb(190, 146, 100), M.WoodPlanks)
	-- amuradas
	for _, sx in { -9.6, 9.6 } do
		Build.block(m, cf * CFrame.new(sx, 7, 0), Vector3.new(0.8, 4, 54), dark, M.Wood)
	end
	-- mastros e velas
	for i, mz in { -12, 8 } do
		Build.cyl(m, cf * CFrame.new(0, 20, mz), 34, 1.6, dark, M.Wood)
		local sail = Build.block(m, cf * CFrame.new(0, 22 - i * 1.5, mz + 1), Vector3.new(16, 16, 0.6), rgb(250, 244, 232), M.Fabric, { collide = false })
		Build.sway(sail, 4, 3)
		Build.block(m, cf * CFrame.new(0, 29 - i * 1.5, mz + 0.8), Vector3.new(17, 1, 1), dark, M.Wood, { collide = false })
	end
	-- bandeira pirata
	local flag = Build.block(m, cf * CFrame.new(1.6, 38.6, -12), Vector3.new(4, 3, 0.3), rgb(24, 24, 30), M.Fabric, { collide = false })
	Build.sway(flag, 14, 1.4)
	Build.ball(flag, flag.CFrame * CFrame.new(0, 0, 0.2), 1.2, rgb(245, 245, 245), M.SmoothPlastic, { collide = false })
	-- lanternas
	for _, lz in { -22, 20 } do
		local l = Build.ball(m, cf * CFrame.new(0, 8.5, lz), 1.6, rgb(255, 210, 120), M.Neon, { collide = false })
		Build.light(l, rgb(255, 200, 120), 2, 30, false)
	end
	m.PrimaryPart = hull

	local world = cf * CFrame.new(0, 5.5, 18)
	Interactive.chest(folder, world.Position + Vector3.new(0, 0, 0), "Baú do Pirata", 220, 400, rgb(255, 210, 70))
	Beach.shipDeck = (cf * CFrame.new(0, 6, -20)).Position
	Nature.reserve(x, z, 40)
	local pos = (cf * CFrame.new(0, 5.4, -10)).Position
	return pos
end

local function buoys(folder: Folder, rng: Random)
	for i = 1, 16 do
		local x = rng:NextNumber(-260, 260)
		local z = rng:NextNumber(470, 640)
		local m = Build.model(folder, "Buoy")
		local color = (i % 2 == 0) and P.Red or P.Accent
		local b = Build.cyl(m, CFrame.new(x, SEA + 0.6, z), 3.2, 3.4, color, M.SmoothPlastic, { collide = false })
		Build.cyl(m, CFrame.new(x, SEA + 2.6, z), 1.4, 3.42, rgb(255, 255, 255), M.SmoothPlastic, { collide = false })
		Build.ball(m, CFrame.new(x, SEA + 4, z), 1.4, P.Accent2, M.Neon, { collide = false })
		Build.bob(b, 0.5, 2.5 + rng:NextNumber(0, 2))
		m.PrimaryPart = b
	end
end

local function raft(folder: Folder, x: number, z: number)
	local m = Build.model(folder, "Raft")
	local y = SEA + 0.6
	local deck = Build.block(m, CFrame.new(x, y, z), Vector3.new(24, 1.2, 24), rgb(176, 128, 88), M.WoodPlanks)
	for i = -2, 2 do
		Build.cyl(m, CFrame.new(x + i * 5, y - 0.3, z) * CFrame.Angles(math.pi / 2, 0, 0), 24.4, 2.4, rgb(120, 84, 56), M.Wood, { collide = false })
	end
	Hub.jumpPad(m, Vector3.new(x, y + 0.6, z), 125, P.Pink)
	-- flamingo bóia
	local fl = Build.cyl(m, CFrame.new(x + 30, SEA + 0.8, z + 6), 1.6, 7, rgb(255, 130, 180), M.SmoothPlastic, { collide = false })
	Build.ball(m, CFrame.new(x + 30, SEA + 4, z + 6), 2.6, rgb(255, 130, 180), M.SmoothPlastic, { collide = false })
	Build.bob(fl, 0.4, 3)
	Build.billboard(deck, "Balsa Saltitante", { color = P.Accent2, offset = Vector3.new(0, 6, 0) })
end

function Beach.build(rng: Random, addSlot)
	local folder = Build.folder("Beach")
	local c = Config.Biomes.Beach.center

	pier(folder, 20, 392, 520)
	lighthouse(folder, -120, 392)
	hut(folder, -70, 372, rgb(255, 130, 150))
	hut(folder, 100, 372, rgb(120, 210, 255))
	hut(folder, 170, 350, rgb(255, 214, 96))
	sandcastle(folder, -20, 360)
	sandcastle(folder, 240, 380)
	local shipPos = ship(folder, 150, 495)
	buoys(folder, rng)
	raft(folder, -110, 520)
	raft(folder, 200, 600)

	-- canhao do navio: dispara para o mar aberto (recorde de distancia)
	Interactive.cannon(folder, shipPos, Vector3.new(120, SEA + 2, 900), "Canhão Pirata", { angle = 45, color = rgb(50, 50, 60) })
	Interactive.signpost(folder, Vector3.new(60, 0, 340), "🏖️ PRAIA DOS VENTOS", Vector3.new(0, 0, -1))

	-- guarda-sois
	local colors = { P.Red, P.Blue, P.Pink, P.Accent, P.Green, P.Purple }
	local placed = 0
	for _ = 1, 60 do
		if placed >= 16 then
			break
		end
		local x, z = c.X + rng:NextNumber(-230, 230), c.Y + rng:NextNumber(-10, 60)
		local pos, normal, mat = Build.ground(x, z)
		if pos and normal.Y > 0.9 and mat == M.Sand and pos.Y > SEA + 2 then
			umbrella(folder, pos, colors[placed % #colors + 1], rng)
			placed += 1
		end
	end

	Nature.scatter(folder, rng, 80, {
		center = c,
		radius = 260,
		materials = Nature.SAND,
		kinds = { { "palm", 1 } },
		scale = { 1, 1.7 },
		minNormalY = 0.9,
		minY = SEA + 3,
		clearance = 5,
		hubClear = 130,
	})
	Nature.scatter(folder, rng, 40, {
		center = c,
		radius = 240,
		materials = Nature.GRASS,
		kinds = { { "palm", 2 }, { "round", 1 } },
		scale = { 1, 1.6 },
		clearance = 4,
		hubClear = 130,
	})

	for _ = 1, 28 do
		local x, z = c.X + rng:NextNumber(-230, 230), c.Y + rng:NextNumber(-40, 70)
		local pos, normal = Build.ground(x, z)
		if pos and normal.Y > 0.9 and pos.Y > SEA + 2 then
			addSlot(pos, "Beach")
		end
	end
end

return Beach
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Build: ferramentas para montar o cenario com pecas (estilo "mundo de brinquedo":
	formas grossas, cores fortes). Tudo ancorado e dentro de workspace.TV_World.
	Animacoes de cenario sao feitas no CLIENTE por tags (Spin, Bob, Sway, Pulse).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local WorldGen = require(script.Parent:WaitForChild("WorldGen"))

local Build = {}

local Tags = Config.Tags
local rootFolder: Folder
local subFolders = {}
local groundParams: RaycastParams

function Build.init()
	rootFolder = workspace:FindFirstChild("TV_World")
	if rootFolder then
		rootFolder:Destroy()
	end
	rootFolder = Instance.new("Folder")
	rootFolder.Name = "TV_World"
	rootFolder.Parent = workspace

	groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Include
	groundParams.FilterDescendantsInstances = { workspace.Terrain }
	groundParams.IgnoreWater = false
end

function Build.folder(name: string): Folder
	local f = subFolders[name]
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = rootFolder
		subFolders[name] = f
	end
	return f
end

-- Chao ---------------------------------------------------------------------------------------------------

-- Retorna posicao, normal e material do terreno em (x, z). nil se nao acha (ou e agua).
function Build.ground(x: number, z: number, allowWater: boolean?)
	local hit = workspace:Raycast(Vector3.new(x, 700, z), Vector3.new(0, -900, 0), groundParams)
	if not hit then
		return nil
	end
	if hit.Material == Enum.Material.Water and not allowWater then
		return nil
	end
	return hit.Position, hit.Normal, hit.Material
end

-- Raycast para baixo a partir de qualquer ponto (util dentro de cavernas)
function Build.groundFrom(origin: Vector3, dist: number)
	local hit = workspace:Raycast(origin, Vector3.new(0, -dist, 0), groundParams)
	if hit then
		return hit.Position, hit.Normal, hit.Material
	end
	return nil
end

-- Altura do chao (raycast; se falhar usa a funcao de altura)
function Build.y(x: number, z: number): number
	local p = Build.ground(x, z, true)
	if p then
		return p.Y
	end
	return WorldGen.height(x, z)
end

-- Pecas -------------------------------------------------------------------------------------------------------

export type Opts = {
	name: string?,
	transparency: number?,
	reflectance: number?,
	collide: boolean?,
	shadow: boolean?,
	anchored: boolean?,
	query: boolean?,
}

local function finish(p: BasePart, parent: Instance, opts: Opts?)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then
		if opts.name then
			p.Name = opts.name
		end
		if opts.transparency then
			p.Transparency = opts.transparency
		end
		if opts.reflectance then
			p.Reflectance = opts.reflectance
		end
		if opts.collide == false then
			p.CanCollide = false
		end
		if opts.shadow == false then
			p.CastShadow = false
		end
		if opts.anchored == false then
			p.Anchored = false
		end
		if opts.query == false then
			p.CanQuery = false
		end
	end
	p.Parent = parent
	return p
end

function Build.block(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: any, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	return finish(p, parent, opts)
end

-- cilindro com o eixo ao longo do Y local de cf
function Build.cyl(parent: Instance, cf: CFrame, height: number, diameter: number, color: Color3, material: any, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cf * CFrame.Angles(0, 0, math.pi / 2)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	return finish(p, parent, opts)
end

function Build.ball(parent: Instance, cf: CFrame, diameter: number, color: Color3, material: any, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * diameter
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	return finish(p, parent, opts)
end

function Build.wedge(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: any, opts: Opts?): WedgePart
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	return finish(p, parent, opts)
end

function Build.model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Build.tag(inst: Instance, tag: string, attrs: { [string]: any }?)
	CollectionService:AddTag(inst, tag)
	if attrs then
		for k, v in attrs do
			inst:SetAttribute(k, v)
		end
	end
end

-- gira ao redor do eixo local ("X"|"Y"|"Z") em graus/s (animado no cliente)
function Build.spin(inst: Instance, axis: string, degPerSec: number)
	Build.tag(inst, Tags.Spin, { SpinAxis = axis, SpinSpeed = degPerSec })
end

-- flutua para cima e para baixo (amplitude em studs, periodo em s)
function Build.bob(inst: Instance, amp: number, period: number, phase: number?)
	Build.tag(inst, Tags.Bob, { BobAmp = amp, BobPeriod = period, BobPhase = phase or math.random() * 6.28 })
end

function Build.sway(inst: Instance, deg: number, period: number)
	Build.tag(inst, Tags.Sway, { SwayDeg = deg, SwayPeriod = period, SwayPhase = math.random() * 6.28 })
end

function Build.pulse(inst: Instance, minB: number, maxB: number, period: number)
	Build.tag(inst, Tags.Pulse, { PulseMin = minB, PulseMax = maxB, PulsePeriod = period })
end

function Build.light(parent: Instance, color: Color3, brightness: number, range: number, shadows: boolean?): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = shadows == true
	l.Parent = parent
	return l
end

-- Texto num painel (SurfaceGui). face padrao: Front
function Build.label(part: BasePart, text: string, opts: { [string]: any }?)
	opts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = opts.name or "Label"
	gui.Face = opts.face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.ppu or 50
	gui.LightInfluence = opts.lightInfluence or 0
	gui.Brightness = opts.brightness or 1.2
	gui.AlwaysOnTop = false
	gui.Parent = part
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = opts.font or Enum.Font.FredokaOne
	t.Text = text
	t.TextColor3 = opts.color or Color3.new(1, 1, 1)
	t.TextScaled = true
	t.RichText = true
	if opts.stroke ~= false then
		t.TextStrokeTransparency = 0.35
		t.TextStrokeColor3 = opts.strokeColor or Color3.fromRGB(20, 20, 40)
	end
	t.Parent = gui
	return t
end

-- Balao de texto flutuante (BillboardGui)
function Build.billboard(part: BasePart, text: string, opts: { [string]: any }?)
	opts = opts or {}
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = opts.size or UDim2.fromOffset(240, 60)
	gui.StudsOffset = opts.offset or Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = opts.maxDistance or 220
	gui.LightInfluence = 0
	gui.Parent = part
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.Text = text
	t.TextColor3 = opts.color or Color3.new(1, 1, 1)
	t.TextScaled = true
	t.TextStrokeTransparency = 0.3
	t.TextStrokeColor3 = Color3.fromRGB(20, 20, 40)
	t.Parent = gui
	return t
end

-- Base enterrada: evita que construcoes fiquem "voando" em terreno irregular
function Build.foundation(parent: Instance, cf: CFrame, size: Vector3, color: Color3?, material: any)
	local depth = 14
	return Build.block(
		parent,
		cf * CFrame.new(0, -depth / 2 + 0.5, 0),
		Vector3.new(size.X, depth + size.Y, size.Z),
		color or Color3.fromRGB(150, 140, 150),
		material or Enum.Material.Concrete
	)
end

-- Prompt de interacao (tecla E). action: nome lido pelo cliente/servidor
function Build.prompt(part: BasePart, actionText: string, objectText: string, id: string, holdTime: number?): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText
	pp.HoldDuration = holdTime or 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.Style = Enum.ProximityPromptStyle.Default
	pp:SetAttribute("Id", id)
	pp.Parent = part
	CollectionService:AddTag(pp, "TV_Prompt")
	return pp
end

-- Natureza ------------------------------------------------------------------------------------------------------------

local function jitter(c: Color3, rng: Random, amt: number): Color3
	local h, s, v = c:ToHSV()
	return Color3.fromHSV((h + rng:NextNumber(-amt, amt) * 0.15) % 1, s, math.clamp(v + rng:NextNumber(-amt, amt), 0, 1))
end

-- kind: "oak" | "round" | "pine" | "snowpine" | "palm" | "cactus" | "mushroom"
function Build.tree(parent: Instance, pos: Vector3, kind: string, scale: number, rng: Random, tilt: Vector3?)
	local m = Build.model(parent, "Tree_" .. kind)
	local s = scale
	local yaw = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	local trunkColor = Color3.fromRGB(122, 84, 52)
	local rootPart

	if kind == "oak" or kind == "round" then
		local h = 9 * s
		rootPart = Build.cyl(m, yaw * CFrame.new(0, h / 2 - 1, 0), h, 2.2 * s, trunkColor, Enum.Material.Wood)
		local leaf = jitter(Color3.fromRGB(70, 200, 90), rng, 0.1)
		local top = yaw * CFrame.new(0, h + 2.2 * s, 0)
		local b = Build.ball(m, top, 10 * s, leaf, Enum.Material.Grass, { collide = false })
		Build.ball(m, top * CFrame.new(3.2 * s, -1.6 * s, 1 * s), 6.5 * s, jitter(leaf, rng, 0.06), Enum.Material.Grass, { collide = false })
		Build.ball(m, top * CFrame.new(-3 * s, -1.2 * s, -1.6 * s), 6 * s, jitter(leaf, rng, 0.06), Enum.Material.Grass, { collide = false })
		Build.sway(b, 1.6, 4 + rng:NextNumber(0, 2))
	elseif kind == "pine" or kind == "snowpine" then
		local h = 6 * s
		rootPart = Build.cyl(m, yaw * CFrame.new(0, h / 2 - 1, 0), h, 1.8 * s, trunkColor, Enum.Material.Wood)
		local leaf = kind == "snowpine" and Color3.fromRGB(56, 128, 96) or jitter(Color3.fromRGB(46, 150, 84), rng, 0.08)
		local tiers = { { 13, 4 }, { 10, 4 }, { 7, 3.5 }, { 4, 3 } }
		local y = h - 1
		for i, t in tiers do
			local c = leaf
			if kind == "snowpine" and i % 2 == 0 then
				c = Color3.fromRGB(240, 248, 255)
			end
			Build.cyl(m, yaw * CFrame.new(0, y + t[2] / 2, 0), t[2] * s, t[1] * s, c, kind == "snowpine" and (i % 2 == 0 and Enum.Material.Snow or Enum.Material.Grass) or Enum.Material.Grass, { collide = false })
			y += t[2] * 0.72 * s
		end
		Build.ball(m, yaw * CFrame.new(0, y + 1.2 * s, 0), 2.4 * s, kind == "snowpine" and Color3.fromRGB(240, 248, 255) or leaf, Enum.Material.SmoothPlastic, { collide = false })
	elseif kind == "palm" then
		local segs = 5
		local cf = yaw
		local lean = tilt or Vector3.new(0.12, 0, 0.05)
		rootPart = nil
		for i = 1, segs do
			local seg = Build.cyl(m, cf * CFrame.new(0, 1.9 * s, 0), 3.8 * s, (2.0 - i * 0.12) * s, Color3.fromRGB(176, 128, 82), Enum.Material.Wood)
			if not rootPart then
				rootPart = seg
			end
			cf = cf * CFrame.new(0, 3.6 * s, 0) * CFrame.Angles(lean.X, lean.Y, lean.Z)
		end
		local crown = cf * CFrame.new(0, 1 * s, 0)
		for i = 0, 6 do
			local a = i / 7 * math.pi * 2
			local frond = Build.wedge(
				m,
				crown * CFrame.Angles(0, a, math.rad(-28)) * CFrame.new(0, 0, -5 * s),
				Vector3.new(1.2 * s, 0.35, 8 * s),
				Color3.fromRGB(60, 190, 90),
				Enum.Material.Grass,
				{ collide = false }
			)
			if i == 0 then
				Build.sway(frond, 2, 3.4)
			end
		end
		Build.ball(m, crown, 2 * s, Color3.fromRGB(120, 84, 50), Enum.Material.Wood, { collide = false })
		Build.ball(m, crown * CFrame.new(1.1 * s, -0.8 * s, 0), 1.3 * s, Color3.fromRGB(110, 76, 44), Enum.Material.Wood, { collide = false })
	elseif kind == "cactus" then
		local h = 8 * s
		rootPart = Build.cyl(m, yaw * CFrame.new(0, h / 2 - 0.5, 0), h, 2.6 * s, Color3.fromRGB(86, 176, 96), Enum.Material.SmoothPlastic)
		Build.ball(m, yaw * CFrame.new(0, h - 0.5, 0), 2.6 * s, Color3.fromRGB(86, 176, 96), Enum.Material.SmoothPlastic)
		Build.cyl(m, yaw * CFrame.new(2.2 * s, h * 0.55, 0), 3.6 * s, 1.7 * s, Color3.fromRGB(86, 176, 96), Enum.Material.SmoothPlastic, { collide = false })
		Build.cyl(m, yaw * CFrame.new(1.2 * s, h * 0.45, 0) * CFrame.Angles(0, 0, math.rad(90)), 2.4 * s, 1.7 * s, Color3.fromRGB(86, 176, 96), Enum.Material.SmoothPlastic, { collide = false })
		Build.ball(m, yaw * CFrame.new(-0.4 * s, h * 0.9, 1.4 * s), 0.9 * s, Color3.fromRGB(255, 120, 190), Enum.Material.Neon, { collide = false })
	elseif kind == "mushroom" then
		local h = 5 * s
		rootPart = Build.cyl(m, yaw * CFrame.new(0, h / 2 - 0.5, 0), h, 2.4 * s, Color3.fromRGB(245, 240, 225), Enum.Material.SmoothPlastic)
		local cap = Build.ball(m, yaw * CFrame.new(0, h + 0.4 * s, 0), 9 * s, Color3.fromRGB(255, 70, 110), Enum.Material.SmoothPlastic, { collide = false })
		cap.Size = Vector3.new(9 * s, 5.5 * s, 9 * s)
		for i = 1, 5 do
			local a = i * 1.2566
			Build.ball(m, yaw * CFrame.new(math.cos(a) * 2.6 * s, h + 2.4 * s, math.sin(a) * 2.6 * s), 1.3 * s, Color3.fromRGB(255, 250, 240), Enum.Material.SmoothPlastic, { collide = false })
		end
	end
	if rootPart then
		m.PrimaryPart = rootPart
	end
	return m
end

function Build.rock(parent: Instance, pos: Vector3, size: number, color: Color3?, rng: Random)
	local c = color or Color3.fromRGB(128, 122, 140)
	local m = Build.model(parent, "Rock")
	local main = Build.block(m, CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)), Vector3.new(size, size * 0.75, size * 0.9), jitter(c, rng, 0.05), Enum.Material.Slate)
	Build.block(m, main.CFrame * CFrame.new(size * 0.35, -size * 0.1, size * 0.15) * CFrame.Angles(0.3, 0.7, 0.2), Vector3.new(size * 0.6, size * 0.5, size * 0.55), jitter(c, rng, 0.05), Enum.Material.Slate)
	m.PrimaryPart = main
	return m
end

function Build.lamp(parent: Instance, pos: Vector3, height: number?, color: Color3?)
	local h = height or 12
	local m = Build.model(parent, "Lamp")
	local c = color or Color3.fromRGB(255, 226, 150)
	Build.cyl(m, CFrame.new(pos + Vector3.new(0, h / 2, 0)), h, 0.7, Color3.fromRGB(50, 54, 78), Enum.Material.Metal)
	Build.block(m, CFrame.new(pos + Vector3.new(0, h + 0.4, 0)), Vector3.new(1.6, 0.6, 1.6), Color3.fromRGB(50, 54, 78), Enum.Material.Metal)
	local bulb = Build.ball(m, CFrame.new(pos + Vector3.new(0, h + 1.5, 0)), 2.2, c, Enum.Material.Neon, { collide = false })
	Build.light(bulb, c, 1.4, 26, false)
	CollectionService:AddTag(bulb, "TV_Lamp")
	return m
end

-- Casa simples: paredes + telhado de dois planos + porta + janelas
function Build.house(parent: Instance, cf: CFrame, size: Vector3, wall: Color3, roof: Color3, name: string?)
	local m = Build.model(parent, name or "House")
	Build.foundation(m, cf, Vector3.new(size.X + 1, 1, size.Z + 1))
	local body = Build.block(m, cf * CFrame.new(0, size.Y / 2 + 0.5, 0), size, wall, Enum.Material.SmoothPlastic)
	local roofH = size.X * 0.32
	local roofLen = size.Z + 2
	for _, sgn in { -1, 1 } do
		Build.block(
			m,
			cf * CFrame.new(sgn * size.X * 0.27, size.Y + 0.5 + roofH * 0.5, 0) * CFrame.Angles(0, 0, -sgn * math.rad(32)),
			Vector3.new(size.X * 0.66, 1, roofLen),
			roof,
			Enum.Material.SmoothPlastic
		)
	end
	Build.block(m, cf * CFrame.new(0, size.Y * 0.4 + 0.5, size.Z / 2 + 0.05), Vector3.new(size.X * 0.22, size.Y * 0.7, 0.3), Color3.fromRGB(100, 66, 44), Enum.Material.Wood)
	for _, sx in { -1, 1 } do
		local w = Build.block(m, cf * CFrame.new(sx * size.X * 0.3, size.Y * 0.6 + 0.5, size.Z / 2 + 0.05), Vector3.new(size.X * 0.16, size.Y * 0.28, 0.3), Color3.fromRGB(180, 230, 255), Enum.Material.Glass)
		w.Reflectance = 0.2
	end
	m.PrimaryPart = body
	return m
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Cave</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Cave: a Caverna de Cristal (dentro da Montanha Gelada): camara com cristais brilhantes,
	cogumelos luminosos, moedas escondidas e um portal de volta para a praca.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Build = require(script.Parent:WaitForChild("Build"))
local WorldGen = require(script.Parent:WaitForChild("WorldGen"))
local Interactive = require(script.Parent:WaitForChild("Interactive"))
local Pickups = require(script.Parent.Parent:WaitForChild("Pickups"))

local Cave = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function crystalCluster(folder: Folder, pos: Vector3, rng: Random)
	local hue = rng:NextNumber(0.45, 0.9)
	local m = Build.model(folder, "CrystalCluster")
	local n = rng:NextInteger(3, 6)
	for i = 1, n do
		local h = rng:NextNumber(4, 13)
		local color = Color3.fromHSV((hue + rng:NextNumber(-0.05, 0.05)) % 1, 0.55, 1)
		local cf = CFrame.new(pos + Vector3.new(rng:NextNumber(-3, 3), h * 0.4, rng:NextNumber(-3, 3))) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6.28), rng:NextNumber(-0.4, 0.4))
		local c = Build.block(m, cf, Vector3.new(rng:NextNumber(1.2, 2.6), h, rng:NextNumber(1.2, 2.6)), color, M.Neon, { transparency = 0.12, collide = false })
		if i == 1 then
			Build.light(c, color, 3, 36, false)
			Build.pulse(c, 0.5, 2, 2 + rng:NextNumber(0, 3))
		end
	end
	return m
end

local function glowShroom(folder: Folder, pos: Vector3, rng: Random)
	local m = Build.model(folder, "GlowShroom")
	local s = rng:NextNumber(0.8, 1.6)
	Build.cyl(m, CFrame.new(pos + Vector3.new(0, 2 * s, 0)), 4 * s, 1.2 * s, rgb(230, 240, 255), M.SmoothPlastic, { collide = false })
	local cap = Build.ball(m, CFrame.new(pos + Vector3.new(0, 4.3 * s, 0)), 5 * s, rgb(90, 255, 200), M.Neon, { collide = false })
	cap.Size = Vector3.new(5 * s, 2.6 * s, 5 * s)
	Build.light(cap, rgb(90, 255, 200), 1.6, 20, false)
	Build.pulse(cap, 0.5, 2, 3)
end

function Cave.build(rng: Random, addSlot)
	local chamber = WorldGen.Cave.chamber
	if not chamber then
		return
	end
	local folder = Build.folder("Cave")

	-- encontra pontos do chao dentro da camara
	local floorPoints = {}
	for _ = 1, 90 do
		local origin = chamber + Vector3.new(rng:NextNumber(-42, 42), rng:NextNumber(4, 22), rng:NextNumber(-42, 42))
		local pos, normal = Build.groundFrom(origin, 60)
		if pos and (pos - chamber).Magnitude < 60 and normal.Y > 0.6 then
			table.insert(floorPoints, { pos = pos, normal = normal })
		end
	end
	for i, fp in floorPoints do
		if i % 3 == 0 then
			glowShroom(folder, fp.pos, rng)
		else
			crystalCluster(folder, fp.pos, rng)
		end
	end

	-- moedas escondidas e brinquedos raros
	local coins = 0
	for _, fp in floorPoints do
		if coins < 14 and rng:NextNumber() < 0.35 then
			Pickups.placeStatic(fp.pos + Vector3.new(0, 3, 0), 25, 120)
			coins += 1
		end
	end
	local slots = 0
	for _, fp in floorPoints do
		if slots < 8 and rng:NextNumber() < 0.3 then
			addSlot(fp.pos + Vector3.new(0, 1, 0), "Cave")
			slots += 1
		end
	end

	-- luz ambiente da camara
	local lampPart = Build.block(folder, CFrame.new(chamber + Vector3.new(0, 24, 0)), Vector3.one, P.Ink, M.SmoothPlastic, { collide = false, transparency = 1, query = false })
	Build.light(lampPart, rgb(140, 200, 255), 2.4, 120, false)

	-- portal de retorno para a praca
	local center = floorPoints[1] and floorPoints[1].pos or chamber
	local ppos = Build.groundFrom(chamber + Vector3.new(0, 10, 0), 60) or center
	local hubY = Build.y(0, 0)
	Interactive.portal(folder, ppos + Vector3.new(0, 0.6, 0), Vector3.new(0, hubY + 6, 30), "Voltar à Praça", P.Purple)
end

return Cave
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Farm</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Farm: a Fazenda Maluca (oeste). Celeiro, moinho, silo, cercas, animais, plantacoes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Build = require(script.Parent:WaitForChild("Build"))
local Nature = require(script.Parent:WaitForChild("Nature"))

local Farm = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function siteCF(x: number, z: number, faceTo: Vector3?): CFrame
	local y = Build.y(x, z)
	local pos = Vector3.new(x, y, z)
	local target = faceTo or Vector3.new(0, y, 0)
	return CFrame.lookAt(pos, Vector3.new(target.X, y, target.Z))
end

local function barn(folder: Folder, x: number, z: number)
	local cf = siteCF(x, z)
	local m = Build.model(folder, "Barn")
	Build.foundation(m, cf, Vector3.new(28, 1, 24), rgb(150, 130, 120), M.Concrete)
	local red = rgb(200, 52, 52)
	local body = Build.block(m, cf * CFrame.new(0, 8.5, 0), Vector3.new(26, 16, 22), red, M.WoodPlanks)
	-- telhado gambrel (dois planos duplos)
	for _, sgn in { -1, 1 } do
		Build.block(m, cf * CFrame.new(sgn * 8.2, 17.2, 0) * CFrame.Angles(0, 0, -sgn * math.rad(30)), Vector3.new(11, 1.2, 24), rgb(70, 60, 90), M.Slate)
		Build.block(m, cf * CFrame.new(sgn * 3.2, 20.6, 0) * CFrame.Angles(0, 0, -sgn * math.rad(52)), Vector3.new(7, 1.2, 24), rgb(70, 60, 90), M.Slate)
	end
	Build.block(m, cf * CFrame.new(0, 22.2, 0), Vector3.new(2.4, 1.4, 24.4), rgb(50, 44, 70), M.Slate)
	-- porta grande com X branco
	local door = Build.block(m, cf * CFrame.new(0, 6.2, 11.05), Vector3.new(10, 12, 0.4), rgb(240, 236, 230), M.WoodPlanks)
	Build.block(m, cf * CFrame.new(0, 6.2, 11.3), Vector3.new(10, 12, 0.4), red, M.WoodPlanks)
	for _, sgn in { -1, 1 } do
		Build.block(m, cf * CFrame.new(0, 6.2, 11.55) * CFrame.Angles(0, 0, sgn * math.rad(50)), Vector3.new(1, 15, 0.3), rgb(240, 236, 230), M.WoodPlanks)
	end
	Build.block(m, cf * CFrame.new(0, 16.8, 11.1), Vector3.new(6, 5, 0.4), rgb(70, 40, 30), M.Wood)
	local sign = Build.block(m, cf * CFrame.new(0, 23.4, 11.4), Vector3.new(19, 3.4, 0.5), rgb(255, 236, 200), M.SmoothPlastic)
	Build.label(sign, "FAZENDA MALUCA", { color = rgb(190, 48, 48), stroke = false })
	m.PrimaryPart = body
	_ = door
	Nature.reserve(x, z, 24)
end

local function silo(folder: Folder, x: number, z: number)
	local cf = siteCF(x, z)
	local m = Build.model(folder, "Silo")
	Build.foundation(m, cf, Vector3.new(14, 1, 14))
	Build.cyl(m, cf * CFrame.new(0, 13, 0), 26, 12, rgb(196, 200, 214), M.Metal)
	for i = 0, 3 do
		Build.cyl(m, cf * CFrame.new(0, 4 + i * 6, 0), 0.5, 12.4, rgb(120, 126, 150), M.Metal)
	end
	local dome = Build.ball(m, cf * CFrame.new(0, 26, 0), 12, rgb(196, 200, 214), M.Metal, { collide = false })
	dome.Size = Vector3.new(12, 8, 12)
	Nature.reserve(x, z, 10)
end

local function windmill(folder: Folder, x: number, z: number)
	local cf = siteCF(x, z, Vector3.new(0, 0, 0))
	local m = Build.model(folder, "Windmill")
	Build.foundation(m, cf, Vector3.new(16, 1, 16))
	-- torre em degraus
	local heights = { { 14, 5 }, { 12, 5 }, { 10, 5 }, { 8, 5 } }
	local y = 0.5
	for _, t in heights do
		Build.cyl(m, cf * CFrame.new(0, y + t[2] / 2, 0), t[2], t[1], rgb(250, 244, 230), M.SmoothPlastic)
		y += t[2]
	end
	Build.cyl(m, cf * CFrame.new(0, y + 1.5, 0), 3, 9, rgb(190, 60, 60), M.SmoothPlastic)
	Build.cyl(m, cf * CFrame.new(0, y + 4, 0), 2, 4, rgb(190, 60, 60), M.SmoothPlastic)
	-- eixo + pas (giram no cliente ao redor de Z)
	local blades = Build.model(m, "Blades")
	local hubCF = cf * CFrame.new(0, y + 1.5, 5.4)
	local hub = Build.ball(blades, hubCF, 3.2, rgb(90, 60, 50), M.Wood, { collide = false })
	blades.PrimaryPart = hub
	for i = 0, 3 do
		local a = i * math.pi / 2
		local arm = hubCF * CFrame.Angles(0, 0, a) * CFrame.new(0, 8.5, 0.4)
		Build.block(blades, arm, Vector3.new(1, 15, 0.6), rgb(150, 100, 70), M.Wood, { collide = false })
		Build.block(blades, arm * CFrame.new(1.8, 2.2, 0.35), Vector3.new(3, 9, 0.3), rgb(255, 250, 240), M.Fabric, { collide = false })
	end
	Build.spin(blades, "Z", 22)
	Nature.reserve(x, z, 12)
end

local function fenceLine(folder: Folder, a: Vector3, b: Vector3)
	local dir = b - a
	local len = dir.Magnitude
	local n = math.max(2, math.floor(len / 6))
	for i = 0, n do
		local p = a + dir * (i / n)
		local y = Build.y(p.X, p.Z)
		Build.block(folder, CFrame.new(p.X, y + 2, p.Z), Vector3.new(0.8, 4.4, 0.8), rgb(176, 130, 90), M.Wood)
	end
	for _, h in { 1.6, 3.2 } do
		local mid = (a + b) / 2
		local y = Build.y(mid.X, mid.Z)
		Build.block(folder, CFrame.lookAt(Vector3.new(mid.X, y + h, mid.Z), Vector3.new(b.X, y + h, b.Z)), Vector3.new(0.5, 0.5, len), rgb(196, 150, 104), M.Wood)
	end
end

local function pen(folder: Folder, cx: number, cz: number, w: number, d: number)
	local corners = {
		Vector3.new(cx - w / 2, 0, cz - d / 2),
		Vector3.new(cx + w / 2, 0, cz - d / 2),
		Vector3.new(cx + w / 2, 0, cz + d / 2),
		Vector3.new(cx - w / 2, 0, cz + d / 2),
	}
	for i = 1, 4 do
		if i ~= 3 then -- deixa um lado aberto
			fenceLine(folder, corners[i], corners[i % 4 + 1])
		end
	end
	Nature.reserve(cx, cz, math.max(w, d) * 0.7)
end

local function animal(folder: Folder, pos: Vector3, kind: string, rng: Random)
	local m = Build.model(folder, "Animal_" .. kind)
	local yaw = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
	local body, head, spot, legs
	if kind == "pig" then
		body, head, spot, legs = rgb(255, 170, 196), rgb(255, 150, 184), rgb(255, 120, 160), rgb(255, 150, 184)
	else
		body, head, spot, legs = rgb(250, 250, 250), rgb(250, 250, 250), rgb(40, 40, 46), rgb(230, 230, 230)
	end
	local torso = Build.block(m, yaw * CFrame.new(0, 3.4, 0), Vector3.new(3.6, 3, 5.6), body, M.SmoothPlastic)
	Build.block(m, yaw * CFrame.new(0, 4.1, -3.6), Vector3.new(2.8, 2.8, 2.8), head, M.SmoothPlastic, { collide = false })
	Build.block(m, yaw * CFrame.new(0, 3.7, -5.2), Vector3.new(1.6, 1.2, 0.6), kind == "pig" and rgb(255, 120, 150) or rgb(255, 190, 190), M.SmoothPlastic, { collide = false })
	Build.ball(m, yaw * CFrame.new(-0.8, 4.9, -4.9), 0.45, rgb(20, 20, 20), M.SmoothPlastic, { collide = false })
	Build.ball(m, yaw * CFrame.new(0.8, 4.9, -4.9), 0.45, rgb(20, 20, 20), M.SmoothPlastic, { collide = false })
	for _, sx in { -1, 1 } do
		Build.block(m, yaw * CFrame.new(sx * 1.6, 5.9, -3.3), Vector3.new(0.9, 1.3, 0.5), spot, M.SmoothPlastic, { collide = false })
		for _, sz in { -1.9, 1.9 } do
			Build.block(m, yaw * CFrame.new(sx * 1.2, 1.1, sz), Vector3.new(1, 2.2, 1), legs, M.SmoothPlastic)
		end
	end
	if kind == "cow" then
		Build.block(m, yaw * CFrame.new(0.9, 4.2, 0.6), Vector3.new(1.6, 1.4, 1.8), spot, M.SmoothPlastic, { collide = false })
		Build.block(m, yaw * CFrame.new(-1.0, 3.2, 1.6), Vector3.new(1.4, 1.5, 1.4), spot, M.SmoothPlastic, { collide = false })
	end
	m.PrimaryPart = torso
	Build.bob(torso, 0.15, 2 + rng:NextNumber(0, 1.5))
end

local function tractor(folder: Folder, x: number, z: number)
	local cf = siteCF(x, z)
	local m = Build.model(folder, "Tractor")
	local body = Build.block(m, cf * CFrame.new(0, 3.6, 0), Vector3.new(5, 3, 8), rgb(64, 170, 80), M.SmoothPlastic)
	Build.block(m, cf * CFrame.new(0, 6.4, 1.6), Vector3.new(4.4, 3.6, 4), rgb(48, 140, 62), M.SmoothPlastic)
	local glass = Build.block(m, cf * CFrame.new(0, 6.6, 1.65), Vector3.new(4.5, 2.4, 3.2), rgb(190, 235, 255), M.Glass)
	glass.Transparency = 0.4
	for _, sx in { -1, 1 } do
		Build.cyl(m, cf * CFrame.new(sx * 3, 2.6, 2.6) * CFrame.Angles(0, 0, math.pi / 2), 1.6, 5.2, rgb(30, 30, 36), M.Rubber)
		Build.cyl(m, cf * CFrame.new(sx * 2.7, 1.9, -2.6) * CFrame.Angles(0, 0, math.pi / 2), 1.2, 3.6, rgb(30, 30, 36), M.Rubber)
	end
	Build.cyl(m, cf * CFrame.new(0, 5.6, -3.8), 3, 0.5, rgb(90, 90, 100), M.Metal)
	m.PrimaryPart = body
end

local function scarecrow(folder: Folder, pos: Vector3, rng: Random)
	local m = Build.model(folder, "Scarecrow")
	local cf = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
	local post = Build.block(m, cf * CFrame.new(0, 5, 0), Vector3.new(0.7, 10, 0.7), rgb(150, 110, 70), M.Wood)
	Build.block(m, cf * CFrame.new(0, 7, 0), Vector3.new(7, 0.7, 0.7), rgb(150, 110, 70), M.Wood)
	Build.block(m, cf * CFrame.new(0, 6, 0), Vector3.new(2.6, 3.4, 1.4), rgb(70, 110, 200), M.Fabric, { collide = false })
	Build.ball(m, cf * CFrame.new(0, 9.2, 0), 2.6, rgb(245, 200, 120), M.Fabric, { collide = false })
	Build.cyl(m, cf * CFrame.new(0, 10.4, 0), 0.3, 4.2, rgb(90, 60, 40), M.Fabric, { collide = false })
	Build.cyl(m, cf * CFrame.new(0, 11.2, 0), 1.6, 2.4, rgb(90, 60, 40), M.Fabric, { collide = false })
	m.PrimaryPart = post
	Build.sway(post, 3, 3.5)
end

local function hay(folder: Folder, pos: Vector3, rng: Random)
	local cf = CFrame.new(pos + Vector3.new(0, 2.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
	local b = Build.cyl(folder, cf * CFrame.Angles(0, 0, math.pi / 2), 5, 4.4, rgb(232, 196, 90), M.Fabric)
	Build.cyl(folder, cf * CFrame.Angles(0, 0, math.pi / 2), 5.1, 1.4, rgb(200, 160, 60), M.Fabric, { collide = false })
	return b
end

local function pumpkinPatch(folder: Folder, cx: number, cz: number, rng: Random)
	local placed = 0
	for _ = 1, 90 do
		local x = cx + rng:NextNumber(-40, 40)
		local z = cz + rng:NextNumber(-40, 40)
		local pos, normal, mat = Build.ground(x, z)
		if pos and normal.Y > 0.9 and (mat == M.Grass or mat == M.LeafyGrass or mat == M.Ground) then
			local s = rng:NextNumber(2.4, 4.2)
			local p = Build.ball(folder, CFrame.new(pos + Vector3.new(0, s * 0.35, 0)), s, rgb(255, rng:NextInteger(110, 150), 30), M.SmoothPlastic, { collide = false })
			p.Size = Vector3.new(s, s * 0.8, s)
			Build.block(folder, CFrame.new(pos + Vector3.new(0, s * 0.85, 0)), Vector3.new(0.4, 0.8, 0.4), rgb(70, 130, 60), M.Wood, { collide = false })
			placed += 1
		end
	end
	Nature.reserve(cx, cz, 44)
end

local function dock(folder: Folder)
	-- pequeno deque sobre a lagoa
	local lx, lz = -560, -170
	local y = Config.World.SeaLevel + 13.4
	for i = 0, 8 do
		Build.block(folder, CFrame.new(lx + 46 - i * 5, y, lz), Vector3.new(5, 0.6, 7), rgb(170, 122, 84), M.WoodPlanks)
	end
	for i = 0, 4 do
		for _, sz in { -3.4, 3.4 } do
			Build.cyl(folder, CFrame.new(lx + 46 - i * 10, y - 3, lz + sz), 7, 0.8, rgb(120, 84, 56), M.Wood)
		end
	end
end

function Farm.build(rng: Random, addSlot)
	local folder = Build.folder("Farm")
	local c = Config.Biomes.Farm.center

	barn(folder, c.X - 10, c.Y + 34)
	silo(folder, c.X + 22, c.Y + 34)
	windmill(folder, c.X + 60, c.Y - 40)
	tractor(folder, c.X + 40, c.Y + 62)
	pen(folder, c.X - 70, c.Y + 10, 44, 34)
	pen(folder, c.X - 60, c.Y - 60, 38, 30)
	for i = 1, 6 do
		animal(folder, Vector3.new(c.X - 70 + rng:NextNumber(-14, 14), Build.y(c.X - 70, c.Y + 10), c.Y + 10 + rng:NextNumber(-10, 10)), i % 2 == 0 and "pig" or "cow", rng)
	end
	for i = 1, 5 do
		animal(folder, Vector3.new(c.X - 60 + rng:NextNumber(-11, 11), Build.y(c.X - 60, c.Y - 60), c.Y - 60 + rng:NextNumber(-9, 9)), "pig", rng)
	end
	pumpkinPatch(folder, c.X + 20, c.Y - 110, rng)
	pumpkinPatch(folder, c.X - 100, c.Y + 90, rng)
	dock(folder)

	for i = 1, 8 do
		local x, z = c.X + rng:NextNumber(-150, 150), c.Y + rng:NextNumber(-150, 150)
		local pos = Build.ground(x, z)
		if pos then
			scarecrow(folder, pos, rng)
		end
	end
	-- pilha de feno (torre)
	local hx, hz = c.X + 90, c.Y + 30
	local hy = Build.y(hx, hz)
	for row = 0, 3 do
		for col = 0, 3 - row do
			hay(folder, Vector3.new(hx + col * 5.2 + row * 2.6, hy + row * 4.2, hz), rng)
		end
	end
	Nature.reserve(hx + 8, hz, 16)

	-- arvores e pedras
	Nature.scatter(folder, rng, 120, {
		center = c,
		radius = 230,
		materials = Nature.GRASS,
		kinds = { { "oak", 5 }, { "round", 3 } },
		scale = { 0.9, 1.7 },
		clearance = 4,
	})
	Nature.rocks(folder, rng, 24, { center = c, radius = 230, materials = Nature.GRASS, clearance = 3 })

	-- brinquedos espalhados
	for _ = 1, 26 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * 210
		local x, z = c.X + math.cos(a) * r, c.Y + math.sin(a) * r
		local pos = Build.ground(x, z)
		if pos and pos.Y > 4 then
			addSlot(pos, "Farm")
		end
	end
	_ = P
end

return Farm
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Hub</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Hub: a Praca Cosmica (centro do mapa). Zona segura, spawn, monumento, loja,
	caça-moedas, placar de recordes, portoes dos biomas e o elevador de vento para a Arena.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Build = require(script.Parent:WaitForChild("Build"))
local WorldGen = require(script.Parent:WaitForChild("WorldGen"))
local Server = script.Parent.Parent
local Data = require(Server:WaitForChild("Data"))
local Board = require(Server:WaitForChild("Board"))
local Pickups = require(Server:WaitForChild("Pickups"))

local Hub = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local P = Config.Palette
local M = Enum.Material

-- Plaza em aneis -----------------------------------------------------------------------------------

local function plaza(folder: Folder, gy: number)
	local c = CFrame.new(0, gy, 0)
	Build.cyl(folder, c * CFrame.new(0, -0.9, 0), 4.6, 132, rgb(226, 218, 240), M.Marble, { name = "PlazaOuter" })
	Build.cyl(folder, c * CFrame.new(0, -0.55, 0), 4.6, 108, rgb(255, 240, 214), M.Marble, { name = "PlazaMid" })
	Build.cyl(folder, c * CFrame.new(0, -0.2, 0), 4.6, 76, rgb(142, 226, 214), M.Marble, { name = "PlazaInner" })
	-- anel de neon na borda do miolo
	Build.cyl(folder, c * CFrame.new(0, 2.15, 0), 0.25, 76.5, P.Accent, M.Neon, { collide = false, name = "PlazaRim" })
	Build.cyl(folder, c * CFrame.new(0, 2.15, 0), 0.26, 74, rgb(142, 226, 214), M.Marble, { collide = false })

	-- rosa dos ventos no chao: 8 raios de neon
	for i = 0, 7 do
		local a = i * math.pi / 4
		local len = (i % 2 == 0) and 34 or 22
		Build.block(
			folder,
			c * CFrame.Angles(0, a, 0) * CFrame.new(0, 2.2, -(len / 2 + 8)),
			Vector3.new(1.6, 0.2, len),
			(i % 2 == 0) and P.Pink or P.Blue,
			M.Neon,
			{ collide = false, shadow = false }
		)
	end
	-- pontinhos de neon em circulo
	for i = 0, 35 do
		local a = i / 36 * math.pi * 2
		Build.ball(folder, c * CFrame.new(math.cos(a) * 52, 2.4, math.sin(a) * 52), 1.4, P.Accent2, M.Neon, { collide = false, shadow = false })
	end
end

-- Monumento central ------------------------------------------------------------------------------------

local function monument(folder: Folder, gy: number)
	local m = Build.model(folder, "Monument")
	local base = CFrame.new(0, gy + 2, 0)
	Build.cyl(m, base * CFrame.new(0, 1, 0), 2, 22, rgb(200, 190, 230), M.Marble)
	Build.cyl(m, base * CFrame.new(0, 3, 0), 2, 16, rgb(160, 150, 210), M.Marble)
	Build.cyl(m, base * CFrame.new(0, 12, 0), 18, 4.6, rgb(120, 110, 190), M.Marble)
	-- cristal flutuante
	local crystal = Build.ball(m, base * CFrame.new(0, 27, 0), 9, P.Purple, M.Neon, { collide = false, name = "Crystal" })
	crystal.Transparency = 0.1
	Build.light(crystal, P.Purple, 3, 60, false)
	Build.bob(crystal, 1.6, 4)
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Rate = 18
	sparkles.Lifetime = NumberRange.new(1.5, 3)
	sparkles.Speed = NumberRange.new(2, 6)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Color = ColorSequence.new(P.Accent2, P.Pink)
	sparkles.Parent = crystal

	-- aneis de esferas orbitando (giram no cliente)
	for ringIdx = 1, 3 do
		local orbit = Build.model(m, "Orbit" .. ringIdx)
		local pivot = Build.block(orbit, base * CFrame.new(0, 27, 0), Vector3.one, P.Ink, M.SmoothPlastic, { collide = false, transparency = 1, query = false })
		orbit.PrimaryPart = pivot
		local n = 5 + ringIdx * 2
		local radius = 8 + ringIdx * 3.2
		for i = 1, n do
			local a = i / n * math.pi * 2
			local color = Color3.fromHSV((i / n + ringIdx * 0.2) % 1, 0.7, 1)
			Build.ball(orbit, pivot.CFrame * CFrame.new(math.cos(a) * radius, math.sin(a * 2) * 1.2, math.sin(a) * radius), 1.8 + ringIdx * 0.3, color, M.Neon, { collide = false, shadow = false })
		end
		Build.spin(orbit, "Y", (ringIdx % 2 == 0 and -1 or 1) * (18 + ringIdx * 9))
	end
	-- placa
	local plaque = Build.block(m, base * CFrame.new(0, 3.2, 9.05), Vector3.new(9, 2.6, 0.4), rgb(40, 36, 80), M.SmoothPlastic)
	Build.label(plaque, "TUDO VOA!", { color = P.Accent })
end

-- Postes, bancos, canteiros ------------------------------------------------------------------------------------

local function decoration(folder: Folder, gy: number, rng: Random)
	for i = 0, 7 do
		local a = (i + 0.5) / 8 * math.pi * 2
		Build.lamp(folder, Vector3.new(math.cos(a) * 60, gy + 1.4, math.sin(a) * 60), 13, (i % 2 == 0) and rgb(255, 226, 150) or rgb(170, 240, 255))
	end
	-- bancos entre os postes
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local cf = CFrame.new(math.cos(a) * 58, gy + 2.2, math.sin(a) * 58) * CFrame.Angles(0, -a + math.pi / 2, 0)
		local m = Build.model(folder, "Bench")
		Build.block(m, cf * CFrame.new(0, 0.9, 0), Vector3.new(7, 0.6, 2.2), rgb(190, 130, 80), M.Wood)
		Build.block(m, cf * CFrame.new(0, 2.1, -0.9), Vector3.new(7, 1.6, 0.4), rgb(190, 130, 80), M.Wood)
		for _, x in { -3, 3 } do
			Build.block(m, cf * CFrame.new(x, 0.3, 0), Vector3.new(0.5, 1.2, 2), rgb(60, 60, 84), M.Metal)
		end
	end
	-- canteiros de flores (circulos de bolas coloridas)
	for i = 0, 3 do
		local a = (i + 0.5) / 4 * math.pi * 2 + math.pi / 8
		local cx, cz = math.cos(a) * 40, math.sin(a) * 40
		Build.cyl(folder, CFrame.new(cx, gy + 2.6, cz), 1.2, 12, rgb(120, 90, 70), M.Slate)
		for k = 1, 9 do
			local aa = k / 9 * math.pi * 2
			local color = Color3.fromHSV(rng:NextNumber(0, 1), 0.65, 1)
			local f = Build.ball(folder, CFrame.new(cx + math.cos(aa) * 3.6, gy + 3.6, cz + math.sin(aa) * 3.6), 1.8, color, M.SmoothPlastic, { collide = false })
			Build.sway(f, 6, 2.5)
		end
		Build.ball(folder, CFrame.new(cx, gy + 4, cz), 3, rgb(255, 230, 90), M.SmoothPlastic, { collide = false })
	end
end

-- Loja de brinquedos -------------------------------------------------------------------------------------------------

local function shop(folder: Folder, gy: number)
	local pos = Vector3.new(-56, gy, 44)
	local cf = CFrame.lookAt(pos, Vector3.new(0, gy, 0))
	local m = Build.house(folder, cf, Vector3.new(24, 12, 16), rgb(255, 150, 200), rgb(255, 210, 80), "ToyShop")
	-- toldo listrado
	for i = -3, 3 do
		local c = (i % 2 == 0) and rgb(255, 255, 255) or rgb(255, 70, 110)
		Build.block(m, cf * CFrame.new(i * 3.4, 8.2, 11) * CFrame.Angles(math.rad(-22), 0, 0), Vector3.new(3.4, 0.5, 6), c, M.Fabric)
	end
	local sign = Build.block(m, cf * CFrame.new(0, 15.6, 8.2), Vector3.new(22, 4, 0.6), rgb(50, 40, 110), M.SmoothPlastic)
	Build.label(sign, "🧸 LOJA DE BRINQUEDOS", { color = P.Accent })
	-- balcao e prompt
	local counter = Build.block(m, cf * CFrame.new(0, 2.6, 10.2), Vector3.new(12, 2.2, 2.2), rgb(150, 100, 70), M.Wood)
	Build.prompt(counter, "Abrir loja", "Loja de Brinquedos", "shop")
	-- vitrine com brinquedos giratorios
	for i, color in { P.Pink, P.Blue, P.Green } do
		local b = Build.ball(m, cf * CFrame.new((i - 2) * 6, 5.5, 10.4), 2.4, color, M.Neon, { collide = false })
		Build.bob(b, 0.4, 2 + i * 0.4)
	end
end

-- Cata-moedas (slot machine) -------------------------------------------------------------------------------------------------

local function slotMachine(folder: Folder, gy: number)
	local pos = Vector3.new(56, gy, 40)
	local cf = CFrame.lookAt(pos, Vector3.new(0, gy, 0))
	local m = Build.model(folder, "SlotMachine")
	Build.foundation(m, cf, Vector3.new(9, 1, 7))
	local body = Build.block(m, cf * CFrame.new(0, 6.5, 0), Vector3.new(8, 12, 5), rgb(220, 50, 70), M.SmoothPlastic)
	Build.block(m, cf * CFrame.new(0, 12.8, 0), Vector3.new(9, 1.6, 6), P.Accent, M.Neon, { collide = false })
	local screen = Build.block(m, cf * CFrame.new(0, 8, 2.55), Vector3.new(6, 4, 0.3), rgb(20, 24, 50), M.SmoothPlastic)
	Build.label(screen, "🪙 🍒 💎", { color = P.White })
	local head = Build.block(m, cf * CFrame.new(0, 12.3, 2.6), Vector3.new(7.2, 1.6, 0.3), rgb(255, 230, 90), M.Neon, { collide = false })
	Build.label(head, "CAÇA-MOEDAS", { color = rgb(120, 20, 40), stroke = false })
	-- alavanca
	local lever = Build.cyl(m, cf * CFrame.new(4.9, 9, 0) * CFrame.Angles(0, 0, math.rad(-20)), 5, 0.6, rgb(200, 200, 210), M.Metal)
	Build.ball(m, cf * CFrame.new(5.6, 11.4, 0), 1.8, P.Red, M.SmoothPlastic, { collide = false })
	Build.light(head, P.Accent, 1.5, 24, false)
	Build.pulse(head, 0.8, 2.6, 1.2)
	local pp = Build.prompt(body, "Puxar alavanca", "Caça-moedas (a cada 15 min)", "slot", 0.3)
	pp.MaxActivationDistance = 14

	pp.Triggered:Connect(function(player)
		if not Data.isLoaded(player) then
			return
		end
		local d = Data.get(player)
		local remaining = (d.LastSlot + Config.Economy.SlotCooldown) - os.time()
		if remaining > 0 then
			Remotes.get("Notify"):FireClient(player, string.format("O caça-moedas recarrega em %s", Util.formatTime(remaining)), "bad")
			return
		end
		Data.set(player, "LastSlot", os.time())
		local base = math.random(Config.Economy.SlotMin, Config.Economy.SlotMax)
		local coins = math.floor(base * (1 + d.Level * 0.06))
		Pickups.burst(lever.Position + Vector3.new(0, 4, 0), coins, math.clamp(coins // 10, 6, 24))
		Remotes.get("Fx"):FireAllClients("confetti", lever.Position + Vector3.new(0, 4, 0), 1.2, nil)
		Remotes.get("Announce"):FireClient(player, "JACKPOT!", coins .. " moedas caíram!", 2.2, P.Accent)
	end)
end

-- Placar de recordes -----------------------------------------------------------------------------------------------------------------

local function leaderboard(folder: Folder, gy: number)
	local pos = Vector3.new(0, gy, -84)
	local cf = CFrame.lookAt(pos, Vector3.new(0, gy, 0))
	local m = Build.model(folder, "Leaderboard")
	Build.foundation(m, cf, Vector3.new(34, 1, 5))
	for _, x in { -15, 15 } do
		Build.block(m, cf * CFrame.new(x, 9, 0), Vector3.new(2, 18, 2), rgb(60, 56, 110), M.Metal)
	end
	local panel = Build.block(m, cf * CFrame.new(0, 13, 0), Vector3.new(32, 18, 1), rgb(24, 26, 56), M.SmoothPlastic)
	Build.block(m, cf * CFrame.new(0, 13, 0.15), Vector3.new(33, 19, 0.8), P.Accent, M.Neon, { collide = false, shadow = false }).Transparency = 0.6

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 90)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = P.Accent
	title.Text = "🏆 MAIORES ARREMESSOS"
	title.Parent = gui

	local rows = {}
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.BackgroundTransparency = 1
		row.Position = UDim2.new(0, 60, 0, 100 + (i - 1) * 60)
		row.Size = UDim2.new(1, -120, 0, 56)
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = (i == 1) and P.Accent or ((i <= 3) and P.Accent2 or P.White)
		row.Text = ""
		row.Parent = gui
		rows[i] = row
	end

	local function refresh()
		local top = Board.top()
		for i = 1, 10 do
			local e = top[i]
			if e then
				rows[i].Text = string.format("%d.  %s  —  %d studs", i, e.name, e.value)
			else
				rows[i].Text = string.format("%d.  ---", i)
			end
		end
	end
	refresh()
	Board.Changed:Connect(function()
		task.delay(1, refresh)
	end)
	task.spawn(function()
		while true do
			task.wait(45)
			refresh()
		end
	end)
end

-- Portoes dos biomas ------------------------------------------------------------------------------------------------------------------------

local function gates(folder: Folder)
	for key, b in Config.Biomes do
		if key ~= "Hub" then
			local dir = Vector3.new(b.center.X, 0, b.center.Y).Unit
			local flat = dir * 112
			local y = Build.y(flat.X, flat.Z)
			local origin = Vector3.new(flat.X, y, flat.Z)
			local cf = CFrame.lookAt(origin, origin + dir)
			local m = Build.model(folder, "Gate_" .. key)
			for _, x in { -11, 11 } do
				Build.foundation(m, cf * CFrame.new(x, 0, 0), Vector3.new(4, 1, 4))
				Build.block(m, cf * CFrame.new(x, 8, 0), Vector3.new(3.4, 16, 3.4), rgb(100, 90, 170), M.Marble)
				local orb = Build.ball(m, cf * CFrame.new(x, 17.6, 0), 3.4, P.Accent2, M.Neon, { collide = false })
				Build.light(orb, P.Accent2, 1.6, 22, false)
				Build.bob(orb, 0.5, 3)
			end
			local beam = Build.block(m, cf * CFrame.new(0, 16.2, 0), Vector3.new(26, 4.4, 2), rgb(60, 54, 120), M.SmoothPlastic)
			Build.label(beam, b.icon .. " " .. string.upper(b.name), { color = P.Accent, face = Enum.NormalId.Front })
			Build.label(beam, "PRAÇA CÓSMICA", { color = P.Accent2, face = Enum.NormalId.Back })
		end
	end
end

-- Elevador de vento para a Arena (ilha flutuante sobre a praca) --------------------------------------------------------------------------------

function Hub.windTube(folder: Folder, x: number, z: number, topY: number, name: string, color: Color3?)
	local baseY = Build.y(x, z)
	local height = topY - baseY
	local c = color or P.Accent2
	local m = Build.model(folder, "Wind_" .. name)
	-- base luminosa
	Build.cyl(m, CFrame.new(x, baseY + 0.4, z), 1.2, 22, rgb(50, 60, 110), M.Metal)
	Build.cyl(m, CFrame.new(x, baseY + 1.1, z), 0.3, 18, c, M.Neon, { collide = false, shadow = false })
	-- tubo translucido (zona de vento)
	local tube = Build.cyl(m, CFrame.new(x, baseY + height / 2, z), height, 16, c, M.Neon, { collide = false, transparency = 0.86, shadow = false, name = "WindZone" })
	tube.CanQuery = false
	Build.tag(tube, "TV_Wind", { Speed = 78, Top = topY, Radius = 8.5 })
	-- particulas subindo
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, -height / 2, 0)
	att.Parent = tube
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 40
	pe.Lifetime = NumberRange.new(3, 5)
	pe.Speed = NumberRange.new(38, 60)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.SpreadAngle = Vector2.new(4, 4)
	pe.Shape = Enum.ParticleEmitterShape.Cylinder
	pe.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0.2) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Color = ColorSequence.new(c, Color3.new(1, 1, 1))
	pe.LightEmission = 1
	pe.Parent = att
	local label = Build.block(m, CFrame.new(x, baseY + 9, z), Vector3.one, P.Ink, M.SmoothPlastic, { collide = false, transparency = 1, query = false })
	Build.billboard(label, "⬆ " .. name, { size = UDim2.fromOffset(260, 46), color = c, offset = Vector3.new(0, 4, 0) })
	return m
end

-- Trampolins de chao (jump pads) --------------------------------------------------------------------------------------------------------------------

function Hub.jumpPad(folder: Folder, pos: Vector3, power: number, color: Color3?, dirVec: Vector3?)
	local c = color or P.Pink
	local m = Build.model(folder, "JumpPad")
	Build.cyl(m, CFrame.new(pos + Vector3.new(0, 0.5, 0)), 1, 9, rgb(50, 56, 100), M.Metal)
	local pad = Build.cyl(m, CFrame.new(pos + Vector3.new(0, 1.1, 0)), 0.4, 7.4, c, M.Neon, { name = "PadTop" })
	Build.tag(pad, "TV_JumpPad", { Power = power, DirX = dirVec and dirVec.X or 0, DirY = dirVec and dirVec.Y or 1, DirZ = dirVec and dirVec.Z or 0 })
	Build.pulse(pad, 0.7, 2.2, 1.3)
	return pad
end

-- Spawn ------------------------------------------------------------------------------------------------------------------------------------------------

local function spawns(gy: number)
	local folder = Build.folder("Spawns")
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + 0.3
		local s = Instance.new("SpawnLocation")
		s.Name = "Spawn" .. i
		s.Anchored = true
		s.CanCollide = false
		s.Neutral = true
		s.Duration = 0
		s.Transparency = 1
		s.Size = Vector3.new(6, 1, 6)
		s.CFrame = CFrame.new(math.cos(a) * 26, gy + 2.6, math.sin(a) * 26)
		s.Parent = folder
	end
end

-- Arvores em volta da praca -------------------------------------------------------------------------------------------------------------------------------

local function trees(folder: Folder, rng: Random)
	for _ = 1, 70 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(74, 118)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if WorldGen.roadDistance(x, z) > 14 then
			local pos = Build.ground(x, z)
			if pos then
				Build.tree(folder, pos, (rng:NextNumber() < 0.7) and "oak" or "round", rng:NextNumber(0.9, 1.5), rng)
			end
		end
	end
end

function Hub.build()
	local folder = Build.folder("Hub")
	local rng = Random.new(Config.World.Seed + 1)
	local gy = Build.y(0, 0)

	plaza(folder, gy)
	monument(folder, gy)
	decoration(folder, gy, rng)
	shop(folder, gy)
	slotMachine(folder, gy)
	leaderboard(folder, gy)
	gates(folder)
	trees(folder, rng)
	spawns(gy)

	-- jump pads em volta
	for i = 0, 5 do
		local a = (i + 0.5) / 6 * math.pi * 2 + math.pi / 12
		Hub.jumpPad(folder, Vector3.new(math.cos(a) * 88, gy + 1.6, math.sin(a) * 88), 105, Color3.fromHSV(i / 6, 0.7, 1))
	end
	_ = Players
end

return Hub
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Interactive</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Interactive: objetos interativos do mundo.
	  cannon   canhao que lanca o jogador em arco balistico ate um destino
	  portal   pad que teleporta
	  chest    bau de moedas com recarga por jogador
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Build = require(script.Parent:WaitForChild("Build"))
local Server = script.Parent.Parent
local Data = require(Server:WaitForChild("Data"))
local Physics = require(Server:WaitForChild("Physics"))
local Ragdoll = require(Server:WaitForChild("Ragdoll"))
local Pickups = require(Server:WaitForChild("Pickups"))

local Interactive = {}

local M = Enum.Material
local P = Config.Palette
local GRAVITY = 196.2

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Velocidade inicial para ir de "from" a "to" com angulo fixo (graus). Retorna Vector3 ou nil.
function Interactive.ballistic(from: Vector3, to: Vector3, angleDeg: number): Vector3?
	local off = to - from
	local flat = Vector3.new(off.X, 0, off.Z)
	local D = flat.Magnitude
	if D < 1 then
		return nil
	end
	local th = math.rad(angleDeg)
	local cos, tan = math.cos(th), math.tan(th)
	local denom = 2 * cos * cos * (D * tan - off.Y)
	if denom <= 0 then
		return nil
	end
	local v = math.sqrt(GRAVITY * D * D / denom)
	local dir = flat.Unit
	return dir * (v * cos) + Vector3.new(0, v * math.sin(th), 0)
end

-- Canhao. target: posicao de destino (Vector3). Retorna o modelo.
function Interactive.cannon(parent: Instance, pos: Vector3, target: Vector3, label: string, opts: { [string]: any }?)
	opts = opts or {}
	local angle = opts.angle or 52
	local y = Build.y(pos.X, pos.Z)
	local origin = Vector3.new(pos.X, y, pos.Z)
	local look = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
	local cf = CFrame.lookAt(origin, origin + look.Unit)
	local m = Build.model(parent, "Cannon")

	Build.foundation(m, cf, Vector3.new(12, 1, 12), rgb(90, 90, 110), M.Slate)
	-- base + rodas
	local base = Build.block(m, cf * CFrame.new(0, 2.6, 0), Vector3.new(7, 2.6, 8), rgb(120, 82, 54), M.Wood)
	for _, sx in { -3.7, 3.7 } do
		Build.cyl(m, cf * CFrame.new(sx, 3, 0) * CFrame.Angles(0, 0, math.pi / 2), 1.2, 6, rgb(90, 60, 40), M.Wood)
		Build.cyl(m, cf * CFrame.new(sx, 3, 0) * CFrame.Angles(0, 0, math.pi / 2), 1.4, 1.6, rgb(180, 180, 190), M.Metal)
	end
	-- cano inclinado
	local barrelCF = cf * CFrame.new(0, 5.4, -0.6) * CFrame.Angles(math.rad(angle), 0, 0)
	local tube = Build.cyl(m, barrelCF * CFrame.new(0, 0, -3.2) * CFrame.Angles(math.pi / 2, 0, 0), 9, 4.6, opts.color or rgb(70, 74, 100), M.Metal)
	Build.cyl(m, barrelCF * CFrame.new(0, 0, -7.6) * CFrame.Angles(math.pi / 2, 0, 0), 1.4, 5.6, rgb(230, 190, 60), M.Metal, { collide = false })
	Build.ball(m, barrelCF * CFrame.new(0, 0, 1.2), 4.8, opts.color or rgb(70, 74, 100), M.Metal, { collide = false })
	local sign = Build.block(m, cf * CFrame.new(0, 10.5, 4.6), Vector3.new(12, 2.4, 0.4), rgb(36, 34, 80), M.SmoothPlastic)
	Build.label(sign, label, { color = P.Accent })
	local light = Build.ball(m, cf * CFrame.new(0, 7.4, 4.3), 1.2, P.Accent2, M.Neon, { collide = false })
	Build.pulse(light, 0.6, 2.4, 1.1)
	Build.light(light, P.Accent2, 1.2, 16, false)

	local pp = Build.prompt(base, "Disparar!", "Canhão: " .. label, "cannon", 0.6)
	pp.MaxActivationDistance = 13
	local last = {}
	pp.Triggered:Connect(function(player)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then
			return
		end
		local now = os.clock()
		if last[player] and now - last[player] < 3 then
			return
		end
		last[player] = now
		local from = origin + Vector3.new(0, 8, 0)
		local vel = Interactive.ballistic(from, target, angle)
		if not vel then
			return
		end
		char:PivotTo(CFrame.new(from + look.Unit * 2))
		Ragdoll.enable(char, { duration = 3.2 })
		Physics.launch(char, vel, Vector3.new(4, 2, 3))
		Remotes.get("Fx"):FireAllClients("cannon", from, 1, { dir = vel.Unit })
		Remotes.get("Struck"):FireClient(player, 0.6, vel.Unit)
	end)
	m.PrimaryPart = base
	_ = tube
	return m
end

-- Portal de retorno: quem pisa vai para a praca
function Interactive.portal(parent: Instance, pos: Vector3, destination: Vector3, label: string, color: Color3?)
	local c = color or P.Purple
	local m = Build.model(parent, "Portal")
	local base = Build.cyl(m, CFrame.new(pos), 1, 12, rgb(40, 40, 90), M.Metal)
	local disc = Build.cyl(m, CFrame.new(pos + Vector3.new(0, 0.7, 0)), 0.4, 10, c, M.Neon, { name = "PortalDisc" })
	Build.pulse(disc, 0.8, 2.4, 1.6)
	local pillar = Build.cyl(m, CFrame.new(pos + Vector3.new(0, 8, 0)), 16, 5, c, M.Neon, { collide = false, transparency = 0.8, shadow = false })
	pillar.CanQuery = false
	Build.billboard(disc, label, { color = c, offset = Vector3.new(0, 7, 0) })
	local att = Instance.new("Attachment")
	att.Parent = disc
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 20
	pe.Lifetime = NumberRange.new(2, 3)
	pe.Speed = NumberRange.new(6, 12)
	pe.EmissionDirection = Enum.NormalId.Top
	pe.SpreadAngle = Vector2.new(6, 6)
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(c, Color3.new(1, 1, 1))
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = att
	local last = {}
	disc.Touched:Connect(function(other)
		local char = other:FindFirstAncestorOfClass("Model")
		local player = char and Players:GetPlayerFromCharacter(char)
		if not player then
			return
		end
		local now = os.clock()
		if last[player] and now - last[player] < 2 then
			return
		end
		last[player] = now
		char:PivotTo(CFrame.new(destination))
		Remotes.get("Fx"):FireAllClients("teleport", destination, 1, nil)
	end)
	m.PrimaryPart = base
	return m
end

-- Bau de moedas (recarga por jogador em segundos)
function Interactive.chest(parent: Instance, pos: Vector3, name: string, coins: number, cooldown: number, color: Color3?)
	local c = color or P.Accent
	local m = Build.model(parent, "Chest")
	local cf = CFrame.new(pos)
	local body = Build.block(m, cf * CFrame.new(0, 2, 0), Vector3.new(6, 4, 4), rgb(150, 96, 56), M.Wood)
	Build.cyl(m, cf * CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.pi / 2), 6, 4.2, rgb(170, 110, 64), M.Wood, { collide = false })
	Build.block(m, cf * CFrame.new(0, 2.6, 2.05), Vector3.new(1.2, 1.6, 0.3), c, M.Metal, { collide = false })
	local glow = Build.ball(m, cf * CFrame.new(0, 6.6, 0), 2, c, M.Neon, { collide = false })
	Build.bob(glow, 0.5, 2)
	Build.light(glow, c, 2, 26, false)
	Build.billboard(glow, "💰 " .. name, { color = c, offset = Vector3.new(0, 3, 0) })
	local pp = Build.prompt(body, "Abrir", name, "chest", 0.5)
	local last = {}
	pp.Triggered:Connect(function(player)
		if not Data.isLoaded(player) then
			return
		end
		local now = os.clock()
		if last[player] and now - last[player] < cooldown then
			Remotes.get("Notify"):FireClient(player, "O baú está vazio. Volte mais tarde!", "bad")
			return
		end
		last[player] = now
		Pickups.burst(pos + Vector3.new(0, 5, 0), coins, math.clamp(coins // 12, 6, 30))
		Data.addXP(player, math.floor(coins / 6))
		Remotes.get("Fx"):FireAllClients("confetti", pos + Vector3.new(0, 5, 0), 1.2, nil)
		Remotes.get("Announce"):FireClient(player, name, "+" .. coins .. " moedas!", 2, c)
	end)
	m.PrimaryPart = body
	return m
end

-- Placa de madeira com texto (em pe)
function Interactive.signpost(parent: Instance, pos: Vector3, text: string, facing: Vector3?)
	local y = Build.y(pos.X, pos.Z)
	local cf = CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(pos.X, y, pos.Z) + (facing or Vector3.zAxis))
	local m = Build.model(parent, "Signpost")
	Build.block(m, cf * CFrame.new(-4, 4, 0), Vector3.new(0.8, 8, 0.8), rgb(120, 84, 52), M.Wood)
	Build.block(m, cf * CFrame.new(4, 4, 0), Vector3.new(0.8, 8, 0.8), rgb(120, 84, 52), M.Wood)
	local board = Build.block(m, cf * CFrame.new(0, 8.4, 0), Vector3.new(11, 4.4, 0.6), rgb(44, 40, 96), M.SmoothPlastic)
	Build.label(board, text, { color = P.White })
	return m
end

_ = TweenService
return Interactive
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Nature</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Nature: espalha arvores, pedras e plantas pelo terreno respeitando material, inclinacao,
	estradas e areas reservadas.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local Build = require(script.Parent:WaitForChild("Build"))
local WorldGen = require(script.Parent:WaitForChild("WorldGen"))

local Nature = {}

local M = Enum.Material

Nature.Reserved = {} -- { { x, z, r } } areas onde nao espalhar nada

function Nature.reserve(x: number, z: number, r: number)
	table.insert(Nature.Reserved, { x = x, z = z, r = r })
end

local function isReserved(x: number, z: number, extra: number): boolean
	for _, a in Nature.Reserved do
		local dx, dz = x - a.x, z - a.z
		if dx * dx + dz * dz < (a.r + extra) ^ 2 then
			return true
		end
	end
	return false
end

-- opts:
--   center: Vector2, radius: number  (regiao circular)
--   materials: { [Enum.Material]: true }  (onde pode nascer)
--   minNormalY: number (0.86 padrao)
--   minRoad: number (12), hubClear: number (100)
--   kinds: { {kind, weight} }, scale: {min, max}
--   place: function(parent, pos, kind, scale, rng) -> nil (opcional, substitui Build.tree)
function Nature.scatter(parent: Instance, rng: Random, count: number, opts)
	local placed = 0
	local attempts = 0
	local maxAttempts = count * 8
	local c = opts.center
	local hubClear = opts.hubClear or 100
	local minRoad = opts.minRoad or 12
	local minNormal = opts.minNormalY or 0.86
	while placed < count and attempts < maxAttempts do
		attempts += 1
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * opts.radius
		local x, z = c.X + math.cos(a) * r, c.Y + math.sin(a) * r
		if math.sqrt(x * x + z * z) < hubClear then
			continue
		end
		if WorldGen.roadDistance(x, z) < minRoad then
			continue
		end
		if isReserved(x, z, opts.clearance or 0) then
			continue
		end
		local pos, normal, material = Build.ground(x, z)
		if not pos or normal.Y < minNormal then
			continue
		end
		if opts.materials and not opts.materials[material] then
			continue
		end
		if pos.Y < (opts.minY or Config.World.SeaLevel + 3) or pos.Y > (opts.maxY or 400) then
			continue
		end
		local kind = Util.weightedPick(opts.kinds, function(k)
			return k[2]
		end, rng)[1]
		local scale = rng:NextNumber(opts.scale[1], opts.scale[2])
		if opts.place then
			opts.place(parent, pos, kind, scale, rng)
		else
			Build.tree(parent, pos - Vector3.new(0, 0.6, 0), kind, scale, rng)
		end
		placed += 1
		if placed % 25 == 0 then
			task.wait()
		end
	end
	return placed
end

function Nature.rocks(parent: Instance, rng: Random, count: number, opts)
	opts.kinds = { { "rock", 1 } }
	opts.scale = opts.scale or { 3, 9 }
	opts.place = function(p, pos, _, scale, r)
		Build.rock(p, pos + Vector3.new(0, scale * 0.15, 0), scale, opts.color, r)
	end
	return Nature.scatter(parent, rng, count, opts)
end

Nature.GRASS = { [M.Grass] = true, [M.LeafyGrass] = true, [M.Ground] = true }
Nature.SAND = { [M.Sand] = true, [M.Sandstone] = true }
Nature.SNOW = { [M.Snow] = true, [M.Glacier] = true }

return Nature
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Scenery</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Scenery: coordena a construcao do mundo (terreno + cenario + brinquedos espalhados).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Server = script.Parent.Parent
local ToySpawner = require(Server:WaitForChild("ToySpawner"))
local Zones = require(Server:WaitForChild("Zones"))

local WorldGen = require(script.Parent:WaitForChild("WorldGen"))
local Build = require(script.Parent:WaitForChild("Build"))
local Nature = require(script.Parent:WaitForChild("Nature"))
local Hub = require(script.Parent:WaitForChild("Hub"))
local Farm = require(script.Parent:WaitForChild("Farm"))
local Snow = require(script.Parent:WaitForChild("Snow"))
local Volcano = require(script.Parent:WaitForChild("Volcano"))
local Beach = require(script.Parent:WaitForChild("Beach"))
local Sky = require(script.Parent:WaitForChild("Sky"))
local Cave = require(script.Parent:WaitForChild("Cave"))
local Interactive = require(script.Parent:WaitForChild("Interactive"))

local Scenery = {}

local function setProgress(p: number, text: string?)
	workspace:SetAttribute("TV_Progress", p)
	if text then
		workspace:SetAttribute("TV_LoadText", text)
	end
end

-- Canhoes expressos: biomas -> praca e praca -> biomas
local function expressCannons(folder: Folder)
	local hubY = Build.y(0, 0)
	local plazaTarget = Vector3.new(0, hubY + 4, 34)
	local list = {
		{ pos = Vector3.new(-410, 0, 60), label = "Fazenda ➜ Praça", target = plazaTarget },
		{ pos = Vector3.new(-30, 0, -340), label = "Montanha ➜ Praça", target = plazaTarget },
		{ pos = Vector3.new(400, 0, 10), label = "Vulcão ➜ Praça", target = plazaTarget },
		{ pos = Vector3.new(40, 0, 340), label = "Praia ➜ Praça", target = plazaTarget },
	}
	for _, c in list do
		Interactive.cannon(folder, c.pos, c.target, c.label, { angle = 50 })
	end
	-- da praca para os biomas (posicao do destino perto do centro de cada bioma)
	for key, b in Config.Biomes do
		if key ~= "Hub" then
			local dir = Vector3.new(b.center.X, 0, b.center.Y).Unit
			local cpos = dir * 92 + Vector3.new(-dir.Z * 20, 0, dir.X * 20)
			local tx = b.center.X * 0.72
			local tz = b.center.Y * 0.72
			local ty = Build.y(tx, tz) + 4
			Interactive.cannon(folder, cpos, Vector3.new(tx, ty, tz), "Praça ➜ " .. b.name, { angle = 52 })
		end
	end
end

-- Roda uma etapa protegida: se falhar, avisa no Output e o resto do mundo continua.
local function stage(name: string, fn: (...any) -> ...any, ...)
	local ok, err = xpcall(fn, debug.traceback, ...)
	if not ok then
		warn("[Mundo] etapa '" .. name .. "' falhou:\n" .. tostring(err))
	end
	return ok
end

function Scenery.build()
	setProgress(0, "Gerando terreno...")
	stage("terreno", WorldGen.build, function(p)
		setProgress(p * 0.55, "Gerando terreno...")
	end)

	Build.init()
	local rng = Random.new(Config.World.Seed)
	local addSlot = function(pos, biome)
		ToySpawner.addSlot(pos, biome)
	end

	setProgress(0.58, "Construindo a praça...")
	-- a Vila dos Jogadores (Activities/Plots) ocupa este raio: nada de arvores/pedras nascendo la
	Nature.reserve(Config.World.Village.X, Config.World.Village.Z, 120)
	stage("praca", Hub.build)
	task.wait()
	setProgress(0.64, "Plantando a fazenda...")
	stage("fazenda", Farm.build, rng, addSlot)
	task.wait()
	setProgress(0.70, "Cobrindo a montanha de neve...")
	stage("montanha", Snow.build, rng, addSlot)
	task.wait()
	setProgress(0.76, "Acendendo o vulcão...")
	stage("vulcao", Volcano.build, rng, addSlot)
	task.wait()
	setProgress(0.82, "Molhando a praia...")
	stage("praia", Beach.build, rng, addSlot)
	task.wait()
	setProgress(0.87, "Levantando as ilhas...")
	stage("ilhas", Sky.build, rng, addSlot)
	task.wait()
	setProgress(0.90, "Iluminando a caverna...")
	stage("caverna", Cave.build, rng, addSlot)

	stage("canhoes", expressCannons, Build.folder("Cannons"))

	-- brinquedos na praca (fora da zona segura) e moedas soltas
	local hubY = Build.y(0, 0)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2 + 0.2
		addSlot(Vector3.new(math.cos(a) * 80, hubY + 1, math.sin(a) * 80), "Hub")
	end
	local pickups = require(Server:WaitForChild("Pickups"))
	local coinRng = Random.new(Config.World.Seed + 9)
	local placed = 0
	local attempts = 0
	while placed < 90 and attempts < 900 do
		attempts += 1
		local a = coinRng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(coinRng:NextNumber()) * 640
		local pos, normal = Build.ground(math.cos(a) * r, math.sin(a) * r)
		if pos and normal.Y > 0.8 and pos.Y > 4 and Vector2.new(pos.X, pos.Z).Magnitude > 70 then
			pickups.placeStatic(pos + Vector3.new(0, 3, 0), 5, 75)
			placed += 1
		end
		if attempts % 60 == 0 then
			task.wait()
		end
	end

	setProgress(0.96, "Soltando os brinquedos...")
	Nature.reserve(0, 0, 0)
	task.wait()
	setProgress(1, "Pronto!")
	_ = Zones
	_ = Remotes
end

return Scenery
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Sky</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Sky: decoracao das ilhas flutuantes + tubos de vento que levam ate elas.
	(A Ilha da Arena e a Ilha do Golem sao completadas pelos modulos de atividades.)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Build = require(script.Parent:WaitForChild("Build"))
local WorldGen = require(script.Parent:WaitForChild("WorldGen"))
local Hub = require(script.Parent:WaitForChild("Hub"))
local Interactive = require(script.Parent:WaitForChild("Interactive"))
local Zones = require(script.Parent.Parent:WaitForChild("Zones"))

local Sky = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Procura terreno seco caminhando em direcao ao centro
local function findLand(x: number, z: number): (number, number)
	local dir = Vector3.new(-x, 0, -z)
	if dir.Magnitude < 1 then
		return x, z
	end
	dir = dir.Unit
	for i = 0, 30 do
		local px, pz = x + dir.X * i * 12, z + dir.Z * i * 12
		local pos, normal = Build.ground(px, pz)
		if pos and normal.Y > 0.82 and pos.Y > Config.World.SeaLevel + 3 then
			return px, pz
		end
	end
	return x, z
end

local TUBES = {
	Arena = { offset = Vector3.new(1, 0, 0), color = rgb(94, 234, 212) },
	Crystal = { offset = Vector3.new(-0.77, 0, -0.64), color = rgb(120, 240, 255) },
	Boss = { offset = Vector3.new(0.83, 0, 0.56), color = rgb(255, 120, 90) },
	Treasure = { offset = Vector3.new(0.35, 0, -0.94), color = rgb(255, 210, 70) },
	Garden = { offset = Vector3.new(-0.74, 0, -0.68), color = rgb(150, 255, 120) },
}

local function crystalIsland(folder: Folder, isl, rng: Random, addSlot)
	local top = WorldGen.islandTop(isl)
	for i = 1, 16 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * isl.radius * 0.85
		local h = rng:NextNumber(8, 26)
		local color = Color3.fromHSV(rng:NextNumber(0.45, 0.85), 0.55, 1)
		local cf = CFrame.new(isl.pos.X + math.cos(a) * r, top + h * 0.45, isl.pos.Z + math.sin(a) * r) * CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6.28), rng:NextNumber(-0.2, 0.2))
		local c = Build.block(folder, cf, Vector3.new(rng:NextNumber(2.5, 4.5), h, rng:NextNumber(2.5, 4.5)), color, M.Neon, { transparency = 0.15 })
		Build.pulse(c, 0.4, 2.2, 3 + rng:NextNumber(0, 3))
		if i % 3 == 0 then
			Build.light(c, color, 2, 40, false)
		end
	end
	for _ = 1, 10 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * isl.radius * 0.8
		Build.tree(folder, Vector3.new(isl.pos.X + math.cos(a) * r, top - 0.4, isl.pos.Z + math.sin(a) * r), "mushroom", rng:NextNumber(0.9, 1.6), rng)
	end
	for _ = 1, 10 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * isl.radius * 0.7
		addSlot(Vector3.new(isl.pos.X + math.cos(a) * r, top + 1, isl.pos.Z + math.sin(a) * r), "Sky")
	end
end

local function treasureIsland(folder: Folder, isl, rng: Random, addSlot)
	local top = WorldGen.islandTop(isl)
	Interactive.chest(folder, Vector3.new(isl.pos.X, top, isl.pos.Z), "Tesouro do Céu", 900, 1200, rgb(255, 214, 80))
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Build.tree(folder, Vector3.new(isl.pos.X + math.cos(a) * 30, top - 0.4, isl.pos.Z + math.sin(a) * 30), "palm", 1.3, rng, Vector3.new(0.1, 0, 0.06))
	end
	for i = 1, 6 do
		addSlot(Vector3.new(isl.pos.X + rng:NextNumber(-25, 25), top + 1, isl.pos.Z + rng:NextNumber(-25, 25)), "Sky")
	end
end

local function flower(folder: Folder, pos: Vector3, size: number, rng: Random)
	local m = Build.model(folder, "GiantFlower")
	local color = Color3.fromHSV(rng:NextNumber(0, 1), 0.6, 1)
	local stem = Build.cyl(m, CFrame.new(pos + Vector3.new(0, size * 3, 0)), size * 6, size * 0.9, rgb(70, 190, 90), M.Grass)
	local head = CFrame.new(pos + Vector3.new(0, size * 6.4, 0))
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local pet = Build.ball(m, head * CFrame.new(math.cos(a) * size * 2.4, 0, math.sin(a) * size * 2.4), size * 2.6, color, M.SmoothPlastic, { collide = false })
		pet.Size = Vector3.new(size * 2.6, size * 1.2, size * 2.6)
	end
	local core = Build.ball(m, head * CFrame.new(0, size * 0.4, 0), size * 2.4, rgb(255, 220, 60), M.SmoothPlastic, { collide = false })
	m.PrimaryPart = stem
	Build.sway(stem, 3, 3.5 + rng:NextNumber(0, 2))
	_ = core
end

local function ring(folder: Folder, pos: Vector3, radius: number, color: Color3, rotY: number)
	local m = Build.model(folder, "FlyRing")
	local pivot = Build.block(m, CFrame.new(pos), Vector3.one, P.Ink, M.SmoothPlastic, { collide = false, transparency = 1, query = false })
	m.PrimaryPart = pivot
	local n = 16
	for i = 1, n do
		local a = i / n * math.pi * 2
		Build.ball(m, CFrame.new(pos) * CFrame.Angles(0, rotY, 0) * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0), 2.4, color, M.Neon, { collide = false, shadow = false })
	end
	Build.bob(pivot, 1.5, 4)
	Build.spin(m, "Z", 14)
end

local function gardenIsland(folder: Folder, isl, rng: Random, addSlot)
	local top = WorldGen.islandTop(isl)
	for _ = 1, 16 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * isl.radius * 0.85
		flower(folder, Vector3.new(isl.pos.X + math.cos(a) * r, top - 0.4, isl.pos.Z + math.sin(a) * r), rng:NextNumber(0.9, 1.8), rng)
	end
	-- aneis flutuantes (para atravessar voando)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		ring(folder, Vector3.new(isl.pos.X + math.cos(a) * 30, top + 18 + i * 4, isl.pos.Z + math.sin(a) * 30), 11, Color3.fromHSV(i / 4, 0.7, 1), a)
	end
	for _ = 1, 10 do
		addSlot(Vector3.new(isl.pos.X + rng:NextNumber(-40, 40), top + 1, isl.pos.Z + rng:NextNumber(-40, 40)), "Sky")
	end
end

local function bossIslandDeco(folder: Folder, isl, rng: Random)
	local top = WorldGen.islandTop(isl)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		local r = isl.radius * 0.93
		local h = rng:NextNumber(10, 22)
		Build.block(folder, CFrame.new(isl.pos.X + math.cos(a) * r, top + h / 2, isl.pos.Z + math.sin(a) * r) * CFrame.Angles(0, -a, 0), Vector3.new(5, h, 5), rgb(110, 100, 130), M.Slate)
		if i % 2 == 0 then
			local o = Build.ball(folder, CFrame.new(isl.pos.X + math.cos(a) * r, top + h + 2, isl.pos.Z + math.sin(a) * r), 3.4, rgb(255, 110, 70), M.Neon, { collide = false })
			Build.light(o, rgb(255, 110, 70), 2, 30, false)
			Build.pulse(o, 0.6, 3, 2.4)
		end
	end
end

function Sky.build(rng: Random, addSlot)
	local folder = Build.folder("Sky")
	for _, isl in WorldGen.SkyIslands do
		Zones.registerSkyName(isl.pos, isl.radius, isl.name, "☁️")
		local t = TUBES[isl.id]
		if t then
			local dist = isl.radius + 9
			local x = isl.pos.X + t.offset.X * dist
			local z = isl.pos.Z + t.offset.Z * dist
			if isl.id ~= "Arena" then
				x, z = findLand(x, z)
			end
			local m = Hub.windTube(folder, x, z, WorldGen.islandTop(isl) + 4, isl.name, t.color)
			local zone = m:FindFirstChild("WindZone")
			if zone then
				zone:SetAttribute("PullX", isl.pos.X)
				zone:SetAttribute("PullZ", isl.pos.Z)
			end
			isl.tube = Vector3.new(x, 0, z)
		end
	end

	crystalIsland(folder, WorldGen.getIsland("Crystal"), rng, addSlot)
	treasureIsland(folder, WorldGen.getIsland("Treasure"), rng, addSlot)
	gardenIsland(folder, WorldGen.getIsland("Garden"), rng, addSlot)
	bossIslandDeco(folder, WorldGen.getIsland("Boss"), rng)

	-- "ilhotas" decorativas ao longe (so visuais)
	for i = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(420, 900)
		local y = Config.World.SkyY + rng:NextNumber(-90, 260)
		local p = Vector3.new(math.cos(a) * r, y, math.sin(a) * r)
		local m = Build.model(folder, "Islet")
		local s = rng:NextNumber(14, 34)
		local top = Build.ball(m, CFrame.new(p), s, rgb(96, 190, 96), M.Grass, { collide = false })
		top.Size = Vector3.new(s, s * 0.25, s)
		local rock = Build.ball(m, CFrame.new(p - Vector3.new(0, s * 0.3, 0)), s * 0.8, rgb(128, 122, 140), M.Slate, { collide = false })
		rock.Size = Vector3.new(s * 0.8, s * 0.7, s * 0.8)
		m.PrimaryPart = top
		Build.bob(top, 2, 6 + rng:NextNumber(0, 5))
		Build.bob(rock, 2, 6 + rng:NextNumber(0, 5))
	end
end

return Sky
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Snow</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Snow: a Montanha Gelada (norte). Pinheiros nevados, cabana, iglu, bonecos de neve,
	rampa de esqui, lago congelado, bandeira no pico e a entrada da Caverna de Cristal.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Build = require(script.Parent:WaitForChild("Build"))
local Nature = require(script.Parent:WaitForChild("Nature"))
local WorldGen = require(script.Parent:WaitForChild("WorldGen"))
local Data = require(script.Parent.Parent:WaitForChild("Data"))
local Quests = require(script.Parent.Parent:WaitForChild("Quests"))
local Pickups = require(script.Parent.Parent:WaitForChild("Pickups"))

local Snow = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function cabin(folder: Folder, x: number, z: number)
	local y = Build.y(x, z)
	local cf = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(0, y, 0))
	local m = Build.house(folder, cf, Vector3.new(22, 11, 16), rgb(168, 116, 76), rgb(240, 248, 255), "Cabin")
	-- neve sobre o telhado
	Build.block(m, cf * CFrame.new(0, 18.2, 0), Vector3.new(24, 1, 18), rgb(250, 252, 255), M.Snow, { collide = false })
	-- chamine com fumaca
	local chim = Build.block(m, cf * CFrame.new(6, 18, -3), Vector3.new(3, 8, 3), rgb(120, 96, 90), M.Brick)
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, 4.4, 0)
	att.Parent = chim
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = SMOKE
	smoke.Rate = 8
	smoke.Lifetime = NumberRange.new(3, 5)
	smoke.Speed = NumberRange.new(4, 7)
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.SpreadAngle = Vector2.new(12, 12)
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 6) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Color = ColorSequence.new(rgb(230, 230, 240))
	smoke.Parent = att
	-- luz quente na janela
	local lamp = Build.ball(m, cf * CFrame.new(0, 7, 8.6), 2, rgb(255, 210, 120), M.Neon, { collide = false })
	Build.light(lamp, rgb(255, 200, 120), 2, 26, false)
	Nature.reserve(x, z, 20)
end

local function igloo(folder: Folder, x: number, z: number)
	local y = Build.y(x, z)
	local cf = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(0, y, 0))
	local m = Build.model(folder, "Igloo")
	local dome = Build.ball(m, cf * CFrame.new(0, 0, 0), 18, rgb(238, 246, 255), M.Snow)
	Build.cyl(m, cf * CFrame.new(0, 1.8, 8.8) * CFrame.Angles(math.pi / 2, 0, 0), 6, 6.4, rgb(226, 238, 252), M.Snow)
	Build.block(m, cf * CFrame.new(0, 2.2, 12) , Vector3.new(4, 4, 1), rgb(30, 40, 80), M.SmoothPlastic, { collide = false })
	local lamp = Build.ball(m, cf * CFrame.new(0, 5, 6), 1.6, rgb(150, 220, 255), M.Neon, { collide = false })
	Build.light(lamp, rgb(150, 220, 255), 1.5, 22, false)
	m.PrimaryPart = dome
	Nature.reserve(x, z, 14)
end

local function snowman(folder: Folder, pos: Vector3, rng: Random)
	local m = Build.model(folder, "Snowman")
	local cf = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
	local s = rng:NextNumber(0.9, 1.5)
	local white = rgb(248, 250, 255)
	local b1 = Build.ball(m, cf * CFrame.new(0, 2.6 * s, 0), 5.6 * s, white, M.Snow)
	Build.ball(m, cf * CFrame.new(0, 6.4 * s, 0), 4 * s, white, M.Snow, { collide = false })
	Build.ball(m, cf * CFrame.new(0, 9.4 * s, 0), 3 * s, white, M.Snow, { collide = false })
	Build.cyl(m, cf * CFrame.new(0, 11.2 * s, 0), 0.3 * s, 3.4 * s, rgb(40, 40, 60), M.Fabric, { collide = false })
	Build.cyl(m, cf * CFrame.new(0, 12.2 * s, 0), 1.8 * s, 2 * s, rgb(40, 40, 60), M.Fabric, { collide = false })
	Build.cyl(m, cf * CFrame.new(0, 9.4 * s, 1.7 * s) * CFrame.Angles(math.pi / 2, 0, 0), 1.6 * s, 0.5 * s, rgb(255, 130, 30), M.SmoothPlastic, { collide = false })
	for _, sx in { -0.6, 0.6 } do
		Build.ball(m, cf * CFrame.new(sx * s, 10 * s, 1.3 * s), 0.4 * s, rgb(20, 20, 20), M.SmoothPlastic, { collide = false })
	end
	for _, sx in { -1, 1 } do
		Build.cyl(m, cf * CFrame.new(sx * 3.4 * s, 7 * s, 0) * CFrame.Angles(0, 0, sx * math.rad(-50)), 4.4 * s, 0.35 * s, rgb(110, 76, 44), M.Wood, { collide = false })
	end
	m.PrimaryPart = b1
	Build.sway(b1, 1.5, 4)
end

local function skiJump(folder: Folder, x: number, z: number)
	local y = Build.y(x, z)
	local cf = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(0, y, 0))
	local m = Build.model(folder, "SkiJump")
	Build.foundation(m, cf, Vector3.new(24, 1, 46))
	local ramp = Build.wedge(m, cf * CFrame.new(0, 6, 4) * CFrame.Angles(0, math.pi, 0), Vector3.new(20, 12, 34), rgb(240, 248, 255), M.Ice)
	ramp.Reflectance = 0.08
	for _, sx in { -10.4, 10.4 } do
		Build.block(m, cf * CFrame.new(sx, 6, 4), Vector3.new(0.8, 12.6, 34.6), rgb(255, 90, 70), M.SmoothPlastic, { collide = false })
		local flag = Build.block(m, cf * CFrame.new(sx, 14, -11), Vector3.new(0.3, 3, 4), rgb(255, 210, 60), M.Fabric, { collide = false })
		Build.sway(flag, 8, 1.8)
		Build.block(m, cf * CFrame.new(sx, 10, -11), Vector3.new(0.4, 10, 0.4), rgb(230, 230, 240), M.Metal)
	end
	local sign = Build.block(m, cf * CFrame.new(0, 16, -14), Vector3.new(14, 3, 0.5), rgb(40, 60, 120), M.SmoothPlastic)
	Build.label(sign, "🎿 RAMPA DE ESQUI", { color = P.White })
	Nature.reserve(x, z, 30)
end

local function summit(folder: Folder)
	local c = Config.Biomes.Snow.center
	-- acha o ponto mais alto perto do centro
	local bx, bz, by = c.X, c.Y, -1e9
	for dx = -70, 70, 7 do
		for dz = -70, 70, 7 do
			local h = WorldGen.height(c.X + dx, c.Y + dz)
			if h > by then
				bx, bz, by = c.X + dx, c.Y + dz, h
			end
		end
	end
	local y = Build.y(bx, bz)
	local m = Build.model(folder, "Summit")
	Build.cyl(m, CFrame.new(bx, y + 9, bz), 18, 0.8, rgb(230, 230, 240), M.Metal)
	local flag = Build.block(m, CFrame.new(bx + 3.2, y + 15, bz), Vector3.new(6, 4, 0.3), P.Pink, M.Fabric, { collide = false })
	Build.sway(flag, 10, 1.6)
	local orb = Build.ball(m, CFrame.new(bx, y + 19.5, bz), 3, P.Accent, M.Neon, { collide = false })
	Build.light(orb, P.Accent, 2.4, 50, false)
	Build.pulse(orb, 1, 4, 1.4)
	Build.bob(orb, 0.6, 2.5)
	local base = Build.cyl(m, CFrame.new(bx, y + 0.8, bz), 1.6, 8, rgb(70, 76, 120), M.Slate)
	local pp = Build.prompt(base, "Plantar bandeira", "Pico da Montanha", "summit", 0.6)
	pp.MaxActivationDistance = 14
	local last = {}
	pp.Triggered:Connect(function(player)
		if not Data.isLoaded(player) then
			return
		end
		local now = os.clock()
		if last[player] and now - last[player] < 300 then
			Remotes.get("Notify"):FireClient(player, "A bandeira já está plantada. Volte mais tarde!", "bad")
			return
		end
		last[player] = now
		Quests.report(player, "summit", 1)
		Data.addXP(player, 60)
		Pickups.burst(Vector3.new(bx, y + 6, bz), 150, 15)
		Remotes.get("Announce"):FireClient(player, "PICO CONQUISTADO!", "Você escalou a montanha inteira", 2.6, P.Accent)
		Remotes.get("Fx"):FireAllClients("confetti", Vector3.new(bx, y + 8, bz), 1.4, nil)
	end)
	Nature.reserve(bx, bz, 12)
	Snow.summitPos = Vector3.new(bx, y, bz)
end

local function caveEntrance(folder: Folder)
	local e = WorldGen.Cave.entranceWorld
	if not e then
		return
	end
	local dir = WorldGen.Cave.direction
	local cf = CFrame.lookAt(e, e + dir)
	local m = Build.model(folder, "CaveEntrance")
	-- moldura de madeira
	for _, sx in { -8, 8 } do
		Build.block(m, cf * CFrame.new(sx, 0, 0), Vector3.new(2.4, 18, 2.4), rgb(122, 84, 52), M.Wood)
	end
	Build.block(m, cf * CFrame.new(0, 9.6, 0), Vector3.new(19, 2.4, 2.6), rgb(122, 84, 52), M.Wood)
	local sign = Build.block(m, cf * CFrame.new(0, 13, 0.4), Vector3.new(16, 3.4, 0.6), rgb(44, 38, 100), M.SmoothPlastic)
	Build.label(sign, "💎 CAVERNA DE CRISTAL", { color = rgb(120, 240, 255) })
	for _, sx in { -6, 6 } do
		local lamp = Build.ball(m, cf * CFrame.new(sx, 6, -1.6), 1.6, rgb(120, 240, 255), M.Neon, { collide = false })
		Build.light(lamp, rgb(120, 240, 255), 2, 28, false)
		Build.bob(lamp, 0.3, 2.4)
	end
	Nature.reserve(e.X, e.Z, 24)
end

function Snow.build(rng: Random, addSlot)
	local folder = Build.folder("Snow")
	local c = Config.Biomes.Snow.center

	-- pinheiros: neve e pradarias nevadas
	Nature.scatter(folder, rng, 170, {
		center = c,
		radius = 300,
		materials = { [M.Snow] = true, [M.Glacier] = true, [M.Grass] = true, [M.LeafyGrass] = true },
		kinds = { { "snowpine", 5 }, { "pine", 2 } },
		scale = { 0.9, 1.8 },
		maxY = 140,
		minNormalY = 0.8,
		clearance = 3,
	})
	Nature.rocks(folder, rng, 34, {
		center = c,
		radius = 300,
		materials = { [M.Snow] = true, [M.Rock] = true, [M.Glacier] = true },
		color = rgb(200, 206, 220),
		maxY = 220,
		minNormalY = 0.6,
		clearance = 2,
	})

	cabin(folder, -20, -290)
	igloo(folder, 210, -300)
	skiJump(folder, -110, -330)
	for i = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(70, 110)
		local lake = WorldGen.Lakes[2]
		local x, z = lake.x + math.cos(a) * r, lake.z + math.sin(a) * r
		local pos, normal = Build.ground(x, z)
		if pos and normal.Y > 0.8 then
			snowman(folder, pos, rng)
		end
	end
	-- lampioes em volta do lago congelado
	local lake = WorldGen.Lakes[2]
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		local pos = Build.ground(lake.x + math.cos(a) * (lake.r + 4), lake.z + math.sin(a) * (lake.r + 4))
		if pos then
			Build.lamp(folder, pos, 9, rgb(170, 230, 255))
		end
	end
	summit(folder)
	caveEntrance(folder)

	for _ = 1, 24 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * 250
		local pos, normal = Build.ground(c.X + math.cos(a) * r, c.Y + math.sin(a) * r)
		if pos and normal.Y > 0.86 and pos.Y > 4 and pos.Y < 130 then
			addSlot(pos, "Snow")
		end
	end
	-- os blocos de gelo aparecem mais no lago
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		addSlot(Vector3.new(lake.x + math.cos(a) * 30, lake.water + 2, lake.z + math.sin(a) * 30), "Snow")
	end
end

return Snow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Volcano</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Volcano: o Vulcao Furioso e o deserto (leste). Lava na cratera, gêiseres que lancam,
	espinhos de obsidiana, piramide, cactos, oasis e a catapulta antiga.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Build = require(script.Parent:WaitForChild("Build"))
local Nature = require(script.Parent:WaitForChild("Nature"))
local WorldGen = require(script.Parent:WaitForChild("WorldGen"))
local Hub = require(script.Parent:WaitForChild("Hub"))
local Pickups = require(script.Parent.Parent:WaitForChild("Pickups"))

local Volcano = {}

local M = Enum.Material
local P = Config.Palette
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function craterGlow(folder: Folder)
	local c = Config.Biomes.Volcano.center
	local y = Build.y(c.X, c.Y)
	Volcano.craterPos = Vector3.new(c.X, y, c.Y)
	local m = Build.model(folder, "CraterGlow")
	-- disco brilhante sobre a lava
	local glow = Build.cyl(m, CFrame.new(c.X, y + 1.2, c.Y), 0.4, 62, rgb(255, 110, 30), M.Neon, { collide = false, transparency = 0.35, shadow = false })
	glow.CanQuery = false
	Build.light(glow, rgb(255, 120, 40), 6, 120, false)
	Build.pulse(glow, 3, 8, 3)

	-- brasas + fumaca subindo
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, 6, 0)
	att.Parent = glow
	local embers = Instance.new("ParticleEmitter")
	embers.Texture = FIRE
	embers.Rate = 30
	embers.Lifetime = NumberRange.new(3, 6)
	embers.Speed = NumberRange.new(20, 50)
	embers.EmissionDirection = Enum.NormalId.Top
	embers.SpreadAngle = Vector2.new(22, 22)
	embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.4), NumberSequenceKeypoint.new(1, 0) })
	embers.Color = ColorSequence.new(rgb(255, 220, 90), rgb(255, 70, 20))
	embers.LightEmission = 1
	embers.Acceleration = Vector3.new(0, -8, 0)
	embers.Parent = att
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = SMOKE
	smoke.Rate = 10
	smoke.Lifetime = NumberRange.new(6, 10)
	smoke.Speed = NumberRange.new(14, 26)
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.SpreadAngle = Vector2.new(14, 14)
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 10), NumberSequenceKeypoint.new(1, 60) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	smoke.Color = ColorSequence.new(rgb(70, 62, 72))
	smoke.Parent = att

	-- rochas de lava flutuando (bolhas de magma)
	local rng = Random.new(Config.World.Seed + 5)
	for i = 1, 9 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(4, 24)
		local b = Build.ball(m, CFrame.new(c.X + math.cos(a) * r, y + 2, c.Y + math.sin(a) * r), rng:NextNumber(2, 4.5), rgb(255, 150, 40), M.Neon, { collide = false, shadow = false })
		Build.bob(b, 1.2, 1.6 + rng:NextNumber(0, 1.5))
	end
end

local function geyser(folder: Folder, pos: Vector3)
	local m = Build.model(folder, "Geyser")
	Build.cyl(m, CFrame.new(pos + Vector3.new(0, 0.8, 0)), 1.6, 9, rgb(50, 44, 58), M.Basalt)
	local rim = Build.cyl(m, CFrame.new(pos + Vector3.new(0, 1.7, 0)), 0.3, 7, rgb(255, 120, 40), M.Neon, { name = "PadTop" })
	Build.tag(rim, "TV_JumpPad", { Power = 150, DirX = 0, DirY = 1, DirZ = 0 })
	Build.pulse(rim, 1, 4, 1.7)
	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, 1, 0)
	att.Parent = rim
	local steam = Instance.new("ParticleEmitter")
	steam.Texture = SMOKE
	steam.Rate = 16
	steam.Lifetime = NumberRange.new(1.4, 2.4)
	steam.Speed = NumberRange.new(30, 50)
	steam.EmissionDirection = Enum.NormalId.Top
	steam.SpreadAngle = Vector2.new(8, 8)
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 10) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	steam.Color = ColorSequence.new(rgb(255, 230, 210))
	steam.Parent = att
end

local function spire(folder: Folder, pos: Vector3, rng: Random)
	local h = rng:NextNumber(14, 34)
	local cf = CFrame.new(pos + Vector3.new(0, h * 0.4, 0)) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, 6.28), rng:NextNumber(-0.15, 0.15))
	Build.block(folder, cf, Vector3.new(rng:NextNumber(4, 7), h, rng:NextNumber(4, 7)), rgb(30, 26, 44), M.Basalt)
	if rng:NextNumber() < 0.4 then
		local crack = Build.block(folder, cf * CFrame.new(0, h * 0.1, 2.9), Vector3.new(0.6, h * 0.6, 0.3), rgb(255, 110, 30), M.Neon, { collide = false, shadow = false })
		Build.pulse(crack, 0.5, 2.5, 2.2)
	end
end

local function pyramid(folder: Folder, x: number, z: number)
	local y = Build.y(x, z)
	local m = Build.model(folder, "Pyramid")
	local size = 64
	local layers = 9
	Build.foundation(m, CFrame.new(x, y, z), Vector3.new(size + 4, 1, size + 4), rgb(220, 180, 120), M.Sandstone)
	for i = 0, layers - 1 do
		local s = size * (1 - i / layers)
		Build.block(m, CFrame.new(x, y + 3.6 * i + 2, z), Vector3.new(s, 3.6, s), rgb(236 - i * 3, 196 - i * 3, 128), M.Sandstone)
	end
	local cap = Build.block(m, CFrame.new(x, y + 3.6 * layers + 2.2, z), Vector3.new(6, 4, 6), P.Accent, M.Neon)
	Build.light(cap, P.Accent, 3, 60, false)
	Build.bob(cap, 0.5, 3)
	Build.spin(cap, "Y", 30)
	Build.billboard(cap, "🔺 Topo da Pirâmide", { color = P.Accent, offset = Vector3.new(0, 6, 0) })
	Pickups.placeStatic(Vector3.new(x, y + 3.6 * layers + 8, z), 60, 90)
	-- entrada
	local door = Build.block(m, CFrame.new(x, y + 5, z - size / 2 - 0.05), Vector3.new(8, 10, 0.6), rgb(50, 30, 30), M.SmoothPlastic, { collide = false })
	door.Transparency = 0.1
	Nature.reserve(x, z, size * 0.8)
	Volcano.pyramidTop = Vector3.new(x, y + 3.6 * layers + 4, z)
end

local function obelisk(folder: Folder, pos: Vector3, rng: Random)
	local m = Build.model(folder, "Obelisk")
	local cf = CFrame.new(pos)
	Build.block(m, cf * CFrame.new(0, 1, 0), Vector3.new(6, 2, 6), rgb(200, 160, 100), M.Sandstone)
	Build.block(m, cf * CFrame.new(0, 12, 0), Vector3.new(3.4, 20, 3.4), rgb(230, 190, 120), M.Sandstone)
	local tip = Build.wedge(m, cf * CFrame.new(0, 23.4, 0), Vector3.new(3.4, 3.4, 3.4), rgb(255, 210, 90), M.Neon, { collide = false })
	tip.CFrame = cf * CFrame.new(0, 23.4, 0) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
	Build.pulse(tip, 0.6, 2.4, 2.5)
end

function Volcano.build(rng: Random, addSlot)
	local folder = Build.folder("Volcano")
	local c = Config.Biomes.Volcano.center

	craterGlow(folder)

	-- gêiseres em anel ao redor da base
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + 0.2
		local r = 150 + (i % 3) * 18
		local x, z = c.X + math.cos(a) * r, c.Y + math.sin(a) * r
		local pos, normal, mat = Build.ground(x, z)
		if pos and normal.Y > 0.8 and mat ~= M.Water then
			geyser(folder, pos)
		end
	end

	-- espinhos de obsidiana
	Nature.scatter(folder, rng, 60, {
		center = c,
		radius = 210,
		materials = { [M.Basalt] = true, [M.Slate] = true, [M.Rock] = true },
		kinds = { { "spire", 1 } },
		scale = { 1, 1 },
		minNormalY = 0.5,
		minY = 20,
		clearance = 3,
		place = function(parent, pos, _, _, r)
			spire(parent, pos, r)
		end,
	})

	-- deserto
	pyramid(folder, c.X + 190, c.Y + 190)
	for i = 1, 5 do
		local a = rng:NextNumber(0, math.pi * 2)
		local pos = Build.ground(c.X + math.cos(a) * 200, c.Y + math.sin(a) * 200)
		if pos and pos.Y > 4 then
			obelisk(folder, pos, rng)
		end
	end
	Nature.scatter(folder, rng, 70, {
		center = c,
		radius = 300,
		materials = Nature.SAND,
		kinds = { { "cactus", 5 }, { "palm", 1 } },
		scale = { 0.8, 1.8 },
		minNormalY = 0.85,
		clearance = 4,
	})
	Nature.rocks(folder, rng, 24, { center = c, radius = 300, materials = Nature.SAND, color = rgb(220, 170, 120), clearance = 3 })

	-- palmeiras no oasis
	local oasis = WorldGen.Lakes[3]
	for i = 0, 8 do
		local a = i / 9 * math.pi * 2
		local pos = Build.ground(oasis.x + math.cos(a) * (oasis.r + 6), oasis.z + math.sin(a) * (oasis.r + 6))
		if pos then
			Build.tree(folder, pos, "palm", rng:NextNumber(1.1, 1.6), rng, Vector3.new(0.1, 0, 0.08))
		end
	end

	Hub.jumpPad(folder, Vector3.new(c.X - 90, Build.y(c.X - 90, c.Y) + 1.6, c.Y), 130, rgb(255, 120, 40), Vector3.new(-0.4, 1, 0))

	for _ = 1, 22 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * 240
		local pos, normal = Build.ground(c.X + math.cos(a) * r, c.Y + math.sin(a) * r)
		if pos and normal.Y > 0.85 and pos.Y > 4 and pos.Y < 110 then
			addSlot(pos, "Volcano")
		end
	end
end

return Volcano
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">WorldGen</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	WorldGen: gera o terreno (Terrain:WriteVoxels) a partir de uma funcao de altura.
	  - Praca central plana, Fazenda (oeste), Montanha Gelada (norte),
	    Vulcao (leste), Praia + mar (sul)
	  - Estradas de pedra ligando a praca aos biomas, lagos, lago congelado, cratera com lava
	  - Ilhas flutuantes (rocha + grama) no ceu
	A funcao WorldGen.height(x, z) e deterministica e usada pelo resto do mundo para colocar coisas.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local WorldGen = {}

local W = Config.World
local B = Config.Biomes
local SEED = W.Seed % 1000 * 0.137
local VOX = W.Voxel

local floor, sqrt, exp, abs, max = math.floor, math.sqrt, math.exp, math.abs, math.max
local smooth, saturate = Util.smoothstep, Util.saturate

-- Ruido -------------------------------------------------------------------------------------

local function fbm(x: number, z: number, freq: number, oct: number, off: number): number
	local amp, sum, norm = 1, 0, 0
	local f = freq
	for i = 1, oct do
		sum += amp * math.noise(x * f + off + 0.113 * i, z * f + off * 1.31 + 0.377 * i, SEED + 7.7 * i)
		norm += amp
		amp *= 0.5
		f *= 2
	end
	return (sum / norm) * 2 -- aproximadamente [-1, 1]
end

-- Lagos (x, z, raio, altura da agua, congelado?)
WorldGen.Lakes = {
	{ x = -560, z = -170, r = 70, water = 13, frozen = false, name = "Lagoa da Fazenda" },
	{ x = 150, z = -320, r = 55, water = 30, frozen = true, name = "Lago Congelado" },
	{ x = 390, z = -270, r = 45, water = 22, frozen = false, name = "Oásis" },
}

-- Estradas: do centro da praca ate cada bioma
local ROADS = {}
for key, b in B do
	if key ~= "Hub" then
		table.insert(ROADS, { a = Vector2.new(0, 0), b = b.center })
	end
end

local function distToSegment(px: number, pz: number, a: Vector2, b: Vector2): number
	local abx, abz = b.X - a.X, b.Y - a.Y
	local t = ((px - a.X) * abx + (pz - a.Y) * abz) / (abx * abx + abz * abz)
	t = saturate(t)
	local cx, cz = a.X + abx * t, a.Y + abz * t
	return sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end

function WorldGen.roadDistance(x: number, z: number): number
	local best = 1e9
	for _, r in ROADS do
		local d = distToSegment(x, z, r.a, r.b)
		if d < best then
			best = d
		end
	end
	return best
end

-- Pesos dos biomas em (x, z)
local function weights(x: number, z: number)
	local ws = {}
	local total = 0
	for key, b in B do
		if key ~= "Hub" then
			local dx, dz = x - b.center.X, z - b.center.Y
			local d = sqrt(dx * dx + dz * dz)
			local w = exp(-((d / (b.radius * 1.05)) ^ 2))
			ws[key] = { w = w, d = d }
			total += w
		end
	end
	return ws, max(total, 1e-6)
end

-- Altura de cada bioma ---------------------------------------------------------------------------

local function hFarm(x, z)
	return 21 + 22 * fbm(x, z, 0.0042, 4, 1.0) + 5 * fbm(x, z, 0.02, 2, 2.0)
end

local function hSnow(x, z, d)
	local cone = max(0, 1 - d / 310)
	local ridge = 1 - abs(fbm(x, z, 0.009, 4, 3.0))
	return 26 + 250 * (cone ^ 1.35) * (0.5 + 0.5 * ridge) + 10 * fbm(x, z, 0.03, 3, 4.0) * (0.3 + cone)
end

local function hVolcano(x, z, d)
	local r = d / 270
	local cone = max(0, 1 - r)
	local h = 24 + 178 * (cone ^ 1.12) + 9 * fbm(x, z, 0.022, 3, 5.0)
	-- cratera: prato no topo (r < 0.2)
	local bowl = 1 - smooth(0.06, 0.22, r)
	h -= 74 * bowl
	return h
end

local function hBeach(x, z)
	-- terra firme ate z ~ 380, depois desce suavemente para o mar (linha da costa em z ~ 410)
	local t = saturate((z - 30) / 470)
	return 25 - 44 * smooth(0.55, 1.0, t) + 4 * fbm(x, z, 0.018, 3, 6.0) + 5 * smooth(0.0, 0.3, t) * fbm(x, z, 0.045, 2, 8.0)
end

-- Altura final do terreno em (x, z)
function WorldGen.height(x: number, z: number): number
	local d = sqrt(x * x + z * z)

	local ws, total = weights(x, z)
	local h = 0
	h += ws.Farm.w * hFarm(x, z)
	h += ws.Snow.w * hSnow(x, z, ws.Snow.d)
	h += ws.Volcano.w * hVolcano(x, z, ws.Volcano.d)
	h += ws.Beach.w * hBeach(x, z)
	h /= total

	-- praca central plana e suave
	local t = smooth(W.HubRadius, W.HubRadius + 130, d)
	h = Util.lerp(W.HubHeight, h, t)

	-- lagos
	for _, lake in WorldGen.Lakes do
		local dl = sqrt((x - lake.x) ^ 2 + (z - lake.z) ^ 2)
		local m = 1 - smooth(lake.r * 0.72, lake.r, dl)
		if m > 0 then
			local target = lake.frozen and lake.water or (lake.water - 9)
			h = Util.lerp(h, target, m)
		end
	end

	-- estradas: achatam um pouco e ficam mais lisas
	local rd = WorldGen.roadDistance(x, z)
	if rd < 12 and d > W.HubRadius - 20 then
		local rm = (1 - smooth(4, 12, rd)) * 0.55
		local smoothH = W.HubHeight + (h - W.HubHeight) * 0.6
		h = Util.lerp(h, smoothH, rm)
	end

	-- oceano ao redor da ilha
	local dw = d + 110 * fbm(x, z, 0.0032, 3, 9.0)
	local mask = 1 - smooth(W.IslandRadius - 210, W.IslandRadius + 20, dw)
	local seabed = -40 + 8 * fbm(x, z, 0.01, 2, 10.0)
	h = seabed + (h - seabed) * (mask ^ 0.85)

	return h
end

-- Material da superficie ----------------------------------------------------------------------------

local M = Enum.Material

local function surfaceMaterial(x: number, z: number, h: number, slope: number, ws, total: number)
	local sea = W.SeaLevel
	-- lagos
	for _, lake in WorldGen.Lakes do
		if lake.frozen then
			local dl = sqrt((x - lake.x) ^ 2 + (z - lake.z) ^ 2)
			if dl < lake.r * 0.82 then
				return M.Ice
			end
		end
	end

	-- pesos "crus" (gaussianas): as fronteiras ficam redondas em vez de em cunha
	local nz = fbm(x, z, 0.012, 3, 20.0) * 0.14
	local wSnow = ws.Snow.w + nz
	local wVol = ws.Volcano.w + nz
	local wFarm = ws.Farm.w + nz
	local wBeach = ws.Beach.w + nz
	local d = sqrt(x * x + z * z)

	-- fundo do mar e praia
	if h < sea - 30 then
		return M.Slate
	elseif h < sea + 4.5 + (wBeach > 0.3 and 6 or 0) then
		return M.Sand
	end

	-- estradas de pedra
	if d > W.HubRadius - 10 and WorldGen.roadDistance(x, z) < 4.6 and h > sea + 5 then
		return M.Cobblestone
	end

	-- vulcao
	if wVol > 0.42 then
		local r = ws.Volcano.d / 270
		if r < 0.13 then
			return M.CrackedLava
		end
		if r < 0.7 then
			return (slope > 1.2 or h > 110) and M.Basalt or (fbm(x, z, 0.06, 2, 11) > 0.1 and M.Slate or M.Basalt)
		end
		return fbm(x, z, 0.05, 2, 12) > -0.2 and M.Sand or M.Sandstone
	elseif wVol > 0.2 then
		return fbm(x, z, 0.05, 2, 12) > -0.2 and M.Sand or M.Sandstone
	end

	-- neve
	if wSnow > 0.36 then
		if h > 150 and slope > 1.3 then
			return M.Rock
		end
		if h > 95 then
			return M.Snow
		end
		if slope > 1.4 then
			return M.Rock
		end
		return (fbm(x, z, 0.04, 2, 13) > 0.5) and M.Glacier or M.Snow
	end

	if slope > 1.35 then
		return M.Rock
	end
	if wFarm > 0.3 then
		-- campos: faixas de terra e grama
		if math.sin(x * 0.045 + fbm(x, z, 0.01, 2, 14) * 3) > 0.82 and abs(z + 100) < 260 then
			return M.Ground
		end
		return (fbm(x, z, 0.08, 2, 15) > 0.15) and M.LeafyGrass or M.Grass
	end
	return M.Grass
end

-- Material + altura + inclinacao em (x, z) (usado por cenario e pelo simulador)
function WorldGen.materialAt(x: number, z: number)
	local h = WorldGen.height(x, z)
	local dx = (WorldGen.height(x + VOX, z) - WorldGen.height(x - VOX, z)) / (2 * VOX)
	local dz = (WorldGen.height(x, z + VOX) - WorldGen.height(x, z - VOX)) / (2 * VOX)
	local slope = sqrt(dx * dx + dz * dz) * 1.6
	local ws, total = weights(x, z)
	return surfaceMaterial(x, z, h, slope, ws, total), h, slope
end

-- Escrita do terreno ----------------------------------------------------------------------------------------

local CHUNK = 64 -- voxels por chunk (256 studs)

local function writeChunk(terrain: Terrain, cx: number, cz: number)
	local x0 = -W.Half + cx * CHUNK * VOX
	local z0 = -W.Half + cz * CHUNK * VOX
	local n = CHUNK

	-- grade de alturas com borda de 1 celula (para inclinacao)
	local hg = table.create(n + 2)
	local hmax = W.SeaLevel + 8
	for i = 0, n + 1 do
		local row = table.create(n + 2)
		local x = x0 + (i - 0.5) * VOX
		for k = 0, n + 1 do
			local z = z0 + (k - 0.5) * VOX
			local h = WorldGen.height(x, z)
			row[k] = h
			if h > hmax then
				hmax = h
			end
		end
		hg[i] = row
	end

	local yMin = W.BedrockY
	local yTop = math.ceil((hmax + 8) / VOX) * VOX
	local ny = (yTop - yMin) // VOX
	local mats = table.create(n)
	local occ = table.create(n)
	local sea = W.SeaLevel

	for i = 1, n do
		local mx = table.create(ny)
		local ox = table.create(ny)
		for y = 1, ny do
			mx[y] = table.create(n, M.Air)
			ox[y] = table.create(n, 0)
		end
		mats[i] = mx
		occ[i] = ox
	end

	for i = 1, n do
		local x = x0 + (i - 0.5) * VOX
		for k = 1, n do
			local z = z0 + (k - 0.5) * VOX
			local h = hg[i][k]
			local dx = (hg[i + 1][k] - hg[i - 1][k]) / (2 * VOX)
			local dz = (hg[i][k + 1] - hg[i][k - 1]) / (2 * VOX)
			local slope = sqrt(dx * dx + dz * dz) * 1.6 -- ~ 1 = 45 graus aproximado
			local ws, total = weights(x, z)
			local surf = surfaceMaterial(x, z, h, slope, ws, total)
			local deepMat = M.Rock
			if surf == M.Sand then
				deepMat = M.Sandstone
			elseif surf == M.Basalt or surf == M.CrackedLava then
				deepMat = M.Basalt
			elseif surf == M.Slate then
				deepMat = M.Slate
			end

			-- indice do voxel do topo
			local top = floor((h - yMin) / VOX) + 1
			top = math.clamp(top, 1, ny)
			for y = 1, top do
				local vb = yMin + (y - 1) * VOX
				local frac = 1
				if y == top then
					frac = math.clamp((h - vb) / VOX, 0.05, 1)
				end
				local depth = top - y
				local m = surf
				if depth > 2 then
					m = deepMat
				elseif depth > 0 and surf == M.Grass then
					m = M.Ground
				elseif depth > 0 and surf == M.LeafyGrass then
					m = M.Ground
				end
				mats[i][y][k] = m
				occ[i][y][k] = frac
			end

			-- agua do mar
			if h < sea then
				local wTop = math.min(ny, floor((sea - yMin) / VOX) + 1)
				for y = top + 1, wTop do
					local vb = yMin + (y - 1) * VOX
					mats[i][y][k] = M.Water
					occ[i][y][k] = math.clamp((sea - vb) / VOX, 0.05, 1)
				end
			end
			-- agua dos lagos
			for _, lake in WorldGen.Lakes do
				if not lake.frozen then
					local dl = sqrt((x - lake.x) ^ 2 + (z - lake.z) ^ 2)
					if dl < lake.r * 0.94 and h < lake.water then
						local wTop = math.min(ny, floor((lake.water - yMin) / VOX) + 1)
						for y = top + 1, wTop do
							local vb = yMin + (y - 1) * VOX
							mats[i][y][k] = M.Water
							occ[i][y][k] = math.clamp((lake.water - vb) / VOX, 0.05, 1)
						end
					end
				end
			end
		end
	end

	local region = Region3.new(Vector3.new(x0, yMin, z0), Vector3.new(x0 + n * VOX, yMin + ny * VOX, z0 + n * VOX))
	terrain:WriteVoxels(region, VOX, mats, occ)
end

local function paintTerrain(terrain: Terrain)
	local function c(mat, r, g, b)
		terrain:SetMaterialColor(mat, Color3.fromRGB(r, g, b))
	end
	c(M.Grass, 104, 212, 72)
	c(M.LeafyGrass, 70, 186, 88)
	c(M.Ground, 156, 108, 72)
	c(M.Mud, 122, 88, 62)
	c(M.Sand, 250, 226, 156)
	c(M.Sandstone, 232, 176, 110)
	c(M.Rock, 128, 122, 140)
	c(M.Slate, 88, 96, 118)
	c(M.Basalt, 66, 58, 76)
	c(M.CrackedLava, 255, 106, 24)
	c(M.Snow, 244, 250, 255)
	c(M.Glacier, 178, 226, 250)
	c(M.Ice, 168, 226, 255)
	c(M.Cobblestone, 176, 168, 190)
	c(M.Pavement, 190, 190, 200)
	pcall(function()
		terrain.WaterColor = Color3.fromRGB(58, 196, 236)
		terrain.WaterTransparency = 0.72
		terrain.WaterReflectance = 0.9
		terrain.WaterWaveSize = 0.32
		terrain.WaterWaveSpeed = 12
	end)
end

-- Ilhas flutuantes ---------------------------------------------------------------------------------------------------

WorldGen.SkyIslands = {
	{ id = "Arena", pos = Vector3.new(0, W.SkyY, -40), radius = 105, name = "Ilha da Arena" },
	{ id = "Crystal", pos = Vector3.new(310, W.SkyY + 45, 260), radius = 62, name = "Ilha dos Cristais" },
	{ id = "Boss", pos = Vector3.new(-340, W.SkyY + 10, -230), radius = 118, name = "Ilha do Golem" },
	{ id = "Treasure", pos = Vector3.new(-120, W.SkyY + 125, 320), radius = 46, name = "Ilha do Tesouro" },
	{ id = "Garden", pos = Vector3.new(360, W.SkyY - 30, -330), radius = 74, name = "Jardim Flutuante" },
}

local function buildSkyIslands(terrain: Terrain)
	for _, isl in WorldGen.SkyIslands do
		local p, r = isl.pos, isl.radius
		-- corpo de rocha: pilha de esferas cada vez menores para baixo
		local steps = 7
		for s = 0, steps do
			local t = s / steps
			local rr = r * (1 - t * 0.85) * 0.92
			terrain:FillBall(p - Vector3.new(0, 6 + t * r * 0.9, 0), math.max(rr, 6), M.Rock)
		end
		-- topo plano de grama (cilindro com eixo Y)
		terrain:FillCylinder(CFrame.new(p), 10, r, M.Ground)
		terrain:FillCylinder(CFrame.new(p + Vector3.new(0, 4.5, 0)), 3, r * 0.985, M.Grass)
		task.wait()
	end
end

WorldGen.islandTop = function(isl): number
	return isl.pos.Y + 6
end

function WorldGen.getIsland(id: string)
	for _, isl in WorldGen.SkyIslands do
		if isl.id == id then
			return isl
		end
	end
	return nil
end

-- Cavernas: tuneis escavados na montanha ------------------------------------------------------------------------------------

WorldGen.Cave = {
	entrance = Vector3.new(-200, 0, -470), -- y calculado
	direction = Vector3.new(1, 0, 0),
}

local function carveCave(terrain: Terrain)
	local e = WorldGen.Cave.entrance
	local y = WorldGen.height(e.X, e.Z) + 6
	local start = Vector3.new(e.X, y, e.Z)
	WorldGen.Cave.entranceWorld = start
	local dir = WorldGen.Cave.direction
	-- tunel inclinado para baixo e depois camara grande
	for i = 0, 22 do
		local pos = start + dir * (i * 7) + Vector3.new(0, -i * 1.6 + math.sin(i * 0.5) * 3, math.sin(i * 0.37) * 8)
		terrain:FillBall(pos, 11 + math.sin(i * 0.8) * 2, M.Air)
	end
	local chamber = start + dir * 190 + Vector3.new(0, -32, 0)
	terrain:FillBall(chamber, 52, M.Air)
	terrain:FillBall(chamber + Vector3.new(30, 8, 20), 30, M.Air)
	terrain:FillBall(chamber + Vector3.new(-25, 6, -30), 26, M.Air)
	WorldGen.Cave.chamber = chamber
end

-- API ---------------------------------------------------------------------------------------------------------------------------------------

function WorldGen.spawnPoint(): Vector3
	return Vector3.new(0, W.HubHeight + 4, 24)
end

function WorldGen.build(progress: ((number) -> ())?)
	local terrain = workspace.Terrain
	terrain:Clear()
	paintTerrain(terrain)

	local chunks = (2 * W.Half) // (CHUNK * VOX)
	local total = chunks * chunks
	local done = 0
	for cx = 0, chunks - 1 do
		for cz = 0, chunks - 1 do
			writeChunk(terrain, cx, cz)
			done += 1
			if progress then
				progress(done / total * 0.8)
			end
			task.wait()
		end
	end
	carveCave(terrain)
	if progress then
		progress(0.88)
	end
	task.wait()
	buildSkyIslands(terrain)
	if progress then
		progress(1)
	end
end

return WorldGen
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Zones</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Zones: em que regiao cada jogador esta (mostra "voce entrou em..."), zona segura
	da praca, e quedas do mundo (respawn, com credito para quem empurrou por ultimo).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Data = require(script.Parent:WaitForChild("Data"))
local Physics = require(script.Parent:WaitForChild("Physics"))

local Zones = {}

Zones.SafeRadius = 62 -- raio da zona segura no centro da praca
Zones.SafeExtra = {} -- outras zonas seguras: { { center = Vector3, radius = number } }

local SKY_NAMES = {}

function Zones.registerSkyName(center: Vector3, radius: number, name: string, icon: string?)
	table.insert(SKY_NAMES, { center = center, radius = radius, name = name, icon = icon or "☁️" })
end

function Zones.at(position: Vector3): (string, string)
	if position.Y > Config.World.SkyY - 60 then
		for _, s in SKY_NAMES do
			local flat = Vector3.new(position.X - s.center.X, 0, position.Z - s.center.Z)
			if flat.Magnitude <= s.radius + 20 then
				return s.name, s.icon
			end
		end
		return "Céu", "☁️"
	end
	local best, bestD = nil, math.huge
	for key, b in Config.Biomes do
		local d = (Vector2.new(position.X, position.Z) - b.center).Magnitude
		if d < b.radius and d < bestD then
			best, bestD = b, d
		end
	end
	if best then
		return best.name, best.icon
	end
	if position.Y < Config.World.SeaLevel - 3 then
		return "Mar Aberto", "🌊"
	end
	return "Ilha Principal", "🏝️"
end

local function isSafe(position: Vector3): boolean
	local flat = Vector3.new(position.X, 0, position.Z)
	if flat.Magnitude <= Zones.SafeRadius and position.Y < Config.World.SkyY - 60 then
		return true
	end
	for _, z in Zones.SafeExtra do
		if (position - z.center).Magnitude <= z.radius then
			return true
		end
	end
	return false
end

local function respawn(player: Player)
	task.wait(3)
	if player.Parent then
		Physics.loadCharacter(player)
	end
end

function Zones.init()
	local last = {}
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in Players:GetPlayers() do
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local pos = hrp.Position
					local name, icon = Zones.at(pos)
					if last[player] ~= name then
						last[player] = name
						player:SetAttribute("Zone", name)
						Remotes.get("Zone"):FireClient(player, name, icon)
					end
					local safe = isSafe(pos)
					if player:GetAttribute("SafeZone") ~= safe then
						player:SetAttribute("SafeZone", safe)
					end
					-- caiu do mundo
					if pos.Y < Config.World.KillY then
						hum.Health = 0
					end
				end
			end
		end
	end)

	local function watch(player: Player)
		player.CharacterAdded:Connect(function(char)
			local hum = char:WaitForChild("Humanoid", 10)
			if not hum then
				return
			end
			hum.Died:Connect(function()
				-- credito para quem empurrou por ultimo (ate 12 s antes)
				local by = char:GetAttribute("LastHitBy")
				local t = char:GetAttribute("LastHitTime")
				if by and t and os.clock() - t < 12 then
					local killer = Players:GetPlayerByUserId(by)
					if killer and killer ~= player and Data.isLoaded(killer) then
						Data.addCoins(killer, 25, "derrubou " .. player.DisplayName)
						Data.addXP(killer, 20)
					end
				end
				respawn(player)
			end)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		last[p] = nil
	end)
end

return Zones
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="50">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">70</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="51">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="52">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	TUDO VOA! — Ilhas do Caos
	Script principal do cliente: inicia a interface e todos os sistemas locais.
	Cada modulo e carregado/iniciado de forma protegida: se um falhar, o resto do jogo continua.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

-- espera o servidor criar os remotes
Remotes.get("ClientReady")

-- esconde a mochila padrao (nao usamos ferramentas); mantem a lista de jogadores
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local function load(parent: Instance, name: string): any
	local ok, mod = xpcall(function()
		return require(parent:WaitForChild(name, 20))
	end, debug.traceback)
	if not ok then
		warn("[Cliente] falha ao carregar '" .. name .. "':\n" .. tostring(mod))
		return nil
	end
	return mod
end

local function start(name: string, mod: any)
	if mod and type(mod.init) == "function" then
		local ok, err = xpcall(mod.init, debug.traceback)
		if not ok then
			warn("[Cliente] falha ao iniciar '" .. name .. "':\n" .. tostring(err))
		end
	end
end

local UI = script:WaitForChild("UI")
local Store = load(script, "Store")
local Loading = load(UI, "Loading")
local HUD = load(UI, "HUD")
local Menu = load(UI, "Menu")
local Mobile = load(UI, "Mobile")
local Tutorial = load(UI, "Tutorial")
local QuestPanel = load(UI, "QuestPanel")
local Fx = load(script, "Fx")
local GrabController = load(script, "GrabController")
local Tether = load(script, "Tether")
local Pose = load(script, "Pose")
local ToyPhysics = load(script, "ToyPhysics")
local Movement = load(script, "Movement")
local DecorAnim = load(script, "DecorAnim")
local AbilityBar = load(script, "AbilityBar")
local Ambient = load(script, "Ambient")

-- ordem importa: carregamento e dados primeiro
start("Loading", Loading)
start("Store", Store)
start("Fx", Fx)
start("HUD", HUD)
start("Menu", Menu)
start("QuestPanel", QuestPanel)
start("Tether", Tether)
start("GrabController", GrabController)
start("Pose", Pose)
start("ToyPhysics", ToyPhysics)
start("Movement", Movement)
start("DecorAnim", DecorAnim)
start("AbilityBar", AbilityBar)
start("Ambient", Ambient)
start("Mobile", Mobile)

-- modulos de atividades do cliente (chefao, arena, eventos...)
local Activities = script:FindFirstChild("Activities")
if Activities then
	for _, mod in Activities:GetChildren() do
		if mod:IsA("ModuleScript") then
			start(mod.Name, load(Activities, mod.Name))
		end
	end
end

-- interacoes por tecla E (ProximityPrompt)
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local id = prompt:GetAttribute("Id")
	if id == "shop" and Menu then
		Menu.open("shop")
	end
end)

-- tira a tela de carregamento quando o mundo, os dados e o personagem estiverem prontos
task.spawn(function()
	local t0 = os.clock()
	while os.clock() - t0 < 120 do
		local worldReady = workspace:GetAttribute("TV_WorldReady") == true
		local char = player.Character
		local hasChar = char and char:FindFirstChild("HumanoidRootPart") ~= nil
		if worldReady and hasChar and ((Store and Store.loaded) or os.clock() - t0 > 20) then
			break
		end
		task.wait(0.2)
	end
	if Loading then
		Loading.finish()
	end
	start("Tutorial", Tutorial)
end)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">AbilityBar</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	AbilityBar: barra de habilidades (teclas 1-7 ou toque), recargas, mira das habilidades,
	corda do gancho e bolha do escudo (visiveis para todos).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local AbilityDefs = require(Shared:WaitForChild("AbilityDefs"))

local Store = require(script.Parent:WaitForChild("Store"))
local Audio = require(script.Parent:WaitForChild("Audio"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Movement = require(script.Parent:WaitForChild("Movement"))
local GrabController = require(script.Parent:WaitForChild("GrabController"))
local HUD = require(script.Parent:WaitForChild("UI"):WaitForChild("HUD"))
local Theme = require(script.Parent:WaitForChild("UI"):WaitForChild("Theme"))

local AbilityBar = {}

local player = Players.LocalPlayer
local P = Theme.P

local slots = {} -- [id] = { def, frame, cdFill, cdText, lock, keyLabel }
local cooldownEnd = {} -- [id] = os.clock()
local cooldownTotal = {}

local function unlocked(def): boolean
	return (Store.get("Level") or 1) >= def.level
end

-- Construcao da barra -----------------------------------------------------------------------------------------------------------------

local function buildSlot(def, order: number)
	local f = Theme.new("TextButton", {
		Name = "Slot_" .. def.id,
		Size = UDim2.fromOffset(68, 68),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.1,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		ClipsDescendants = true,
		Parent = HUD.abilityBar,
	})
	Theme.corner(f, 14)
	Theme.stroke(f, P.White, 2, 0.7)
	Theme.gradient(f, P.PanelLight, P.Ink, 90)
	local icon = Theme.text(f, { text = def.icon, size = 34, frame = UDim2.new(1, 0, 0, 44), position = UDim2.fromOffset(0, 6) })
	local key = Theme.text(f, { text = def.keyLabel, size = 13, font = Theme.Title, color = P.Accent, alignX = Enum.TextXAlignment.Left, frame = UDim2.fromOffset(20, 16), position = UDim2.fromOffset(6, 3), stroke = 0.4 })
	local name = Theme.text(f, { text = def.name, size = 9, font = Theme.Bold, color = P.Muted, frame = UDim2.new(1, -4, 0, 12), position = UDim2.new(0, 2, 1, -14), wrap = false })
	local cdFill = Theme.new("Frame", { Name = "Cooldown", Size = UDim2.fromScale(1, 0), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, ZIndex = 5, Parent = f })
	local cdText = Theme.text(f, { text = "", size = 22, font = Theme.Title, z = 6, stroke = 0.3 })
	local lock = Theme.new("Frame", { Name = "Lock", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(10, 10, 24), BackgroundTransparency = 0.25, ZIndex = 7, Parent = f })
	Theme.text(lock, { text = "🔒\nNv " .. def.level, size = 15, font = Theme.Title, z = 8 })
	f.Activated:Connect(function()
		AbilityBar.activate(def)
	end)
	f.MouseEnter:Connect(function()
		Theme.tween(f, 0.1, { Size = UDim2.fromOffset(72, 72) })
	end)
	f.MouseLeave:Connect(function()
		Theme.tween(f, 0.1, { Size = UDim2.fromOffset(68, 68) })
	end)
	slots[def.id] = { def = def, frame = f, cdFill = cdFill, cdText = cdText, lock = lock, icon = icon, key = key, name = name }
end

local function refreshLocks()
	for _, s in slots do
		s.lock.Visible = not unlocked(s.def)
	end
end

-- Ativacao ---------------------------------------------------------------------------------------------------------------------------------

local function startCooldown(def)
	local total = def.cooldown * Store.cooldownScale()
	cooldownEnd[def.id] = os.clock() + total
	cooldownTotal[def.id] = total
end

function AbilityBar.activate(def)
	local slot = slots[def.id]
	if not unlocked(def) then
		HUD.toast(def.name .. " libera no nível " .. def.level, "bad")
		Audio.ui("Error", 0.3)
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return
	end
	if Movement.isRagdolled() then
		return
	end
	if cooldownEnd[def.id] and os.clock() < cooldownEnd[def.id] - 0.1 then
		Audio.ui("Error", 0.2, 1.4)
		if slot then
			Theme.tween(slot.frame, 0.08, { Rotation = 6 })
			task.delay(0.08, function()
				Theme.tween(slot.frame, 0.1, { Rotation = 0 })
			end)
		end
		return
	end

	local arg = nil
	if def.id == "pull" then
		local _, key = GrabController.aimTarget(def.range)
		if not key or (key.Parent and key.Parent:FindFirstChildOfClass("Humanoid")) then
			HUD.toast("Mire em um objeto para puxar", "bad")
			return
		end
		arg = key
	elseif def.id == "stasis" then
		local holds = GrabController.getHolds()
		if holds[1] and holds[1].kind == "object" then
			arg = holds[1].key
			GrabController.dropAll()
		else
			local _, key = GrabController.aimTarget(def.range)
			if not key then
				HUD.toast("Mire em um objeto (ou segure um) para congelar", "bad")
				return
			end
			arg = key
		end
	elseif def.id == "bubble" then
		local pt = GrabController.aimWorldPoint(def.range)
		if not pt then
			local cam = workspace.CurrentCamera
			pt = cam.CFrame.Position + cam.CFrame.LookVector * 40
		end
		arg = pt
	elseif def.id == "hook" then
		local pt = GrabController.aimWorldPoint(def.range)
		if not pt then
			HUD.toast("Mire em uma superfície para usar o gancho", "bad")
			return
		end
		arg = pt
	elseif def.id == "dash" then
		Movement.dash()
	elseif def.id == "shock" then
		Fx.shake(0.4)
	end

	Remotes.get("UseAbility"):FireServer(def.id, arg)
	startCooldown(def)
	Audio.ui("Charge", 0.35, 1.2 + (slot and slot.def.index or 1) * 0.06)
end

-- Efeitos remotos (todos veem) -------------------------------------------------------------------------------------------------------------

local ropes = {} -- [player] = { part, beam, a0 }
local shields = {} -- [player] = part

local function handOf(char: Model): BasePart?
	return char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
end

local function updateRope(p: Player)
	local point = p:GetAttribute("HookPoint")
	local rec = ropes[p]
	if typeof(point) == "Vector3" then
		local char = p.Character
		local hand = char and handOf(char)
		if not hand then
			return
		end
		if not rec then
			local anchor = Instance.new("Part")
			anchor.Anchored = true
			anchor.CanCollide = false
			anchor.CanQuery = false
			anchor.CanTouch = false
			anchor.Transparency = 1
			anchor.Size = Vector3.one
			anchor.Position = point
			anchor.Parent = workspace
			local a1 = Instance.new("Attachment")
			a1.Parent = anchor
			local a0 = Instance.new("Attachment")
			a0.Name = "TV_HookA0"
			a0.Parent = hand
			local beam = Instance.new("Beam")
			beam.Attachment0 = a0
			beam.Attachment1 = a1
			beam.Width0 = 0.3
			beam.Width1 = 0.3
			beam.Segments = 1
			beam.FaceCamera = true
			beam.Color = ColorSequence.new(Color3.fromRGB(230, 230, 240))
			beam.LightEmission = 0.4
			beam.Parent = anchor
			-- gancho na ponta
			local tip = Instance.new("Part")
			tip.Shape = Enum.PartType.Ball
			tip.Size = Vector3.one * 1.4
			tip.Color = P.Accent
			tip.Material = Enum.Material.Neon
			tip.Anchored = true
			tip.CanCollide = false
			tip.CanQuery = false
			tip.Position = point
			tip.Parent = anchor
			rec = { part = anchor, a0 = a0 }
			ropes[p] = rec
			if p == player then
				Audio.ui("Throw", 0.4, 1.7)
				Fx.fovKick(5)
			end
		end
	elseif rec then
		rec.part:Destroy()
		if rec.a0.Parent then
			rec.a0:Destroy()
		end
		ropes[p] = nil
	end
end

local function updateShield(p: Player)
	local untilT = p:GetAttribute("ShieldUntil")
	local active = type(untilT) == "number" and untilT > workspace:GetServerTimeNow()
	local part = shields[p]
	local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if active and hrp then
		if not part then
			part = Instance.new("Part")
			part.Shape = Enum.PartType.Ball
			part.Size = Vector3.one * 9
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			part.Material = Enum.Material.ForceField
			part.Color = P.Accent2
			part.Transparency = 0.35
			part.Parent = workspace
			shields[p] = part
		end
		part.CFrame = CFrame.new(hrp.Position)
		-- pisca perto do fim
		local remaining = untilT - workspace:GetServerTimeNow()
		part.Transparency = remaining < 1.5 and (0.35 + 0.4 * math.abs(math.sin(os.clock() * 14))) or 0.35
	elseif part then
		part:Destroy()
		shields[p] = nil
	end
end

local AFX = {}
function AFX.pull(_, pos)
	Fx.handlers.freeze(pos, 1)
end
function AFX.dash(userId, pos)
	Fx.handlers.bounce(pos, 1)
	Fx.handlers.shock(pos, 0.3)
	local _ = userId
end
function AFX.shield(_, pos)
	Fx.handlers.sparkle(pos)
end

function AbilityBar.init()
	for i, def in AbilityDefs.List do
		buildSlot(def, i)
	end
	refreshLocks()
	Store.Changed:Connect(function(key)
		if key == "Level" then
			refreshLocks()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		for _, def in AbilityDefs.List do
			if input.KeyCode == Enum.KeyCode[def.key] then
				AbilityBar.activate(def)
				return
			end
		end
	end)

	Remotes.get("AbilityFx").OnClientEvent:Connect(function(kind, userId, pos, extra)
		if kind == "fail" then
			-- o servidor recusou: libera a recarga local
			if type(extra) == "string" then
				cooldownEnd[extra] = nil
			end
			return
		end
		local h = AFX[kind]
		if h and typeof(pos) == "Vector3" then
			h(userId, pos, extra)
		end
	end)

	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for id, s in slots do
			local endT = cooldownEnd[id]
			if endT and now < endT then
				local total = cooldownTotal[id] or 1
				local remain = endT - now
				s.cdFill.Size = UDim2.fromScale(1, math.clamp(remain / total, 0, 1))
				s.cdText.Text = remain >= 1 and tostring(math.ceil(remain)) or string.format("%.1f", remain)
			elseif s.cdFill.Size.Y.Scale > 0 then
				s.cdFill.Size = UDim2.fromScale(1, 0)
				s.cdText.Text = ""
				local st = s.frame:FindFirstChildOfClass("UIStroke")
				if st then
					st.Transparency = 0
					Theme.tween(st, 0.4, { Transparency = 0.7 })
				end
			end
		end
		for _, p in Players:GetPlayers() do
			updateRope(p)
			updateShield(p)
		end
	end)

	Players.PlayerRemoving:Connect(function(p)
		local r = ropes[p]
		if r then
			r.part:Destroy()
			ropes[p] = nil
		end
		local s = shields[p]
		if s then
			s:Destroy()
			shields[p] = nil
		end
	end)
	local _ = Config
end

return AbilityBar
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="54">
          <Properties>
            <string name="Name">Activities</string>
          </Properties>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">ArenaUI</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	ArenaUI: painel da Arena do Caos (onda atual, robos restantes e contagem regressiva).
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Theme = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("Theme"))
local HUD = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("HUD"))
local Audio = require(script.Parent.Parent:WaitForChild("Audio"))

local ArenaUI = {}

local P = Theme.P
local frame, sub, big
local lastUpdate = 0
local lastCount = -1

function ArenaUI.init()
	frame = Theme.panel(HUD.gui, {
		size = UDim2.fromOffset(300, 80),
		position = UDim2.new(1, -16, 0, 60),
		anchor = Vector2.new(1, 0),
		visible = false,
		name = "ArenaPanel",
		color = Color3.fromRGB(80, 34, 100),
		color2 = P.Ink,
		strokeColor = P.Pink,
		strokeTransparency = 0.35,
	})
	Theme.text(frame, { text = "⚔️ ARENA DO CAOS", font = Theme.Title, size = 19, color = P.Pink, frame = UDim2.new(1, 0, 0, 26), position = UDim2.fromOffset(0, 6), stroke = 0.4 })
	sub = Theme.text(frame, { text = "", font = Theme.Bold, size = 15, color = P.White, frame = UDim2.new(1, 0, 0, 22), position = UDim2.fromOffset(0, 34) })
	big = Theme.text(HUD.gui, { text = "", font = Theme.Title, size = 90, color = P.Accent, frame = UDim2.fromOffset(300, 100), position = UDim2.fromScale(0.5, 0.34), anchor = Vector2.new(0.5, 0.5), stroke = 0.1 })
	big.Visible = false

	Remotes.get("ArenaState").OnClientEvent:Connect(function(state)
		lastUpdate = os.clock()
		frame.Visible = true
		if state.state == "idle" then
			sub.Text = "Derrube os robôs da plataforma!"
			big.Visible = false
		elseif state.state == "countdown" then
			sub.Text = string.format("Próxima onda: %d/%d", math.min(state.wave + 1, state.maxWave), state.maxWave)
			big.Visible = state.countdown > 0
			big.Text = tostring(state.countdown)
			if state.countdown ~= lastCount then
				lastCount = state.countdown
				Audio.ui("Charge", 0.3, 1 + (5 - state.countdown) * 0.1)
			end
		else
			sub.Text = string.format("Onda <b>%d</b>/%d   ·   Robôs: <b>%d</b>", state.wave, state.maxWave, state.bots)
			big.Visible = false
		end
	end)

	RunService.Heartbeat:Connect(function()
		if frame.Visible and os.clock() - lastUpdate > 2.5 then
			frame.Visible = false
			big.Visible = false
		end
	end)
end

return ArenaUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">BossUI</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	BossUI: barra de vida do chefao (Golem Sucata) + distancia ate ele.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Theme = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("Theme"))
local HUD = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("HUD"))

local BossUI = {}

local P = Theme.P
local player = Players.LocalPlayer
local frame, hpBar, hpLabel, distLabel, phaseLabel
local lastState = nil
local lastUpdate = 0

function BossUI.init()
	frame = Theme.panel(HUD.gui, {
		size = UDim2.fromOffset(560, 92),
		position = UDim2.new(0.5, 0, 0, 86),
		anchor = Vector2.new(0.5, 0),
		visible = false,
		name = "BossBar",
		color = Color3.fromRGB(70, 28, 40),
		color2 = P.Ink,
		strokeColor = P.Red,
		strokeTransparency = 0.4,
	})
	Theme.text(frame, { text = "🗿 GOLEM SUCATA", font = Theme.Title, size = 24, color = P.Accent, frame = UDim2.new(1, -20, 0, 30), position = UDim2.fromOffset(10, 6), stroke = 0.4 })
	hpBar = Theme.bar(frame, { size = UDim2.new(1, -30, 0, 22), position = UDim2.fromOffset(15, 40), color = P.Red, gradient = P.Accent, radius = 11 })
	hpLabel = Theme.text(frame, { text = "", font = Theme.Bold, size = 13, color = P.White, frame = UDim2.new(1, -30, 0, 22), position = UDim2.fromOffset(15, 40), stroke = 0.4, z = 5 })
	distLabel = Theme.text(frame, { text = "", font = Theme.Bold, size = 13, color = P.Muted, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(0.6, 0, 0, 18), position = UDim2.fromOffset(16, 67) })
	phaseLabel = Theme.text(frame, { text = "", font = Theme.Title, size = 14, color = P.Pink, alignX = Enum.TextXAlignment.Right, frame = UDim2.new(0.4, -16, 0, 18), position = UDim2.new(0.6, 0, 0, 67) })

	Remotes.get("BossState").OnClientEvent:Connect(function(state)
		lastState = state
		lastUpdate = os.clock()
		if state.active then
			frame.Visible = true
			hpBar.set(state.hp / math.max(state.maxHp, 1))
			hpLabel.Text = string.format("%s / %s", Util.formatNumber(state.hp), Util.formatNumber(state.maxHp))
			phaseLabel.Text = string.format("FASE %d/4", state.phase or 1)
		else
			frame.Visible = false
		end
	end)

	RunService.Heartbeat:Connect(function()
		if not frame.Visible or not lastState or not lastState.pos then
			return
		end
		if os.clock() - lastUpdate > 5 then
			frame.Visible = false
			return
		end
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local d = (hrp.Position - lastState.pos).Magnitude
			distLabel.Text = string.format("📍 %d studs  ·  Ilha do Golem (tubo de vento laranja)", math.floor(d))
		end
	end)
end

return BossUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">EventBanner</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	EventBanner: faixa com o evento do mundo em andamento + contagem regressiva.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Theme = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("Theme"))
local HUD = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("HUD"))

local EventBanner = {}

local P = Theme.P
local frame, label
local current = nil

function EventBanner.init()
	frame = Theme.panel(HUD.gui, {
		size = UDim2.fromOffset(380, 42),
		position = UDim2.new(0.5, 0, 0, 200),
		anchor = Vector2.new(0.5, 0),
		visible = false,
		name = "EventBanner",
		color = Color3.fromRGB(40, 60, 100),
		color2 = P.Ink,
		strokeColor = P.Accent2,
		strokeTransparency = 0.35,
		radius = 21,
	})
	label = Theme.text(frame, { text = "", font = Theme.Title, size = 19, color = P.White, stroke = 0.4 })

	Remotes.get("EventState").OnClientEvent:Connect(function(state)
		if state.active then
			current = state
			frame.Visible = true
			frame.Position = UDim2.new(0.5, 0, 0, 170)
			Theme.tween(frame, 0.4, { Position = UDim2.new(0.5, 0, 0, 200) }, Enum.EasingStyle.Back)
		else
			current = nil
			frame.Visible = false
		end
	end)

	RunService.Heartbeat:Connect(function()
		if current then
			local remain = math.max(0, (current.endsAt or 0) - workspace:GetServerTimeNow())
			label.Text = string.format("%s  %s   ·   %s", current.icon, string.upper(current.name), Util.formatTime(remain))
			if remain <= 0 then
				current = nil
				frame.Visible = false
			end
		end
	end)
end

return EventBanner
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Ambient</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Ambient: particulas ambiente que seguem o jogador e mudam com a regiao
	(polen, neve, brasas, esporos de caverna, brilhos no ceu).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Ambient = {}

local player = Players.LocalPlayer
local P = Config.Palette

local part, emitters
local currentPreset = nil
local lastIndoorCheck = 0
local indoor = false

local function ns(a, b)
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

local function makeEmitter(att: Attachment, props)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.Enabled = true
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	for k, v in props do
		e[k] = v
	end
	e.Parent = att
	return e
end

local function build()
	part = Instance.new("Part")
	part.Name = "TV_AmbientEmitter"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(110, 2, 110)
	part.Parent = workspace
	local att = Instance.new("Attachment")
	att.Parent = part
	emitters = {
		pollen = makeEmitter(att, {
			Lifetime = NumberRange.new(6, 10),
			Speed = NumberRange.new(0.5, 2),
			SpreadAngle = Vector2.new(180, 180),
			Size = ns(0.35, 0.1),
			LightEmission = 0.7,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.3), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(Color3.fromRGB(255, 240, 170), Color3.fromRGB(255, 255, 255)),
			Acceleration = Vector3.new(0.6, 0.2, 0.3),
		}),
		snow = makeEmitter(att, {
			Lifetime = NumberRange.new(6, 8),
			Speed = NumberRange.new(4, 9),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(20, 20),
			Size = ns(0.5, 0.4),
			LightEmission = 0.3,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.1), NumberSequenceKeypoint.new(1, 0.5) }),
			Color = ColorSequence.new(Color3.new(1, 1, 1)),
			Acceleration = Vector3.new(3, 0, 1.5),
		}),
		embers = makeEmitter(att, {
			Lifetime = NumberRange.new(3, 5),
			Speed = NumberRange.new(7, 14),
			EmissionDirection = Enum.NormalId.Top,
			SpreadAngle = Vector2.new(30, 30),
			Size = ns(0.6, 0),
			LightEmission = 1,
			Color = ColorSequence.new(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 70, 20)),
			Acceleration = Vector3.new(2, 4, 1),
		}),
		spores = makeEmitter(att, {
			Lifetime = NumberRange.new(5, 9),
			Speed = NumberRange.new(0.5, 3),
			SpreadAngle = Vector2.new(180, 180),
			Size = ns(0.7, 0.2),
			LightEmission = 1,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.2), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(P.Accent2, P.Pink),
			Acceleration = Vector3.new(0, 0.8, 0),
		}),
		sparkle = makeEmitter(att, {
			Lifetime = NumberRange.new(4, 7),
			Speed = NumberRange.new(1, 4),
			SpreadAngle = Vector2.new(180, 180),
			Size = ns(0.6, 0),
			LightEmission = 1,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(P.Accent2, P.Purple),
		}),
	}
end

local RATES = {
	pollen = { pollen = 5 },
	snow = { snow = 70 },
	embers = { embers = 22 },
	spores = { spores = 14 },
	sparkle = { sparkle = 8 },
}

local function setPreset(name: string)
	if name == currentPreset then
		return
	end
	currentPreset = name
	local rates = RATES[name] or {}
	for id, e in emitters do
		e.Rate = rates[id] or 0
	end
end

local function presetFor(zone: string?, y: number): string
	if indoor then
		return "spores"
	end
	if y > Config.World.SkyY - 60 then
		return "sparkle"
	end
	if zone == Config.Biomes.Snow.name then
		return "snow"
	elseif zone == Config.Biomes.Volcano.name then
		return "embers"
	elseif zone == Config.Biomes.Hub.name then
		return "sparkle"
	end
	return "pollen"
end

function Ambient.init()
	build()
	RunService.RenderStepped:Connect(function()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then
			return
		end
		local now = os.clock()
		if now - lastIndoorCheck > 1 then
			lastIndoorCheck = now
			-- ha terreno/teto acima do jogador? (caverna)
			local hit = workspace:Raycast(hrp.Position, Vector3.new(0, 90, 0))
			indoor = hit ~= nil and hit.Instance == workspace.Terrain
			setPreset(presetFor(player:GetAttribute("Zone"), hrp.Position.Y))
		end
		part.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 26, 0))
	end)
end

return Ambient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Audio (cliente): efeitos sonoros simples. Usa os sons do Roblox (Config.Sounds).
]]

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Store = require(script.Parent:WaitForChild("Store"))

local Audio = {}

local function enabled(): boolean
	return Store.setting("Sfx") ~= false
end

local function idOf(name: string): string?
	return Config.Sounds[name]
end

-- Som nao-posicional (interface / eventos do proprio jogador)
function Audio.ui(name: string, volume: number?, pitch: number?)
	if not enabled() then
		return
	end
	local id = idOf(name)
	if not id then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.PlaybackSpeed = pitch or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 5)
end

-- Som no mundo (3D)
function Audio.at(name: string, position: Vector3, volume: number?, pitch: number?, maxDist: number?)
	if not enabled() then
		return
	end
	local id = idOf(name)
	if not id then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = position
	p.Parent = workspace
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.7
	s.PlaybackSpeed = pitch or 1
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 12
	s.RollOffMaxDistance = maxDist or 220
	s.Parent = p
	s:Play()
	Debris:AddItem(p, 6)
end

-- Sons em loop presos a uma parte (vento, propulsor...). Retorna o Sound.
function Audio.loop(name: string, parent: Instance, volume: number?, pitch: number?): Sound?
	local id = idOf(name)
	if not id then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = true
	s.Volume = enabled() and (volume or 0.4) or 0
	s.PlaybackSpeed = pitch or 1
	s.RollOffMaxDistance = 160
	s.Parent = parent
	s:Play()
	return s
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">DecorAnim</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	DecorAnim: anima o cenario no CLIENTE (o servidor so marca com tags):
	  TV_Spin (gira), TV_Bob (flutua), TV_Sway (balanca), TV_Pulse (luz pulsante)
	Somente o que esta perto da camera e animado (economia de CPU).
]]

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local DecorAnim = {}

local T = Config.Tags
local recs = {} -- [inst] = rec
local active = {} -- lista de recs perto da camera
local NEAR = 300

local function pivotOf(inst: Instance): CFrame
	if inst:IsA("Model") then
		return inst:GetPivot()
	end
	return inst.CFrame
end

local function setPivot(inst: Instance, cf: CFrame)
	if inst:IsA("Model") then
		inst:PivotTo(cf)
	else
		inst.CFrame = cf
	end
end

local function approx(a: CFrame, b: CFrame): boolean
	return (a.Position - b.Position).Magnitude < 0.03 and a.LookVector:Dot(b.LookVector) > 0.9995 and a.UpVector:Dot(b.UpVector) > 0.9995
end

local function ensureRec(inst: Instance)
	local r = recs[inst]
	if not r then
		if not (inst:IsA("BasePart") or inst:IsA("Model")) then
			return nil
		end
		local base = pivotOf(inst)
		r = { inst = inst, base = base, last = base, angle = 0 }
		recs[inst] = r
	end
	return r
end

local function readAttrs(r)
	local inst = r.inst
	r.spin = CollectionService:HasTag(inst, T.Spin)
	r.bob = CollectionService:HasTag(inst, T.Bob)
	r.sway = CollectionService:HasTag(inst, T.Sway)
	r.pulse = CollectionService:HasTag(inst, T.Pulse)
	if r.spin then
		r.axis = inst:GetAttribute("SpinAxis") or "Y"
		r.speed = math.rad(inst:GetAttribute("SpinSpeed") or 30)
	end
	if r.bob then
		r.bobAmp = inst:GetAttribute("BobAmp") or 1
		r.bobPeriod = inst:GetAttribute("BobPeriod") or 3
		r.bobPhase = inst:GetAttribute("BobPhase") or 0
	end
	if r.sway then
		r.swayDeg = math.rad(inst:GetAttribute("SwayDeg") or 3)
		r.swayPeriod = inst:GetAttribute("SwayPeriod") or 4
		r.swayPhase = inst:GetAttribute("SwayPhase") or 0
	end
	if r.pulse then
		r.pMin = inst:GetAttribute("PulseMin") or 0.5
		r.pMax = inst:GetAttribute("PulseMax") or 2
		r.pPeriod = inst:GetAttribute("PulsePeriod") or 2
		r.light = inst:IsA("BasePart") and inst:FindFirstChildWhichIsA("PointLight") or inst:FindFirstChildWhichIsA("PointLight", true)
	end
end

local function onTagged(inst: Instance)
	local r = ensureRec(inst)
	if r then
		r.dirty = true
	end
end

local function onUntagged(inst: Instance)
	local r = recs[inst]
	if r then
		if not (CollectionService:HasTag(inst, T.Spin) or CollectionService:HasTag(inst, T.Bob) or CollectionService:HasTag(inst, T.Sway) or CollectionService:HasTag(inst, T.Pulse)) then
			recs[inst] = nil
		else
			r.dirty = true
		end
	end
end

local function refreshActive()
	local cam = workspace.CurrentCamera
	local cpos = cam.CFrame.Position
	table.clear(active)
	for inst, r in recs do
		if not inst.Parent then
			recs[inst] = nil
		else
			if r.dirty then
				readAttrs(r)
				r.dirty = false
			end
			if (r.base.Position - cpos).Magnitude < NEAR then
				table.insert(active, r)
			end
		end
	end
end

function DecorAnim.init()
	for _, tag in { T.Spin, T.Bob, T.Sway, T.Pulse } do
		for _, inst in CollectionService:GetTagged(tag) do
			onTagged(inst)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(onTagged)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(onUntagged)
	end

	-- luzes dos postes: acendem a noite
	local Lighting = game:GetService("Lighting")
	local lamps = {}
	local function trackLamp(p)
		if p:IsA("BasePart") then
			table.insert(lamps, p)
		end
	end
	for _, p in CollectionService:GetTagged("TV_Lamp") do
		trackLamp(p)
	end
	CollectionService:GetInstanceAddedSignal("TV_Lamp"):Connect(trackLamp)
	local lastNight = nil
	local function updateLamps()
		local t = Lighting.ClockTime
		local night = t < 5.8 or t > 18.2
		if night == lastNight then
			return
		end
		lastNight = night
		for i = #lamps, 1, -1 do
			local p = lamps[i]
			if not p.Parent then
				table.remove(lamps, i)
			else
				p.Material = night and Enum.Material.Neon or Enum.Material.SmoothPlastic
				local l = p:FindFirstChildWhichIsA("PointLight")
				if l then
					l.Enabled = night
				end
			end
		end
	end

	local acc = 0
	local accLamps = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		accLamps += dt
		if accLamps > 2 then
			accLamps = 0
			updateLamps()
		end
		if acc > 0.4 then
			acc = 0
			refreshActive()
		end
		local t = os.clock()
		for _, r in active do
			local inst = r.inst
			if inst.Parent then
				-- se o servidor mexeu no objeto (ex.: moedas), o novo pivo vira a base
				local cur = pivotOf(inst)
				if not approx(cur, r.last) then
					r.base = cur
				end
				local cf = r.base
				if r.bob then
					local off = math.sin(t * (math.pi * 2 / r.bobPeriod) + r.bobPhase) * r.bobAmp
					cf = cf + Vector3.new(0, off, 0)
				end
				if r.spin then
					r.angle += r.speed * dt
					if r.axis == "X" then
						cf = cf * CFrame.Angles(r.angle, 0, 0)
					elseif r.axis == "Z" then
						cf = cf * CFrame.Angles(0, 0, r.angle)
					else
						cf = cf * CFrame.Angles(0, r.angle, 0)
					end
				end
				if r.sway then
					local a = t * (math.pi * 2 / r.swayPeriod) + r.swayPhase
					cf = cf * CFrame.Angles(math.sin(a) * r.swayDeg, 0, math.cos(a * 0.8) * r.swayDeg * 0.7)
				end
				if r.bob or r.spin or r.sway then
					setPivot(inst, cf)
					r.last = cf
				end
				if r.pulse and r.light and r.light.Parent then
					local k = (math.sin(t * (math.pi * 2 / r.pPeriod)) + 1) / 2
					r.light.Brightness = r.pMin + (r.pMax - r.pMin) * k
				end
			end
		end
	end)
end

return DecorAnim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Fx (cliente): efeitos visuais e sonoros — impactos, explosoes, ondas, confete,
	tremor de camera, pisca vermelho ao ser atingido, numeros flutuantes.
]]

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Store = require(script.Parent:WaitForChild("Store"))
local Audio = require(script.Parent:WaitForChild("Audio"))

local Fx = {}

local P = Config.Palette
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local rng = Random.new()

-- Tremor de camera ------------------------------------------------------------------------------------------

local shakeAmount = 0

function Fx.shake(intensity: number)
	if Store.setting("Shake") == false then
		return
	end
	shakeAmount = math.min(1.6, math.max(shakeAmount, intensity))
end

function Fx.shakeAt(position: Vector3, intensity: number, maxDist: number?)
	local md = maxDist or 160
	local d = (camera.CFrame.Position - position).Magnitude
	local k = math.clamp(1 - d / md, 0, 1)
	if k > 0 then
		Fx.shake(intensity * k)
	end
end

-- Pontos de emissao ---------------------------------------------------------------------------------------------

local function anchorAt(position: Vector3, lifetime: number): (Part, Attachment)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = position
	p.Parent = workspace
	local a = Instance.new("Attachment")
	a.Parent = p
	Debris:AddItem(p, lifetime)
	return p, a
end

local function emitter(att: Attachment, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Rate = 0
	for k, v in props do
		e[k] = v
	end
	e.Parent = att
	return e
end

local function ns(a: number, b: number): NumberSequence
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

local function fadeOut(from: number?): NumberSequence
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, from or 0), NumberSequenceKeypoint.new(1, 1) })
end

-- Anel horizontal que se expande (onda de choque)
local function ring(position: Vector3, color: Color3, finalDiameter: number, time: number, thickness: number?)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.15
	p.Size = Vector3.new(thickness or 0.6, 2, 2)
	p.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(thickness or 0.6, finalDiameter, finalDiameter),
		Transparency = 1,
	}):Play()
	Debris:AddItem(p, time + 0.1)
end

local function flash(position: Vector3, color: Color3, range: number, time: number)
	local p, a = anchorAt(position, time + 0.2)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = 6
	l.Shadows = false
	l.Parent = a
	TweenService:Create(l, TweenInfo.new(time), { Brightness = 0 }):Play()
	return p
end

-- Efeitos -----------------------------------------------------------------------------------------------------------

local function matSound(mat: string?): (number, string)
	if mat == "Metal" or mat == "DiamondPlate" or mat == "CorrodedMetal" then
		return 1.5, "Impact"
	elseif mat == "Grass" or mat == "LeafyGrass" or mat == "Sand" or mat == "Snow" or mat == "Fabric" or mat == "Mud" or mat == "Ground" then
		return 1.1, "Soft"
	elseif mat == "Wood" or mat == "WoodPlanks" then
		return 0.9, "Soft"
	end
	return 1.0, "Impact"
end

local handlers = {}

function handlers.impact(pos: Vector3, mag: number, extra)
	local color = (extra and extra.color) or Color3.fromRGB(220, 220, 230)
	local _, att = anchorAt(pos, 3)
	emitter(att, {
		Texture = SMOKE,
		Lifetime = NumberRange.new(0.4, 0.9),
		Speed = NumberRange.new(8, 22 * (0.4 + mag)),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(1.2 + mag * 2, 0.2),
		Transparency = fadeOut(0.35),
		Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.5)),
		Drag = 4,
	}):Emit(math.floor(4 + mag * 12))
	if mag > 0.3 then
		emitter(att, {
			Lifetime = NumberRange.new(0.3, 0.6),
			Speed = NumberRange.new(20, 50),
			SpreadAngle = Vector2.new(180, 180),
			Size = ns(0.5, 0),
			LightEmission = 1,
			Color = ColorSequence.new(P.Accent, Color3.new(1, 1, 1)),
		}):Emit(math.floor(mag * 10))
	end
	local pitch, snd = matSound(extra and extra.mat)
	Audio.at(snd, pos, 0.25 + mag * 0.7, pitch * (0.9 + rng:NextNumber(0, 0.3)))
	Fx.shakeAt(pos, mag * 0.35, 90)
end

function handlers.explosion(pos: Vector3, scale: number)
	scale = math.max(scale, 0.6)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.Material = Enum.Material.Neon
	ball.Color = Color3.fromRGB(255, 170, 60)
	ball.Size = Vector3.one * 2
	ball.Position = pos
	ball.Parent = workspace
	TweenService:Create(ball, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * 34 * scale, Transparency = 1 }):Play()
	Debris:AddItem(ball, 0.6)
	ring(pos - Vector3.new(0, 1, 0), Color3.fromRGB(255, 220, 140), 70 * scale, 0.6, 1.2)
	ring(pos, Color3.fromRGB(255, 130, 60), 46 * scale, 0.45, 0.8)
	flash(pos, Color3.fromRGB(255, 190, 110), 90 * scale, 0.5)
	local _, att = anchorAt(pos, 4)
	emitter(att, {
		Texture = FIRE,
		Lifetime = NumberRange.new(0.6, 1.4),
		Speed = NumberRange.new(30 * scale, 80 * scale),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(6 * scale, 0.5),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 70, 20)),
		Transparency = fadeOut(0),
		Drag = 2,
	}):Emit(math.floor(50 * scale))
	emitter(att, {
		Texture = SMOKE,
		Lifetime = NumberRange.new(1.6, 3.2),
		Speed = NumberRange.new(12 * scale, 34 * scale),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(8 * scale, 24 * scale),
		Color = ColorSequence.new(Color3.fromRGB(80, 74, 84)),
		Transparency = fadeOut(0.3),
		Drag = 1.5,
	}):Emit(math.floor(22 * scale))
	Audio.at("Explosion", pos, 1, 0.85 + rng:NextNumber(0, 0.25), 420)
	Fx.shakeAt(pos, 1.3 * scale, 260)
end

function handlers.shock(pos: Vector3, scale: number)
	ring(pos - Vector3.new(0, 2, 0), P.Accent2, 86 * math.max(scale, 0.5), 0.5, 0.7)
	ring(pos - Vector3.new(0, 1, 0), Color3.new(1, 1, 1), 60 * math.max(scale, 0.5), 0.4, 0.4)
	local _, att = anchorAt(pos, 3)
	emitter(att, {
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(30, 70),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(1, 0),
		LightEmission = 1,
		Color = ColorSequence.new(P.Accent2, Color3.new(1, 1, 1)),
	}):Emit(40)
	Audio.at("Explosion", pos, 0.6, 1.6, 260)
	Fx.shakeAt(pos, 0.8, 140)
end

function handlers.bubble(pos: Vector3, scale: number)
	ring(pos - Vector3.new(0, 3, 0), P.Purple, 60 * math.max(scale, 0.5), 0.6, 0.6)
	local _, att = anchorAt(pos, 3)
	emitter(att, {
		Lifetime = NumberRange.new(1, 2),
		Speed = NumberRange.new(4, 16),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(1.4, 0),
		LightEmission = 1,
		Color = ColorSequence.new(P.Purple, P.Accent2),
	}):Emit(36)
	Audio.at("Charge", pos, 0.6, 0.6)
end

function handlers.coin(pos: Vector3)
	local _, att = anchorAt(pos, 2)
	emitter(att, {
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(8, 16),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(0.9, 0),
		LightEmission = 1,
		Color = ColorSequence.new(P.Accent, Color3.new(1, 1, 1)),
	}):Emit(8)
	Audio.ui("Coin", 0.35, 1.5 + rng:NextNumber(0, 0.3))
end

function handlers.confetti(pos: Vector3, scale: number)
	local _, att = anchorAt(pos, 5)
	local colors = { P.Pink, P.Accent, P.Accent2, P.Blue, P.Green, P.Purple }
	for _, c in colors do
		emitter(att, {
			Lifetime = NumberRange.new(2, 3.4),
			Speed = NumberRange.new(30 * math.max(scale, 0.6), 80 * math.max(scale, 0.6)),
			SpreadAngle = Vector2.new(60, 60),
			EmissionDirection = Enum.NormalId.Top,
			Acceleration = Vector3.new(0, -70, 0),
			Size = ns(0.9, 0.9),
			RotSpeed = NumberRange.new(-300, 300),
			Rotation = NumberRange.new(0, 360),
			LightEmission = 0.4,
			Color = ColorSequence.new(c),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.8, 0), NumberSequenceKeypoint.new(1, 1) }),
		}):Emit(math.floor(16 * math.max(scale, 0.6)))
	end
	Audio.at("LevelUp", pos, 0.35, 1.2)
end

function handlers.splat(pos: Vector3, mag: number, extra)
	local color = (extra and extra.color) or P.Red
	local _, att = anchorAt(pos, 3)
	emitter(att, {
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(14, 50),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -90, 0),
		Size = ns(1.6, 0.4),
		Color = ColorSequence.new(color),
		Transparency = fadeOut(0),
	}):Emit(math.floor(26 + mag * 20))
	Audio.at("Soft", pos, 0.9, 0.55)
	Fx.shakeAt(pos, 0.3, 80)
end

function handlers.fuse(pos: Vector3)
	Audio.at("Charge", pos, 0.6, 1.8, 120)
end

function handlers.oof(pos: Vector3)
	Audio.at("Oof", pos, 0.9, 0.95 + rng:NextNumber(0, 0.2), 140)
end

function handlers.squeak(pos: Vector3, mag: number)
	Audio.at("Coin", pos, 0.5, 2.2 + rng:NextNumber(0, 0.6) - mag * 0.4, 100)
end

function handlers.bounce(pos: Vector3, mag: number)
	Audio.at("Bounce", pos, 0.4 + mag * 0.5, 1.1 + rng:NextNumber(0, 0.5), 110)
	ring(pos, Color3.new(1, 1, 1), 8 + mag * 10, 0.3, 0.2)
end

function handlers.thud(pos: Vector3, mag: number)
	Audio.at("Impact", pos, 0.6 + mag * 0.4, 0.55, 200)
	Fx.shakeAt(pos, mag * 0.6, 130)
end

function handlers.sparkle(pos: Vector3)
	local _, att = anchorAt(pos, 2)
	emitter(att, {
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(6, 18),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(1.2, 0),
		LightEmission = 1,
		Color = ColorSequence.new(P.Accent2, Color3.new(1, 1, 1)),
	}):Emit(16)
	Audio.at("Coin", pos, 0.35, 2.4)
end

function handlers.cannon(pos: Vector3, _, extra)
	local dir = (extra and extra.dir) or Vector3.yAxis
	flash(pos, Color3.fromRGB(255, 200, 120), 60, 0.4)
	local p, att = anchorAt(pos + dir * 4, 4)
	p.CFrame = CFrame.lookAt(p.Position, p.Position + dir)
	emitter(att, {
		Texture = SMOKE,
		Lifetime = NumberRange.new(0.8, 1.8),
		Speed = NumberRange.new(20, 60),
		SpreadAngle = Vector2.new(20, 20),
		EmissionDirection = Enum.NormalId.Front,
		Size = ns(4, 16),
		Color = ColorSequence.new(Color3.fromRGB(190, 190, 200)),
		Transparency = fadeOut(0.3),
	}):Emit(24)
	emitter(att, {
		Texture = FIRE,
		Lifetime = NumberRange.new(0.3, 0.7),
		Speed = NumberRange.new(30, 90),
		SpreadAngle = Vector2.new(24, 24),
		EmissionDirection = Enum.NormalId.Front,
		Size = ns(3, 0),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 230, 130), Color3.fromRGB(255, 80, 20)),
	}):Emit(30)
	Audio.at("Explosion", pos, 1, 1.3, 400)
	Fx.shakeAt(pos, 1.0, 200)
end

function handlers.teleport(pos: Vector3)
	ring(pos - Vector3.new(0, 3, 0), P.Purple, 30, 0.6, 0.5)
	flash(pos, P.Purple, 50, 0.5)
	Audio.at("Charge", pos, 0.7, 1.3)
end

function handlers.freeze(pos: Vector3)
	local _, att = anchorAt(pos, 2.5)
	emitter(att, {
		Lifetime = NumberRange.new(0.6, 1.2),
		Speed = NumberRange.new(6, 18),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(1.3, 0),
		LightEmission = 0.8,
		Color = ColorSequence.new(Color3.fromRGB(150, 230, 255), Color3.new(1, 1, 1)),
	}):Emit(28)
	Audio.at("Charge", pos, 0.6, 0.7)
end
handlers.unfreeze = handlers.freeze

function handlers.spawn(pos: Vector3)
	local _, att = anchorAt(pos, 2.5)
	emitter(att, {
		Texture = SMOKE,
		Lifetime = NumberRange.new(0.5, 1),
		Speed = NumberRange.new(6, 16),
		SpreadAngle = Vector2.new(180, 180),
		Size = ns(2, 6),
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Transparency = fadeOut(0.3),
	}):Emit(14)
	Audio.at("Soft", pos, 0.6, 1.4)
end

-- Numeros flutuantes no mundo -----------------------------------------------------------------------------------------

function Fx.popup(position: Vector3, text: string, color: Color3?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = position
	p.Parent = workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(300, 60)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	gui.Parent = p
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color or P.Accent
	t.TextStrokeTransparency = 0.2
	t.TextStrokeColor3 = P.Ink
	t.Parent = gui
	TweenService:Create(p, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = position + Vector3.new(0, 9, 0) }):Play()
	TweenService:Create(t, TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(p, 2)
end

-- Flash vermelho de dano -------------------------------------------------------------------------------------------------

local flashGui
local flashFrame

local function ensureFlash()
	if flashGui then
		return
	end
	flashGui = Instance.new("ScreenGui")
	flashGui.Name = "TV_Fx"
	flashGui.IgnoreGuiInset = true
	flashGui.ResetOnSpawn = false
	flashGui.DisplayOrder = 30
	flashGui.Parent = player:WaitForChild("PlayerGui")
	flashFrame = Instance.new("Frame")
	flashFrame.Size = UDim2.fromScale(1, 1)
	flashFrame.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
	flashFrame.BackgroundTransparency = 1
	flashFrame.BorderSizePixel = 0
	flashFrame.Parent = flashGui
	local g = Instance.new("UIGradient")
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.6, 0.85),
		NumberSequenceKeypoint.new(1, 0.85),
	})
	g.Rotation = 0
	g.Parent = flashFrame
end

function Fx.screenFlash(color: Color3?, strength: number?)
	ensureFlash()
	flashFrame.BackgroundColor3 = color or Color3.fromRGB(255, 60, 60)
	flashFrame.BackgroundTransparency = 1 - math.clamp(strength or 0.5, 0, 0.8)
	TweenService:Create(flashFrame, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
end

-- FOV: pulso temporario (arremesso, impulso...)
local fovKick = 0
function Fx.fovKick(amount: number)
	fovKick = math.max(fovKick, amount)
end
Fx.baseFov = 70

function Fx.init()
	RunService:BindToRenderStep("TV_FxCamera", Enum.RenderPriority.Camera.Value + 5, function(dt)
		camera = workspace.CurrentCamera
		if shakeAmount > 0.002 then
			local s = shakeAmount
			camera.CFrame = camera.CFrame
				* CFrame.new(rng:NextNumber(-1, 1) * s * 0.35, rng:NextNumber(-1, 1) * s * 0.35, 0)
				* CFrame.Angles(rng:NextNumber(-1, 1) * s * 0.012, rng:NextNumber(-1, 1) * s * 0.012, rng:NextNumber(-1, 1) * s * 0.02)
			shakeAmount = math.max(0, shakeAmount - dt * (1.6 + shakeAmount * 2))
		end
		if fovKick > 0.05 then
			camera.FieldOfView = camera.FieldOfView + fovKick
			fovKick = fovKick * math.exp(-dt * 7)
		end
	end)

	Remotes.get("Fx").OnClientEvent:Connect(function(kind, pos, force, extra)
		local h = handlers[kind]
		if h and typeof(pos) == "Vector3" then
			local ok, err = pcall(h, pos, force or 1, extra)
			if not ok then
				warn("[Fx] erro em", kind, err)
			end
		end
	end)

	Remotes.get("ScorePopup").OnClientEvent:Connect(function(pos, text, color)
		if typeof(pos) == "Vector3" then
			Fx.popup(pos, text, color)
		end
	end)

	Remotes.get("Struck").OnClientEvent:Connect(function(force)
		Fx.shake(0.4 + (force or 0.5) * 1.1)
		Fx.screenFlash(nil, 0.25 + (force or 0.5) * 0.3)
		Audio.ui("Oof", 0.5, 1)
	end)
end

Fx.handlers = handlers

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">GrabController</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	GrabController: o "cabo de energia" no cliente.
	  - Mira (mouse livre; ao segurar algo a mira trava no centro, estilo terceira pessoa)
	  - Agarra objetos e pessoas (o servidor valida e entrega a fisica ao jogador)
	  - Segura com AlignPosition/AlignOrientation locais (o cliente e dono da fisica)
	  - Roda o mouse (scroll) muda a distancia; Z/X giram e C/V inclinam o objeto
	  - Botao direito: carrega a forca (com trajetoria prevista) e solta = arremessa
	  - Dois cabos (upgrade), controle (gamepad) e botoes de celular
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Store = require(script.Parent:WaitForChild("Store"))
local Audio = require(script.Parent:WaitForChild("Audio"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local HUD = require(script.Parent:WaitForChild("UI"):WaitForChild("HUD"))
local Trajectory = require(script.Parent:WaitForChild("Trajectory"))

local GrabController = {}

GrabController.Changed = Util.Signal.new() -- (evento, ...)  "grab" | "drop" | "throw" | "chargeStart" | "chargeEnd"
GrabController.charge = 0
GrabController.charging = false
GrabController.holdCount = 0
GrabController.primary = nil -- primeira hold (para pose/HUD)

local player = Players.LocalPlayer
local GRAVITY = 196.2
local TAG = Config.Tags

local holds = {} -- { key, kind, model, mass, part, att, align, orient, rel (CFrame), parts = {BasePart} }
local pending = false
local holdDist = Config.Grab.HoldDefault
local hoverKey = nil
local hoverHit = nil
local lastGrabAttempt = 0
local usingCenterAim = false
local wheelBound = false

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local clientFolder = Instance.new("Folder")
clientFolder.Name = "TV_ClientFx"
clientFolder.Parent = workspace

local hoverHL = Instance.new("Highlight")
hoverHL.Name = "TV_Hover"
hoverHL.FillTransparency = 1
hoverHL.OutlineColor = Color3.new(1, 1, 1)
hoverHL.OutlineTransparency = 0.15
hoverHL.DepthMode = Enum.HighlightDepthMode.Occluded
hoverHL.Parent = clientFolder

-- Utilitarios --------------------------------------------------------------------------------------------------------

local function character(): Model?
	return player.Character
end

local function rootPart(): BasePart?
	local c = character()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function humanoid(): Humanoid?
	local c = character()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function updateFilter()
	local list = { clientFolder }
	local c = character()
	if c then
		table.insert(list, c)
	end
	for _, h in holds do
		table.insert(list, h.model or h.part)
	end
	local pk = workspace:FindFirstChild("TV_Pickups")
	if pk then
		table.insert(list, pk)
	end
	rayParams.FilterDescendantsInstances = list
end

local function isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

local function usesCenter(): boolean
	return usingCenterAim or #holds > 0 or isTouch() or UserInputService.GamepadEnabled and not UserInputService.MouseEnabled
end

local function aimRay(): (Vector3, Vector3)
	local cam = workspace.CurrentCamera
	if usesCenter() then
		local vs = cam.ViewportSize
		local r = cam:ViewportPointToRay(vs.X / 2, vs.Y / 2)
		return r.Origin, r.Direction
	end
	local m = UserInputService:GetMouseLocation()
	local r = cam:ViewportPointToRay(m.X, m.Y)
	return r.Origin, r.Direction
end

-- Raio com "gordura" (ajuda a acertar objetos pequenos)
local function castAim(distance: number)
	updateFilter()
	local origin, dir = aimRay()
	local ok, result = pcall(function()
		return workspace:Spherecast(origin, 1.4, dir * distance, rayParams)
	end)
	if ok and result then
		return result, origin, dir
	end
	return workspace:Raycast(origin, dir * distance, rayParams), origin, dir
end

-- Descobre o "alvo agarravel" a partir de uma parte atingida: retorna key, modelo, ehPessoa
local function resolveTarget(part: BasePart)
	if not part or not part:IsA("BasePart") then
		return nil
	end
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then
			if model == character() then
				return nil
			end
			local p = Players:GetPlayerFromCharacter(model)
			if p or CollectionService:HasTag(model, TAG.Grabbable) then
				return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart"), model, true
			end
			return nil
		end
		local parent = model.Parent
		model = parent and parent:FindFirstAncestorOfClass("Model") or nil
	end
	local root = part.AssemblyRootPart or part
	if root.Anchored or not CollectionService:HasTag(root, TAG.Grabbable) then
		return nil
	end
	local m = root:FindFirstAncestorOfClass("Model")
	if m and m.PrimaryPart ~= root then
		m = nil
	end
	return root, m, false
end

-- Constraints de segurar ----------------------------------------------------------------------------------------------------

local function massOf(target: Instance): number
	local total = 0
	if target:IsA("BasePart") then
		return target.AssemblyMass
	end
	for _, d in target:GetDescendants() do
		if d:IsA("BasePart") then
			total += d:GetMass()
		end
	end
	return total
end

local function buildHold(info)
	local key: BasePart = info.key
	if not key or not key.Parent then
		return nil
	end
	-- espera o servidor entregar a fisica
	local t0 = os.clock()
	while os.clock() - t0 < 0.7 and key.Parent do
		if key.ReceiveAge == 0 then
			break
		end
		task.wait()
	end
	if not key.Parent then
		return nil
	end

	local mass = info.mass or massOf(info.model or key)
	local att = Instance.new("Attachment")
	att.Name = "TV_HoldAtt"
	att.Parent = key

	local ap = Instance.new("AlignPosition")
	ap.Name = "TV_HoldPos"
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.RigidityEnabled = false
	ap.ApplyAtCenterOfMass = true
	ap.MaxForce = math.max(mass, 5) * GRAVITY * 16
	ap.MaxVelocity = Config.Grab.MaxVelocity
	ap.Responsiveness = Config.Grab.Responsiveness
	ap.Position = key.Position
	ap.Parent = key

	local ao = Instance.new("AlignOrientation")
	ao.Name = "TV_HoldRot"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = false
	ao.MaxTorque = math.max(mass, 5) * 9000
	ao.MaxAngularVelocity = 26
	ao.Responsiveness = Config.Grab.OrientResponsiveness
	ao.CFrame = key.CFrame.Rotation
	ao.Parent = key

	-- rotacao relativa ao "yaw" da camera
	local cam = workspace.CurrentCamera
	local look = cam.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	local yawCF = CFrame.Angles(0, yaw, 0)
	local rel = yawCF:Inverse() * key.CFrame.Rotation

	local parts = {}
	if info.kind == "character" and info.model then
		for _, d in info.model:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(parts, d)
			end
		end
	else
		table.insert(parts, key)
		if info.model then
			for _, d in info.model:GetDescendants() do
				if d:IsA("BasePart") and d.AssemblyRootPart == key then
					table.insert(parts, d)
				end
			end
		end
	end

	return {
		key = key,
		part = key,
		kind = info.kind,
		model = info.model,
		mass = mass,
		att = att,
		align = ap,
		orient = ao,
		rel = rel,
		parts = parts,
		behavior = key:GetAttribute("Behavior"),
	}
end

local function destroyConstraints(h)
	for _, o in { h.align, h.orient, h.att } do
		if o and o.Parent then
			o:Destroy()
		end
	end
end

local function refreshState()
	GrabController.holdCount = #holds
	GrabController.primary = holds[1]
end

local function bindWheel()
	if wheelBound then
		return
	end
	wheelBound = true
	ContextActionService:BindActionAtPriority("TV_HoldWheel", function(_, state, input)
		if state == Enum.UserInputState.Change and #holds > 0 then
			holdDist = math.clamp(holdDist + input.Position.Z * Config.Grab.ScrollStep, Config.Grab.HoldMin, Store.holdMax())
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, 3000, Enum.UserInputType.MouseWheel)
end

local function unbindWheel()
	if not wheelBound then
		return
	end
	wheelBound = false
	ContextActionService:UnbindAction("TV_HoldWheel")
end

local function releaseHold(h, silent: boolean?)
	local idx = table.find(holds, h)
	if idx then
		table.remove(holds, idx)
	end
	destroyConstraints(h)
	refreshState()
	if #holds == 0 then
		GrabController.charging = false
		GrabController.charge = 0
		HUD.setCharge(nil)
		Trajectory.hide()
		unbindWheel()
		local hum = humanoid()
		if hum then
			hum.AutoRotate = true
		end
	end
	if not silent then
		GrabController.Changed:Fire("drop", h)
	end
end

-- Agarrar ----------------------------------------------------------------------------------------------------------------------

local function tryGrab()
	if pending or os.clock() - lastGrabAttempt < 0.15 then
		return
	end
	lastGrabAttempt = os.clock()
	local hum = humanoid()
	local hrp = rootPart()
	if not hum or not hrp or hum.Health <= 0 or character():GetAttribute("Ragdolled") then
		return
	end
	if #holds >= Store.maxHolds() then
		return
	end
	local result = castAim(Store.grabRange() + 10)
	local key, model, isPerson
	if result then
		key, model, isPerson = resolveTarget(result.Instance)
	end
	if not key then
		return false
	end
	if (key.Position - hrp.Position).Magnitude > Store.grabRange() + 14 then
		HUD.toast("Longe demais", "bad")
		return false
	end
	pending = true
	local ok, res, info = pcall(function()
		return Remotes.get("Grab"):InvokeServer(key, result and result.Position or key.Position)
	end)
	pending = false
	if not ok or not res then
		Audio.ui("Error", 0.4)
		if ok and type(info) == "string" then
			HUD.toast(info, "bad")
		end
		return false
	end
	local hold = buildHold(info)
	if not hold then
		Remotes.get("Release"):FireServer(key)
		return false
	end
	table.insert(holds, hold)
	refreshState()
	holdDist = math.clamp((key.Position - workspace.CurrentCamera.CFrame.Position).Magnitude, Config.Grab.HoldMin, Store.holdMax())
	bindWheel()
	Audio.ui("Grab", 0.5, 1 + math.random() * 0.15)
	GrabController.Changed:Fire("grab", hold)
	local _ = isPerson or model
	return true
end

local function dropAll(reason: string?)
	for i = #holds, 1, -1 do
		local h = holds[i]
		Remotes.get("Release"):FireServer(h.key)
		releaseHold(h)
	end
	if reason then
		Audio.ui("Release", 0.4)
	end
end

-- Arremesso -----------------------------------------------------------------------------------------------------------------------

local function aimPoint(): (Vector3, Vector3)
	local result, origin, dir = castAim(300)
	if result then
		return result.Position, dir
	end
	return origin + dir * 300, dir
end

local function throwAll()
	if #holds == 0 then
		return
	end
	local charge = math.max(GrabController.charge, Config.Throw.MinCharge)
	local point, camDir = aimPoint()
	local count = #holds
	local list = table.clone(holds)
	local hrp = rootPart()
	for i, h in list do
		local pos = h.part.Position
		local dir = point - pos
		if dir.Magnitude < 8 then
			dir = camDir
		end
		dir = dir.Unit
		-- dois cabos: abre um pouco os arremessos
		if count > 1 then
			local spread = math.rad((i - (count + 1) / 2) * 5)
			dir = (CFrame.Angles(0, spread, 0) * dir)
		end
		local speed = Store.throwSpeed(h.mass, charge)

		-- solta o cabo local ANTES de aplicar a velocidade
		destroyConstraints(h)
		table.remove(holds, table.find(holds, h))

		local mode = h.part:GetAttribute("AlignMode")
		local alignYaw = h.part:GetAttribute("AlignYaw") or 0
		local angular = Util.randomUnit() * Config.Throw.Spin
		if h.kind == "object" then
			if mode == "look" or h.behavior == "rocket" or h.behavior == "glide" and mode ~= "flat" then
				h.part.CFrame = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, math.rad(alignYaw), 0)
				angular = dir * 0
				if h.behavior == "rocket" then
					angular = Vector3.zero
				end
			elseif mode == "flat" then
				h.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dir.X, -dir.Z), math.pi / 2)
				angular = Vector3.new(0, 26, 0)
			elseif mode == "flatY" then
				h.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dir.X, -dir.Z), 0)
				angular = Vector3.new(0, 22, 0)
			end
		end
		for _, p in h.parts do
			p.AssemblyLinearVelocity = dir * speed
			p.AssemblyAngularVelocity = angular
		end
		Remotes.get("Throw"):FireServer(h.key, dir, charge)
		GrabController.Changed:Fire("throw", h, speed, charge)
	end
	holds = {}
	refreshState()
	GrabController.charging = false
	GrabController.charge = 0
	HUD.setCharge(nil)
	Trajectory.hide()
	unbindWheel()
	local hum = humanoid()
	if hum then
		hum.AutoRotate = true
	end
	Audio.ui("Throw", 0.5 + charge * 0.4, 0.8 + charge * 0.5)
	Fx.fovKick(2 + charge * 7)
	Fx.shake(0.15 + charge * 0.3)
	local _ = hrp
end

local function beginCharge()
	if #holds == 0 or GrabController.charging or HUD.menuOpen then
		return
	end
	GrabController.charging = true
	GrabController.charge = 0
	GrabController.Changed:Fire("chargeStart")
end

local function endCharge()
	if not GrabController.charging then
		return
	end
	throwAll()
	GrabController.Changed:Fire("chargeEnd")
end

-- Atualizacao por quadro ---------------------------------------------------------------------------------------------------------------

local function setHover(key: BasePart?, model: Instance?)
	if key == hoverKey then
		return
	end
	hoverKey = key
	hoverHL.Adornee = key and (model or key) or nil
end

local function update(dt: number)
	local cam = workspace.CurrentCamera
	local hum = humanoid()
	local hrp = rootPart()
	if not hum or not hrp or hum.Health <= 0 then
		return
	end
	local c = character()

	-- caiu no ragdoll (ou abriu o menu) com coisas na mao: solta
	if (c:GetAttribute("Ragdolled") or HUD.menuOpen) and #holds > 0 then
		dropAll()
	end

	-- limpa holds cujo objeto sumiu
	for i = #holds, 1, -1 do
		local h = holds[i]
		if not h.part.Parent or not h.part:IsDescendantOf(workspace) then
			releaseHold(h)
		end
	end

	if #holds > 0 then
		-- travar mouse no centro e esconder o cursor
		if UserInputService.MouseEnabled then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = false
		end
		hum.AutoRotate = false
		usingCenterAim = true

		local look = cam.CFrame.LookVector
		local yaw = math.atan2(-look.X, -look.Z)
		local yawCF = CFrame.Angles(0, yaw, 0)

		-- personagem olha para onde a camera olha
		if not c:GetAttribute("Ragdolled") then
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				local target = CFrame.lookAt(hrp.Position, hrp.Position + flat)
				hrp.CFrame = hrp.CFrame:Lerp(target, math.min(1, dt * 14))
			end
		end

		-- rotacao do objeto pelo teclado
		local ry = (UserInputService:IsKeyDown(Enum.KeyCode.X) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.Z) and 1 or 0)
		local rx = (UserInputService:IsKeyDown(Enum.KeyCode.V) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.C) and 1 or 0)

		local origin = cam.CFrame.Position
		updateFilter()
		holdDist = math.clamp(holdDist, Config.Grab.HoldMin, Store.holdMax())
		local aimO, aimD = aimRay()
		for idx, h in holds do
			if ry ~= 0 or rx ~= 0 then
				h.rel = CFrame.Angles(rx * dt * 2.6, ry * dt * 2.6, 0) * h.rel
			end
			-- com dois cabos, o segundo fica ao lado
			local side = 0
			if #holds > 1 then
				side = (idx == 1) and -1.8 or 1.8
			end
			local wanted = aimD * holdDist + cam.CFrame.RightVector * side
			-- nao atravessar paredes/terreno
			local radius = h.part.Size.Magnitude * 0.5
			local hit = workspace:Raycast(aimO, wanted, rayParams)
			local target
			if hit then
				target = hit.Position + hit.Normal * math.min(radius + 0.4, 6)
			else
				target = aimO + wanted
			end
			h.align.Position = target
			h.orient.CFrame = yawCF * h.rel
		end

		-- carga do arremesso
		if GrabController.charging then
			GrabController.charge = math.min(1, GrabController.charge + dt / Config.Throw.ChargeTime)
			HUD.setCharge(GrabController.charge)
			local h = holds[1]
			if h then
				local point = aimPoint()
				local dir = (point - h.part.Position)
				if dir.Magnitude < 8 then
					dir = aimD
				end
				Trajectory.update(h.part.Position, dir.Unit, Store.throwSpeed(h.mass, math.max(GrabController.charge, Config.Throw.MinCharge)), rayParams)
			end
		end
		-- camera por cima do ombro
		hum.CameraOffset = hum.CameraOffset:Lerp(Vector3.new(2, 0.4, 0), math.min(1, dt * 8))
		setHover(nil)
		HUD.setHint(nil)
		local _ = origin
	else
		usingCenterAim = false
		hum.CameraOffset = hum.CameraOffset:Lerp(Vector3.zero, math.min(1, dt * 8))
		if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter and not UserInputService.MouseIconEnabled then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if UserInputService.MouseEnabled then
			UserInputService.MouseIconEnabled = true
		end
		-- destaca o que pode ser agarrado
		if not c:GetAttribute("Ragdolled") then
			local result = castAim(Store.grabRange() + 6)
			if result then
				local key, model, isPerson = resolveTarget(result.Instance)
				if key and (key.Position - hrp.Position).Magnitude <= Store.grabRange() + 8 then
					setHover(key, model)
					local label = isPerson and "Agarrar pessoa" or "Agarrar"
					if not isPerson and key:GetAttribute("ToyId") then
						local toy = require(Shared:WaitForChild("Toys")).ById[key:GetAttribute("ToyId")]
						if toy then
							label = toy.icon .. " " .. toy.name
						end
					end
					HUD.setHint(label, true)
					hoverHit = key
					return
				end
			end
		end
		setHover(nil)
		hoverHit = nil
		HUD.setHint(nil)
	end
end

-- Entrada ----------------------------------------------------------------------------------------------------------------------------------

local tryGrabSecond

local function onInputBegan(input: InputObject, processed: boolean)
	if processed or HUD.menuOpen then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if #holds < Store.maxHolds() and hoverHit then
			task.spawn(tryGrab)
		elseif #holds > 0 then
			if not tryGrabSecond() then
				dropAll("click")
			end
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
		beginCharge()
	elseif input.KeyCode == Enum.KeyCode.G then
		dropAll("key")
	end
end

-- com dois cabos, clicar em outro objeto pega o segundo
tryGrabSecond = function(): boolean
	if #holds >= Store.maxHolds() then
		return false
	end
	local result = castAim(Store.grabRange() + 10)
	if result then
		local key = resolveTarget(result.Instance)
		if key then
			task.spawn(tryGrab)
			return true
		end
	end
	return false
end

local function onInputEnded(input: InputObject, _processed: boolean)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		endCharge()
	end
end

-- API publica (botoes de celular / controle) ---------------------------------------------------------------------------------------------

function GrabController.mobileGrab()
	if #holds > 0 then
		dropAll("tap")
	else
		usingCenterAim = true
		task.spawn(tryGrab)
	end
end

function GrabController.mobileChargeBegin()
	beginCharge()
end

function GrabController.mobileChargeEnd()
	endCharge()
end

function GrabController.adjustDistance(direction: number)
	holdDist = math.clamp(holdDist + direction * Config.Grab.ScrollStep * 1.5, Config.Grab.HoldMin, Store.holdMax())
end

function GrabController.isHolding(): boolean
	return #holds > 0
end

function GrabController.getHolds()
	return holds
end

function GrabController.dropAll()
	dropAll()
end

-- alvo sob a mira (habilidades usam para saber o que puxar/congelar)
function GrabController.aimTarget(distance: number)
	local result, _, dir = castAim(distance)
	if result then
		local key = resolveTarget(result.Instance)
		return result.Position, key, result.Normal, dir
	end
	return nil, nil, nil, dir
end

function GrabController.aimWorldPoint(distance: number): Vector3?
	local result = castAim(distance)
	return result and result.Position or nil
end

function GrabController.init()
	RunService:BindToRenderStep("TV_Grab", Enum.RenderPriority.Camera.Value + 1, update)
	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)

	-- toque na tela: pega o que estiver no ponto tocado
	UserInputService.TouchTapInWorld:Connect(function(position, processed)
		if processed or #holds > 0 then
			return
		end
		local cam = workspace.CurrentCamera
		local r = cam:ViewportPointToRay(position.X, position.Y)
		updateFilter()
		local result = workspace:Raycast(r.Origin, r.Direction * (Store.grabRange() + 10), rayParams)
		if result then
			local key = resolveTarget(result.Instance)
			if key then
				usingCenterAim = true
				hoverHit = key
				task.spawn(tryGrab)
			end
		end
	end)

	-- controle: R1 pega/solta, R2 carrega/arremessa, D-pad ajusta distancia
	ContextActionService:BindActionAtPriority("TV_PadGrab", function(_, state)
		if state == Enum.UserInputState.Begin then
			GrabController.mobileGrab()
		end
		return Enum.ContextActionResult.Pass
	end, false, 2500, Enum.KeyCode.ButtonR1)
	ContextActionService:BindActionAtPriority("TV_PadThrow", function(_, state)
		if state == Enum.UserInputState.Begin then
			beginCharge()
		elseif state == Enum.UserInputState.End then
			endCharge()
		end
		return Enum.ContextActionResult.Pass
	end, false, 2500, Enum.KeyCode.ButtonR2)
	ContextActionService:BindActionAtPriority("TV_PadDist", function(_, state, input)
		if state == Enum.UserInputState.Begin then
			GrabController.adjustDistance(input.KeyCode == Enum.KeyCode.DPadUp and 1 or -1)
		end
		return Enum.ContextActionResult.Pass
	end, false, 2500, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadDown)

	Remotes.get("ForceRelease").OnClientEvent:Connect(function(key, reason)
		for _, h in holds do
			if h.key == key then
				releaseHold(h)
				if reason == "leash" then
					HUD.toast("O cabo esticou demais!", "bad")
				elseif reason == "escaped" then
					Audio.ui("Error", 0.3)
				end
				break
			end
		end
	end)

	player.CharacterAdded:Connect(function()
		for i = #holds, 1, -1 do
			releaseHold(holds[i], true)
		end
		holds = {}
		refreshState()
		GrabController.charging = false
		GrabController.charge = 0
	end)
end

return GrabController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Movement (cliente): tudo que mexe no proprio personagem.
	  - Lancamentos do servidor (canhoes, explosoes, cama elastica)
	  - Ragdoll: estado fisico, levantar (espaco) e ESPERNEAR quando alguem te agarra
	  - Tubos de vento (elevadores para as ilhas), jump pads (cogumelos, gêiseres)
	  - Correr (Shift) e impulso (dash)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Fx = require(script.Parent:WaitForChild("Fx"))
local Audio = require(script.Parent:WaitForChild("Audio"))
local HUD = require(script.Parent:WaitForChild("UI"):WaitForChild("HUD"))
local GrabController = require(script.Parent:WaitForChild("GrabController"))

local Movement = {}

local player = Players.LocalPlayer

local heldBy: string? = nil
local ragdolled = false
local ragdollStart = 0
local lastStruggle = 0
local lastPad = 0
local winds = {}
local pads = {}
local sprinting = false
local inWind = false

local BASE_SPEED = 16
local SPRINT_SPEED = 27

local function character(): Model?
	return player.Character
end

local function hrpOf(): BasePart?
	local c = character()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function humanoid(): Humanoid?
	local c = character()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function setAllVelocity(v: Vector3)
	local c = character()
	if not c then
		return
	end
	for _, d in c:GetDescendants() do
		if d:IsA("BasePart") then
			d.AssemblyLinearVelocity = v
		end
	end
end

-- Ragdoll -------------------------------------------------------------------------------------------------------------------------

local function setRagdoll(on: boolean)
	local hum = humanoid()
	if not hum then
		return
	end
	ragdolled = on
	if on then
		ragdollStart = os.clock()
		hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
		hum.PlatformStand = true
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	else
		hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

local function onJumpRequest()
	if heldBy then
		local now = os.clock()
		if now - lastStruggle > 0.055 then
			lastStruggle = now
			Remotes.get("Struggle"):FireServer()
			Fx.shake(0.12)
			Audio.ui("Soft", 0.15, 1.6 + math.random() * 0.4)
		end
	elseif ragdolled and os.clock() - ragdollStart > Config.Ragdoll.GetUpAfter then
		Remotes.get("RequestGetUp"):FireServer()
	end
end

-- Vento e jump pads -------------------------------------------------------------------------------------------------------------------

local function trackTag(tag: string, list)
	for _, p in CollectionService:GetTagged(tag) do
		if p:IsA("BasePart") then
			table.insert(list, p)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(p)
		if p:IsA("BasePart") then
			table.insert(list, p)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(p)
		local i = table.find(list, p)
		if i then
			table.remove(list, i)
		end
	end)
end

local function stepWorld(dt: number)
	local hrp = hrpOf()
	local hum = humanoid()
	if not hrp or not hum or hum.Health <= 0 then
		return
	end
	local pos = hrp.Position

	-- vento
	local nowInWind = false
	for _, tube in winds do
		if tube.Parent then
			local rel = tube.CFrame:PointToObjectSpace(pos)
			local halfLen = tube.Size.X / 2
			local radius = tube.Size.Y / 2
			if math.abs(rel.X) < halfLen and math.sqrt(rel.Y * rel.Y + rel.Z * rel.Z) < radius then
				nowInWind = true
				local speed = tube:GetAttribute("Speed") or 78
				local v = hrp.AssemblyLinearVelocity
				local axisPoint = tube.CFrame * Vector3.new(rel.X, 0, 0)
				local toAxis = Vector3.new(axisPoint.X - pos.X, 0, axisPoint.Z - pos.Z)
				local horiz = Vector3.new(v.X, 0, v.Z) * math.max(0, 1 - dt * 2.5) + toAxis * dt * 5
				local top = tube:GetAttribute("Top") or (tube.Position.Y + halfLen)
				local px, pz = tube:GetAttribute("PullX"), tube:GetAttribute("PullZ")
				if px and pz then
					local frac = Util.saturate((pos.Y - (top - 55)) / 45)
					local toCenter = Vector3.new(px - pos.X, 0, pz - pos.Z)
					if toCenter.Magnitude > 1 then
						horiz = horiz:Lerp(toCenter.Unit * 34, frac * math.min(1, dt * 3.5))
					end
				end
				local vy = Util.lerp(v.Y, speed, math.min(1, dt * 5))
				local newVel = Vector3.new(horiz.X, vy, horiz.Z)
				for _, d in character():GetDescendants() do
					if d:IsA("BasePart") and d.AssemblyRootPart == d then
						d.AssemblyLinearVelocity = newVel
					end
				end
				if not ragdolled then
					hum:ChangeState(Enum.HumanoidStateType.Freefall)
				end
				break
			end
		end
	end
	if nowInWind and not inWind then
		Audio.ui("Charge", 0.4, 0.5)
		Fx.fovKick(0)
	end
	inWind = nowInWind

	-- jump pads
	local now = os.clock()
	if now - lastPad > 0.5 then
		for _, pad in pads do
			if pad.Parent then
				local dx, dz = pos.X - pad.Position.X, pos.Z - pad.Position.Z
				local dy = pos.Y - pad.Position.Y
				local r = pad.Size.Y / 2 + 1
				if dx * dx + dz * dz < r * r and dy > -1 and dy < 7 then
					local power = pad:GetAttribute("Power") or 110
					local dir = Vector3.new(pad:GetAttribute("DirX") or 0, pad:GetAttribute("DirY") or 1, pad:GetAttribute("DirZ") or 0)
					dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.yAxis
					lastPad = now
					local v = hrp.AssemblyLinearVelocity
					setAllVelocity(dir * power + Vector3.new(v.X * 0.3, 0, v.Z * 0.3))
					if not ragdolled then
						hum:ChangeState(Enum.HumanoidStateType.Freefall)
					end
					Fx.handlers.bounce(pad.Position, 1)
					Fx.fovKick(6)
					break
				end
			end
		end
	end

	-- correr
	if not ragdolled then
		local target = BASE_SPEED
		if sprinting and not GrabController.isHolding() then
			target = SPRINT_SPEED
		elseif GrabController.isHolding() then
			target = 14
		end
		hum.WalkSpeed = Util.lerp(hum.WalkSpeed, target, math.min(1, dt * 8))
	end
end

-- API --------------------------------------------------------------------------------------------------------------------------------------

function Movement.dash()
	local hrp = hrpOf()
	local hum = humanoid()
	if not hrp or not hum then
		return
	end
	local cam = workspace.CurrentCamera
	local look = cam.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 then
		flat = hrp.CFrame.LookVector
	end
	flat = flat.Unit
	local v = flat * 105 + Vector3.new(0, 46, 0)
	setAllVelocity(v)
	hum:ChangeState(Enum.HumanoidStateType.Freefall)
	Fx.fovKick(10)
	Audio.ui("Throw", 0.5, 1.4)
end

function Movement.isRagdolled(): boolean
	return ragdolled
end

function Movement.isHeld(): boolean
	return heldBy ~= nil
end

function Movement.init()
	trackTag("TV_Wind", winds)
	trackTag("TV_JumpPad", pads)

	Remotes.get("Launch").OnClientEvent:Connect(function(velocity)
		if typeof(velocity) == "Vector3" then
			setAllVelocity(velocity)
			local hum = humanoid()
			if hum and not ragdolled then
				hum:ChangeState(Enum.HumanoidStateType.Freefall)
			end
		end
	end)

	Remotes.get("RagdollState").OnClientEvent:Connect(function(on)
		setRagdoll(on == true)
	end)

	Remotes.get("HoldedBy").OnClientEvent:Connect(function(name, progress)
		heldBy = name
		HUD.setStruggle(name, progress)
	end)

	UserInputService.JumpRequest:Connect(onJumpRequest)

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			sprinting = true
		end
		local _ = processed
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			sprinting = false
		end
	end)

	RunService.Heartbeat:Connect(stepWorld)

	player.CharacterAdded:Connect(function(char)
		ragdolled = false
		heldBy = nil
		HUD.setStruggle(nil)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			hum.WalkSpeed = BASE_SPEED
		end
	end)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Pose</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Pose: animacao procedural do corpo (sem assets de animacao).
	  - Quem esta segurando algo estica os bracos em direcao ao objeto (todos veem)
	  - Ao carregar a forca o braco vai para tras e o tronco gira (jogador local)
	  - Ao arremessar o braco "chicoteia" para frente com mola (todos veem, via atributo ThrowT)
	Tudo e feito mexendo em Motor6D.C0 (o Animator so mexe em Transform).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Tether = require(script.Parent:WaitForChild("Tether"))
local GrabController = require(script.Parent:WaitForChild("GrabController"))

local Pose = {}

local UserInputService = game:GetService("UserInputService")

local EMOTE_DURATION = { wave = 2.6, cheer = 2.4, dance = 5 }
local EMOTE_KEYS = {
	[Enum.KeyCode.H] = "wave",
	[Enum.KeyCode.B] = "cheer",
	[Enum.KeyCode.N] = "dance",
}

local player = Players.LocalPlayer
local states = {} -- [character] = state
local failedAt = setmetatable({}, { __mode = "k" }) -- [character] = quando a montagem do rig falhou

local UP = Vector3.yAxis

local function motorInfo(m: Motor6D?)
	if not m or not m:IsA("Motor6D") or not m.Part0 then
		return nil
	end
	return { m = m, c0 = m.C0, c1 = m.C1, part0 = m.Part0 }
end

local function buildRig(char: Model)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return nil
	end
	local rig = {}
	if hum.RigType == Enum.HumanoidRigType.R15 then
		local rua = char:FindFirstChild("RightUpperArm")
		local lua = char:FindFirstChild("LeftUpperArm")
		local ut = char:FindFirstChild("UpperTorso")
		rig.right = motorInfo(rua and rua:FindFirstChild("RightShoulder"))
		rig.left = motorInfo(lua and lua:FindFirstChild("LeftShoulder"))
		rig.waist = motorInfo(ut and ut:FindFirstChild("Waist"))
	else
		local torso = char:FindFirstChild("Torso")
		rig.right = motorInfo(torso and torso:FindFirstChild("Right Shoulder"))
		rig.left = motorInfo(torso and torso:FindFirstChild("Left Shoulder"))
	end
	if not rig.right and not rig.left then
		return nil
	end
	return rig
end

local function getState(char: Model)
	local st = states[char]
	if st then
		return st
	end
	local rig = buildRig(char)
	if not rig then
		failedAt[char] = os.clock()
		return nil
	end
	st = {
		rig = rig,
		weight = Util.Spring.new(0, 16, 0.9),
		kick = Util.Spring.new(0, 22, 0.32), -- subamortecida: chicote com retorno
		lastTarget = nil,
		char = char,
	}
	states[char] = st
	char.Destroying:Once(function()
		states[char] = nil
	end)
	char:GetAttributeChangedSignal("ThrowT"):Connect(function()
		st.kick.Position = 1
		st.kick.Velocity = 6
	end)
	char:GetAttributeChangedSignal("EmoteT"):Connect(function()
		local name = char:GetAttribute("Emote")
		if EMOTE_DURATION[name] and (not st.emote or os.clock() - st.emote.t0 > 0.5) then
			st.emote = { name = name, t0 = os.clock() }
		end
	end)
	return st
end

local function restore(info)
	if info and info.m.Parent then
		info.m.C0 = info.c0
	end
end

-- Aponta o membro (o "para baixo" natural do braco) para uma direcao no mundo
local function pointArm(info, worldDir: Vector3, weight: number)
	if not info or not info.m.Parent or not info.part0.Parent then
		return
	end
	local restDir = (info.c0 * info.c1:Inverse()):VectorToWorldSpace(Vector3.new(0, -1, 0))
	local desired = info.part0.CFrame:VectorToObjectSpace(worldDir)
	local axis = restDir:Cross(desired)
	local dot = math.clamp(restDir:Dot(desired), -1, 1)
	local angle = math.acos(dot)
	local rot = CFrame.identity
	if axis.Magnitude > 1e-4 then
		rot = CFrame.fromAxisAngle(axis.Unit, angle * weight)
	end
	info.m.C0 = CFrame.new(info.c0.Position) * rot * info.c0.Rotation
	if weight > 0.6 then
		info.m.Transform = CFrame.identity
	end
end

local function shoulderWorld(info): Vector3
	return (info.part0.CFrame * info.c0).Position
end

local function stepChar(char: Model, st, dt: number)
	local holdList = Tether.active[char]
	local isLocal = char == player.Character
	local chargeAmt = isLocal and GrabController.charge or 0

	if char:GetAttribute("Ragdolled") then
		st.weight.Target = 0
		st.weight.Position = 0
		return
	end

	-- alvo do braco: primeiro objeto segurado
	local targetPos: Vector3? = nil
	if holdList and holdList[1] and holdList[1].key.Parent then
		targetPos = holdList[1].key.Position
		st.lastTarget = targetPos
	end

	local holding = targetPos ~= nil
	local emote = st.emote
	local emoteAge = emote and (os.clock() - emote.t0) or 0
	if emote and emoteAge > EMOTE_DURATION[emote.name] then
		st.emote = nil
		emote = nil
	end
	st.weight.Target = (holding or emote or st.kick.Position > 0.02) and 1 or 0
	local w = st.weight:Step(dt)
	st.kick:Step(dt)
	w = math.clamp(w, 0, 1)

	if w < 0.01 and st.kick.Position < 0.01 then
		restore(st.rig.right)
		restore(st.rig.left)
		restore(st.rig.waist)
		return
	end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local look = hrp and hrp.CFrame.LookVector or Vector3.zAxis
	look = Vector3.new(look.X, 0, look.Z)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.zAxis

	local kick = math.clamp(st.kick.Position, -1.2, 1.4)

	-- emotes: direcoes dos bracos e giro do tronco
	local emoteDir = nil
	local emoteYaw = 0
	if emote and not holding then
		local rightV = hrp and hrp.CFrame.RightVector or Vector3.xAxis
		local t = emoteAge
		local fade = math.clamp(math.min(t * 6, (EMOTE_DURATION[emote.name] - t) * 6), 0, 1)
		if emote.name == "wave" then
			emoteDir = {
				right = (UP * 0.9 + rightV * 0.32 * math.sin(t * 11) + look * 0.15).Unit,
			}
		elseif emote.name == "cheer" then
			local wob = math.sin(t * 9) * 0.18
			emoteDir = {
				right = (UP + rightV * (0.25 + wob)).Unit,
				left = (UP - rightV * (0.25 - wob)).Unit,
			}
		elseif emote.name == "dance" then
			local s = math.sin(t * 7)
			emoteDir = {
				right = (UP * (0.4 + 0.6 * math.max(s, 0)) + rightV * 0.5 + look * 0.4 * (1 - math.max(s, 0))).Unit,
				left = (UP * (0.4 + 0.6 * math.max(-s, 0)) - rightV * 0.5 + look * 0.4 * (1 - math.max(-s, 0))).Unit,
			}
			emoteYaw = s * 0.45
		end
		if emoteDir then
			emoteDir.fade = fade
		end
	end

	for side, info in { right = st.rig.right, left = st.rig.left } do
		if info and emoteDir then
			local d = emoteDir[side]
			if d then
				pointArm(info, d, w * emoteDir.fade)
			else
				restore(info)
			end
		elseif info then
			local from = shoulderWorld(info)
			local to = targetPos or st.lastTarget or (from + look * 8)
			local dir = (to - from)
			dir = dir.Magnitude > 0.1 and dir.Unit or look
			-- carregando: braco vai para tras e um pouco para cima (so o braco direito e o esquerdo levemente)
			if chargeAmt > 0 then
				local back = (-look * 0.85 + UP * 0.55).Unit
				dir = dir:Lerp(back, math.clamp(chargeAmt * (side == "right" and 1 or 0.55), 0, 1)).Unit
			end
			-- chicote: vai para frente e levemente para cima
			if kick > 0.01 then
				local whip = (look * 1 + UP * 0.25).Unit
				dir = dir:Lerp(whip, math.clamp(kick, 0, 1)).Unit
			end
			pointArm(info, dir, w)
		end
	end

	-- tronco: gira para tras ao carregar e "chicoteia" no arremesso
	local wa = st.rig.waist
	if wa and wa.m.Parent then
		local yaw = -chargeAmt * 0.55 + kick * 0.6 + emoteYaw
		local lean = holding and 0.08 or 0
		wa.m.C0 = wa.c0 * CFrame.Angles(-lean - chargeAmt * 0.12, yaw, 0)
	end
end

-- toca um emote no jogador local (e avisa o servidor para todos verem)
function Pose.emote(name: string)
	if not EMOTE_DURATION[name] then
		return
	end
	local char = player.Character
	local st = char and getState(char)
	if not st then
		return
	end
	if st.emote and os.clock() - st.emote.t0 < 0.6 then
		return
	end
	st.emote = { name = name, t0 = os.clock() }
	Remotes.get("ActivityAction"):FireServer("emote", name)
end

function Pose.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local name = EMOTE_KEYS[input.KeyCode]
		if name and not GrabController.isHolding() then
			Pose.emote(name)
		end
	end)
	GrabController.Changed:Connect(function(event)
		if event == "throw" then
			local char = player.Character
			local st = char and getState(char)
			if st then
				st.kick.Position = 1
				st.kick.Velocity = 6
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		-- cria estado para quem esta segurando algo
		for char in Tether.active do
			if char.Parent and not states[char] then
				getState(char)
			end
		end
		-- todos os personagens precisam de estado para ver os emotes dos outros
		for _, pl in Players:GetPlayers() do
			local c = pl.Character
			if c and c.Parent and not states[c] and c:FindFirstChildOfClass("Humanoid") then
				local f = failedAt[c]
				if not f or os.clock() - f > 2 then
					getState(c)
				end
			end
		end
		for char, st in states do
			if not char.Parent then
				states[char] = nil
			else
				local ok, err = pcall(stepChar, char, st, math.min(dt, 0.05))
				if not ok then
					warn("[Pose] erro:", err)
					states[char] = nil
				end
			end
		end
	end)
end

return Pose
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Store (cliente): copia dos dados do jogador enviados pelo servidor.
	Store.get("Coins"), Store.Changed:Connect(function(chave, valor) ... end)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))
local Toys = require(Shared:WaitForChild("Toys"))

local Store = {}

Store.Changed = Util.Signal.new() -- (chave, valor)
Store.Ready = Util.Signal.new()
Store.loaded = false

local data = {
	Coins = 0,
	XP = 0,
	XPNeeded = 100,
	Level = 1,
	SkillPoints = 0,
	BestThrow = 0,
	TotalThrows = 0,
	TotalHits = 0,
	BossDamage = 0,
	Upgrades = {},
	Toys = {},
	OwnedTethers = { Roxo = true, Ciano = true, Rosa = true },
	OwnedTrails = { Nenhum = true },
	Tether = "Roxo",
	Trail = "Nenhum",
	Settings = { Peaceful = false, Music = true, Sfx = true, Shake = true, Tutorial = false },
	Wins = 0,
	Quests = { slots = {}, completed = 0 },
}

function Store.get(key: string): any
	return data[key]
end

function Store.all()
	return data
end

function Store.upgrade(id: string): number
	return (data.Upgrades and data.Upgrades[id]) or 0
end

function Store.setting(key: string): any
	local s = data.Settings
	if s and s[key] ~= nil then
		return s[key]
	end
	return true
end

function Store.ownsToy(id: string): boolean
	local toy = Toys.ById[id]
	if not toy then
		return false
	end
	return toy.price == 0 or (data.Toys and data.Toys[id] == true)
end

-- multiplicador das recargas das habilidades (Recarga)
function Store.cooldownScale(): number
	return math.max(0.4, 1 - 0.06 * Store.upgrade("Cooldown"))
end

function Store.grabRange(): number
	return Config.Grab.BaseRange + Config.Grab.RangePerLevel * Store.upgrade("Range")
end

function Store.holdMax(): number
	return Config.Grab.HoldMaxBase + Config.Grab.HoldMaxPerLevel * Store.upgrade("Range")
end

function Store.maxHolds(): number
	return 1 + Store.upgrade("DoubleTether")
end

function Store.throwSpeed(mass: number, charge: number): number
	local T = Config.Throw
	local factor = math.clamp((T.RefMass / math.max(mass, 0.5)) ^ T.MassExponent, 0.2, 1.6)
	local power = 1 + T.PowerPerLevel * Store.upgrade("Power")
	local speed = Util.lerp(T.MinSpeed, T.MaxSpeed, charge ^ 0.85) * factor * power
	return math.min(speed, T.MaxSpeedHard)
end

function Store.init()
	Remotes.get("DataSync").OnClientEvent:Connect(function(snapshot)
		for k, v in snapshot do
			data[k] = v
		end
		if not Store.loaded then
			Store.loaded = true
			Store.Ready:Fire()
		end
		for k, v in snapshot do
			Store.Changed:Fire(k, v)
		end
	end)
	Remotes.get("DataChanged").OnClientEvent:Connect(function(key, value)
		data[key] = value
		Store.Changed:Fire(key, value)
	end)
	Remotes.get("ClientReady"):FireServer()
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Tether</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Tether: desenha o cabo de energia de TODOS os jogadores (o servidor cria um ObjectValue
	"Hold" na pasta TV_Holds do personagem; aqui cada cliente monta o visual localmente).
	Cores/rastros vem dos atributos TetherColor/TetherTrail do jogador.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local Tether = {}

Tether.active = {} -- [character] = { { key = part, ... } }

local COLORS = {}
for _, c in Config.TetherColors do
	COLORS[c.id] = c
end

local beams = {} -- { beam, core, a0, a1, char, player, rainbow, key, emitter }

local function colorFor(player: Player?): (Color3, boolean)
	local id = player and player:GetAttribute("TetherColor") or "Roxo"
	local def = COLORS[id] or COLORS.Roxo
	return def.color, def.rainbow == true
end

local function handOf(char: Model): BasePart?
	return char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
end

local function makeBeam(char: Model, ov: ObjectValue)
	local key: BasePart? = ov.Value
	if not key or not key.Parent then
		return
	end
	local player = Players:GetPlayerFromCharacter(char)
	local hand = handOf(char)
	if not hand then
		return
	end
	local color, rainbow = colorFor(player)

	local a0 = hand:FindFirstChild("RightGripAttachment")
	local own0 = false
	if not a0 then
		a0 = Instance.new("Attachment")
		a0.Name = "TV_TetherA0"
		a0.Parent = hand
		own0 = true
	end
	local a1 = Instance.new("Attachment")
	a1.Name = "TV_TetherA1"
	a1.Parent = key

	local beam = Instance.new("Beam")
	beam.Name = "TV_TetherBeam"
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.55))
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 26
	beam.CurveSize0 = 2.5
	beam.CurveSize1 = -2.5
	beam.Width0 = 0.5
	beam.Width1 = 0.9
	beam.Transparency = NumberSequence.new(0.05)
	beam.Parent = hand

	local core = Instance.new("Beam")
	core.Name = "TV_TetherCore"
	core.Attachment0 = a0
	core.Attachment1 = a1
	core.Color = ColorSequence.new(Color3.new(1, 1, 1))
	core.LightEmission = 1
	core.LightInfluence = 0
	core.FaceCamera = true
	core.Segments = 26
	core.CurveSize0 = 2.5
	core.CurveSize1 = -2.5
	core.Width0 = 0.16
	core.Width1 = 0.3
	core.Transparency = NumberSequence.new(0.1)
	core.Parent = hand

	-- fagulhas no objeto
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "TV_TetherSparks"
	sparks.Rate = 14
	sparks.Lifetime = NumberRange.new(0.4, 0.9)
	sparks.Speed = NumberRange.new(2, 8)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	sparks.LightEmission = 1
	sparks.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	sparks.Parent = a1

	-- contorno colorido no objeto/pessoa segurado
	local hl = Instance.new("Highlight")
	hl.Name = "TV_HeldOutline"
	hl.Adornee = (key.Parent and key.Parent:IsA("Model") and key.Parent) or key
	hl.FillTransparency = 1
	hl.OutlineColor = color
	hl.OutlineTransparency = 0.15
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = key

	local rec = { beam = beam, core = core, a0 = a0, own0 = own0, a1 = a1, sparks = sparks, hl = hl, char = char, player = player, rainbow = rainbow, key = key, ov = ov, t0 = os.clock() }
	table.insert(beams, rec)
	local list = Tether.active[char]
	if not list then
		list = {}
		Tether.active[char] = list
	end
	table.insert(list, rec)
	return rec
end

local function destroyBeam(rec)
	local i = table.find(beams, rec)
	if i then
		table.remove(beams, i)
	end
	local list = Tether.active[rec.char]
	if list then
		local j = table.find(list, rec)
		if j then
			table.remove(list, j)
		end
		if #list == 0 then
			Tether.active[rec.char] = nil
		end
	end
	for _, o in { rec.beam, rec.core, rec.a1, rec.sparks, rec.hl } do
		if o and o.Parent then
			o:Destroy()
		end
	end
	if rec.own0 and rec.a0 and rec.a0.Parent then
		rec.a0:Destroy()
	end
end

local function watchCharacter(char: Model)
	local function hookFolder(folder: Instance)
		for _, ov in folder:GetChildren() do
			if ov:IsA("ObjectValue") then
				makeBeam(char, ov)
			end
		end
		folder.ChildAdded:Connect(function(ov)
			if ov:IsA("ObjectValue") then
				task.defer(makeBeam, char, ov)
			end
		end)
		folder.ChildRemoved:Connect(function(ov)
			for _, rec in table.clone(beams) do
				if rec.ov == ov then
					destroyBeam(rec)
				end
			end
		end)
	end
	local existing = char:FindFirstChild("TV_Holds")
	if existing then
		hookFolder(existing)
	end
	char.ChildAdded:Connect(function(c)
		if c.Name == "TV_Holds" then
			hookFolder(c)
		end
	end)
end

local function watchPlayer(player: Player)
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)
end

function Tether.isHolding(char: Model): boolean
	return Tether.active[char] ~= nil
end

function Tether.init()
	for _, p in Players:GetPlayers() do
		watchPlayer(p)
	end
	Players.PlayerAdded:Connect(watchPlayer)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for i = #beams, 1, -1 do
			local rec = beams[i]
			if not rec.key.Parent or not rec.beam.Parent then
				destroyBeam(rec)
			else
				local age = t - rec.t0
				local pulse = 0.5 + math.sin(t * 9) * 0.08
				local grow = math.min(1, age * 6)
				rec.beam.Width0 = pulse * grow
				rec.beam.Width1 = (pulse + 0.35) * grow
				rec.beam.CurveSize0 = math.sin(t * 5) * 2.4
				rec.beam.CurveSize1 = math.cos(t * 4.3) * 2.4
				rec.core.CurveSize0 = rec.beam.CurveSize0
				rec.core.CurveSize1 = rec.beam.CurveSize1
				if rec.rainbow then
					local c0 = Util.hue(t * 0.4, 0.75, 1)
					local c1 = Util.hue(t * 0.4 + 0.3, 0.75, 1)
					rec.beam.Color = ColorSequence.new(c0, c1)
					rec.sparks.Color = ColorSequence.new(c0, c1)
					rec.hl.OutlineColor = c0
				end
			end
		end
	end)
end

return Tether
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">ToyPhysics</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	ToyPhysics (cliente): comportamentos em voo dos brinquedos arremessados.
	  - Quem arremessou e dono da fisica: so ele aplica as forcas (planar, foguete, bumerangue)
	  - TODOS os clientes: chama do foguete, rastro do jogador (estrelas, fumaca, cometa...)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Audio = require(script.Parent:WaitForChild("Audio"))

local ToyPhysics = {}

local player = Players.LocalPlayer
local GRAVITY = 196.2
local airborne = {} -- [part] = { t0, visuals = {...}, caught = false }

local TRAIL_COLORS = {}
for _, c in Config.TetherColors do
	TRAIL_COLORS[c.id] = c
end

-- Rastro cosmetico ------------------------------------------------------------------------------------------------------------

local function makeTrailVisual(part: BasePart, trailId: string, colorId: string)
	local color = (TRAIL_COLORS[colorId] or TRAIL_COLORS.Roxo).color
	local visuals = {}
	local att = Instance.new("Attachment")
	att.Name = "TV_TrailAtt"
	att.Parent = part
	table.insert(visuals, att)

	if trailId == "Estrelas" or trailId == "Faiscas" or trailId == "Cometa" then
		local e = Instance.new("ParticleEmitter")
		e.Rate = trailId == "Cometa" and 80 or 40
		e.Lifetime = NumberRange.new(0.5, trailId == "Cometa" and 1.6 or 1.0)
		e.Speed = NumberRange.new(2, trailId == "Faiscas" and 22 or 8)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, trailId == "Cometa" and 2.2 or 1.2), NumberSequenceKeypoint.new(1, 0) })
		e.LightEmission = 1
		e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
		e.Parent = att
		table.insert(visuals, e)
	end
	if trailId == "Fumaca" then
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/smoke_main.dds"
		e.Rate = 30
		e.Lifetime = NumberRange.new(0.8, 1.6)
		e.Speed = NumberRange.new(0, 3)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 6) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		e.Color = ColorSequence.new(color)
		e.Parent = att
		table.insert(visuals, e)
	end
	if trailId == "Cometa" or trailId == "Estrelas" then
		local a2 = Instance.new("Attachment")
		a2.Position = Vector3.new(0, 0, 0)
		a2.Parent = part
		local tr = Instance.new("Trail")
		tr.Attachment0 = att
		tr.Attachment1 = a2
		att.Position = Vector3.new(0, part.Size.Y / 2, 0)
		a2.Position = Vector3.new(0, -part.Size.Y / 2, 0)
		tr.Lifetime = trailId == "Cometa" and 0.9 or 0.5
		tr.LightEmission = 1
		tr.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.6))
		tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
		tr.Parent = part
		table.insert(visuals, a2)
		table.insert(visuals, tr)
	end
	return visuals
end

local function onAirborne(part: BasePart)
	if not part:IsA("BasePart") or airborne[part] then
		return
	end
	local rec = { t0 = os.clock(), visuals = {}, caught = false, throwerId = part:GetAttribute("Thrower") }
	airborne[part] = rec

	-- rastro do jogador que arremessou
	local thrower = rec.throwerId and Players:GetPlayerByUserId(rec.throwerId)
	if thrower then
		local trail = thrower:GetAttribute("TetherTrail")
		if trail and trail ~= "Nenhum" then
			rec.visuals = makeTrailVisual(part, trail, thrower:GetAttribute("TetherColor") or "Roxo")
		end
	end

	local behavior = part:GetAttribute("Behavior")
	if behavior == "rocket" then
		local flame = part:FindFirstChild("Flame", true)
		if flame then
			flame.Enabled = true
			rec.flame = flame
		end
		rec.sound = Audio.loop("Rocket", part, 0.5, 1)
		table.insert(rec.visuals, rec.sound)
	elseif behavior == "explosive" then
		-- o pavio acende quando o servidor liga o emissor Spark
	end
end

local function onGrounded(part: Instance)
	local rec = airborne[part]
	if not rec then
		return
	end
	airborne[part] = nil
	if rec.flame and rec.flame.Parent then
		rec.flame.Enabled = false
	end
	for _, v in rec.visuals do
		if typeof(v) == "Instance" and v.Parent then
			if v:IsA("ParticleEmitter") then
				v.Enabled = false
				task.delay(2, function()
					if v.Parent then
						v:Destroy()
					end
				end)
			elseif v:IsA("Sound") then
				v:Destroy()
			else
				task.delay(1.5, function()
					if v.Parent then
						v:Destroy()
					end
				end)
			end
		end
	end
end

-- Forcas (so o dono) -----------------------------------------------------------------------------------------------------------------

local function steer(part: BasePart, rec, dt: number)
	local behavior = part:GetAttribute("Behavior")
	local age = os.clock() - rec.t0
	local mass = part.AssemblyMass
	local vel = part.AssemblyLinearVelocity
	local speed = vel.Magnitude

	if behavior == "glide" then
		-- sustentacao proporcional a velocidade + um pouco de arrasto
		local lift = GRAVITY * math.clamp(speed / 75, 0, 0.94)
		part:ApplyImpulse(Vector3.new(0, mass * lift * dt, 0))
		if speed > 30 then
			part:ApplyImpulse(-vel.Unit * mass * speed * 0.05 * dt)
		end
		-- aviao alinha o nariz com a velocidade
		if part:GetAttribute("AlignMode") == "look" and speed > 25 then
			local cf = CFrame.lookAt(part.Position, part.Position + vel)
			part.AssemblyAngularVelocity = Vector3.zero
			part.CFrame = part.CFrame:Lerp(cf, math.min(1, dt * 5))
		end
	elseif behavior == "rocket" then
		local yaw = part:GetAttribute("AlignYaw") or 0
		-- a frente do foguete e o eixo definido por AlignYaw (X local com 90 graus)
		local forward = (part.CFrame * CFrame.Angles(0, -math.rad(yaw), 0)).LookVector
		if age < 1.7 then
			part:ApplyImpulse(forward * mass * 330 * dt)
			part:ApplyImpulse(Vector3.new(0, mass * GRAVITY * 0.9 * dt, 0))
			-- nariz segue a velocidade
			if speed > 20 then
				local cf = CFrame.lookAt(part.Position, part.Position + vel) * CFrame.Angles(0, math.rad(yaw), 0)
				part.CFrame = part.CFrame:Lerp(cf, math.min(1, dt * 8))
				part.AssemblyAngularVelocity = Vector3.zero
			end
		elseif rec.flame then
			rec.flame.Enabled = false
		end
	elseif behavior == "boomerang" then
		local thrower = rec.throwerId and Players:GetPlayerByUserId(rec.throwerId)
		local hrp = thrower and thrower.Character and thrower.Character:FindFirstChild("HumanoidRootPart")
		part.AssemblyAngularVelocity = Vector3.new(0, 24, 0)
		part:ApplyImpulse(Vector3.new(0, mass * GRAVITY * 0.93 * dt, 0))
		if hrp and age > 0.8 then
			local to = (hrp.Position + Vector3.new(0, 2, 0)) - part.Position
			local dist = to.Magnitude
			local pull = math.clamp((age - 0.8) * 1.6, 0, 2.6)
			part:ApplyImpulse(to.Unit * mass * 160 * pull * dt)
			-- freia perto do jogador para poder "pegar"
			if dist < 16 then
				part.AssemblyLinearVelocity = vel * (1 - math.min(1, dt * 4))
			end
			if dist < 7 and not rec.caught and age > 1.6 then
				rec.caught = true
				Remotes.get("ActivityAction"):FireServer("boomerang", "catch", part)
			end
		end
	end
end

function ToyPhysics.init()
	local tag = Config.Tags.Airborne
	for _, part in CollectionService:GetTagged(tag) do
		onAirborne(part)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(onAirborne)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(onGrounded)

	RunService.Heartbeat:Connect(function(dt)
		for part, rec in airborne do
			if not part.Parent then
				onGrounded(part)
			elseif rec.throwerId == player.UserId and part.ReceiveAge == 0 then
				steer(part, rec, dt)
			end
		end
	end)
	local _ = Util
end

return ToyPhysics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Trajectory</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	Trajectory: previsao do arco do arremesso (bolinhas neon + anel onde vai cair).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Trajectory = {}

local GRAVITY = 196.2
local COUNT = 30
local STEP = 0.06

local pool = {}
local marker
local visible = false
local folder

local function ensure()
	if folder then
		return
	end
	folder = workspace:FindFirstChild("TV_ClientFx")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "TV_ClientFx"
		folder.Parent = workspace
	end
	for i = 1, COUNT do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.one * (0.9 - i * 0.012)
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = Config.Palette.Accent
		p.Transparency = 1
		p.Parent = folder
		pool[i] = p
	end
	marker = Instance.new("Part")
	marker.Shape = Enum.PartType.Cylinder
	marker.Size = Vector3.new(0.3, 7, 7)
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.CastShadow = false
	marker.Material = Enum.Material.Neon
	marker.Color = Config.Palette.Pink
	marker.Transparency = 1
	marker.Parent = folder
end

function Trajectory.hide()
	if not visible then
		return
	end
	visible = false
	for _, p in pool do
		p.Transparency = 1
	end
	if marker then
		marker.Transparency = 1
	end
end

-- pos: posicao inicial, dir: direcao unitaria, speed: velocidade inicial
function Trajectory.update(pos: Vector3, dir: Vector3, speed: number, params: RaycastParams)
	ensure()
	visible = true
	local v = dir * speed
	local p = pos
	local landed = false
	for i = 1, COUNT do
		local dot = pool[i]
		if landed then
			dot.Transparency = 1
		else
			local nextV = v + Vector3.new(0, -GRAVITY * STEP, 0)
			local nextP = p + v * STEP
			local hit = workspace:Raycast(p, nextP - p, params)
			if hit then
				landed = true
				dot.Transparency = 1
				-- o cilindro tem o eixo no X: alinhar o eixo com a normal da superficie
				local n = hit.Normal
				local tangent = n:Cross(Vector3.xAxis)
				if tangent.Magnitude < 0.1 then
					tangent = n:Cross(Vector3.zAxis)
				end
				marker.CFrame = CFrame.fromMatrix(hit.Position + n * 0.15, n, tangent.Unit)
				marker.Transparency = 0.25
			else
				dot.CFrame = CFrame.new(nextP)
				dot.Transparency = 0.15 + i / COUNT * 0.6
				p = nextP
				v = nextV
			end
		end
	end
	if not landed then
		marker.Transparency = 1
	end
end

return Trajectory
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="69">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	HUD: interface principal — cartao do jogador (nivel/XP/moedas), mira com barra de carga,
	avisos de zona, toasts, anuncios, resultado do arremesso, agarrado/espernear.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))

local Store = require(script.Parent.Parent:WaitForChild("Store"))
local Audio = require(script.Parent.Parent:WaitForChild("Audio"))
local Theme = require(script.Parent:WaitForChild("Theme"))

local HUD = {}

local P = Theme.P
local player = Players.LocalPlayer

local gui: ScreenGui
local scaleObj: UIScale
local card, levelLabel, xpBar, xpLabel, coinLabel, coinScale, pointsLabel
local crosshair, crossDot, crossRing, chargeFrame, chargeBar, chargeLabel, hintLabel
local zoneFrame, zoneLabel
local toastList
local announceFrame, announceTitle, announceSub
local resultCard, resultDist, resultInfo, resultCombo
local struggleFrame, struggleBar, struggleTitle
local chipPeace, chipSafe

HUD.gui = nil
HUD.abilityBar = nil

local shownCoins = 0
local coinTween = nil

-- Toasts ------------------------------------------------------------------------------------------------------------------

local TOAST_COLORS = {
	coin = P.Accent,
	good = P.Green,
	bad = P.Red,
	info = P.Accent2,
}

function HUD.toast(text: string, kind: string?)
	if not toastList then
		return
	end
	local color = TOAST_COLORS[kind or "info"] or P.White
	-- limita a fila
	local children = {}
	for _, c in toastList:GetChildren() do
		if c:IsA("Frame") then
			table.insert(children, c)
		end
	end
	if #children >= 6 then
		children[1]:Destroy()
	end
	local f = Theme.new("Frame", {
		BackgroundColor3 = P.Ink,
		BackgroundTransparency = 0.15,
		Size = UDim2.fromOffset(300, 34),
		AutomaticSize = Enum.AutomaticSize.None,
		Name = "Toast",
		Parent = toastList,
	})
	Theme.corner(f, 10)
	Theme.stroke(f, color, 2, 0.35)
	local bar = Theme.new("Frame", { BackgroundColor3 = color, Size = UDim2.new(0, 5, 1, -10), Position = UDim2.new(0, 6, 0, 5), Parent = f })
	Theme.corner(bar, 3)
	Theme.text(f, {
		text = text,
		size = 16,
		font = Theme.Bold,
		color = P.White,
		alignX = Enum.TextXAlignment.Left,
		frame = UDim2.new(1, -24, 1, 0),
		position = UDim2.fromOffset(20, 0),
	})
	f.Position = UDim2.fromOffset(-40, 0)
	Theme.tween(f, 0.25, { BackgroundTransparency = 0.15 })
	task.delay(3.4, function()
		if f.Parent then
			Theme.tween(f, 0.4, { BackgroundTransparency = 1 })
			for _, d in f:GetDescendants() do
				if d:IsA("TextLabel") then
					Theme.tween(d, 0.4, { TextTransparency = 1 })
				elseif d:IsA("Frame") then
					Theme.tween(d, 0.4, { BackgroundTransparency = 1 })
				elseif d:IsA("UIStroke") then
					Theme.tween(d, 0.4, { Transparency = 1 })
				end
			end
			task.wait(0.45)
			f:Destroy()
		end
	end)
end

-- Anuncio grande ------------------------------------------------------------------------------------------------------------

local announceToken = 0
function HUD.announce(title: string, subtitle: string?, duration: number?, color: Color3?)
	announceToken += 1
	local token = announceToken
	announceTitle.Text = title
	announceTitle.TextColor3 = color or P.Accent
	announceSub.Text = subtitle or ""
	announceFrame.Visible = true
	announceFrame.Position = UDim2.new(0.5, 0, 0, 40)
	local sc = announceFrame:FindFirstChild("Scale")
	sc.Scale = 0.4
	announceTitle.TextTransparency = 0
	announceSub.TextTransparency = 0
	Theme.tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Theme.tween(announceFrame, 0.35, { Position = UDim2.new(0.5, 0, 0, 120) }, Enum.EasingStyle.Back)
	Audio.ui("LevelUp", 0.35, 1.1)
	task.delay(duration or 2.5, function()
		if token == announceToken then
			Theme.tween(announceTitle, 0.4, { TextTransparency = 1 })
			Theme.tween(announceSub, 0.4, { TextTransparency = 1 })
			task.wait(0.45)
			if token == announceToken then
				announceFrame.Visible = false
			end
		end
	end)
end

-- Zona -------------------------------------------------------------------------------------------------------------------------

local zoneToken = 0
function HUD.setZone(name: string, icon: string?)
	zoneToken += 1
	local token = zoneToken
	zoneLabel.Text = (icon or "📍") .. "  " .. string.upper(name)
	zoneFrame.Visible = true
	zoneFrame.BackgroundTransparency = 1
	zoneLabel.TextTransparency = 1
	Theme.tween(zoneFrame, 0.4, { BackgroundTransparency = 0.25 })
	Theme.tween(zoneLabel, 0.4, { TextTransparency = 0 })
	task.delay(3.2, function()
		if token == zoneToken then
			Theme.tween(zoneFrame, 0.6, { BackgroundTransparency = 1 })
			Theme.tween(zoneLabel, 0.6, { TextTransparency = 1 })
		end
	end)
end

-- Mira -----------------------------------------------------------------------------------------------------------------------------

function HUD.setCharge(fraction: number?)
	if not fraction then
		chargeFrame.Visible = false
		crossRing.Size = UDim2.fromOffset(28, 28)
		return
	end
	chargeFrame.Visible = true
	chargeBar.Size = UDim2.fromScale(fraction, 1)
	local color = P.Green:Lerp(P.Accent, math.clamp(fraction * 2, 0, 1)):Lerp(P.Red, math.clamp(fraction * 2 - 1, 0, 1))
	chargeBar.BackgroundColor3 = color
	chargeLabel.Text = string.format("FORÇA %d%%", math.floor(fraction * 100))
	crossRing.Size = UDim2.fromOffset(28 + fraction * 26, 28 + fraction * 26)
	crossRing.UIStroke.Color = color
end

function HUD.setHint(text: string?, hovering: boolean?)
	if text then
		hintLabel.Text = text .. (hovering and "  <font color='#ffc43d'>[clique]</font>" or "")
		hintLabel.Visible = true
	else
		hintLabel.Visible = false
	end
	if hovering then
		crossDot.BackgroundColor3 = P.Accent
		crossRing.UIStroke.Color = P.Accent
	else
		crossDot.BackgroundColor3 = P.White
		if not chargeFrame.Visible then
			crossRing.UIStroke.Color = P.White
		end
	end
end

function HUD.setCrosshairVisible(visible: boolean)
	crosshair.Visible = visible
end

-- Resultado do arremesso ----------------------------------------------------------------------------------------------------------

local resultToken = 0
function HUD.showThrowResult(distance: number, coins: number, xp: number, record: boolean, combo: number, label: string?)
	resultToken += 1
	local token = resultToken
	resultDist.Text = string.format("%d <font size='22'>studs</font>", distance)
	resultDist.TextColor3 = record and P.Pink or P.Accent
	local extra = ""
	if label then
		extra = "  ·  " .. label
	end
	resultInfo.Text = string.format("+%d 🪙   +%d XP%s", coins, xp, extra)
	resultCombo.Text = combo > 1 and string.format("COMBO ×%d 🔥", combo) or (record and "NOVO RECORDE! 🏆" or "")
	resultCard.Visible = true
	resultCard.Position = UDim2.new(1, 320, 0.4, 0)
	Theme.tween(resultCard, 0.35, { Position = UDim2.new(1, -18, 0.4, 0) }, Enum.EasingStyle.Back)
	task.delay(3.6, function()
		if token == resultToken then
			Theme.tween(resultCard, 0.4, { Position = UDim2.new(1, 320, 0.4, 0) })
		end
	end)
end

-- Espernear ------------------------------------------------------------------------------------------------------------------------------

function HUD.setStruggle(holderName: string?, progress: number?)
	if not holderName then
		struggleFrame.Visible = false
		return
	end
	struggleFrame.Visible = true
	struggleTitle.Text = string.format("🕸️ %s te agarrou!  Aperte <b>ESPAÇO</b> sem parar!", holderName)
	struggleBar.set(progress or 0, true)
end

-- Cartao do jogador -----------------------------------------------------------------------------------------------------------------------

local function formatCoins(n: number): string
	return Util.formatNumber(math.floor(n))
end

local function refreshCard()
	levelLabel.Text = tostring(Store.get("Level") or 1)
	local xp, need = Store.get("XP") or 0, Store.get("XPNeeded") or 100
	xpBar.set(xp / math.max(need, 1))
	xpLabel.Text = string.format("XP %s / %s", Util.formatNumber(xp), Util.formatNumber(need))
	local sp = Store.get("SkillPoints") or 0
	pointsLabel.Visible = sp > 0
	pointsLabel.Text = string.format("⭐ %d ponto%s de habilidade — abra o Menu [M]", sp, sp == 1 and "" or "s")
end

local function setCoins(target: number)
	if coinTween then
		coinTween:Disconnect()
	end
	local from = shownCoins
	local t0 = os.clock()
	local dur = 0.6
	coinTween = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - t0) / dur, 0, 1)
		shownCoins = Util.lerp(from, target, 1 - (1 - a) ^ 3)
		coinLabel.Text = "🪙 " .. formatCoins(shownCoins)
		if a >= 1 then
			coinTween:Disconnect()
			coinTween = nil
		end
	end)
	if target > from then
		coinScale.Scale = 1.25
		Theme.tween(coinScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

-- Construcao ---------------------------------------------------------------------------------------------------------------------------------

local function build()
	gui = Theme.new("ScreenGui", {
		Name = "TV_HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	HUD.gui = gui
	scaleObj = Theme.new("UIScale", { Parent = gui })
	local function rescale()
		local vs = workspace.CurrentCamera.ViewportSize
		scaleObj.Scale = math.clamp(vs.Y / 820, 0.62, 1.25)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- cartao do jogador
	card = Theme.panel(gui, { size = UDim2.fromOffset(330, 104), position = UDim2.fromOffset(16, 16), name = "PlayerCard" })
	local badge = Theme.new("Frame", { Size = UDim2.fromOffset(74, 74), Position = UDim2.fromOffset(14, 15), BackgroundColor3 = Color3.new(1, 1, 1), Parent = card, Name = "Badge" })
	Theme.corner(badge, 37)
	Theme.gradient(badge, Color3.fromRGB(255, 226, 120), Color3.fromRGB(255, 150, 40), 90)
	Theme.stroke(badge, Color3.new(1, 1, 1), 3, 0.3)
	levelLabel = Theme.text(badge, { text = "1", font = Theme.Title, size = 38, color = P.Ink, stroke = 1 })
	Theme.text(card, { text = "NÍVEL", size = 10, font = Theme.Bold, color = P.Muted, frame = UDim2.fromOffset(74, 12), position = UDim2.fromOffset(14, 91) }).ZIndex = 2
	Theme.text(card, {
		text = player.DisplayName,
		font = Theme.Title,
		size = 18,
		alignX = Enum.TextXAlignment.Left,
		frame = UDim2.new(1, -110, 0, 22),
		position = UDim2.fromOffset(100, 10),
	})
	xpBar = Theme.bar(card, { size = UDim2.new(1, -116, 0, 14), position = UDim2.fromOffset(100, 36), color = P.Accent2, gradient = P.Blue })
	xpLabel = Theme.text(card, { text = "XP", size = 11, font = Theme.Bold, color = P.Muted, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(1, -116, 0, 12), position = UDim2.fromOffset(100, 52) })
	coinLabel = Theme.text(card, {
		text = "🪙 0",
		font = Theme.Title,
		size = 26,
		color = P.Accent,
		alignX = Enum.TextXAlignment.Left,
		frame = UDim2.new(1, -110, 0, 30),
		position = UDim2.fromOffset(100, 64),
		stroke = 0.6,
	})
	coinScale = Theme.new("UIScale", { Parent = coinLabel })
	pointsLabel = Theme.text(gui, {
		text = "",
		size = 14,
		font = Theme.Bold,
		color = P.Accent,
		alignX = Enum.TextXAlignment.Left,
		frame = UDim2.fromOffset(340, 20),
		position = UDim2.fromOffset(20, 126),
		stroke = 0.5,
	})
	pointsLabel.Visible = false

	-- mira
	crosshair = Theme.new("Frame", { Size = UDim2.fromOffset(60, 60), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Name = "Crosshair", Parent = gui })
	crossDot = Theme.new("Frame", { Size = UDim2.fromOffset(6, 6), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = P.White, Parent = crosshair })
	Theme.corner(crossDot, 3)
	Theme.stroke(crossDot, P.Ink, 1, 0.3)
	crossRing = Theme.new("Frame", { Size = UDim2.fromOffset(28, 28), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = crosshair, Name = "Ring" })
	Theme.corner(crossRing, 20)
	Theme.stroke(crossRing, P.White, 2, 0.35)

	chargeFrame = Theme.new("Frame", { Size = UDim2.fromOffset(200, 16), Position = UDim2.new(0.5, 0, 0.5, 60), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = P.Ink, BackgroundTransparency = 0.3, Visible = false, Parent = gui, Name = "Charge" })
	Theme.corner(chargeFrame, 8)
	Theme.stroke(chargeFrame, P.White, 2, 0.6)
	chargeBar = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = P.Green, Parent = chargeFrame })
	Theme.corner(chargeBar, 8)
	chargeLabel = Theme.text(chargeFrame, { text = "FORÇA", size = 12, font = Theme.Title, color = P.White, stroke = 0.4, z = 3 })

	hintLabel = Theme.text(gui, {
		text = "",
		font = Theme.Bold,
		size = 17,
		frame = UDim2.fromOffset(340, 24),
		position = UDim2.new(0.5, 0, 0.5, 32),
		anchor = Vector2.new(0.5, 0),
		stroke = 0.4,
	})
	hintLabel.Visible = false

	-- zona
	zoneFrame = Theme.new("Frame", { Size = UDim2.fromOffset(420, 50), Position = UDim2.new(0.5, 0, 0, 22), AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = P.Ink, BackgroundTransparency = 1, Visible = false, Parent = gui, Name = "Zone" })
	Theme.corner(zoneFrame, 25)
	zoneLabel = Theme.text(zoneFrame, { text = "", font = Theme.Title, size = 24, color = P.White, stroke = 0.4 })

	-- toasts
	toastList = Theme.new("Frame", { Size = UDim2.fromOffset(310, 260), Position = UDim2.new(0, 16, 1, -190), AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1, Parent = gui, Name = "Toasts" })
	Theme.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 6), Parent = toastList })

	-- anuncio
	announceFrame = Theme.new("Frame", { Size = UDim2.fromOffset(700, 120), Position = UDim2.new(0.5, 0, 0, 120), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1, Visible = false, Parent = gui, Name = "Announce" })
	Theme.new("UIScale", { Name = "Scale", Parent = announceFrame })
	announceTitle = Theme.text(announceFrame, { text = "", font = Theme.Title, size = 58, color = P.Accent, frame = UDim2.new(1, 0, 0, 70), stroke = 0.15 })
	announceSub = Theme.text(announceFrame, { text = "", font = Theme.Bold, size = 22, color = P.White, frame = UDim2.new(1, 0, 0, 30), position = UDim2.fromOffset(0, 74), stroke = 0.3 })

	-- resultado
	resultCard = Theme.panel(gui, { size = UDim2.fromOffset(280, 118), position = UDim2.new(1, 320, 0.4, 0), anchor = Vector2.new(1, 0.5), visible = false, name = "ThrowResult" })
	Theme.text(resultCard, { text = "ARREMESSO", size = 12, font = Theme.Bold, color = P.Muted, frame = UDim2.new(1, 0, 0, 16), position = UDim2.fromOffset(0, 8) })
	resultDist = Theme.text(resultCard, { text = "0", font = Theme.Title, size = 46, color = P.Accent, frame = UDim2.new(1, 0, 0, 50), position = UDim2.fromOffset(0, 22), stroke = 0.4 })
	resultInfo = Theme.text(resultCard, { text = "", size = 16, font = Theme.Bold, color = P.White, frame = UDim2.new(1, 0, 0, 20), position = UDim2.fromOffset(0, 74) })
	resultCombo = Theme.text(resultCard, { text = "", size = 15, font = Theme.Title, color = P.Pink, frame = UDim2.new(1, 0, 0, 18), position = UDim2.fromOffset(0, 94) })

	-- espernear
	struggleFrame = Theme.panel(gui, { size = UDim2.fromOffset(460, 70), position = UDim2.new(0.5, 0, 0.72, 0), anchor = Vector2.new(0.5, 0.5), visible = false, name = "Struggle", color = Color3.fromRGB(80, 30, 50), color2 = P.Ink })
	struggleTitle = Theme.text(struggleFrame, { text = "", size = 18, font = Theme.Bold, frame = UDim2.new(1, -20, 0, 26), position = UDim2.fromOffset(10, 8) })
	struggleBar = Theme.bar(struggleFrame, { size = UDim2.new(1, -30, 0, 16), position = UDim2.fromOffset(15, 40), color = P.Red, gradient = P.Accent })

	-- barra de habilidades
	local ab = Theme.new("Frame", { Size = UDim2.fromOffset(560, 84), Position = UDim2.new(0.5, 0, 1, -14), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = gui, Name = "AbilityBar" })
	Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Bottom, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = ab })
	HUD.abilityBar = ab

	-- status (canto superior direito)
	local chips = Theme.new("Frame", { Size = UDim2.fromOffset(300, 34), Position = UDim2.new(1, -16, 0, 16), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Parent = gui, Name = "Chips" })
	Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 6), Parent = chips })
	local function chip(text: string, color: Color3)
		local c = Theme.new("Frame", { Size = UDim2.fromOffset(130, 30), BackgroundColor3 = color, BackgroundTransparency = 0.25, Visible = false, Parent = chips })
		Theme.corner(c, 15)
		Theme.stroke(c, Color3.new(1, 1, 1), 2, 0.6)
		Theme.text(c, { text = text, size = 14, font = Theme.Bold })
		return c
	end
	chipPeace = chip("🕊️ Modo Pacífico", P.Green)
	chipSafe = chip("🛡️ Zona Segura", P.Blue)

	-- botao de menu
	Theme.button(gui, {
		text = "☰  MENU  [M]",
		size = UDim2.fromOffset(150, 40),
		position = UDim2.new(1, -16, 1, -16),
		anchor = Vector2.new(1, 1),
		color = P.Purple,
		textColor = P.White,
		textSize = 16,
		onClick = function()
			if HUD.onMenu then
				HUD.onMenu()
			end
		end,
	})
end

function HUD.init()
	build()

	Store.Changed:Connect(function(key, value)
		if key == "Coins" then
			setCoins(value)
		elseif key == "XP" or key == "Level" or key == "XPNeeded" or key == "SkillPoints" then
			refreshCard()
		end
	end)
	shownCoins = Store.get("Coins") or 0
	coinLabel.Text = "🪙 " .. formatCoins(shownCoins)
	refreshCard()

	local function refreshChips()
		chipPeace.Visible = player:GetAttribute("Peaceful") == true
		chipSafe.Visible = player:GetAttribute("SafeZone") == true
	end
	player:GetAttributeChangedSignal("Peaceful"):Connect(refreshChips)
	player:GetAttributeChangedSignal("SafeZone"):Connect(refreshChips)
	refreshChips()

	Remotes.get("Notify").OnClientEvent:Connect(function(text, kind)
		HUD.toast(text, kind)
		if kind == "coin" then
			Audio.ui("Coin", 0.25, 1.4)
		elseif kind == "bad" then
			Audio.ui("Error", 0.25)
		end
	end)
	Remotes.get("Announce").OnClientEvent:Connect(function(title, sub, dur, color)
		HUD.announce(title, sub, dur, color)
	end)
	Remotes.get("Zone").OnClientEvent:Connect(function(name, icon)
		HUD.setZone(name, icon)
	end)
	Remotes.get("ThrowResult").OnClientEvent:Connect(function(distance, coins, xp, record, combo, label)
		HUD.showThrowResult(distance, coins, xp, record, combo, label)
	end)

	-- esconde a mira em tela de menu aberta etc. (controlado por outros modulos)
	HUD.setCrosshairVisible(UserInputService.MouseEnabled == false or UserInputService.TouchEnabled)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Loading</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	Loading: tela de carregamento enquanto o servidor gera o mundo e o personagem nasce.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Theme = require(script.Parent:WaitForChild("Theme"))

local Loading = {}

local P = Theme.P
local player = Players.LocalPlayer

local TIPS = {
	"Clique em um objeto para agarrar. Clique com o botão direito e segure para carregar a força!",
	"Role o mouse enquanto segura algo para aproximar ou afastar.",
	"Pessoas também podem ser agarradas... e elas esperneiam! (Espaço repetido para escapar)",
	"Z/X giram o objeto, C/V inclinam. Mire com cuidado!",
	"Suba de nível para desbloquear habilidades: Puxão, Impulso, Estase, Onda de Choque...",
	"Estase congela objetos no ar: empilhe e construa escadas!",
	"O Caça-Moedas na praça dá um prêmio a cada 15 minutos.",
	"Os tubos de vento levam às ilhas flutuantes. Lá em cima tem arena, chefão e tesouros.",
	"Arremessos longos dão moedas, XP e entram no placar de recordes.",
	"Combos: arremesse de novo em até 6 segundos para multiplicar as moedas.",
	"O Foguete voa sozinho, o Bumerangue volta, a Dinamite espera... escolha seu estilo!",
	"Modo Pacífico no Menu impede que te agarrem (e você não agarra ninguém).",
}

local gui: ScreenGui
local bar
local textLabel
local tipLabel
local done = false

function Loading.init()
	gui = Theme.new("ScreenGui", {
		Name = "TV_Loading",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 100,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local bg = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = gui, Name = "Bg" })
	Theme.gradient(bg, Color3.fromRGB(38, 28, 90), Color3.fromRGB(10, 12, 32), 90)

	-- estrelas
	local rng = Random.new(7)
	for _ = 1, 60 do
		local s = Theme.new("Frame", {
			Size = UDim2.fromOffset(rng:NextInteger(2, 5), rng:NextInteger(2, 5)),
			Position = UDim2.fromScale(rng:NextNumber(), rng:NextNumber()),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = rng:NextNumber(0.2, 0.8),
			BorderSizePixel = 0,
			Parent = bg,
		})
		Theme.corner(s, 3)
	end

	Theme.text(bg, {
		text = Config.GameName,
		font = Theme.Title,
		size = 96,
		color = P.Accent,
		frame = UDim2.new(1, 0, 0, 110),
		position = UDim2.new(0, 0, 0.26, 0),
		stroke = 0.1,
	})
	Theme.text(bg, {
		text = string.upper(Config.Subtitle),
		font = Theme.Title,
		size = 30,
		color = P.Accent2,
		frame = UDim2.new(1, 0, 0, 40),
		position = UDim2.new(0, 0, 0.26, 108),
		stroke = 0.3,
	})

	local barBox = Theme.new("Frame", { Size = UDim2.fromOffset(520, 22), Position = UDim2.fromScale(0.5, 0.62), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = P.Panel, Parent = bg })
	Theme.corner(barBox, 11)
	Theme.stroke(barBox, P.White, 2, 0.7)
	bar = Theme.bar(barBox, { size = UDim2.new(1, -8, 1, -8), position = UDim2.fromOffset(4, 4), color = P.Accent, gradient = P.Pink, radius = 8 })
	textLabel = Theme.text(bg, {
		text = "Conectando...",
		size = 20,
		font = Theme.Bold,
		color = P.White,
		frame = UDim2.fromOffset(520, 28),
		position = UDim2.fromScale(0.5, 0.62),
		anchor = Vector2.new(0.5, 0),
	})
	textLabel.Position = UDim2.new(0.5, 0, 0.62, 22)
	tipLabel = Theme.text(bg, {
		text = TIPS[1],
		size = 19,
		font = Theme.Body,
		color = P.Muted,
		wrap = true,
		frame = UDim2.fromOffset(640, 60),
		position = UDim2.new(0.5, 0, 0.8, 0),
		anchor = Vector2.new(0.5, 0),
	})

	task.spawn(function()
		local i = 1
		while gui.Parent and not done do
			tipLabel.Text = "💡 " .. TIPS[i]
			i = i % #TIPS + 1
			task.wait(4.5)
		end
	end)

	RunService.RenderStepped:Connect(function()
		if done then
			return
		end
		local p = workspace:GetAttribute("TV_Progress") or 0
		bar.set(p, false)
		textLabel.Text = workspace:GetAttribute("TV_LoadText") or "Carregando..."
	end)
end

function Loading.finish()
	if done then
		return
	end
	done = true
	local bg = gui:FindFirstChild("Bg")
	if bg then
		Theme.tween(bg, 0.8, { BackgroundTransparency = 1 })
		for _, d in bg:GetDescendants() do
			if d:IsA("TextLabel") then
				Theme.tween(d, 0.7, { TextTransparency = 1, TextStrokeTransparency = 1 })
			elseif d:IsA("Frame") then
				Theme.tween(d, 0.7, { BackgroundTransparency = 1 })
			elseif d:IsA("UIStroke") then
				Theme.tween(d, 0.7, { Transparency = 1 })
			end
		end
	end
	task.delay(1, function()
		gui:Destroy()
	end)
end

return Loading
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	Menu: janela principal (tecla M). Abas: Loja, Meus Brinquedos, Habilidades, Cabo, Recordes,
	Ajustes e Ajuda.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Util = require(Shared:WaitForChild("Util"))
local Toys = require(Shared:WaitForChild("Toys"))
local AbilityDefs = require(Shared:WaitForChild("AbilityDefs"))
local QuestDefs = require(Shared:WaitForChild("QuestDefs"))

local Store = require(script.Parent.Parent:WaitForChild("Store"))
local Audio = require(script.Parent.Parent:WaitForChild("Audio"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local HUD = require(script.Parent:WaitForChild("HUD"))

local Menu = {}

local P = Theme.P
local player = Players.LocalPlayer

local gui, window, content, tabButtons, walletLabel
local currentTab = "shop"
local isOpen = false
local buildTab = {}

local TABS = {
	{ id = "shop", label = "🧸  Loja" },
	{ id = "toys", label = "🎒  Meus Brinquedos" },
	{ id = "skills", label = "⭐  Habilidades" },
	{ id = "quests", label = "📋  Missões" },
	{ id = "tether", label = "🔗  Cabo & Rastro" },
	{ id = "board", label = "🏆  Recordes" },
	{ id = "settings", label = "⚙️  Ajustes" },
	{ id = "help", label = "❓  Ajuda" },
}

-- Ajudantes --------------------------------------------------------------------------------------------------------------------

local function clear()
	for _, c in content:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end

local function useGrid(cellW: number, cellH: number)
	Theme.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cellW, cellH),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})
end

local function useList(pad: number?)
	Theme.new("UIListLayout", {
		Padding = UDim.new(0, pad or 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = content,
	})
end

local function header(text: string, order: number)
	local h = Theme.text(content, { text = text, font = Theme.Title, size = 22, color = P.Accent, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(1, -10, 0, 30) })
	h.LayoutOrder = order
	return h
end

local function refreshWallet()
	if walletLabel then
		walletLabel.Text = string.format("🪙 %s     ⭐ %d pts", Util.formatNumber(Store.get("Coins") or 0), Store.get("SkillPoints") or 0)
	end
end

local function shopCall(action: string, id: string)
	local ok, res, msg = pcall(function()
		return Remotes.get("Shop"):InvokeServer(action, id)
	end)
	if not ok then
		HUD.toast("Erro na loja", "bad")
		return false
	end
	if res then
		Audio.ui("Coin", 0.5, 1.3)
	else
		Audio.ui("Error", 0.35)
	end
	HUD.toast(msg or (res and "Pronto!" or "Não foi possível"), res and "good" or "bad")
	return res
end

-- Aba: Loja ------------------------------------------------------------------------------------------------------------------------------

local function toyCard(toy, order: number, showBuy: boolean)
	local owned = Store.ownsToy(toy.id)
	local level = Store.get("Level") or 1
	local coins = Store.get("Coins") or 0
	local rarity = Toys.Rarity[toy.rarity] or Toys.Rarity["Comum"]
	local f = Theme.panel(content, { size = UDim2.fromOffset(206, 196), name = "Toy_" .. toy.id, strokeColor = rarity.color, strokeTransparency = 0.35 })
	f.LayoutOrder = order
	Theme.text(f, { text = toy.icon, size = 42, frame = UDim2.new(1, 0, 0, 52), position = UDim2.fromOffset(0, 6) })
	Theme.text(f, { text = toy.name, size = 16, font = Theme.Title, color = rarity.color, frame = UDim2.new(1, -12, 0, 20), position = UDim2.fromOffset(6, 58) })
	Theme.text(f, { text = toy.rarity .. "  ·  Nv " .. toy.level, size = 11, font = Theme.Bold, color = P.Muted, frame = UDim2.new(1, -12, 0, 14), position = UDim2.fromOffset(6, 78) })
	Theme.text(f, { text = toy.desc, size = 11, color = P.White, wrap = true, alignY = Enum.TextYAlignment.Top, frame = UDim2.new(1, -16, 0, 46), position = UDim2.fromOffset(8, 94) })

	local label, color, enabled, action
	if owned then
		label, color, enabled = "INVOCAR", P.Green, true
		action = function()
			Remotes.get("SpawnToy"):FireServer(toy.id)
			Audio.ui("Ui", 0.3)
		end
	elseif level < toy.level then
		label, color, enabled = "🔒 Nível " .. toy.level, P.PanelLight, false
	else
		label, color, enabled = "🪙 " .. Util.formatNumber(toy.price), (coins >= toy.price) and P.Accent or P.Muted, true
		action = function()
			if shopCall("buyToy", toy.id) then
				Menu.refresh()
			end
		end
	end
	local btn = Theme.button(f, { text = label, size = UDim2.new(1, -20, 0, 36), position = UDim2.new(0, 10, 1, -44), color = color, textSize = 16, onClick = enabled and action or nil })
	if not enabled then
		btn.TextColor3 = P.Muted
	end
	if not showBuy and not owned then
		f.Visible = false
	end
end

buildTab.shop = function()
	useGrid(206, 196)
	local list = {}
	for _, t in Toys.List do
		table.insert(list, t)
	end
	table.sort(list, function(a, b)
		return a.level < b.level
	end)
	for i, t in list do
		toyCard(t, i, true)
	end
end

buildTab.toys = function()
	useGrid(206, 196)
	local n = 0
	for i, t in Toys.List do
		if Store.ownsToy(t.id) then
			n += 1
			toyCard(t, i, false)
		end
	end
	local clearBtn = Theme.button(content, {
		text = "🧹 Guardar todos os meus brinquedos",
		size = UDim2.fromOffset(206, 196),
		color = P.Purple,
		textColor = P.White,
		textSize = 18,
		onClick = function()
			Remotes.get("DespawnToys"):FireServer()
			Audio.ui("Ui", 0.3)
		end,
	})
	clearBtn.LayoutOrder = 999
end

-- Aba: Habilidades ------------------------------------------------------------------------------------------------------------------------

buildTab.skills = function()
	useList(10)
	local sp = Store.get("SkillPoints") or 0
	header(string.format("Pontos de habilidade: %d ⭐  (1 por nível)", sp), 1)
	local order = 2
	for _, id in { "Power", "Range", "Strength", "Cooldown", "Escape", "DoubleTether" } do
		local def = Config.Upgrades[id]
		local cur = Store.upgrade(id)
		local cost = (id == "DoubleTether") and 5 or (1 + cur // 3)
		local row = Theme.panel(content, { size = UDim2.new(1, -12, 0, 64), name = "Up_" .. id })
		row.LayoutOrder = order
		order += 1
		Theme.text(row, { text = def.icon, size = 30, frame = UDim2.fromOffset(56, 64) })
		Theme.text(row, { text = def.name, font = Theme.Title, size = 18, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(0.4, 0, 0, 24), position = UDim2.fromOffset(60, 6) })
		Theme.text(row, { text = def.desc, size = 12, color = P.Muted, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(0.5, 0, 0, 18), position = UDim2.fromOffset(60, 34) })
		-- pontinhos de nivel
		for i = 1, def.max do
			local pip = Theme.new("Frame", {
				Size = UDim2.fromOffset(10, 10),
				Position = UDim2.new(0.55, (i - 1) * 14, 0.5, -5),
				BackgroundColor3 = (i <= cur) and P.Accent or P.Ink,
				Parent = row,
			})
			Theme.corner(pip, 5)
			Theme.stroke(pip, Color3.new(1, 1, 1), 1, 0.7)
		end
		local maxed = cur >= def.max
		Theme.button(row, {
			text = maxed and "MÁX" or string.format("+  (%d⭐)", cost),
			size = UDim2.fromOffset(100, 38),
			position = UDim2.new(1, -110, 0.5, -19),
			color = maxed and P.PanelLight or ((sp >= cost) and P.Green or P.Muted),
			textSize = 16,
			onClick = (not maxed) and function()
				Remotes.get("BuyUpgrade"):FireServer(id)
				Audio.ui("Ui", 0.4, 1.3)
			end or nil,
		})
	end

	header("Habilidades (teclas 1-7)", order)
	order += 1
	local level = Store.get("Level") or 1
	for _, def in AbilityDefs.List do
		local unlocked = level >= def.level
		local row = Theme.panel(content, { size = UDim2.new(1, -12, 0, 62), name = "Ab_" .. def.id })
		row.LayoutOrder = order
		order += 1
		Theme.text(row, { text = def.icon, size = 30, frame = UDim2.fromOffset(56, 62) })
		Theme.text(row, { text = string.format("%s  <font color='#ffc43d'>[%s]</font>", def.name, def.keyLabel), font = Theme.Title, size = 17, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(0.6, 0, 0, 24), position = UDim2.fromOffset(60, 5) })
		Theme.text(row, { text = def.desc, size = 12, color = P.Muted, wrap = true, alignX = Enum.TextXAlignment.Left, alignY = Enum.TextYAlignment.Top, frame = UDim2.new(0.68, 0, 0, 30), position = UDim2.fromOffset(60, 30) })
		Theme.text(row, {
			text = unlocked and string.format("⏱ %ds", def.cooldown) or ("🔒 Nível " .. def.level),
			font = Theme.Title,
			size = 16,
			color = unlocked and P.Green or P.Muted,
			frame = UDim2.fromOffset(110, 30),
			position = UDim2.new(1, -120, 0.5, -15),
		})
		if not unlocked then
			row.BackgroundTransparency = 0.5
		end
	end
end

-- Aba: Missoes ---------------------------------------------------------------------------------------------------------------------------------

buildTab.quests = function()
	useList(10)
	local q = Store.get("Quests") or { slots = {}, completed = 0 }
	header(string.format("Missões ativas  ·  %d concluídas", q.completed or 0), 1)
	for i, s in q.slots do
		local def = QuestDefs.ById[s.id]
		if def then
			local row = Theme.panel(content, { size = UDim2.new(1, -12, 0, 78) })
			row.LayoutOrder = i + 1
			Theme.text(row, { text = def.icon, size = 34, frame = UDim2.fromOffset(60, 78) })
			Theme.text(row, { text = def.text, font = Theme.Title, size = 17, alignX = Enum.TextXAlignment.Left, wrap = true, frame = UDim2.new(1, -220, 0, 26), position = UDim2.fromOffset(64, 8) })
			local bar = Theme.bar(row, { size = UDim2.new(1, -230, 0, 14), position = UDim2.fromOffset(66, 44), color = P.Green, gradient = P.Accent2, radius = 7 })
			bar.set(s.progress / math.max(def.goal, 1), true)
			Theme.text(row, { text = string.format("%s / %s", Util.formatNumber(s.progress), Util.formatNumber(def.goal)), size = 13, font = Theme.Bold, color = P.Muted, alignX = Enum.TextXAlignment.Left, frame = UDim2.fromOffset(120, 16), position = UDim2.fromOffset(66, 60) })
			Theme.text(row, { text = string.format("🪙 %d   ✨ %d XP", def.coins, def.xp), size = 16, font = Theme.Title, color = P.Accent, alignX = Enum.TextXAlignment.Right, frame = UDim2.fromOffset(140, 30), position = UDim2.new(1, -150, 0.5, -15) })
		end
	end
	local tip = Theme.text(content, { text = "Ao cumprir uma missão, outra aparece no lugar. Novas missões entram conforme você sobe de nível.", size = 14, color = P.Muted, wrap = true, frame = UDim2.new(1, -12, 0, 40) })
	tip.LayoutOrder = 99
end

-- Aba: Cabo & Rastro ------------------------------------------------------------------------------------------------------------------------

local function swatch(item, order: number, kind: string)
	local owned = (kind == "tether" and Store.get("OwnedTethers")[item.id]) or (kind == "trail" and Store.get("OwnedTrails")[item.id]) or false
	local equipped = (kind == "tether" and Store.get("Tether") == item.id) or (kind == "trail" and Store.get("Trail") == item.id)
	local level = Store.get("Level") or 1
	local coins = Store.get("Coins") or 0
	local f = Theme.panel(content, { size = UDim2.fromOffset(150, 128), name = "Sw_" .. item.id, strokeColor = equipped and P.Accent or P.White, strokeTransparency = equipped and 0.1 or 0.82 })
	f.LayoutOrder = order
	local preview = Theme.new("Frame", { Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = item.color or P.Accent2, Parent = f })
	Theme.corner(preview, 13)
	if item.rainbow then
		Theme.new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
				ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 120)),
				ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 160, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
			}),
			Parent = preview,
		})
	elseif kind == "trail" then
		preview.BackgroundColor3 = P.PanelLight
		Theme.text(preview, { text = item.id == "Nenhum" and "—" or "✨", size = 18 })
	end
	Theme.text(f, { text = item.name, font = Theme.Title, size = 14, frame = UDim2.new(1, -8, 0, 32), position = UDim2.fromOffset(4, 40), wrap = true })
	local label, color, enabled, action
	local buyAction = kind == "tether" and "buyTether" or "buyTrail"
	local equipAction = kind == "tether" and "equipTether" or "equipTrail"
	if equipped then
		label, color, enabled = "EQUIPADO ✔", P.Accent, false
	elseif owned then
		label, color, enabled = "EQUIPAR", P.Green, true
		action = function()
			if shopCall(equipAction, item.id) then
				Menu.refresh()
			end
		end
	elseif level < item.level then
		label, color, enabled = "🔒 Nv " .. item.level, P.PanelLight, false
	else
		label, color, enabled = "🪙 " .. Util.formatNumber(item.price), (coins >= item.price) and P.Accent or P.Muted, true
		action = function()
			if shopCall(buyAction, item.id) then
				Menu.refresh()
			end
		end
	end
	local b = Theme.button(f, { text = label, size = UDim2.new(1, -16, 0, 32), position = UDim2.new(0, 8, 1, -40), color = color, textSize = 14, onClick = enabled and action or nil })
	if not enabled and not equipped then
		b.TextColor3 = P.Muted
	end
end

buildTab.tether = function()
	useGrid(150, 128)
	local order = 0
	for _, c in Config.TetherColors do
		order += 1
		swatch(c, order, "tether")
	end
	for _, t in Config.Trails do
		order += 1
		swatch(t, 100 + order, "trail")
	end
end

-- Aba: Recordes ----------------------------------------------------------------------------------------------------------------------------

buildTab.board = function()
	useList(6)
	header("🏆 Maiores arremessos do servidor", 1)
	local mine = Theme.panel(content, { size = UDim2.new(1, -12, 0, 60), color = Color3.fromRGB(60, 44, 110) })
	mine.LayoutOrder = 2
	Theme.text(mine, {
		text = string.format("Você:  <font color='#ffc43d'>%d studs</font>   ·   %d arremessos   ·   %d acertos   ·   Nível %d", Store.get("BestThrow") or 0, Store.get("TotalThrows") or 0, Store.get("TotalHits") or 0, Store.get("Level") or 1),
		size = 17,
		font = Theme.Bold,
	})
	local loading = Theme.text(content, { text = "Carregando placar...", size = 16, color = P.Muted, frame = UDim2.new(1, 0, 0, 30) })
	loading.LayoutOrder = 3
	task.spawn(function()
		local ok, list = pcall(function()
			return Remotes.get("GetBoard"):InvokeServer()
		end)
		if not content.Parent or currentTab ~= "board" or not loading.Parent then
			return
		end
		loading:Destroy()
		if not ok or type(list) ~= "table" or #list == 0 then
			local t = Theme.text(content, { text = "Ainda ninguém arremessou longe. Seja o primeiro!", size = 16, color = P.Muted, frame = UDim2.new(1, 0, 0, 30) })
			t.LayoutOrder = 4
			return
		end
		for i, e in list do
			local row = Theme.panel(content, { size = UDim2.new(1, -12, 0, 44) })
			row.LayoutOrder = 3 + i
			local medal = (i == 1 and "🥇") or (i == 2 and "🥈") or (i == 3 and "🥉") or tostring(i) .. "."
			Theme.text(row, { text = medal, font = Theme.Title, size = 22, frame = UDim2.fromOffset(60, 44) })
			Theme.text(row, { text = e.name, font = Theme.Bold, size = 18, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(0.6, 0, 1, 0), position = UDim2.fromOffset(64, 0) })
			Theme.text(row, { text = e.value .. " studs", font = Theme.Title, size = 20, color = P.Accent, alignX = Enum.TextXAlignment.Right, frame = UDim2.new(0.3, 0, 1, 0), position = UDim2.new(0.7, -14, 0, 0) })
		end
	end)
end

-- Aba: Ajustes ------------------------------------------------------------------------------------------------------------------------------

local function toggleRow(label: string, desc: string, key: string, order: number)
	local row = Theme.panel(content, { size = UDim2.new(1, -12, 0, 64) })
	row.LayoutOrder = order
	Theme.text(row, { text = label, font = Theme.Title, size = 18, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(0.7, 0, 0, 26), position = UDim2.fromOffset(16, 8) })
	Theme.text(row, { text = desc, size = 12, color = P.Muted, alignX = Enum.TextXAlignment.Left, wrap = true, frame = UDim2.new(0.7, 0, 0, 22), position = UDim2.fromOffset(16, 34) })
	local on = Store.setting(key) == true
	local track = Theme.new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(64, 32), Position = UDim2.new(1, -80, 0.5, -16), BackgroundColor3 = on and P.Green or P.Ink, Parent = row })
	Theme.corner(track, 16)
	Theme.stroke(track, Color3.new(1, 1, 1), 2, 0.7)
	local knob = Theme.new("Frame", { Size = UDim2.fromOffset(24, 24), Position = on and UDim2.fromOffset(36, 4) or UDim2.fromOffset(4, 4), BackgroundColor3 = P.White, Parent = track })
	Theme.corner(knob, 12)
	track.Activated:Connect(function()
		local nowOn = not (Store.setting(key) == true)
		Remotes.get("SetSetting"):FireServer(key, nowOn)
		Store.get("Settings")[key] = nowOn
		Theme.tween(track, 0.15, { BackgroundColor3 = nowOn and P.Green or P.Ink })
		Theme.tween(knob, 0.15, { Position = nowOn and UDim2.fromOffset(36, 4) or UDim2.fromOffset(4, 4) })
		Audio.ui("Ui", 0.3)
	end)
end

buildTab.settings = function()
	useList(10)
	toggleRow("🕊️ Modo Pacífico", "Ninguém consegue te agarrar, e você não agarra pessoas. Objetos continuam liberados.", "Peaceful", 1)
	toggleRow("🔊 Efeitos sonoros", "Liga ou desliga os sons do jogo.", "Sfx", 2)
	toggleRow("📳 Tremor de câmera", "Impactos e explosões balançam a tela. Desligue se sentir enjoo.", "Shake", 3)
	local reset = Theme.button(content, {
		text = "🔄  Reaparecer na praça",
		size = UDim2.fromOffset(300, 46),
		color = P.Red,
		textColor = P.White,
		textSize = 18,
		onClick = function()
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.Health = 0
			end
			Menu.close()
		end,
	})
	reset.LayoutOrder = 10
end

-- Aba: Ajuda -----------------------------------------------------------------------------------------------------------------------------------

buildTab.help = function()
	useList(8)
	local lines = {
		{ "🖱️ Clique esquerdo", "Agarra o objeto ou a pessoa sob a mira. Clique de novo para soltar." },
		{ "🖱️ Botão direito (segurar)", "Carrega a força do arremesso. Solte para arremessar. Uma linha mostra onde vai cair." },
		{ "🖲️ Scroll", "Aproxima ou afasta o objeto que você está segurando." },
		{ "⌨️ Z / X   C / V", "Gira (Z/X) e inclina (C/V) o objeto — só enquanto segura." },
		{ "⌨️ 1 a 7", "Usa as habilidades (liberadas por nível)." },
		{ "⌨️ Shift", "Correr.   Espaço: pular / levantar do chão / escapar quando te agarram (aperte várias vezes)." },
		{ "⌨️ G", "Solta tudo que está segurando." },
		{ "⌨️ M", "Abre e fecha este menu." },
		{ "⌨️ H · B · N", "Emotes: acenar · comemorar · dançar (todos veem)." },
		{ "⌨️ J", "Recolhe/expande a lista de missões." },
		{ "🎮 Controle", "R1 agarra/solta · R2 carrega e arremessa · D-pad ajusta a distância." },
		{ "📱 Celular", "Toque num objeto para agarrar. Use os botões ARREMESSAR (segure), SOLTAR e ± distância." },
		{ "💡 Dica", "Arremessos longos dão moedas, XP e recordes. Combos multiplicam os ganhos. Explore os tubos de vento para chegar às ilhas!" },
	}
	for i, l in lines do
		local row = Theme.panel(content, { size = UDim2.new(1, -12, 0, 52) })
		row.LayoutOrder = i
		Theme.text(row, { text = l[1], font = Theme.Title, size = 16, color = P.Accent, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(0.32, 0, 1, 0), position = UDim2.fromOffset(14, 0) })
		Theme.text(row, { text = l[2], size = 14, alignX = Enum.TextXAlignment.Left, wrap = true, frame = UDim2.new(0.66, -20, 1, 0), position = UDim2.new(0.33, 0, 0, 0) })
	end
end

-- Abrir / fechar --------------------------------------------------------------------------------------------------------------------------------

function Menu.refresh()
	if not isOpen then
		return
	end
	clear()
	refreshWallet()
	local fn = buildTab[currentTab]
	if fn then
		fn()
	end
	for id, b in tabButtons do
		local active = id == currentTab
		Theme.tween(b, 0.12, { BackgroundColor3 = active and P.Accent or P.PanelLight, TextColor3 = active and P.Ink or P.White })
	end
end

function Menu.setTab(id: string)
	currentTab = id
	content.CanvasPosition = Vector2.zero
	Menu.refresh()
	Audio.ui("Ui", 0.25, 1.1)
end

function Menu.open(tab: string?)
	if tab then
		currentTab = tab
	end
	isOpen = true
	HUD.menuOpen = true
	gui.Enabled = true
	window.Position = UDim2.fromScale(0.5, 0.56)
	Theme.tween(window, 0.22, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
	Menu.refresh()
	Audio.ui("Ui", 0.3)
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
end

function Menu.close()
	if not isOpen then
		return
	end
	isOpen = false
	HUD.menuOpen = false
	gui.Enabled = false
end

function Menu.toggle()
	if isOpen then
		Menu.close()
	else
		Menu.open()
	end
end

function Menu.isOpen(): boolean
	return isOpen
end

function Menu.init()
	gui = Theme.new("ScreenGui", { Name = "TV_Menu", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20, Enabled = false, Parent = player:WaitForChild("PlayerGui") })
	local dim = Theme.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Text = "", AutoButtonColor = false, Parent = gui, Name = "Dim" })
	dim.Activated:Connect(Menu.close)

	window = Theme.panel(gui, { size = UDim2.fromOffset(980, 600), position = UDim2.fromScale(0.5, 0.5), anchor = Vector2.new(0.5, 0.5), name = "Window", radius = 20 })
	Theme.new("UISizeConstraint", { MaxSize = Vector2.new(980, 600), Parent = window })
	local sc = Theme.new("UIScale", { Parent = window })
	local function rescale()
		local vs = workspace.CurrentCamera.ViewportSize
		sc.Scale = math.clamp(math.min(vs.X / 1040, vs.Y / 660), 0.5, 1.15)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	Theme.text(window, { text = Config.GameName .. "  —  MENU", font = Theme.Title, size = 28, color = P.Accent, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(0, 400, 0, 44), position = UDim2.fromOffset(24, 10) })
	walletLabel = Theme.text(window, { text = "", font = Theme.Title, size = 22, color = P.White, alignX = Enum.TextXAlignment.Right, frame = UDim2.new(0, 360, 0, 44), position = UDim2.new(1, -90, 0, 10) })
	Theme.button(window, { text = "✕", size = UDim2.fromOffset(42, 42), position = UDim2.new(1, -18, 0, 12), anchor = Vector2.new(1, 0), color = P.Red, textColor = P.White, textSize = 22, onClick = Menu.close })

	-- abas
	local tabs = Theme.new("Frame", { Size = UDim2.fromOffset(220, 520), Position = UDim2.fromOffset(16, 66), BackgroundTransparency = 1, Parent = window })
	Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabs })
	tabButtons = {}
	for i, t in TABS do
		local b = Theme.button(tabs, {
			text = t.label,
			size = UDim2.new(1, 0, 0, 50),
			color = P.PanelLight,
			textColor = P.White,
			textSize = 17,
			onClick = function()
				Menu.setTab(t.id)
			end,
		})
		b.LayoutOrder = i
		b.TextXAlignment = Enum.TextXAlignment.Left
		Theme.padding(b, 10)
		tabButtons[t.id] = b
	end

	-- conteudo
	content = Theme.new("ScrollingFrame", {
		Size = UDim2.fromOffset(700, 520),
		Position = UDim2.fromOffset(250, 66),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = P.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = window,
		Name = "Content",
	})
	Theme.padding(content, 4)

	Store.Changed:Connect(function(key)
		if isOpen and (key == "Coins" or key == "Toys" or key == "Level" or key == "SkillPoints" or key == "Upgrades" or key == "Tether" or key == "Trail" or key == "OwnedTethers" or key == "OwnedTrails" or key == "Quests") then
			Menu.refresh()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.M and not processed then
			Menu.toggle()
		elseif input.KeyCode == Enum.KeyCode.Escape and isOpen then
			Menu.close()
		end
	end)
	HUD.onMenu = Menu.toggle
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Mobile</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	Mobile: botoes na tela para celular/tablet (agarrar, arremessar com carga, soltar, distancia).
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent:WaitForChild("Theme"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local GrabController = require(script.Parent.Parent:WaitForChild("GrabController"))
local Audio = require(script.Parent.Parent:WaitForChild("Audio"))

local Mobile = {}

local P = Theme.P
local player = Players.LocalPlayer

local function pressButton(props: { [string]: any })
	local b = Theme.new("TextButton", {
		Name = props.name,
		Size = props.size,
		Position = props.position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = props.color,
		BackgroundTransparency = 0.15,
		Text = props.text,
		TextColor3 = props.textColor or P.White,
		Font = Theme.Title,
		TextSize = props.textSize or 20,
		AutoButtonColor = false,
		Parent = props.parent,
	})
	Theme.corner(b, 40)
	Theme.stroke(b, Color3.new(1, 1, 1), 3, 0.4)
	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
	end
	b.InputBegan:Connect(function(input)
		if isPress(input) then
			Theme.tween(b, 0.06, { BackgroundTransparency = 0.45 })
			Audio.ui("Ui", 0.2, 1.2)
			if props.onDown then
				props.onDown()
			end
		end
	end)
	b.InputEnded:Connect(function(input)
		if isPress(input) then
			Theme.tween(b, 0.1, { BackgroundTransparency = 0.15 })
			if props.onUp then
				props.onUp()
			end
		end
	end)
	return b
end

function Mobile.init()
	if not UserInputService.TouchEnabled then
		return
	end
	local gui = Theme.new("ScreenGui", { Name = "TV_Mobile", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 6, Parent = player:WaitForChild("PlayerGui") })
	Theme.new("UIScale", { Scale = 0.9, Parent = gui })
	pressButton({ parent = gui, name = "Throw", text = "ARREMESSAR\n(segure)", size = UDim2.fromOffset(118, 118), position = UDim2.new(1, -90, 1, -260), color = P.Pink, textSize = 15, onDown = GrabController.mobileChargeBegin, onUp = GrabController.mobileChargeEnd })
	pressButton({ parent = gui, name = "Grab", text = "AGARRAR\nSOLTAR", size = UDim2.fromOffset(96, 96), position = UDim2.new(1, -210, 1, -190), color = P.Purple, textSize = 14, onDown = GrabController.mobileGrab })
	pressButton({ parent = gui, name = "Near", text = "−", size = UDim2.fromOffset(60, 60), position = UDim2.new(1, -60, 1, -390), color = P.Blue, textSize = 30, onDown = function()
		GrabController.adjustDistance(-1)
	end })
	pressButton({ parent = gui, name = "Far", text = "+", size = UDim2.fromOffset(60, 60), position = UDim2.new(1, -130, 1, -390), color = P.Blue, textSize = 30, onDown = function()
		GrabController.adjustDistance(1)
	end })
	HUD.setCrosshairVisible(true)
end

return Mobile
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">QuestPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	QuestPanel: lista compacta das missoes ativas (canto esquerdo, abaixo do cartao do jogador).
	Tecla J recolhe/expande.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local QuestDefs = require(Shared:WaitForChild("QuestDefs"))
local Util = require(Shared:WaitForChild("Util"))

local Store = require(script.Parent.Parent:WaitForChild("Store"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local HUD = require(script.Parent:WaitForChild("HUD"))

local QuestPanel = {}

local P = Theme.P
local panel, list, header
local collapsed = false
local lastProgress = {}

local ROW_H = 46

local function render()
	for _, c in list:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local q = Store.get("Quests")
	local slots = q and q.slots or {}
	header.Text = string.format("📋 MISSÕES  <font color='#96a0c8' size='12'>[J]  ·  %d feitas</font>", (q and q.completed) or 0)
	for i, s in slots do
		local def = QuestDefs.ById[s.id]
		if def then
			local row = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, ROW_H), BackgroundTransparency = 1, LayoutOrder = i, Parent = list, Name = "Q" .. i })
			Theme.text(row, { text = def.icon .. " " .. def.text, size = 13, font = Theme.Bold, alignX = Enum.TextXAlignment.Left, wrap = true, alignY = Enum.TextYAlignment.Top, frame = UDim2.new(1, -6, 0, 26), position = UDim2.fromOffset(2, 0) })
			local bar = Theme.bar(row, { size = UDim2.new(1, -62, 0, 10), position = UDim2.fromOffset(2, 30), color = P.Green, gradient = P.Accent2, radius = 5 })
			local frac = s.progress / math.max(def.goal, 1)
			bar.set(frac, true)
			Theme.text(row, { text = string.format("%s/%s", Util.formatNumber(s.progress), Util.formatNumber(def.goal)), size = 12, font = Theme.Bold, color = P.Accent, alignX = Enum.TextXAlignment.Right, frame = UDim2.fromOffset(56, 14), position = UDim2.new(1, -56, 0, 26) })
			local last = lastProgress[s.id]
			if last and s.progress > last then
				Theme.tween(row, 0.001, {})
				local pulse = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = P.Accent, BackgroundTransparency = 0.6, Parent = row, ZIndex = 0 })
				Theme.corner(pulse, 6)
				Theme.tween(pulse, 0.8, { BackgroundTransparency = 1 })
				task.delay(0.9, function()
					pulse:Destroy()
				end)
			end
			lastProgress[s.id] = s.progress
		end
	end
	local n = #slots
	panel.Size = UDim2.fromOffset(300, collapsed and 34 or (44 + n * (ROW_H + 4)))
	list.Visible = not collapsed
end

function QuestPanel.init()
	panel = Theme.panel(HUD.gui, {
		size = UDim2.fromOffset(300, 160),
		position = UDim2.fromOffset(16, 158),
		name = "Quests",
		transparency = 0.25,
		radius = 12,
	})
	header = Theme.text(panel, { text = "📋 MISSÕES", font = Theme.Title, size = 16, color = P.Accent, alignX = Enum.TextXAlignment.Left, frame = UDim2.new(1, -16, 0, 26), position = UDim2.fromOffset(10, 4) })
	list = Theme.new("Frame", { Size = UDim2.new(1, -20, 1, -38), Position = UDim2.fromOffset(10, 34), BackgroundTransparency = 1, Parent = panel })
	Theme.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	local btn = Theme.new("TextButton", { Size = UDim2.fromScale(1, 0), Text = "", BackgroundTransparency = 1, Parent = panel })
	btn.Size = UDim2.new(1, 0, 0, 30)
	btn.Activated:Connect(function()
		collapsed = not collapsed
		render()
	end)

	Store.Changed:Connect(function(key)
		if key == "Quests" then
			render()
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.J then
			collapsed = not collapsed
			render()
		end
	end)
	render()
end

return QuestPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	Theme: visual da interface (cores, fontes e construtores de componentes).
	Estilo "arcade cosmico": paineis azul-noite arredondados, brilho dourado, fonte FredokaOne.
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Theme = {}

Theme.P = Config.Palette
Theme.Title = Enum.Font.FredokaOne
Theme.Body = Enum.Font.GothamMedium
Theme.Bold = Enum.Font.GothamBold

local P = Theme.P

function Theme.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(parent: Instance, radius: number?)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?)
	return Theme.new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 2,
		Transparency = transparency or 0.75,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Theme.gradient(parent: Instance, c0: Color3, c1: Color3, rotation: number?)
	return Theme.new("UIGradient", {
		Color = ColorSequence.new(c0, c1),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function Theme.padding(parent: Instance, all: number)
	return Theme.new("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
		Parent = parent,
	})
end

-- Painel padrao (fundo azul-noite com gradiente e borda suave)
function Theme.panel(parent: Instance, props: { [string]: any }?): Frame
	props = props or {}
	local useGradient = props.gradient ~= false
	local f = Theme.new("Frame", {
		BackgroundColor3 = useGradient and Color3.new(1, 1, 1) or (props.color or P.Panel),
		BackgroundTransparency = props.transparency or 0.08,
		Size = props.size or UDim2.fromOffset(200, 100),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		ClipsDescendants = props.clip or false,
		Name = props.name or "Panel",
		Visible = props.visible ~= false,
		ZIndex = props.z or 1,
		Parent = parent,
	})
	Theme.corner(f, props.radius or 14)
	Theme.stroke(f, props.strokeColor or P.White, 2, props.strokeTransparency or 0.82)
	if useGradient then
		-- o UIGradient multiplica a cor de fundo: por isso o fundo e branco e o gradiente da a cor
		Theme.gradient(f, props.color and props.color:Lerp(Color3.new(1, 1, 1), 0.06) or P.PanelLight, props.color2 or P.Ink, 90)
	end
	return f
end

function Theme.text(parent: Instance, props: { [string]: any }): TextLabel
	return Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = props.font or Theme.Body,
		Text = props.text or "",
		TextColor3 = props.color or P.White,
		TextSize = props.size or 18,
		TextXAlignment = props.alignX or Enum.TextXAlignment.Center,
		TextYAlignment = props.alignY or Enum.TextYAlignment.Center,
		TextScaled = props.scaled or false,
		TextWrapped = props.wrap or false,
		RichText = props.rich ~= false,
		Size = props.frame or UDim2.fromScale(1, 1),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		TextStrokeTransparency = props.stroke or 1,
		TextStrokeColor3 = props.strokeColor or P.Ink,
		Name = props.name or "Text",
		ZIndex = props.z or 1,
		Parent = parent,
	})
end

-- Botao com efeito de hover/clique. Retorna o TextButton.
function Theme.button(parent: Instance, props: { [string]: any }): TextButton
	local base = props.color or P.Accent
	local b = Theme.new("TextButton", {
		BackgroundColor3 = base,
		AutoButtonColor = false,
		Font = props.font or Theme.Title,
		Text = props.text or "",
		TextColor3 = props.textColor or P.Ink,
		TextSize = props.textSize or 18,
		TextWrapped = true,
		Size = props.size or UDim2.fromOffset(140, 42),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		Name = props.name or "Button",
		ZIndex = props.z or 1,
		Parent = parent,
	})
	Theme.corner(b, props.radius or 10)
	Theme.stroke(b, Color3.new(1, 1, 1), 2, 0.7)
	local scale = Theme.new("UIScale", { Scale = 1, Parent = b })
	b.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.06 }):Play()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.2) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
	end)
	b.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.94 }):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1.04 }):Play()
	end)
	if props.onClick then
		b.Activated:Connect(props.onClick)
	end
	return b
end

function Theme.tween(inst: Instance, time: number, goal: { [string]: any }, style: any?, dir: any?): Tween
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

-- Barra de progresso simples. Retorna { frame, fill, set(fraction) }
function Theme.bar(parent: Instance, props: { [string]: any }): any
	local frame = Theme.new("Frame", {
		BackgroundColor3 = P.Ink,
		BackgroundTransparency = 0.25,
		Size = props.size or UDim2.new(1, 0, 0, 14),
		Position = props.position or UDim2.new(),
		AnchorPoint = props.anchor or Vector2.zero,
		ClipsDescendants = true,
		Name = props.name or "Bar",
		Parent = parent,
	})
	Theme.corner(frame, props.radius or 8)
	local fill = Theme.new("Frame", {
		BackgroundColor3 = props.gradient and Color3.new(1, 1, 1) or (props.color or P.Accent),
		Size = UDim2.fromScale(0, 1),
		Name = "Fill",
		Parent = frame,
	})
	Theme.corner(fill, props.radius or 8)
	if props.gradient then
		Theme.gradient(fill, props.color or P.Accent, props.gradient, 0)
	end
	local bar = { frame = frame, fill = fill }
	function bar.set(fraction: number, instant: boolean?)
		fraction = math.clamp(fraction, 0, 1)
		if instant then
			fill.Size = UDim2.fromScale(fraction, 1)
		else
			Theme.tween(fill, 0.25, { Size = UDim2.fromScale(fraction, 1) })
		end
	end
	return bar
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!nonstrict
--[[
	Tutorial: dicas curtas no comeco (some depois que o jogador aprende o basico).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local Store = require(script.Parent.Parent:WaitForChild("Store"))
local GrabController = require(script.Parent.Parent:WaitForChild("GrabController"))
local Theme = require(script.Parent:WaitForChild("Theme"))
local HUD = require(script.Parent:WaitForChild("HUD"))

local Tutorial = {}

local player = Players.LocalPlayer
local panel, label
local step = 0
local finished = false

local STEPS = {
	"👋 Chegue perto de um objeto e <font color='#ffc43d'>clique</font> nele para agarrar!",
	"💪 Agora segure o <font color='#ffc43d'>botão direito</font> para carregar a força e solte para <font color='#ffc43d'>arremessar</font>!",
	"🌟 Arremessos longos dão moedas e XP. Aperte <font color='#ffc43d'>M</font> para abrir o menu (loja, habilidades, cabos)!",
}

local function show(text: string)
	label.Text = text
	panel.Visible = true
	panel.Position = UDim2.new(0.5, 0, 0, 90)
	Theme.tween(panel, 0.35, { Position = UDim2.new(0.5, 0, 0, 96) }, Enum.EasingStyle.Back)
end

local function advance(to: number)
	if finished or to <= step then
		return
	end
	step = to
	if step > #STEPS then
		finished = true
		Theme.tween(panel, 0.4, { Position = UDim2.new(0.5, 0, 0, -80) })
		task.delay(0.5, function()
			panel.Visible = false
		end)
		Remotes.get("SetSetting"):FireServer("Tutorial", true)
		return
	end
	show(STEPS[step])
end

function Tutorial.init()
	if Store.setting("Tutorial") == true then
		return
	end
	local gui = Theme.new("ScreenGui", { Name = "TV_Tutorial", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 7, Parent = player:WaitForChild("PlayerGui") })
	panel = Theme.panel(gui, { size = UDim2.fromOffset(640, 54), position = UDim2.new(0.5, 0, 0, 96), anchor = Vector2.new(0.5, 0), visible = false, name = "Tip", radius = 27 })
	label = Theme.text(panel, { text = "", size = 18, font = Theme.Bold, wrap = true })
	HUD.tutorialPanel = panel

	GrabController.Changed:Connect(function(event)
		if event == "grab" then
			advance(2)
		elseif event == "throw" then
			advance(3)
			task.delay(9, function()
				advance(4)
			end)
		end
	end)

	task.delay(5, function()
		advance(1)
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
